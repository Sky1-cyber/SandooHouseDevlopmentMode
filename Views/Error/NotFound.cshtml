@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"/>
    <title>404 Not Found</title>
    <link rel="icon" href="~/assets/img/kaiadmin/SandooHouse.ico" type="image/x-icon"/>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --brand: #FF6B35;
            --brand-dark: #E85520;
            --brand-light: #FFF0EA;
            --brand-mid: rgba(255, 107, 53, .12);
            --accent: #2D3561;
            --bg: #F7F4F0;
            --surface: #FFFFFF;
            --surface2: #FAF8F5;
            --border: #EDE8E0;
            --text: #1A1714;
            --text-sub: #7A736B;
            --text-light: #B5AFA8;
            --danger: #E84545;
            --font: 'Sora', sans-serif;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
            width: 100%;
            overflow: hidden; /* PREVENTS SCROLLING */
            font-family: var(--font);
            background: var(--bg);
            color: var(--text);
            -webkit-font-smoothing: antialiased;
            position: fixed; /* Ensures no movement on mobile */
        }

        /* dot grid background */
        body {
            background-image: radial-gradient(circle, #DDD7CE 1px, transparent 1px);
            background-size: 28px 28px;
        }

        /* ── Shell - full viewport, no scroll ── */
        .nf-shell {
            height: 100vh;
            width: 100vw;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 16px;
            position: relative;
            overflow: hidden; /* Extra safety */
        }

        /* ── Decorative blobs ── */
        .nf-blob {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
            opacity: .06;
        }

        .nf-blob-1 {
            width: min(520px, 80vw);
            height: min(520px, 80vw);
            background: var(--brand);
            top: -10%;
            right: -10%;
        }

        .nf-blob-2 {
            width: min(360px, 60vw);
            height: min(360px, 60vw);
            background: var(--accent);
            bottom: -10%;
            left: -10%;
        }

        /* ── Brand bar ── */
        .nf-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: clamp(16px, 4vh, 32px);
            z-index: 1;
            text-decoration: none;
            flex-shrink: 0;
        }

        .nf-brand-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: var(--brand);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            box-shadow: 0 4px 14px rgba(255, 107, 53, .4);
        }

        .nf-brand-name {
            font-size: clamp(14px, 4vw, 15px);
            font-weight: 700;
            color: var(--text);
            letter-spacing: -.2px;
        }

        /* ── Main card - flexible height, no overflow ── */
        .nf-card {
            background: var(--surface);
            border: 1.5px solid var(--border);
            border-radius: 28px;
            padding: clamp(24px, 5vh, 48px) clamp(20px, 5vw, 52px);
            max-width: 560px;
            width: 100%;
            max-height: 90vh; /* Prevents overflow */
            overflow-y: auto; /* Allows internal scroll if absolutely needed */
            text-align: center;
            box-shadow: 0 16px 48px rgba(26, 23, 20, .12);
            z-index: 1;
            position: relative;
            display: flex;
            flex-direction: column;
            scrollbar-width: none; /* Hide scrollbar Firefox */
            -ms-overflow-style: none; /* Hide scrollbar IE/Edge */
        }

        /* Hide scrollbar but keep functionality */
        .nf-card::-webkit-scrollbar {
            display: none;
        }

        /* ── Illustration: responsive sizing ── */
        .nf-illustration {
            margin-bottom: clamp(20px, 3vh, 36px);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            flex-shrink: 0;
        }

        .nf-number {
            font-size: clamp(80px, 20vw, 120px);
            font-weight: 800;
            letter-spacing: -6px;
            color: var(--bg);
            -webkit-text-stroke: 2.5px var(--border);
            line-height: 1;
            position: relative;
            user-select: none;
        }

        .nf-number .accent {
            -webkit-text-stroke: 2.5px var(--brand);
            color: var(--brand-light);
        }

        .nf-icon-badge {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: clamp(48px, 12vw, 64px);
            height: clamp(48px, 12vw, 64px);
            border-radius: 20px;
            background: var(--brand);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: clamp(20px, 5vw, 28px);
            color: #fff;
            box-shadow: 0 8px 28px rgba(255, 107, 53, .45);
            animation: nfFloat 3s ease-in-out infinite;
        }

        @@keyframes nfFloat {
            0%, 100% {
                transform: translate(-50%, -50%) translateY(0);
            }
            50% {
                transform: translate(-50%, -50%) translateY(-8px);
            }
        }

        /* ── Copy with responsive spacing ── */
        .nf-eyebrow {
            font-size: clamp(10px, 3vw, 11px);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: var(--brand);
            margin-bottom: clamp(8px, 2vh, 12px);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            flex-shrink: 0;
        }

        .nf-eyebrow::before,
        .nf-eyebrow::after {
            content: '';
            width: clamp(20px, 5vw, 28px);
            height: 1.5px;
            background: var(--brand);
            border-radius: 2px;
        }

        .nf-title {
            font-size: clamp(20px, 5vw, 26px);
            font-weight: 700;
            color: var(--text);
            margin-bottom: clamp(10px, 2vh, 14px);
            letter-spacing: -.5px;
            line-height: 1.25;
            flex-shrink: 0;
        }

        .nf-desc {
            font-size: clamp(13px, 3.5vw, 14px);
            color: var(--text-sub);
            line-height: 1.6;
            margin-bottom: clamp(20px, 3vh, 36px);
            font-weight: 400;
            max-width: 400px;
            margin-left: auto;
            margin-right: auto;
            flex-shrink: 0;
        }

        /* ── Actions - responsive ── */
        .nf-actions {
            display: flex;
            gap: clamp(8px, 2vw, 12px);
            justify-content: center;
            flex-wrap: wrap;
            flex-shrink: 0;
        }

        .btn-home, .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            height: clamp(42px, 10vh, 46px);
            padding: 0 clamp(18px, 4vw, 24px);
            border: none;
            border-radius: 24px;
            font-family: var(--font);
            font-size: clamp(13px, 3.5vw, 14px);
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            transition: all .18s;
            white-space: nowrap;
        }

        .btn-home {
            background: var(--brand);
            color: #fff;
            box-shadow: 0 4px 16px rgba(255, 107, 53, .38);
        }

        .btn-home:hover {
            background: var(--brand-dark);
            transform: translateY(-2px);
            color: #fff;
        }

        .btn-back {
            background: var(--surface);
            color: var(--text-sub);
            border: 1.5px solid var(--border);
        }

        .btn-back:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        /* ── Divider ── */
        .nf-divider {
            display: flex;
            align-items: center;
            gap: 14px;
            margin: clamp(20px, 4vh, 36px) 0 clamp(16px, 3vh, 28px);
            flex-shrink: 0;
        }

        .nf-divider::before,
        .nf-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border);
        }

        .nf-divider span {
            font-size: clamp(10px, 3vw, 11px);
            color: var(--text-light);
            font-weight: 500;
            white-space: nowrap;
        }

        /* ── Quick links - responsive wrap ── */
        .nf-links {
            display: flex;
            gap: 8px;
            justify-content: center;
            flex-wrap: wrap;
            flex-shrink: 0;
        }

        .nf-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px clamp(10px, 3vw, 14px);
            background: var(--surface2);
            border: 1.5px solid var(--border);
            border-radius: 20px;
            font-size: clamp(11px, 3vw, 12px);
            font-weight: 600;
            color: var(--text-sub);
            text-decoration: none;
            transition: all .15s;
            white-space: nowrap;
        }

        .nf-link i {
            font-size: clamp(11px, 3vw, 12px);
            color: var(--text-light);
            transition: color .15s;
        }

        .nf-link:hover {
            border-color: var(--brand);
            color: var(--brand);
            background: var(--brand-light);
        }

        .nf-link:hover i {
            color: var(--brand);
        }

        /* ── Footer ── */
        .nf-footer {
            margin-top: clamp(16px, 4vh, 36px);
            z-index: 1;
            font-size: clamp(11px, 3vw, 12px);
            color: var(--text-light);
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }

        .nf-footer span {
            color: var(--brand);
            font-weight: 700;
        }

        /* Landscape mode optimization */
        @@media (max-height: 600px) and (orientation: landscape) {
            .nf-card {
                padding: 16px 24px;
                max-height: 85vh;
            }

            .nf-illustration {
                margin-bottom: 12px;
            }

            .nf-number {
                font-size: 70px;
            }

            .nf-icon-badge {
                width: 40px;
                height: 40px;
                font-size: 18px;
            }

            .nf-desc {
                margin-bottom: 16px;
            }

            .nf-divider {
                margin: 16px 0 12px;
            }
        }

        /* Very small devices */
        @@media (max-width: 360px) {
            .nf-actions {
                flex-direction: column;
                width: 100%;
            }

            .btn-home, .btn-back {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>
<body>

<div class="nf-shell">

    <!-- Blobs -->
    <div class="nf-blob nf-blob-1"></div>
    <div class="nf-blob nf-blob-2"></div>

    <!-- Brand -->
    <a asp-controller="Home" asp-action="Index" class="nf-brand">
        <div class="nf-brand-icon"><i class="bi bi-house-heart-fill"></i></div>
        <span class="nf-brand-name">Sandoo House</span>
    </a>

    <!-- Card -->
    <div class="nf-card">

        <!-- Illustration -->
        <div class="nf-illustration">
            <div class="nf-number">
                <span class="accent">4</span>0<span class="accent">4</span>
            </div>
            <div class="nf-icon-badge">
                <i class="bi bi-map"></i>
            </div>
        </div>

        <!-- Copy -->
        <div class="nf-eyebrow">Page not found</div>

        <h1 class="nf-title">Looks like you took a wrong turn</h1>

        <p class="nf-desc">
            The page you're looking for doesn't exist, may have been moved,
            or the URL might be incorrect. Let's get you back on track.
        </p>

        <!-- Primary actions -->
        <div class="nf-actions">
            <a asp-controller="Home" asp-action="Index" class="btn-home">
                <i class="bi bi-house-fill"></i> Back to Dashboard
            </a>
            <a href="javascript:history.back()" class="btn-back">
                <i class="bi bi-arrow-left"></i> Go Back
            </a>
        </div>

        <!-- Divider -->
        <div class="nf-divider"><span>or jump to a section</span></div>

        <!-- Quick links -->
        <div class="nf-links">
            <a asp-controller="Account" asp-action="ListAccount" class="nf-link">
                <i class="bi bi-people-fill"></i> Admin
            </a>
            <a asp-controller="Supplier" asp-action="Index" class="nf-link">
                <i class="bi bi-truck"></i> Supplier
            </a>
            <a asp-controller="Brand" asp-action="Index" class="nf-link">
                <i class="bi bi-tag-fill"></i> Brand
            </a>
            <a asp-controller="Menu" asp-action="Index" class="nf-link">
                <i class="bi bi-grid-fill"></i> Menu
            </a>
        </div>

    </div><!-- /.nf-card -->

    <!-- Footer -->
    <div class="nf-footer">
        <i class="bi bi-c-circle"></i>
        2026 <span>Sandoo House</span> · All rights reserved
    </div>

</div>

</body>
</html>