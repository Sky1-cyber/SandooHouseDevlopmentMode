@using Sandoohouse.Models.Enum
@model IEnumerable<Sandoohouse.Models.Order>

@{
    ViewData["Title"] = "Order List";

    var now          = DateTime.Now;
    int curYear      = now.Year;
    int curMonth     = now.Month;
    string curMonthName = new DateTime(curYear, curMonth, 1).ToString("MMMM yyyy");
    int daysInMonth  = DateTime.DaysInMonth(curYear, curMonth);

    // Current-month orders only (for charts)
    var monthOrders  = Model.Where(o => o.OrderDate.Year == curYear && o.OrderDate.Month == curMonth).ToList();

    // Daily buckets
    var dailyRevenue = new decimal[daysInMonth + 1];
    var dailyCount   = new int[daysInMonth + 1];
    foreach (var o in monthOrders)
    {
        var d = o.OrderDate.Day;
        if (d >= 1 && d <= daysInMonth) { dailyRevenue[d] += o.TotalAmount; dailyCount[d]++; }
    }

    // Status breakdown (current month)
    int mPaid     = monthOrders.Count(o => o.OrderStatus == OrderStatus.Paid);
    int mPending  = monthOrders.Count(o => o.OrderStatus == OrderStatus.Pending);
    int mCanceled = monthOrders.Count(o => o.OrderStatus == OrderStatus.Canceled);
    decimal mRevenue  = monthOrders.Sum(o => o.TotalAmount);
    decimal mDiscount = monthOrders.Sum(o => o.DiscountAmount);
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

<div class="page-inner">
    
    <!-- ── STAT CARDS ── -->
    <div class="stats-grid">
        <div class="stat-card stat-purple">
            <div class="stat-card-inner">
                <div class="stat-info">
                    <span class="stat-label">Total Orders</span>
                    <span class="stat-value">@Model.Count()</span>
                </div>
                <div class="stat-icon-wrap"><i class="fas fa-shopping-bag"></i></div>
            </div>
            <div class="stat-bar"></div>
        </div>
        <div class="stat-card stat-green">
            <div class="stat-card-inner">
                <div class="stat-info">
                    <span class="stat-label">Total Revenue</span>
                    <span class="stat-value">$@Model.Sum(o => o.TotalAmount).ToString("N2")</span>
                </div>
                <div class="stat-icon-wrap"><i class="fas fa-dollar-sign"></i></div>
            </div>
            <div class="stat-bar"></div>
        </div>
        <div class="stat-card stat-blue">
            <div class="stat-card-inner">
                <div class="stat-info">
                    <span class="stat-label">Total Discount</span>
                    <span class="stat-value">$@Model.Sum(o => o.DiscountAmount).ToString("N2")</span>
                </div>
                <div class="stat-icon-wrap"><i class="fas fa-tags"></i></div>
            </div>
            <div class="stat-bar"></div>
        </div>
        <div class="stat-card stat-amber">
            <div class="stat-card-inner">
                <div class="stat-info">
                    <span class="stat-label">Avg. Order Value</span>
                    <span class="stat-value">$@(Model.Any() ? Model.Average(o => o.TotalAmount).ToString("N2") : "0.00")</span>
                </div>
                <div class="stat-icon-wrap"><i class="fas fa-chart-line"></i></div>
            </div>
            <div class="stat-bar"></div>
        </div>
    </div>

    <!-- ══ CHARTS ROW — current month ══ -->
    <div class="charts-row">

        <!-- Daily Revenue Bar Chart -->
        <div class="chart-card chart-main">
            <div class="chart-card-head">
                <div>
                    <h6 class="chart-title">
                        <i class="fas fa-chart-bar" style="color:var(--purple-a);margin-right:7px;"></i>
                        Daily Revenue
                    </h6>
                    <p class="chart-sub">Revenue per day · <strong>@curMonthName</strong></p>
                </div>
                <div class="chart-head-right">
                    <span class="chart-kpi">
                        <span class="chart-kpi-label">Month Total</span>
                        <span class="chart-kpi-val">$@mRevenue.ToString("N2")</span>
                    </span>
                    <span class="chart-badge">@monthOrders.Count orders</span>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="dailyRevenueChart"></canvas>
            </div>
        </div>

        <!-- Status Doughnut -->
        <div class="chart-card chart-side">
            <div class="chart-card-head">
                <div>
                    <h6 class="chart-title">
                        <i class="fas fa-circle-half-stroke" style="color:var(--purple-a);margin-right:7px;"></i>
                        Order Status
                    </h6>
                    <p class="chart-sub">Breakdown · @curMonthName</p>
                </div>
            </div>
            <div class="chart-body donut-wrap">
                
                <div class="donut-legend">
                    <div class="leg-item">
                        <span class="leg-dot" style="background:#28a745"></span>
                        <span class="leg-name">Paid</span>
                        <span class="leg-val">@mPaid</span>
                        <span class="leg-pct">@(monthOrders.Count > 0 ? Math.Round((decimal)mPaid / monthOrders.Count * 100) : 0)%</span>
                    </div>
                    <div class="leg-item">
                        <span class="leg-dot" style="background:#ffc107"></span>
                        <span class="leg-name">Pending</span>
                        <span class="leg-val">@mPending</span>
                        <span class="leg-pct">@(monthOrders.Count > 0 ? Math.Round((decimal)mPending / monthOrders.Count * 100) : 0)%</span>
                    </div>
                    <div class="leg-item">
                        <span class="leg-dot" style="background:#dc3545"></span>
                        <span class="leg-name">Canceled</span>
                        <span class="leg-val">@mCanceled</span>
                        <span class="leg-pct">@(monthOrders.Count > 0 ? Math.Round((decimal)mCanceled / monthOrders.Count * 100) : 0)%</span>
                    </div>
                    <div class="leg-divider"></div>
                    <div class="leg-item leg-total">
                        <span class="leg-name">Discount</span>
                        <span class="leg-val" style="color:var(--amber-b)">-$@mDiscount.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── FILTER BAR ── -->
    <div class="filter-card">
        <div class="filter-card-inner">
            <div class="filter-field filter-search">
                <i class="fas fa-search filter-icon"></i>
                <input type="text" id="searchInput" placeholder="Search by order #, amount…" class="filter-input">
            </div>
            <div class="filter-field">
                <i class="fas fa-circle-dot filter-icon"></i>
                <select id="statusFilter" class="filter-select">
                    <option value="">All Statuses</option>
                    @foreach (var status in Enum.GetValues(typeof(OrderStatus)))
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>
            <div class="filter-field">
                <i class="fas fa-calendar filter-icon"></i>
                <select id="dateFilter" class="filter-select">
                    <option value="">All Time</option>
                    <option value="today">Today</option>
                    <option value="week">This Week</option>
                    <option value="month">This Month</option>
                </select>
            </div>
            <button class="btn-clear" id="clearFilters">
                <i class="fas fa-rotate-left"></i>
                <span>Reset</span>
            </button>
        </div>
    </div>

    <!-- ── TABLE CARD ── -->
    <div class="table-card" id="tableCard">
        <div class="table-card-header">
            <div class="table-card-title">
                <span class="title-dot"></span>
                <h5>All Orders</h5>
                <span class="order-count-pill" id="visibleCount">@Model.Count() total</span>
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
                <span style="font-size:12px;color:var(--text-light);">Rows per page:</span>
                <select id="pageSizeSelect" class="filter-select" style="width:72px;min-width:unset;flex:unset;height:34px;padding:0 8px 0 10px;">
                    <option value="10">10</option>
                    <option value="20" selected>20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="orders-table" id="ordersTable">
                <thead>
                    <tr>
                        <th class="col-order">Order</th>
                        <th class="col-date">Date</th>
                        <th class="col-items">Items</th>
                        <th class="col-total">Discount</th>
                        <th class="col-total">Total</th>
                        <th class="col-status">Status</th>
                        <th class="col-payment">Payment</th>
                        <th class="col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr class="order-row"
                            data-order-num="@order.OrderNumber"
                            data-date="@order.OrderDate.ToString("MMM dd, yyyy")"
                            data-items="@(order.OrderItems?.Count ?? 0)"
                            data-total="$@order.TotalAmount.ToString("N2")"
                            data-status="@order.OrderStatus"
                            data-cash="$@order.CashReceived.ToString("N2")"
                            data-change="$@order.ChangeAmount.ToString("N2")">
                            <td class="col-order">
                                <div class="order-ref">
                                    <div class="order-avatar"><i class="fas fa-receipt"></i></div>
                                    <div class="order-ref-text">
                                        <span class="order-num">@order.OrderNumber</span>
                                        <span class="order-id">ID #@order.Id</span>
                                    </div>
                                </div>
                            </td>
                            <td class="col-date">
                                <span class="date-main">@order.OrderDate.ToString("MMM dd, yyyy")</span>
                                <span class="date-time">@order.OrderDate.ToString("hh:mm tt")</span>
                            </td>
                            <td class="col-items">
                                <span class="items-pill">
                                    <i class="fas fa-box" style="font-size:10px;margin-right:4px;"></i>
                                    @(order.OrderItems?.Count ?? 0) items
                                </span>
                            </td>
                            <td class="col-items text-center">
                                <span class="badge bg-warning text-dark px-3 py-1 fw-semibold d-flex align-items-center justify-content-center gap-1">
                                    <i class="fas fa-tag"></i> <!-- discount icon -->
                                    @order.DiscountAmount $
                                </span>
                            </td>
                            <td class="col-total">
                                <span class="amount-val">$@order.TotalAmount.ToString("N2")</span>
                            </td>
                            <td class="col-status">
                                @{
                                    var (statusCls, statusIcon) = order.OrderStatus switch
                                    {
                                        OrderStatus.Paid     => ("status-paid",    "fa-solid fa-circle-check"),
                                        OrderStatus.Pending  => ("status-pending", "fa-solid fa-clock"),
                                        OrderStatus.Canceled => ("status-cancel",  "fa-solid fa-circle-xmark"),
                                        _                    => ("status-default", "fa-solid fa-circle")
                                    };
                                }
                                <span class="status-badge @statusCls">
                                    <i class="@statusIcon"></i> @order.OrderStatus
                                </span>
                            </td>
                            <td class="col-payment">
                                <div class="pay-info">
                                    <span class="pay-row">
                                        <span class="pay-lbl">Cash</span>
                                        <span class="pay-amt">$@order.CashReceived.ToString("N2")</span>
                                    </span>
                                    <span class="pay-row muted">
                                        <span class="pay-lbl">Change</span>
                                        <span class="pay-amt">$@order.ChangeAmount.ToString("N2")</span>
                                    </span>
                                </div>
                            </td>
                            <td class="col-actions">
                                <div class="action-btns">
                                    <button class="act-btn act-view" onclick="viewOrder(@order.Id)" title="View">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button class="act-btn act-edit" onclick="editOrder(@order.Id)" title="Edit">
                                        <i class="fas fa-pen"></i>
                                    </button>
                                    <button class="act-btn act-del"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal"
                                            onclick="setDeleteData(@order.Id, '@order.OrderNumber')"
                                            title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="table-footer">
            <span class="showing-text" id="showingText">Showing <strong>0</strong> of <strong>0</strong> entries</span>
            <nav><ul class="pager" id="pager"></ul></nav>
        </div>
    </div>
</div>

<!-- ── DELETE MODAL ── -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content del-modal">
            <div class="del-modal-head">
                <div class="del-icon-ring">
                    <i class="fas fa-triangle-exclamation"></i>
                </div>
                <h5>Delete Order</h5>
                <p>Are you sure you want to delete <strong id="adminNameDisplay"></strong>?<br>
                    <span class="del-warn">This action cannot be undone.</span></p>
            </div>
            <div class="del-modal-foot">
                <button type="button" class="del-btn-cancel" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <form id="deleteForm" method="post" asp-controller="Order" asp-action="DeleteOrder">
                    <input type="hidden" name="id" id="adminIdToDelete"/>
                    <button type="submit" class="del-btn-confirm">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
:root {
    --purple-a:#667eea; --purple-b:#764ba2;
    --green-a:#28a745;  --green-b:#20c997;
    --blue-a:#17a2b8;   --blue-b:#0dcaf0;
    --amber-a:#ffc107;  --amber-b:#fd7e14;
    --danger-a:#dc3545; --danger-b:#c82333;
    --surface:#fff; --bg:#f4f6fb; --border:#e8ecf4;
    --text:#1e2340; --text-sub:#6b7280; --text-light:#9ca3b0;
    --r-sm:10px; --r-md:14px; --r-lg:20px;
    --shadow-card:0 2px 12px rgba(102,126,234,0.08),0 1px 3px rgba(0,0,0,0.04);
    --shadow-hover:0 8px 28px rgba(102,126,234,0.14);
}

/* ── HEADER ── */
.ord-header { display:flex; justify-content:space-between; align-items:flex-end; margin:1.5rem 0 1.75rem; gap:16px; flex-wrap:wrap; }
.ord-header-eyebrow { display:flex; align-items:center; gap:6px; margin-bottom:6px; font-size:12px; color:var(--text-light); }
.crumb-link { color:var(--text-sub); text-decoration:none; transition:color .2s; }
.crumb-link:hover,.crumb-link.active { color:var(--purple-a); }
.crumb-sep { color:var(--text-light); font-size:10px; }
.ord-title { font-size:1.6rem; font-weight:800; color:var(--text); margin:0 0 4px; letter-spacing:-0.3px; }
.ord-subtitle { color:var(--text-sub); font-size:13px; margin:0; }
.ord-header-right { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }

.btn-pdf {
    display:inline-flex; align-items:center; gap:8px;
    background:linear-gradient(135deg,var(--danger-a),var(--danger-b));
    color:#fff; border:none; border-radius:50px;
    padding:10px 20px; font-size:13px; font-weight:700; cursor:pointer;
    box-shadow:0 4px 14px rgba(220,53,69,0.3); transition:all .2s; white-space:nowrap;
}
.btn-pdf:hover { transform:translateY(-2px); box-shadow:0 6px 18px rgba(220,53,69,0.4); }

.btn-new-order {
    display:inline-flex; align-items:center; gap:8px;
    background:linear-gradient(135deg,var(--purple-a),var(--purple-b));
    color:#fff; border:none; border-radius:50px;
    padding:10px 22px; font-size:13px; font-weight:700;
    text-decoration:none; box-shadow:0 4px 16px rgba(102,126,234,0.35); transition:all .22s; white-space:nowrap;
}
.btn-new-order:hover { color:#fff; transform:translateY(-2px); box-shadow:0 8px 22px rgba(102,126,234,0.45); }

/* ── STATS GRID ── */
.stats-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:20px; }
.stat-card { border-radius:var(--r-lg); padding:0; overflow:hidden; box-shadow:var(--shadow-card); transition:transform .22s,box-shadow .22s; position:relative; }
.stat-card:hover { transform:translateY(-4px); box-shadow:var(--shadow-hover); }
.stat-card-inner { display:flex; justify-content:space-between; align-items:center; padding:20px 22px 16px; }
.stat-info { display:flex; flex-direction:column; gap:4px; }
.stat-label { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.6px; color:rgba(255,255,255,0.75); }
.stat-value { font-size:1.6rem; font-weight:800; color:#fff; line-height:1; letter-spacing:-0.5px; }
.stat-icon-wrap { width:48px; height:48px; background:rgba(255,255,255,0.18); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:20px; color:rgba(255,255,255,0.9); flex-shrink:0; }
.stat-bar { height:4px; background:rgba(255,255,255,0.25); position:relative; }
.stat-bar::after { content:''; position:absolute; left:0; top:0; height:100%; width:65%; background:rgba(255,255,255,0.6); border-radius:0 2px 2px 0; }
.stat-purple { background:linear-gradient(135deg,var(--purple-a),var(--purple-b)); }
.stat-green  { background:linear-gradient(135deg,var(--green-a),var(--green-b)); }
.stat-blue   { background:linear-gradient(135deg,var(--blue-a),var(--blue-b)); }
.stat-amber  { background:linear-gradient(135deg,var(--amber-a),var(--amber-b)); }

/* ══ CHARTS ══ */
.charts-row { display:grid; grid-template-columns:1fr 320px; gap:16px; margin-bottom:20px; }
.chart-card { background:var(--surface); border-radius:var(--r-lg); box-shadow:var(--shadow-card); overflow:hidden; }
.chart-card-head { display:flex; justify-content:space-between; align-items:flex-start; padding:18px 22px 14px; border-bottom:1px solid var(--border); gap:12px; flex-wrap:wrap; }
.chart-title { font-size:14px; font-weight:800; color:var(--text); margin:0 0 3px; }
.chart-sub   { font-size:11px; color:var(--text-light); margin:0; }
.chart-sub strong { color:var(--text-sub); }
.chart-head-right { display:flex; flex-direction:column; align-items:flex-end; gap:6px; }
.chart-kpi { display:flex; flex-direction:column; align-items:flex-end; }
.chart-kpi-label { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:var(--text-light); }
.chart-kpi-val   { font-size:16px; font-weight:800; color:var(--purple-a); }
.chart-badge { background:rgba(102,126,234,0.1); color:var(--purple-a); font-size:11px; font-weight:700; padding:3px 10px; border-radius:20px; white-space:nowrap; }
.chart-body { padding:18px 20px; }

/* Donut */
.donut-wrap { display:flex; flex-direction:column; align-items:center; gap:16px; padding:18px 20px; }
.donut-canvas-wrap { position:relative; width:160px; height:160px; flex-shrink:0; }
.donut-center-label { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; pointer-events:none; }
.dcl-num  { font-size:24px; font-weight:800; color:var(--text); line-height:1; }
.dcl-text { font-size:11px; color:var(--text-light); font-weight:600; }
.donut-legend { width:100%; display:flex; flex-direction:column; gap:8px; }
.leg-item { display:flex; align-items:center; gap:8px; font-size:12px; }
.leg-dot  { width:10px; height:10px; border-radius:50%; flex-shrink:0; }
.leg-name { flex:1; color:var(--text-sub); font-weight:500; }
.leg-val  { font-weight:800; color:var(--text); min-width:24px; text-align:right; }
.leg-pct  { font-size:11px; color:var(--text-light); min-width:32px; text-align:right; }
.leg-divider { border-top:1px dashed var(--border); margin:4px 0; }
.leg-total .leg-name { font-weight:700; color:var(--text); }

/* ── FILTER ── */
.filter-card { background:var(--surface); border-radius:var(--r-lg); box-shadow:var(--shadow-card); margin-bottom:18px; padding:16px 20px; }
.filter-card-inner { display:flex; gap:12px; align-items:center; flex-wrap:wrap; }
.filter-field { position:relative; display:flex; align-items:center; flex:1; min-width:160px; }
.filter-search { flex:2; min-width:220px; }
.filter-icon { position:absolute; left:13px; color:var(--text-light); font-size:13px; pointer-events:none; z-index:1; }
.filter-input,.filter-select { width:100%; height:40px; border:1.5px solid var(--border); border-radius:50px; padding:0 14px 0 36px; font-size:13px; color:var(--text); background:var(--bg); appearance:none; transition:border-color .2s,box-shadow .2s; outline:none; }
.filter-input:focus,.filter-select:focus { border-color:var(--purple-a); box-shadow:0 0 0 3px rgba(102,126,234,0.12); background:var(--surface); }
.filter-select { cursor:pointer; }
.btn-clear { height:40px; padding:0 18px; border:1.5px solid var(--border); border-radius:50px; background:var(--surface); font-size:12px; font-weight:700; color:var(--text-sub); cursor:pointer; display:flex; align-items:center; gap:7px; transition:all .2s; white-space:nowrap; flex-shrink:0; }
.btn-clear:hover { border-color:var(--danger-a); color:var(--danger-a); background:#fff5f5; }

/* ── TABLE CARD ── */
.table-card { background:var(--surface); border-radius:var(--r-lg); box-shadow:var(--shadow-card); overflow:hidden; }
.table-card-header { display:flex; justify-content:space-between; align-items:center; padding:18px 24px; border-bottom:1px solid var(--border); flex-wrap:wrap; gap:10px; }
.table-card-title { display:flex; align-items:center; gap:10px; }
.title-dot { width:10px; height:10px; border-radius:50%; background:linear-gradient(135deg,var(--purple-a),var(--purple-b)); flex-shrink:0; }
.table-card-title h5 { font-size:15px; font-weight:800; color:var(--text); margin:0; }
.order-count-pill { background:rgba(102,126,234,0.1); color:var(--purple-a); font-size:11px; font-weight:700; padding:3px 10px; border-radius:20px; }

/* Table */
.orders-table { width:100%; border-collapse:separate; border-spacing:0; }
.orders-table thead th { padding:12px 16px; font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:0.7px; color:var(--text-light); background:var(--bg); border-bottom:1px solid var(--border); white-space:nowrap; }
.orders-table tbody tr { transition:background .18s; }
.orders-table tbody tr:hover { background:rgba(102,126,234,0.04); }
.orders-table tbody td { padding:14px 16px; vertical-align:middle; border-bottom:1px solid var(--border); font-size:13px; }
.col-order { min-width:180px; } .col-date { min-width:130px; } .col-items { min-width:90px; }
.col-total { min-width:100px; } .col-status { min-width:110px; } .col-payment { min-width:140px; }
.col-actions { min-width:120px; text-align:right; }
.order-ref { display:flex; align-items:center; gap:12px; }
.order-avatar { width:38px; height:38px; border-radius:10px; background:linear-gradient(135deg,rgba(102,126,234,0.12),rgba(118,75,162,0.12)); display:flex; align-items:center; justify-content:center; font-size:15px; color:var(--purple-a); flex-shrink:0; }
.order-ref-text { display:flex; flex-direction:column; gap:2px; }
.order-num { font-size:13px; font-weight:700; color:var(--text); }
.order-id  { font-size:11px; color:var(--text-light); }
.date-main { display:block; font-size:13px; font-weight:600; color:var(--text); }
.date-time { display:block; font-size:11px; color:var(--text-light); margin-top:2px; }
.items-pill { background:var(--bg); border:1px solid var(--border); color:var(--text-sub); font-size:11px; font-weight:600; padding:4px 10px; border-radius:20px; white-space:nowrap; display:inline-flex; align-items:center; }
.amount-val { font-size:14px; font-weight:800; color:var(--text); }
.status-badge { display:inline-flex; align-items:center; gap:6px; font-size:11px; font-weight:700; padding:5px 12px; border-radius:50px; white-space:nowrap; }
.status-paid    { background:linear-gradient(135deg,#d4f5e9,#c3efe0); color:#0a6741; }
.status-pending { background:linear-gradient(135deg,#fff3cd,#ffe99a); color:#7a5200; }
.status-cancel  { background:linear-gradient(135deg,#fde8ea,#fcd4d7); color:#8b0000; }
.status-default { background:#e9ecef; color:#6c757d; }
.pay-info { display:flex; flex-direction:column; gap:3px; }
.pay-row  { display:flex; gap:6px; align-items:center; font-size:12px; }
.pay-lbl  { color:var(--text-light); min-width:42px; }
.pay-amt  { font-weight:600; color:var(--text); }
.pay-row.muted .pay-amt { color:var(--text-sub); }
.action-btns { display:flex; align-items:center; justify-content:flex-end; gap:5px; }
.act-btn { width:32px; height:32px; border-radius:8px; border:1.5px solid var(--border); background:var(--surface); display:flex; align-items:center; justify-content:center; font-size:12px; cursor:pointer; transition:all .18s; }
.act-view { color:var(--purple-a); } .act-view:hover { background:rgba(102,126,234,0.1); border-color:var(--purple-a); }
.act-edit { color:var(--blue-a); }  .act-edit:hover  { background:rgba(23,162,184,0.1); border-color:var(--blue-a); }
.act-del  { color:var(--danger-a); }.act-del:hover   { background:rgba(220,53,69,0.1); border-color:var(--danger-a); }

/* ── TABLE FOOTER ── */
.table-footer { display:flex; justify-content:space-between; align-items:center; padding:14px 24px; border-top:1px solid var(--border); flex-wrap:wrap; gap:10px; }
.showing-text { font-size:12px; color:var(--text-sub); }
.showing-text strong { color:var(--text); }
.pager { list-style:none; display:flex; gap:4px; margin:0; padding:0; }
.page-lnk { display:inline-flex; align-items:center; justify-content:center; height:32px; min-width:32px; padding:0 10px; border-radius:8px; border:1.5px solid var(--border); background:var(--surface); font-size:12px; font-weight:600; color:var(--text-sub); text-decoration:none; transition:all .18s; }
.page-lnk:hover { border-color:var(--purple-a); color:var(--purple-a); }
.page-item.active .page-lnk { background:linear-gradient(135deg,var(--purple-a),var(--purple-b)); border-color:transparent; color:#fff; box-shadow:0 3px 10px rgba(102,126,234,0.35); }
.page-item.disabled .page-lnk { opacity:0.45; pointer-events:none; }

/* ── DELETE MODAL ── */
.del-modal { border:none; border-radius:var(--r-lg); overflow:hidden; box-shadow:0 20px 50px rgba(0,0,0,0.18); }
.del-modal-head { padding:36px 32px 20px; text-align:center; border-bottom:1px solid var(--border); }
.del-icon-ring { width:64px; height:64px; border-radius:50%; background:linear-gradient(135deg,#fde8ea,#fcd4d7); color:var(--danger-a); font-size:24px; display:flex; align-items:center; justify-content:center; margin:0 auto 16px; }
.del-modal-head h5 { font-size:17px; font-weight:800; color:var(--text); margin-bottom:8px; }
.del-modal-head p { font-size:13px; color:var(--text-sub); margin:0; }
.del-warn { font-size:12px; color:var(--danger-a); font-weight:600; }
.del-modal-foot { display:flex; gap:10px; padding:18px 32px; justify-content:center; }
.del-btn-cancel { height:42px; padding:0 22px; border:1.5px solid var(--border); border-radius:50px; background:var(--surface); font-size:13px; font-weight:700; color:var(--text-sub); cursor:pointer; display:flex; align-items:center; gap:7px; transition:all .2s; }
.del-btn-cancel:hover { border-color:var(--text-sub); color:var(--text); }
.del-btn-confirm { height:42px; padding:0 22px; border:none; border-radius:50px; background:linear-gradient(135deg,var(--danger-a),var(--danger-b)); color:#fff; font-size:13px; font-weight:700; cursor:pointer; display:flex; align-items:center; gap:7px; box-shadow:0 4px 14px rgba(220,53,69,0.3); transition:all .2s; }
.del-btn-confirm:hover { transform:translateY(-1px); box-shadow:0 6px 18px rgba(220,53,69,0.4); }

/* ── PDF loading overlay ── */
.pdf-overlay { display:none; position:fixed; inset:0; background:rgba(26,23,20,0.55); z-index:99999; align-items:center; justify-content:center; backdrop-filter:blur(4px); }
.pdf-overlay.show { display:flex; }
.pdf-spinner-box { background:#fff; border-radius:20px; padding:32px 40px; text-align:center; box-shadow:0 20px 50px rgba(0,0,0,0.2); }
.pdf-spinner-box i { font-size:2.5rem; color:var(--danger-a); margin-bottom:12px; display:block; }
.pdf-spinner-box p { font-size:14px; font-weight:700; color:var(--text); margin:0; }
.pdf-spinner-box small { font-size:12px; color:var(--text-light); }

/* ── RESPONSIVE ── */
@@media (max-width:1200px) { .charts-row { grid-template-columns:1fr 280px; } }
@@media (max-width:1100px) { .stats-grid { grid-template-columns:repeat(2,1fr); } }
@@media (max-width:960px)  { .charts-row { grid-template-columns:1fr; } .donut-wrap { flex-direction:row; align-items:flex-start; } .donut-legend { flex:1; } }
