                updateShiftStats();
            }
        } catch (e) { console.warn('Could not load shift state:', e); }
    })();

    function showShiftModal() {
        const now = new Date();
        const h   = now.getHours() % 12 || 12;
        const m   = String(now.getMinutes()).padStart(2, '0');
        const ap  = now.getHours() >= 12 ? 'PM' : 'AM';
        document.getElementById('shiftCurrentTime').textContent = `${h}:${m} ${ap}`;

        if (shift.isOpen) {
            document.getElementById('shiftClosedView').style.display = 'none';
            document.getElementById('shiftOpenView').style.display   = 'block';
            updateShiftStats();
        } else {
            document.getElementById('shiftClosedView').style.display = 'block';
            document.getElementById('shiftOpenView').style.display   = 'none';
        }
        document.getElementById('shiftModal').classList.add('show');
    }

    function hideShiftModal() {
        document.getElementById('shiftModal').classList.remove('show');
    }

    function updateShiftStats() {
        if (!shift.startTime) return;
        const elapsed = Math.floor((Date.now() - shift.startTime) / 1000);
        const hrs     = Math.floor(elapsed / 3600);
        const mins    = Math.floor((elapsed % 3600) / 60);
        document.getElementById('shiftElapsed').textContent    = `${hrs}:${String(mins).padStart(2,'0')}`;
        document.getElementById('shiftOrderCount').textContent = shift.orderCount;
        document.getElementById('shiftRevenue').textContent    = '$' + shift.revenue.toFixed(2);
        document.getElementById('shiftTotalCash').textContent  = '$' + (shift.openingCash + shift.revenue).toFixed(2);
    }

    /* ── START SHIFT ── */
    document.getElementById('shiftStartBtn').addEventListener('click', async function () {
        const openCash = parseFloat(document.getElementById('shiftOpeningCash').value) || 0;
        this.disabled  = true;
        this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> កំពុងបើក...';

        try {
            const res  = await fetch('/Shift/OpenShift', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ openingCash: openCash })
            });
            const data = await res.json();

            shift.isOpen      = true;
            shift.shiftId     = data.shiftId;
            shift.startTime   = Date.now();
            shift.openingCash = openCash;
            shift.orderCount  = 0;
            shift.revenue     = 0;

            document.getElementById('shiftBtn').classList.add('shift-open');

            const now     = new Date();
            const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
            document.getElementById('shiftStartedTime').textContent     = 'ចាប់ផ្ដើម — ' + timeStr;
            document.getElementById('shiftOpenCashDisplay').textContent = '$' + openCash.toFixed(2);

            clearInterval(shift.elapsedTimer);
            shift.elapsedTimer = setInterval(updateShiftStats, 10000);

            document.getElementById('shiftClosedView').style.display = 'none';
            document.getElementById('shiftOpenView').style.display   = 'block';
            updateShiftStats();

        } catch (e) {
            alert('បើកវេនមិនបានជោគជ័យ: ' + e.message);
        } finally {
            this.disabled  = false;
            this.innerHTML = '<i class="fas fa-play-circle"></i> ចាប់ផ្ដើមវេន';
        }
    });

    /* ── END SHIFT ── */
    /* ── END SHIFT ── */
    document.getElementById('shiftEndBtn').addEventListener('click', async function () {
        if (!confirm('បញ្ចប់វេនការងារ?\n\nការកម្មង់: ' + shift.orderCount + '\nចំណូល: $' + shift.revenue.toFixed(2))) return;

        this.disabled  = true;
        this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> កំពុងបិទ...';

        try {
            const res  = await fetch('/Shift/CloseShift', { method: 'POST' });
            const data = await res.json();

            if (!data.success) {
                alert('មានបញ្ហា: ' + (data.message || 'Unknown error'));
                return;
            }

            clearInterval(shift.elapsedTimer);
            shift.isOpen      = false;
            shift.shiftId     = null;
            shift.startTime   = null;
            shift.orderCount  = 0;
            shift.revenue     = 0;
            shift.openingCash = 0;

            document.getElementById('shiftBtn').classList.remove('shift-open');
            document.getElementById('shiftOpeningCash').value = '0';
            hideShiftModal();

            // ── Redirect to ShiftSummary ──
            window.location.href = '/Shift/ShiftSummary/' + data.shiftId;

        } catch (e) {
            alert('បិទវេនមិនបានជោគជ័យ: ' + e.message);
        } finally {
            this.disabled  = false;
            this.innerHTML = '<i class="fas fa-stop-circle"></i> បញ្ចប់វេន';
        }
    });

    /* Close modal on backdrop click */
    document.getElementById('shiftModal').addEventListener('click', function (e) {
        if (e.target === this) hideShiftModal();
    });

    /* ── Hook: update local shift counters after each successful payment ──
       Reads window.lastOrder which is set by runPayFlow BEFORE resetCart.   */
    (function watchShiftRevenue() {
        const obs = new MutationObserver(function (mutations) {
            mutations.forEach(function (m) {
                m.addedNodes.forEach(function (node) {
                    if (node.classList &&
                        node.classList.contains('toast') &&
                        node.classList.contains('t-success') &&
                        shift.isOpen &&
                        window.lastOrder &&
                        window.lastOrder.total > 0) {

                        shift.orderCount++;
                        shift.revenue += window.lastOrder.total;
                        updateShiftStats();
                    }
                });
            });
        });
        obs.observe(document.body, { childList: true });
    })();
</script>
</body>
</html>
