    .ord-header { flex-direction:column; align-items:flex-start; }
    .stats-grid { grid-template-columns:repeat(2,1fr); gap:12px; }
    .filter-card-inner { flex-direction:column; }
    .filter-field,.filter-search { min-width:unset; width:100%; }
    .btn-clear { width:100%; justify-content:center; }
    .stat-value { font-size:1.3rem; }
}
@@media (max-width:480px) {
    .stats-grid { grid-template-columns:1fr 1fr; gap:8px; }
    .stat-card-inner { padding:14px 16px 12px; }
    .stat-icon-wrap { width:38px; height:38px; font-size:16px; }
    .donut-wrap { flex-direction:column; }
}
</style>

