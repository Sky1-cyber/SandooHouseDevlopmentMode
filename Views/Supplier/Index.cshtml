@model IEnumerable<Sandoohouse.Models.Supplier>

@{
    ViewData["Title"] = "Suppliers List";
    Layout = "_Layout";
}
<style>
    .card {
        transition: 0.2s;
    }

    .card:hover {
        transform: translateY(-2px);
    }

    .table td, .table th {
        vertical-align: middle;
    }

    .table-hover tbody tr:hover {
        background-color: #f8fafc;
    }

    .badge {
        font-weight: 500;
        font-size: 13px;
    }

    .btn-light {
        background: #fff;
    }

    .btn-light:hover {
        background: #f1f5f9;
    }
</style>
<div class="page-inner">
    <div class="page-header">
        <h3 class="fw-bold mb-3">Suppliers Table</h3>
        <ul class="breadcrumbs mb-3">
            <li class="nav-home">
                <a asp-controller="Home" asp-action="Index">
                    <i class="icon-home"></i>
                </a>
            </li>
            <li class="separator">
                <i class="icon-arrow-right"></i>
            </li>
            <li class="nav-item">
                <a asp-controller="Supplier" asp-action="Index">Supplier</a>
            </li>
        </ul>
        <div class="ms-md-auto py-2 py-md-0">
            <a asp-controller="Supplier" asp-action="AddSupplier" class="btn btn-primary btn-round">Add Supplier</a>
        </div>
    </div>

    
    <div class="row">
        <div class="col-12">
            <div class="card shadow border-0 rounded-4">

                <!-- Header -->
                <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold mb-0">Admin Management</h4>
                        <small class="text-muted">Manage system administrators</small>
                    </div>
                </div>

                <!-- Body -->
                <div class="card-body bg-dark-subtle pt-0">

                    <div class="table-responsive">

                        <table id="adminTable" class="table align-middle table-hover">

                            <thead class="table-light">
                            <tr>
                                <th>Admin</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-center">Actions</th>
                            </tr>
                            </thead>

                            <tbody>

                            @foreach (var supplier in Model)
                            {
                                
                            }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#basic-datatables').DataTable({
                pageLength: 10,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true
            });
        });
    </script>
}