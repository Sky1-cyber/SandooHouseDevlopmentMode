        async function openQrOnSecondScreen(totalUsd) {
            let left = window.screen.width, top = 0;
            let sw   = window.screen.width,  sh  = window.screen.height;

            const details = await getScreenDetails();
            if (details && details.screens.length > 1) {
                const second = details.screens.find(s => !s.isPrimary) || details.screens[1];
                if (second) {
                    left = (second.availLeft  !== undefined) ? second.availLeft  : (second.left  || window.screen.width);
                    top  = (second.availTop   !== undefined) ? second.availTop   : (second.top   || 0);
                    sw   = (second.availWidth !== undefined) ? second.availWidth : (second.width  || window.screen.width);
                    sh   = (second.availHeight!== undefined) ? second.availHeight: (second.height || window.screen.height);
                }
            } else {
                left = window.screen.availWidth;
                sw   = window.screen.availWidth;
                sh   = window.screen.availHeight;
            }

            const s1Left  = window.screen.availLeft  || 0;
            const s1Top   = window.screen.availTop   || 0;
            const s1Right = s1Left + (window.screen.availWidth  || window.screen.width);
            const s1Bot   = s1Top  + (window.screen.availHeight || window.screen.height);
            const wouldBeOnScreen1 = (left >= s1Left && left < s1Right && top >= s1Top && top < s1Bot);
            if (wouldBeOnScreen1) {
                const hasReal2nd = details && details.screens && details.screens.length > 1;
                if (!hasReal2nd) { notify('QR ត្រូវការ Screen ទី 2 — បើ Extended Display', 'error'); return false; }
            }

            if (qrWindow && !qrWindow.closed) { qrWindow.close(); qrWindow = null; }

            qrWindow = window.open('', 'SandooKHQR_Display',
                `width=${sw},height=${sh},left=${left},top=${top},resizable=yes,scrollbars=no,toolbar=no,menubar=no,location=no,status=no`);

            if (!qrWindow) { notify('Browser ទប់ Popup — សូម Allow popup', 'error'); return false; }

            try { qrWindow.moveTo(left, top); qrWindow.resizeTo(sw, sh); }
            catch(e) { console.warn('KHQR: moveTo/resizeTo blocked:', e.message); }

            qrWindow.document.open();
            qrWindow.document.write(buildQrWindowHtml(totalUsd));
            qrWindow.document.close();

            const tryFullscreen = function () {
                try {
                    if (qrWindow && !qrWindow.closed) {
