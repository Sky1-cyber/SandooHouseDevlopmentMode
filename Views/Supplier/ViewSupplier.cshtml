@model Supplier
@using System.Globalization
@using Sandoohouse.Models.Enum
@{
    ViewData["Title"] = Model.CompanyName + " — Supplier Profile";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
:root {
    --brand:        #FF6B35;
    --brand-dark:   #E85520;
    --brand-light:  #FFF0EA;
    --brand-mid:    rgba(255,107,53,.13);
    --accent:       #1C2340;
    --accent2:      #2D3561;
    --success:      #00B894;
    --success-bg:   rgba(0,184,148,.1);
    --warning:      #F0A500;
    --warning-bg:   rgba(240,165,0,.1);
    --danger:       #E84545;
    --danger-bg:    rgba(232,69,69,.1);
    --bg:           #F2EFE9;
    --surface:      #FFFFFF;
    --surface2:     #FAF8F5;
    --surface3:     #F4F1EC;
    --border:       #EAE5DC;
    --border-s:     #D8D2C8;
    --text:         #18150F;
    --text-sub:     #6E685F;
    --text-light:   #AEA89F;
    --shadow-xs:    0 1px 3px rgba(24,21,15,.05);
    --shadow-sm:    0 2px 8px rgba(24,21,15,.07);
    --shadow-md:    0 6px 24px rgba(24,21,15,.10);
    --shadow-lg:    0 16px 48px rgba(24,21,15,.14);
    --shadow-brand: 0 6px 20px rgba(255,107,53,.32);
    --r-xs:6px; --r-sm:10px; --r-md:16px; --r-lg:24px; --r-xl:32px;
    --font: 'Sora', sans-serif;
}
*, *::before, *::after { box-sizing: border-box; }

.sp-page {
    font-family: var(--font);
    background: var(--bg);
    background-image: radial-gradient(circle, #D8D2C8 1px, transparent 1px);
    background-size: 28px 28px;
    min-height: 100vh;
    padding: 28px 24px;
    color: var(--text);
}

/* ── Topbar ── */
.sp-topbar {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 26px; flex-wrap: wrap; gap: 12px;
    max-width: 960px; margin-left: auto; margin-right: auto;
}
.sp-topbar h1 { font-size: 20px; font-weight: 700; color: var(--text); margin: 0 0 5px; letter-spacing: -.4px; }
.sp-breadcrumb { display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 500; margin: 0; padding: 0; list-style: none; }
.sp-breadcrumb a { color: var(--text-light); text-decoration: none; transition: color .14s; }
.sp-breadcrumb a:hover { color: var(--brand); }
.sp-breadcrumb .sep { color: var(--border-s); }
.sp-breadcrumb .cur { color: var(--text-sub); font-weight: 600; }

.btn-edit-top {
    display: inline-flex; align-items: center; gap: 7px;
    height: 38px; padding: 0 18px;
    background: var(--brand); color: #fff;
    border: none; border-radius: var(--r-xl);
    font-family: var(--font); font-size: 13px; font-weight: 700;
    text-decoration: none; cursor: pointer;
    box-shadow: var(--shadow-brand); transition: all .18s;
}
.btn-edit-top:hover { background: var(--brand-dark); transform: translateY(-1px); color: #fff; text-decoration: none; }

/* ── Wrap ── */
.sp-wrap { max-width: 960px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }

/* ═══ HERO ═══ */
.sp-hero {
    background: var(--accent);
    border-radius: var(--r-lg);
    position: relative; overflow: hidden;
    box-shadow: var(--shadow-md);
}
.sp-hero::before {
    content: ''; position: absolute; inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='30' cy='30' r='1' fill='rgba(255,255,255,0.04)'/%3E%3C/svg%3E");
    pointer-events: none;
}
.sp-deco1 { position: absolute; width: 340px; height: 340px; border-radius: 50%; background: rgba(255,107,53,.07); top: -130px; right: -90px; pointer-events: none; }
.sp-deco2 { position: absolute; width: 220px; height: 220px; border-radius: 50%; background: rgba(255,255,255,.03); bottom: -90px; left: 240px; pointer-events: none; }

.sp-cover {
    height: 110px;
    background: linear-gradient(135deg, rgba(255,107,53,.22) 0%, transparent 70%);
}
.sp-avatar-row {
    display: flex; align-items: flex-end; justify-content: space-between;
    padding: 0 32px 28px;
    position: relative; z-index: 1;
    margin-top: -50px;
    flex-wrap: wrap; gap: 16px;
}
.sp-avatar-left { display: flex; align-items: flex-end; gap: 20px; flex-wrap: wrap; }

.sp-logo-wrap { position: relative; flex-shrink: 0; }
.sp-logo {
    width: 90px; height: 90px; border-radius: var(--r-md);
    overflow: hidden;
    border: 4px solid var(--accent);
    box-shadow: 0 4px 20px rgba(0,0,0,.35);
    background: var(--surface2);
}
.sp-logo img { width: 100%; height: 100%; object-fit: cover; display: block; }
/* logo placeholder if no image */
.sp-logo-placeholder {
    width: 90px; height: 90px; border-radius: var(--r-md);
    border: 4px solid var(--accent);
    box-shadow: 0 4px 20px rgba(0,0,0,.35);
    background: var(--brand);
    display: flex; align-items: center; justify-content: center;
    font-size: 30px; color: #fff; font-weight: 800;
    flex-shrink: 0; position: relative;
}

.sp-online-dot {
    position: absolute; bottom: -2px; right: -2px;
    width: 18px; height: 18px; border-radius: 50%;
    border: 3px solid var(--accent);
}
.sp-online-dot.on  { background: var(--success); }
.sp-online-dot.off { background: var(--text-light); }
.sp-online-dot.warn { background: var(--warning); }
.sp-online-dot.red  { background: var(--danger); }

.sp-hero-info { padding-top: 54px; }
.sp-hero-name { font-size: 22px; font-weight: 800; color: #fff; margin: 0 0 8px; letter-spacing: -.4px; line-height: 1.15; }
.sp-hero-chips { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

.chip-type {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 12px; border-radius: 20px;
    font-size: 11px; font-weight: 700;
    background: var(--brand-mid); color: var(--brand);
    border: 1px solid rgba(255,107,53,.3);
}
.chip-status {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 12px; border-radius: 20px;
    font-size: 11px; font-weight: 700;
}
.chip-status.active    { background: var(--success-bg); color: var(--success);  border: 1px solid rgba(0,184,148,.25); }
.chip-status.inactive  { background: rgba(255,255,255,.07); color: rgba(255,255,255,.5); border: 1px solid rgba(255,255,255,.12); }
.chip-status.banned    { background: var(--danger-bg);  color: var(--danger);   border: 1px solid rgba(232,69,69,.3); }
.chip-status.onhold    { background: var(--warning-bg); color: var(--warning);  border: 1px solid rgba(240,165,0,.3); }

.sp-hero-sub { font-size: 11px; color: rgba(255,255,255,.32); font-weight: 500; margin-top: 6px; font-family: monospace; }

/* ═══ STAT STRIP ═══ */
.sp-stat-strip {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
}
.sp-stat-cell {
    padding: 20px 24px; text-align: center;
    border-right: 1px solid var(--border);
    position: relative; overflow: hidden;
    transition: background .2s;
}
.sp-stat-cell:last-child { border-right: none; }
.sp-stat-cell::after {
    content: ''; position: absolute; bottom: 0; left: 0; right: 0;
    height: 3px; background: var(--brand);
    transform: scaleX(0); transform-origin: center; transition: transform .3s;
}
.sp-stat-cell:hover { background: var(--brand-light); }
.sp-stat-cell:hover::after { transform: scaleX(1); }
.sp-stat-num   { font-size: 28px; font-weight: 800; color: var(--text); line-height: 1; letter-spacing: -1px; }
.sp-stat-num.brand { color: var(--brand); }
.sp-stat-label { font-size: 10px; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: .08em; margin-top: 5px; }

/* ═══ MAIN LAYOUT ═══ */
.sp-layout { display: grid; grid-template-columns: 290px 1fr; gap: 20px; align-items: start; }

/* ── Sidebar ── */
.sp-sidebar {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
}
.sp-sb-sec {
    font-size: 9px; font-weight: 800; text-transform: uppercase;
    letter-spacing: .12em; color: var(--text-light);
    padding: 14px 18px 12px;
    display: flex; align-items: center; gap: 7px;
    border-bottom: 1px solid var(--border);
    background: var(--surface2);
}
.sp-sb-sec i { color: var(--brand); font-size: 12px; }

.sp-contact-list { padding: 6px 0; border-bottom: 1.5px solid var(--border); }
.sp-ci {
    display: flex; align-items: center; gap: 12px;
    padding: 11px 18px;
    transition: background .14s;
}
.sp-ci:hover { background: var(--brand-light); }
.sp-ci-icon {
    width: 34px; height: 34px; border-radius: var(--r-xs);
    background: var(--brand-light); color: var(--brand);
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; flex-shrink: 0; transition: all .15s;
}
.sp-ci:hover .sp-ci-icon { background: var(--brand); color: #fff; }
.sp-ci-body { flex: 1; min-width: 0; }
.sp-ci-lbl { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--text-light); margin-bottom: 1px; }
.sp-ci-val { font-size: 12px; font-weight: 600; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sp-ci-val.muted { color: var(--text-light); font-weight: 400; }

.btn-copy {
    width: 26px; height: 26px; border-radius: var(--r-xs);
    border: 1.5px solid var(--border); background: var(--surface);
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; color: var(--text-light); cursor: pointer;
    transition: all .15s; flex-shrink: 0;
}
.btn-copy:hover  { border-color: var(--brand); color: var(--brand); background: var(--brand-light); }
.btn-copy.copied { border-color: var(--success); color: var(--success); background: var(--success-bg); }

.sp-sb-actions { padding: 14px 16px; display: flex; flex-direction: column; gap: 8px; }
.btn-sb {
    height: 40px; width: 100%; border-radius: var(--r-xl);
    font-family: var(--font); font-size: 13px; font-weight: 700;
    cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
    text-decoration: none; transition: all .18s;
}
.btn-sb.primary { background: var(--brand); color: #fff; border: none; box-shadow: var(--shadow-brand); }
.btn-sb.primary:hover { background: var(--brand-dark); transform: translateY(-1px); color: #fff; text-decoration: none; }
.btn-sb.ghost   { background: var(--surface); color: var(--text-sub); border: 1.5px solid var(--border); }
.btn-sb.ghost:hover   { border-color: var(--accent2); color: var(--accent2); text-decoration: none; }

/* ── Right detail cards ── */
.sp-right { display: flex; flex-direction: column; gap: 16px; }

.sp-det-card {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
}
.sp-det-head {
    padding: 13px 20px;
    background: var(--surface2);
    border-bottom: 1.5px solid var(--border);
    display: flex; align-items: center; gap: 10px;
}
.sp-det-bar   { width: 3px; height: 16px; background: var(--brand); border-radius: 3px; flex-shrink: 0; }
.sp-det-title { font-size: 11px; font-weight: 800; color: var(--text); text-transform: uppercase; letter-spacing: .07em; }

/* info grid */
.sp-ig { display: grid; grid-template-columns: 1fr 1fr; }
.sp-ig-cell {
    padding: 16px 20px;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    position: relative; overflow: hidden;
    transition: background .14s;
}
.sp-ig-cell:nth-child(even) { border-right: none; }
.sp-ig-cell:nth-last-child(-n+2) { border-bottom: none; }
.sp-ig-cell.full { grid-column: 1 / -1; border-right: none; }
.sp-ig-cell:hover { background: var(--brand-light); }
.sp-ig-cell::before {
    content: ''; position: absolute; top: 0; left: 0;
    width: 3px; height: 100%; background: var(--brand);
    transform: scaleX(0); transform-origin: left; transition: transform .2s;
}
.sp-ig-cell:hover::before { transform: scaleX(1); }
.sp-ig-lbl { font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: .09em; color: var(--text-light); margin-bottom: 6px; }
.sp-ig-val { font-size: 13px; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
.sp-ig-val i { font-size: 13px; color: var(--brand); }
.sp-ig-val.success { color: var(--success); }
.sp-ig-val.danger  { color: var(--danger); }
.sp-ig-val.warning { color: var(--warning); }
.sp-ig-val.muted   { color: var(--text-light); font-weight: 500; }

/* timeline */
.sp-tl { padding: 8px 20px 16px; }
.sp-tl-item { display: flex; gap: 14px; padding: 13px 0; border-bottom: 1px solid var(--border); }
.sp-tl-item:last-child { border-bottom: none; }
.sp-tl-left { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; padding-top: 2px; }
.sp-tl-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.sp-tl-dot.brand   { background: var(--brand);   box-shadow: 0 0 0 3px var(--brand-mid); }
.sp-tl-dot.success { background: var(--success); box-shadow: 0 0 0 3px var(--success-bg); }
.sp-tl-dot.neutral { background: var(--text-light); box-shadow: 0 0 0 3px var(--border); }
.sp-tl-line { flex: 1; width: 1px; background: var(--border); margin: 5px 0 0; min-height: 20px; }
.sp-tl-item:last-child .sp-tl-line { display: none; }
.sp-tl-body { flex: 1; min-width: 0; }
.sp-tl-title { font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 2px; }
.sp-tl-desc  { font-size: 11px; color: var(--text-sub); line-height: 1.5; }
.sp-tl-time  { font-size: 10px; color: var(--text-light); margin-top: 4px; display: flex; align-items: center; gap: 4px; }

/* Toast */
.sp-toast-wrap { position: fixed; bottom: 24px; right: 24px; z-index: 9999; pointer-events: none; }
.sp-toast {
    background: var(--success); color: #fff;
    border-radius: var(--r-sm); padding: 12px 18px;
    font-family: var(--font); font-size: 13px; font-weight: 600;
    display: flex; align-items: center; gap: 8px;
    box-shadow: var(--shadow-md);
    opacity: 0; transform: translateY(12px);
    transition: opacity .2s, transform .2s;
}
.sp-toast.show { opacity: 1; transform: translateY(0); }

/* ── Responsive ── */
@@media (max-width: 820px) {
    .sp-layout { grid-template-columns: 1fr; }
    .sp-ig { grid-template-columns: 1fr; }
    .sp-ig-cell { border-right: none; }
    .sp-ig-cell:nth-last-child(-n+2) { border-bottom: 1px solid var(--border); }
    .sp-ig-cell:last-child { border-bottom: none; }
    .sp-stat-strip { grid-template-columns: 1fr; }
    .sp-stat-cell { border-right: none; border-bottom: 1px solid var(--border); }
    .sp-stat-cell:last-child { border-bottom: none; }
}
@@media (max-width: 560px) {
    .sp-page { padding: 16px 14px; }
    .sp-hero-name { font-size: 18px; }
    .sp-avatar-row { padding: 0 18px 20px; margin-top: -40px; }
    .sp-cover { height: 80px; }
    .sp-logo, .sp-logo-placeholder { width: 76px; height: 76px; }
}
</style>

@{
    var statusClass = Model.Status switch {
        SupplierStatus.Active   => "active",
        SupplierStatus.Banned   => "banned",
        SupplierStatus.OnHold   => "onhold",
        _                       => "inactive"
    };
    var dotClass = Model.Status switch {
        SupplierStatus.Active   => "on",
        SupplierStatus.Banned   => "red",
        SupplierStatus.OnHold   => "warn",
        _                       => "off"
    };
    var locationParts = new[] { Model.City, Model.State, Model.Country }
                            .Where(x => !string.IsNullOrWhiteSpace(x));
    var locationFull  = string.Join(", ", locationParts);
    var initials      = string.IsNullOrEmpty(Model.CompanyName) ? "S"
                        : Model.CompanyName.Length >= 2
                            ? $"{Model.CompanyName[0]}{Model.CompanyName.Split(' ').Last()[0]}"
                            : Model.CompanyName[0].ToString();
}

<div class="sp-page">

    <!-- Topbar -->
    <div class="sp-topbar">
        <div>
            <h1>Supplier Profile</h1>
            <nav class="sp-breadcrumb">
                <a asp-controller="Home"     asp-action="Index"><i class="bi bi-house-door-fill"></i></a>
                <span class="sep">›</span>
                <a asp-controller="Supplier" asp-action="Index">Suppliers</a>
                <span class="sep">›</span>
                <span class="cur">@Model.CompanyName</span>
            </nav>
        </div>
        <a asp-controller="Supplier" asp-action="EditSupplier" asp-route-id="@Model.SupplierId" class="btn-edit-top">
            <i class="bi bi-pencil-fill"></i> Edit Supplier
        </a>
    </div>

    <div class="sp-wrap">

        <!-- ══ HERO ══ -->
        <div class="sp-hero">
            <div class="sp-deco1"></div>
            <div class="sp-deco2"></div>
            <div class="sp-cover"></div>

            <div class="sp-avatar-row">
                <div class="sp-avatar-left">

                    <!-- Company logo or initials -->
                    @if (!string.IsNullOrEmpty(Model.CompanyProfile))
                    {
                        <div class="sp-logo-wrap">
                            <div class="sp-logo">
                                <img src="@Url.Content($"~/uploads/suppliers/{Model.CompanyProfile}")" alt="@Model.CompanyName" />
                            </div>
                            <span class="sp-online-dot @dotClass"></span>
                        </div>
                    }
                    else
                    {
                        <div style="position:relative;flex-shrink:0;">
                            <div class="sp-logo-placeholder">@initials</div>
                            <span class="sp-online-dot @dotClass"></span>
                        </div>
                    }

                    <div class="sp-hero-info">
                        <div class="sp-hero-name">@Model.CompanyName</div>
                        <div class="sp-hero-chips">
                            <span class="chip-type"><i class="bi bi-truck"></i> Supplier</span>
                            <span class="chip-status @statusClass">
                                <i class="bi bi-circle-fill" style="font-size:7px;"></i>
                                @Model.Status
                            </span>
                        </div>
                        <div class="sp-hero-sub">
                            ID · SUP-@Model.SupplierId
                            @if (!string.IsNullOrEmpty(locationFull))
                            {
                                <span style="margin-left:10px;"><i class="bi bi-geo-alt" style="margin-right:3px;"></i>@locationFull</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ══ STAT STRIP ══ -->
        <div class="sp-stat-strip">
            <div class="sp-stat-cell">
                <div class="sp-stat-num">@((int)(DateTime.UtcNow - Model.CreatedAt).TotalDays)</div>
                <div class="sp-stat-label">Days Registered</div>
            </div>
            <div class="sp-stat-cell">
                <div class="sp-stat-num">@Model.CreatedAt.ToString("yyyy")</div>
                <div class="sp-stat-label">Registered Since</div>
            </div>
            <div class="sp-stat-cell">
                <div class="sp-stat-num brand">@(Model.Status == SupplierStatus.Active ? "ON" : "OFF")</div>
                <div class="sp-stat-label">Supply Status</div>
            </div>
        </div>

        <!-- ══ MAIN LAYOUT ══ -->
        <div class="sp-layout">

            <!-- ── Sidebar ── -->
            <div class="sp-sidebar">

                <div class="sp-sb-sec"><i class="bi bi-person-lines-fill"></i> Contact Details</div>

                <div class="sp-contact-list">

                    @if (!string.IsNullOrEmpty(Model.ContactPerson))
                    {
                        <div class="sp-ci">
                            <div class="sp-ci-icon"><i class="bi bi-person-fill"></i></div>
                            <div class="sp-ci-body">
                                <div class="sp-ci-lbl">Contact Person</div>
                                <div class="sp-ci-val">@Model.ContactPerson</div>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <div class="sp-ci">
                            <div class="sp-ci-icon"><i class="bi bi-envelope-fill"></i></div>
                            <div class="sp-ci-body">
                                <div class="sp-ci-lbl">Email</div>
                                <div class="sp-ci-val">@Model.Email</div>
                            </div>
                            <button class="btn-copy" onclick="copyText('@Model.Email')"><i class="bi bi-copy"></i></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Phone))
                    {
                        <div class="sp-ci">
                            <div class="sp-ci-icon"><i class="bi bi-telephone-fill"></i></div>
                            <div class="sp-ci-body">
                                <div class="sp-ci-lbl">Phone</div>
                                <div class="sp-ci-val">@Model.Phone</div>
                            </div>
                            <button class="btn-copy" onclick="copyText('@Model.Phone')"><i class="bi bi-copy"></i></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(locationFull))
                    {
                        <div class="sp-ci">
                            <div class="sp-ci-icon"><i class="bi bi-geo-alt-fill"></i></div>
                            <div class="sp-ci-body">
                                <div class="sp-ci-lbl">Location</div>
                                <div class="sp-ci-val" style="white-space:normal;font-size:11px;">@locationFull</div>
                            </div>
                        </div>
                    }

                </div>

                <div class="sp-sb-actions">
                    <a asp-controller="Supplier" asp-action="EditSupplier" asp-route-id="@Model.SupplierId"
                       class="btn-sb primary">
                        <i class="bi bi-pencil-fill"></i> Edit Supplier
                    </a>
                    <a asp-controller="Supplier" asp-action="Index"
                       class="btn-sb ghost">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                </div>

            </div>

            <!-- ── Right cards ── -->
            <div class="sp-right">

                <!-- Company info grid -->
                <div class="sp-det-card">
                    <div class="sp-det-head">
                        <span class="sp-det-bar"></span>
                        <span class="sp-det-title">Company Information</span>
                    </div>
                    <div class="sp-ig">
                        <div class="sp-ig-cell">
                            <div class="sp-ig-lbl">Status</div>
                            <div class="sp-ig-val @(Model.Status == SupplierStatus.Active ? "success" : Model.Status == SupplierStatus.Banned ? "danger" : Model.Status == SupplierStatus.OnHold ? "warning" : "muted")">
                                <i class="bi @(Model.Status == SupplierStatus.Active ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                                @Model.Status
                            </div>
                        </div>
                        <div class="sp-ig-cell">
                            <div class="sp-ig-lbl">Supplier ID</div>
                            <div class="sp-ig-val">
                                <i class="bi bi-fingerprint"></i> SUP-@Model.SupplierId
                            </div>
                        </div>
                        <div class="sp-ig-cell">
                            <div class="sp-ig-lbl">Registered On</div>
                            <div class="sp-ig-val">
                                <i class="bi bi-calendar-check"></i>
                                @Model.CreatedAt.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture)
                            </div>
                        </div>
                        <div class="sp-ig-cell">
                            <div class="sp-ig-lbl">Last Updated</div>
                            <div class="sp-ig-val @(Model.UpdatedAt == DateTime.MinValue ? "muted" : "")">
                                <i class="bi bi-clock-history"></i>
                                @(Model.UpdatedAt == DateTime.MinValue
                                    ? "Never updated"
                                    : Model.UpdatedAt.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture))
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Address))
                        {
                            <div class="sp-ig-cell full">
                                <div class="sp-ig-lbl">Street Address</div>
                                <div class="sp-ig-val">
                                    <i class="bi bi-geo-alt-fill"></i> @Model.Address
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <div class="sp-ig-cell full">
                                <div class="sp-ig-lbl">Notes</div>
                                <div class="sp-ig-val" style="font-size:12px;font-weight:500;color:var(--text-sub);flex-direction:column;align-items:flex-start;gap:0;">
                                    @Model.Notes
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Activity timeline -->
                <div class="sp-det-card">
                    <div class="sp-det-head">
                        <span class="sp-det-bar"></span>
                        <span class="sp-det-title">Supplier Activity</span>
                    </div>
                    <div class="sp-tl">
                        <div class="sp-tl-item">
                            <div class="sp-tl-left"><div class="sp-tl-dot brand"></div><div class="sp-tl-line"></div></div>
                            <div class="sp-tl-body">
                                <div class="sp-tl-title">Supplier registered</div>
                                <div class="sp-tl-desc">@Model.CompanyName was successfully added to the system</div>
                                <div class="sp-tl-time"><i class="bi bi-clock"></i> @Model.CreatedAt.ToString("MMM dd, yyyy · hh:mm tt", CultureInfo.InvariantCulture)</div>
                            </div>
                        </div>

                        @if (Model.UpdatedAt != DateTime.MinValue)
                        {
                            <div class="sp-tl-item">
                                <div class="sp-tl-left"><div class="sp-tl-dot success"></div><div class="sp-tl-line"></div></div>
                                <div class="sp-tl-body">
                                    <div class="sp-tl-title">Profile updated</div>
                                    <div class="sp-tl-desc">Supplier information was modified</div>
                                    <div class="sp-tl-time"><i class="bi bi-clock"></i> @Model.UpdatedAt.ToString("MMM dd, yyyy · hh:mm tt", CultureInfo.InvariantCulture)</div>
                                </div>
                            </div>
                        }

                        <div class="sp-tl-item">
                            <div class="sp-tl-left"><div class="sp-tl-dot @(Model.Status == SupplierStatus.Active ? "success" : "neutral")"></div><div class="sp-tl-line"></div></div>
                            <div class="sp-tl-body">
                                <div class="sp-tl-title">Current status: @Model.Status</div>
                                <div class="sp-tl-desc">Supply chain visibility and contract eligibility</div>
                                <div class="sp-tl-time"><i class="bi bi-truck"></i> Verified supplier</div>
                            </div>
                        </div>
                    </div>
                </div>

            </div><!-- /.sp-right -->

        </div><!-- /.sp-layout -->

    </div><!-- /.sp-wrap -->
</div><!-- /.sp-page -->

<!-- Toast -->
<div class="sp-toast-wrap">
    <div class="sp-toast" id="spToast">
        <i class="bi bi-check-circle-fill"></i> Copied to clipboard!
    </div>
</div>

<script>
function copyText(text) {
    navigator.clipboard.writeText(text).then(() => {
        const t = document.getElementById('spToast');
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2000);
    }).catch(() => alert('Copy failed'));
}
</script>
