@model IEnumerable<Sandoohouse.Models.Shift>
@{
    ViewData["Title"] = "Shift Report";

    var shifts       = Model.ToList();
    var totalShifts  = (int)(ViewBag.TotalShifts      ?? 0);
    var totalSales   = (decimal)(ViewBag.TotalSales    ?? 0m);
    var totalOrders  = (int)(ViewBag.TotalOrders       ?? 0);
    var totalOpening = (decimal)(ViewBag.TotalOpeningCash ?? 0m);
    var avgSales     = (decimal)(ViewBag.AvgSalesPerShift ?? 0m);

    string fromDate  = ViewBag.FromDate ?? "";
    string toDate    = ViewBag.ToDate   ?? "";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=Noto+Sans+Khmer:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<!-- jsPDF + AutoTable for PDF export -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

<style>
:root {
    --brand:        #FF6B35;
    --brand-dark:   #E85520;
    --brand-light:  #FFF0EA;
    --brand-mid:    rgba(255,107,53,.12);
    --accent:       #1C2340;
    --success:      #00B894;
    --success-bg:   rgba(0,184,148,.1);
    --warning:      #F0A500;
    --warning-bg:   rgba(240,165,0,.1);
    --danger:       #E84545;
    --danger-bg:    rgba(232,69,69,.1);
    --bg:           #F2EFE9;
    --surface:      #FFFFFF;
    --surface2:     #FAF8F5;
    --border:       #EAE5DC;
    --border-s:     #D8D2C8;
    --text:         #18150F;
    --text-sub:     #6E685F;
    --text-light:   #AEA89F;
    --shadow-sm:    0 2px 8px rgba(24,21,15,.07);
    --shadow-md:    0 6px 24px rgba(24,21,15,.10);
    --shadow-brand: 0 6px 20px rgba(255,107,53,.32);
    --shadow-danger:0 6px 20px rgba(232,69,69,.28);
    --r-xs:6px; --r-sm:10px; --r-md:16px; --r-lg:24px; --r-xl:32px;
    --font:'Sora','Noto Sans Khmer',sans-serif;
}
*,*::before,*::after { box-sizing:border-box; }

.sr-page {
    font-family: var(--font);
    background: var(--bg);
    background-image: radial-gradient(circle,#D8D2C8 1px,transparent 1px);
    background-size: 28px 28px;
    min-height: 100vh;
    padding: 28px 24px;
    color: var(--text);
}

/* ── Topbar ── */
.sr-topbar {
    display:flex; align-items:center; justify-content:space-between;
    margin-bottom:26px; flex-wrap:wrap; gap:12px;
    max-width:1100px; margin-left:auto; margin-right:auto;
}
.sr-topbar h1 { font-size:20px; font-weight:700; color:var(--text); margin:0 0 5px; letter-spacing:-.4px; }
.sr-breadcrumb { display:flex; align-items:center; gap:6px; font-size:12px; font-weight:500; margin:0; padding:0; list-style:none; }
.sr-breadcrumb a { color:var(--text-light); text-decoration:none; transition:color .14s; }
.sr-breadcrumb a:hover { color:var(--brand); }
.sr-breadcrumb .sep { color:var(--border-s); }
.sr-breadcrumb .cur { color:var(--text-sub); font-weight:600; }
.sr-topbar-actions { display:flex; align-items:center; gap:8px; }
.btn-topbar {
    display:inline-flex; align-items:center; gap:6px;
    height:36px; padding:0 16px; border-radius:var(--r-xl);
    font-family:var(--font); font-size:12px; font-weight:600;
    cursor:pointer; text-decoration:none; transition:all .16s;
    border:1.5px solid var(--border); background:var(--surface); color:var(--text-sub);
}
.btn-topbar:hover { border-color:var(--brand); color:var(--brand); background:var(--brand-light); text-decoration:none; }
.btn-topbar-brand { background:var(--brand); color:#fff; border-color:var(--brand); box-shadow:var(--shadow-brand); }
.btn-topbar-brand:hover { background:var(--brand-dark); color:#fff; border-color:var(--brand-dark); }
.btn-topbar-pdf { background:var(--accent); color:#fff; border-color:var(--accent); box-shadow:0 6px 20px rgba(28,35,64,.28); }
.btn-topbar-pdf:hover { background:#141929; color:#fff; border-color:#141929; }

/* ── Wrap ── */
.sr-wrap { max-width:1100px; margin:0 auto; display:flex; flex-direction:column; gap:20px; }

/* ── Hero ── */
.sr-hero {
    background:var(--accent);
    border-radius:var(--r-lg) var(--r-lg) 0 0;
    padding:28px 36px; display:flex; align-items:center; gap:18px;
    position:relative; overflow:hidden;
}
.sr-hero::before {
    content:''; position:absolute; inset:0;
    background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='30' cy='30' r='1' fill='rgba(255,255,255,0.04)'/%3E%3C/svg%3E");
    pointer-events:none;
}
.sr-hero::after {
    content:''; position:absolute; width:280px; height:280px; border-radius:50%;
    background:rgba(255,107,53,.08); top:-110px; right:-70px; pointer-events:none;
}
.sr-hero-circle {
    position:absolute; width:200px; height:200px; border-radius:50%;
    background:rgba(255,255,255,.03); bottom:-80px; left:220px; pointer-events:none;
}
.sr-hero-badge {
    width:56px; height:56px; border-radius:15px; background:var(--brand);
    display:flex; align-items:center; justify-content:center;
    font-size:24px; color:#fff; flex-shrink:0; z-index:1; box-shadow:var(--shadow-brand);
}
.sr-hero-text { z-index:1; flex:1; }
.sr-hero-text h2 { font-size:20px; font-weight:800; color:#fff; margin:0 0 5px; letter-spacing:-.3px; }
.sr-hero-text p  { font-size:12px; color:rgba(255,255,255,.5); margin:0; font-weight:500; }
.sr-hero-pill {
    display:inline-flex; align-items:center; gap:6px;
    padding:5px 14px; border-radius:20px; z-index:1; flex-shrink:0;
    background:var(--brand-mid); color:var(--brand);
    border:1px solid rgba(255,107,53,.25); font-size:11px; font-weight:700;
}

/* ── Content surface ── */
.sr-content {
    background:var(--surface);
    border:1.5px solid var(--border); border-top:none;
    border-radius:0 0 var(--r-lg) var(--r-lg);
    box-shadow:var(--shadow-md); overflow:hidden;
}

/* ── Filter bar ── */
.sr-filter-bar {
    padding:16px 28px; background:var(--surface2);
    border-bottom:1.5px solid var(--border);
    display:flex; align-items:center; gap:10px; flex-wrap:wrap;
}
.sr-filter-group { display:flex; align-items:center; gap:8px; flex-wrap:wrap; flex:1; }
.sr-filter-field { position:relative; display:flex; align-items:center; }
.sr-filter-icon  { position:absolute; left:12px; color:var(--text-light); font-size:12px; pointer-events:none; z-index:1; }
.sr-date-inp {
    height:38px; padding:0 14px 0 34px;
    border:1.5px solid var(--border); border-radius:var(--r-xl);
    background:var(--surface); font-family:var(--font);
    font-size:13px; color:var(--text); outline:none;
    transition:border-color .15s,box-shadow .15s; min-width:160px;
}
.sr-date-inp:focus { border-color:var(--brand); box-shadow:0 0 0 3px var(--brand-mid); }
.sr-filter-sep { font-size:11px; color:var(--text-light); font-weight:500; }
.btn-filter {
    height:38px; padding:0 20px; background:var(--brand); color:#fff; border:none;
    border-radius:var(--r-xl); font-family:var(--font); font-size:13px; font-weight:700;
    cursor:pointer; display:flex; align-items:center; gap:7px;
    box-shadow:var(--shadow-brand); transition:all .18s; white-space:nowrap;
}
.btn-filter:hover { background:var(--brand-dark); transform:translateY(-1px); }
.btn-reset-filter {
    height:38px; padding:0 16px; background:var(--surface); color:var(--text-sub);
    border:1.5px solid var(--border); border-radius:var(--r-xl);
    font-family:var(--font); font-size:12px; font-weight:600;
    cursor:pointer; display:flex; align-items:center; gap:6px;
    transition:all .18s; text-decoration:none;
}
.btn-reset-filter:hover { border-color:var(--danger); color:var(--danger); background:var(--danger-bg); text-decoration:none; }

/* ── KPI strip ── */
.sr-kpi-strip {
    display:grid; grid-template-columns:repeat(5,1fr);
    border-bottom:1.5px solid var(--border);
}
.sr-kpi-cell {
    padding:20px 22px; border-right:1px solid var(--border);
    display:flex; align-items:center; gap:13px;
    position:relative; overflow:hidden; transition:background .2s;
}
.sr-kpi-cell:last-child { border-right:none; }
.sr-kpi-cell::after {
    content:''; position:absolute; bottom:0; left:0; right:0;
    height:3px; background:var(--kc,var(--brand));
    transform:scaleX(0); transform-origin:left; transition:transform .3s;
}
.sr-kpi-cell:hover { background:var(--brand-light); }
.sr-kpi-cell:hover::after { transform:scaleX(1); }
.sr-kpi-icon {
    width:42px; height:42px; border-radius:var(--r-sm);
    background:var(--ki,var(--brand-light)); color:var(--kc,var(--brand));
    display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0;
}
.sr-kpi-info { display:flex; flex-direction:column; gap:2px; }
.sr-kpi-label { font-size:9.5px; font-weight:700; color:var(--text-light); text-transform:uppercase; letter-spacing:.07em; }
.sr-kpi-val   { font-size:20px; font-weight:800; color:var(--text); letter-spacing:-.4px; line-height:1.1; }
.sr-kpi-sub   { font-size:10px; font-weight:600; color:var(--text-light); }
.kpi-green { --kc:var(--success); --ki:var(--success-bg); }
.kpi-brand { --kc:var(--brand);   --ki:var(--brand-light); }
.kpi-warn  { --kc:var(--warning); --ki:var(--warning-bg); }

/* ── Table head ── */
.sr-table-head {
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 28px; border-bottom:1.5px solid var(--border); flex-wrap:wrap; gap:10px;
}
.sr-table-title { display:flex; align-items:center; gap:10px; }
.title-bar { width:4px; height:20px; background:var(--brand); border-radius:4px; flex-shrink:0; }
.sr-table-title h4    { font-size:15px; font-weight:700; color:var(--text); margin:0; }
.sr-table-title small { font-size:12px; color:var(--text-light); }
.count-pill { font-size:11px; font-weight:700; color:var(--brand); background:var(--brand-light); padding:3px 10px; border-radius:20px; }

/* ── Table ── */
.sr-table { width:100%; border-collapse:collapse; }
.sr-table thead th {
    padding:10px 14px; font-size:10px; font-weight:700;
    text-transform:uppercase; letter-spacing:.07em;
    color:var(--text-light); background:var(--surface2);
    border-bottom:1.5px solid var(--border); white-space:nowrap;
}
.sr-table thead th:first-child { padding-left:28px; }
.sr-table thead th:last-child  { padding-right:28px; text-align:right; }
.sr-table tbody tr { transition:background .13s; }
.sr-table tbody tr:hover { background:var(--brand-light); }
.sr-table tbody td {
    padding:14px; border-bottom:1px solid var(--border);
    font-size:13px; color:var(--text); vertical-align:middle;
}
.sr-table tbody tr:last-child td { border-bottom:none; }
.sr-table tbody td:first-child { padding-left:28px; }
.sr-table tbody td:last-child  { padding-right:28px; text-align:right; }

/* ── Cells ── */
.shift-num    { font-size:13px; font-weight:700; color:var(--text); }
.shift-sub    { font-size:11px; color:var(--text-light); margin-top:2px; }
.cashier-wrap { display:flex; align-items:center; gap:9px; }
.cashier-av   {
    width:30px; height:30px; border-radius:50%; flex-shrink:0;
    background:var(--brand-light); color:var(--brand);
    display:flex; align-items:center; justify-content:center;
    font-size:11px; font-weight:800; border:1.5px solid rgba(255,107,53,.2);
}
.cashier-nm   { font-size:13px; font-weight:600; color:var(--text); }
.s-badge {
    display:inline-flex; align-items:center; gap:5px;
    padding:4px 12px; border-radius:20px; font-size:11px; font-weight:700; white-space:nowrap;
}
.s-closed { background:var(--success-bg); color:var(--success); border:1px solid rgba(0,184,148,.2); }
.s-open   { background:var(--brand-light); color:var(--brand);   border:1px solid rgba(255,107,53,.2); }
.date-main { font-size:13px; font-weight:600; color:var(--text); }
.date-time { font-size:11px; color:var(--text-light); margin-top:2px; display:flex; align-items:center; gap:4px; }
.dur-val   { font-size:13px; font-weight:600; color:var(--text-sub); display:flex; align-items:center; gap:5px; }
.dur-val i { color:var(--brand); }
.orders-val   { font-size:15px; font-weight:800; color:var(--brand); }
.amount-main  { font-size:13px; font-weight:800; color:var(--text); }
.amount-main.brand   { color:var(--brand); }
.amount-main.success { color:var(--success); }
.amount-khr   { font-size:11px; color:var(--text-light); margin-top:2px; }

/* ── Action buttons ── */
.btn-actions { display:flex; align-items:center; gap:6px; justify-content:flex-end; }
.btn-view {
    display:inline-flex; align-items:center; gap:5px;
    padding:5px 13px; border-radius:var(--r-xl);
    background:var(--surface2); border:1.5px solid var(--border);
    color:var(--text-sub); font-size:11px; font-weight:600;
    font-family:var(--font); text-decoration:none; transition:all .15s; white-space:nowrap;
}
.btn-view:hover { border-color:var(--brand); color:var(--brand); background:var(--brand-light); text-decoration:none; }
.btn-delete {
    display:inline-flex; align-items:center; gap:5px;
    padding:5px 13px; border-radius:var(--r-xl);
    background:var(--surface2); border:1.5px solid var(--border);
    color:var(--text-sub); font-size:11px; font-weight:600;
    font-family:var(--font); cursor:pointer; transition:all .15s; white-space:nowrap;
}
.btn-delete:hover { border-color:var(--danger); color:var(--danger); background:var(--danger-bg); }

/* ── Empty ── */
.sr-empty {
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding:56px 24px; gap:12px;
}
.sr-empty-icon {
    width:60px; height:60px; border-radius:var(--r-md);
    background:var(--surface2); color:var(--text-light);
    display:flex; align-items:center; justify-content:center; font-size:26px;
}
.sr-empty strong { font-size:15px; color:var(--text-sub); }
.sr-empty p { font-size:13px; color:var(--text-light); text-align:center; margin:0; max-width:280px; }

/* ── Footer ── */
.sr-footer {
    padding:14px 28px; border-top:1.5px solid var(--border); background:var(--surface2);
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;
}
.sr-footer-stats { display:flex; align-items:center; gap:20px; font-size:12px; color:var(--text-sub); }
.sr-footer-stat  { display:flex; align-items:center; gap:6px; font-weight:600; }
.sr-footer-stat i { color:var(--brand); font-size:13px; }
.sr-footer-total { font-size:14px; font-weight:800; color:var(--text); display:flex; align-items:center; gap:8px; }
.sr-footer-total span { color:var(--success); font-size:16px; }

/* ── Delete Modal ── */
.del-backdrop {
    display:none; position:fixed; inset:0; z-index:1000;
    background:rgba(24,21,15,.45); backdrop-filter:blur(4px);
    align-items:center; justify-content:center;
}
.del-backdrop.active { display:flex; }
.del-modal {
    background:var(--surface); border-radius:var(--r-lg);
    box-shadow:var(--shadow-md); width:100%; max-width:420px;
    margin:16px; overflow:hidden; animation:modalIn .2s ease;
}
@@keyframes modalIn {
    from { opacity:0; transform:scale(.95) translateY(8px); }
    to   { opacity:1; transform:scale(1) translateY(0); }
}
.del-modal-top {
    padding:28px 28px 20px; display:flex; flex-direction:column; align-items:center; gap:14px; text-align:center;
}
.del-modal-icon {
    width:56px; height:56px; border-radius:var(--r-md);
    background:var(--danger-bg); color:var(--danger);
    display:flex; align-items:center; justify-content:center; font-size:24px;
}
.del-modal-top h3 { font-size:17px; font-weight:800; color:var(--text); margin:0; }
.del-modal-top p  { font-size:13px; color:var(--text-sub); margin:0; line-height:1.55; }
.del-modal-info {
    margin:0 28px 20px; padding:12px 16px; border-radius:var(--r-sm);
    background:var(--surface2); border:1.5px solid var(--border);
    display:flex; align-items:center; gap:10px;
}
.del-modal-info-av {
    width:34px; height:34px; border-radius:50%; flex-shrink:0;
    background:var(--brand-light); color:var(--brand);
    display:flex; align-items:center; justify-content:center;
    font-size:12px; font-weight:800; border:1.5px solid rgba(255,107,53,.2);
}
.del-modal-info-text { display:flex; flex-direction:column; gap:2px; }
.del-modal-info-name { font-size:13px; font-weight:700; color:var(--text); }
.del-modal-info-meta { font-size:11px; color:var(--text-light); }
.del-modal-actions {
    padding:16px 28px; border-top:1.5px solid var(--border);
    background:var(--surface2); display:flex; gap:10px;
}
.btn-modal-cancel {
    flex:1; height:42px; border-radius:var(--r-xl);
    background:var(--surface); border:1.5px solid var(--border);
    color:var(--text-sub); font-family:var(--font); font-size:13px; font-weight:600;
    cursor:pointer; transition:all .15s;
}
.btn-modal-cancel:hover { border-color:var(--border-s); color:var(--text); }
.btn-modal-confirm {
    flex:1; height:42px; border-radius:var(--r-xl);
    background:var(--danger); border:none; color:#fff;
    font-family:var(--font); font-size:13px; font-weight:700;
    cursor:pointer; box-shadow:var(--shadow-danger); transition:all .15s;
    display:flex; align-items:center; justify-content:center; gap:7px;
}
.btn-modal-confirm:hover { background:#d03030; transform:translateY(-1px); }

/* ── PDF Progress Overlay ── */
.pdf-overlay {
    display:none; position:fixed; inset:0; z-index:2000;
    background:rgba(24,21,15,.55); backdrop-filter:blur(6px);
    align-items:center; justify-content:center;
}
.pdf-overlay.active { display:flex; }
.pdf-spinner-box {
    background:var(--surface); border-radius:var(--r-lg); padding:32px 40px;
    display:flex; flex-direction:column; align-items:center; gap:16px;
    box-shadow:var(--shadow-md); min-width:220px; text-align:center;
}
.pdf-spinner {
    width:44px; height:44px; border:3px solid var(--border);
    border-top-color:var(--brand); border-radius:50%;
    animation:spin .7s linear infinite;
}
@@keyframes spin { to { transform:rotate(360deg); } }
.pdf-spinner-box p { font-size:13px; font-weight:600; color:var(--text-sub); margin:0; }

/* ── Responsive ── */
@@media (max-width:1000px) {
    .sr-kpi-strip { grid-template-columns:repeat(3,1fr); }
    .sr-kpi-cell  { border-bottom:1px solid var(--border); }
}
@@media (max-width:680px) {
    .sr-page { padding:16px 14px; }
    .sr-filter-bar { flex-direction:column; }
    .sr-date-inp { width:100%; }
    .sr-hero { padding:22px 20px; gap:14px; }
    .sr-kpi-strip { grid-template-columns:1fr 1fr; }
}
@@media print {
    .sr-topbar-actions, .sr-filter-bar { display:none !important; }
}
</style>

<div class="sr-page">

    <!-- Topbar -->
    <div class="sr-topbar">
        <div>
            <h1>Shift Report</h1>
            <nav class="sr-breadcrumb">
                <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door-fill"></i></a>
                <span class="sep">›</span>
                <a asp-controller="Sale" asp-action="Index">Sale Report</a>
                <span class="sep">›</span>
                <span class="cur">Shift Report</span>
            </nav>
        </div>
        <div class="sr-topbar-actions">
            <a asp-controller="Sale" asp-action="Index" class="btn-topbar">
                <i class="bi bi-bar-chart-line"></i> Sale Report
            </a>
            <button type="button" class="btn-topbar btn-topbar-pdf" onclick="downloadShiftPDF()">
                <i class="bi bi-file-earmark-pdf-fill"></i> Download PDF
            </button>
        </div>
    </div>

    <div class="sr-wrap">

        <!-- Hero -->
        <div class="sr-hero">
            <div class="sr-hero-circle"></div>
            <div class="sr-hero-badge"><i class="bi bi-clock-history"></i></div>
            <div class="sr-hero-text">
                <h2>Shift Overview</h2>
                <p>Filter and analyse cashier shifts, revenue and drawer totals</p>
            </div>
            <span class="sr-hero-pill">
                <i class="bi bi-calendar3" style="font-size:11px;"></i>
                @DateTime.Now.ToString("MMM yyyy")
            </span>
        </div>

        <!-- Content surface -->
        <div class="sr-content">

            <!-- Filter -->
            <form method="get" asp-action="ShiftTable">
                <div class="sr-filter-bar">
                    <div class="sr-filter-group">
                        <div class="sr-filter-field">
                            <i class="bi bi-calendar-event sr-filter-icon"></i>
                            <input type="date" name="fromDate" class="sr-date-inp" value="@fromDate">
                        </div>
                        <span class="sr-filter-sep">→</span>
                        <div class="sr-filter-field">
                            <i class="bi bi-calendar-check sr-filter-icon"></i>
                            <input type="date" name="toDate" class="sr-date-inp" value="@toDate">
                        </div>
                    </div>
                    <button type="submit" class="btn-filter">
                        <i class="bi bi-funnel-fill"></i> Apply Filter
                    </button>
                    @if (!string.IsNullOrEmpty(fromDate) || !string.IsNullOrEmpty(toDate))
                    {
                        <a asp-action="ShiftTable" class="btn-reset-filter">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset
                        </a>
                    }
                </div>
            </form>

            <!-- KPI Strip -->
            <div class="sr-kpi-strip">
                <div class="sr-kpi-cell kpi-brand">
                    <div class="sr-kpi-icon"><i class="bi bi-clock-history"></i></div>
                    <div class="sr-kpi-info">
                        <span class="sr-kpi-label">Total Shifts</span>
                        <span class="sr-kpi-val">@totalShifts</span>
                        <span class="sr-kpi-sub">All periods</span>
                    </div>
                </div>
                <div class="sr-kpi-cell kpi-green">
                    <div class="sr-kpi-icon"><i class="bi bi-currency-dollar"></i></div>
                    <div class="sr-kpi-info">
                        <span class="sr-kpi-label">Total Revenue</span>
                        <span class="sr-kpi-val">$@totalSales.ToString("N2")</span>
                        <span class="sr-kpi-sub">@(Math.Round(totalSales * 4100).ToString("N0")) ៛</span>
                    </div>
                </div>
                <div class="sr-kpi-cell kpi-brand">
                    <div class="sr-kpi-icon"><i class="bi bi-bag-check"></i></div>
                    <div class="sr-kpi-info">
                        <span class="sr-kpi-label">Total Orders</span>
                        <span class="sr-kpi-val">@totalOrders</span>
                        <span class="sr-kpi-sub">Across all shifts</span>
                    </div>
                </div>
                <div class="sr-kpi-cell kpi-warn">
                    <div class="sr-kpi-icon"><i class="bi bi-cash-stack"></i></div>
                    <div class="sr-kpi-info">
                        <span class="sr-kpi-label">Opening Cash</span>
                        <span class="sr-kpi-val">$@totalOpening.ToString("N2")</span>
                        <span class="sr-kpi-sub">@(Math.Round(totalOpening * 4100).ToString("N0")) ៛</span>
                    </div>
                </div>
                <div class="sr-kpi-cell kpi-green">
                    <div class="sr-kpi-icon"><i class="bi bi-graph-up-arrow"></i></div>
                    <div class="sr-kpi-info">
                        <span class="sr-kpi-label">Avg / Shift</span>
                        <span class="sr-kpi-val">$@avgSales.ToString("N2")</span>
                        <span class="sr-kpi-sub">Revenue per shift</span>
                    </div>
                </div>
            </div>

            <!-- Table header -->
            <div class="sr-table-head">
                <div class="sr-table-title">
                    <span class="title-bar"></span>
                    <div>
                        <h4>Shift Transactions</h4>
                        <small>Sorted by latest date</small>
                    </div>
                </div>
                <span class="count-pill">@totalShifts shift@(totalShifts == 1 ? "" : "s")</span>
            </div>

            <!-- Table -->
            <div class="table-responsive">
                <table class="sr-table" id="shiftDataTable">
                    <thead>
                        <tr>
                            <th>Shift</th>
                            <th>Cashier</th>
                            <th>Status</th>
                            <th>Date &amp; Time</th>
                            <th>Duration</th>
                            <th>Orders</th>
                            <th>Opening Cash</th>
                            <th>Revenue</th>
                            <th>Est. Drawer</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (shifts.Any())
                    {
                        @foreach (var s in shifts)
                        {
                            var dur     = s.EndTime.HasValue ? s.EndTime.Value - s.StartTime : DateTime.UtcNow - s.StartTime;
                            var durHrs  = (int)dur.TotalHours;
                            var durMins = dur.Minutes;
                            var durStr  = durHrs > 0 ? $"{durHrs}h {durMins}m" : $"{durMins}m";

                            var cashier  = s.CashierName ?? s.ClosedBy ?? "—";
                            var initials = cashier.Length >= 2
                                ? string.Concat(cashier.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                    .Take(2).Select(w => w[0].ToString().ToUpper()))
                                : cashier.Substring(0, Math.Min(2, cashier.Length)).ToUpper();

                            decimal drawer = s.OpeningCash + s.TotalSales;

                            <tr>
                                <td>
                                    <div class="shift-num">#@s.Id</div>
                                    <div class="shift-sub">@s.StartTime.ToLocalTime().ToString("MMM dd")</div>
                                </td>
                                <td>
                                    <div class="cashier-wrap">
                                        <div class="cashier-av">@initials</div>
                                        <span class="cashier-nm">@cashier</span>
                                    </div>
                                </td>
                                <td>
                                    @if (s.IsClosed)
                                    {
                                        <span class="s-badge s-closed">
                                            <i class="bi bi-circle-fill" style="font-size:7px;"></i> Closed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="s-badge s-open">
                                            <i class="bi bi-circle-fill" style="font-size:7px;"></i> Open
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="date-main">@s.StartTime.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                    <div class="date-time">
                                        <i class="bi bi-clock" style="font-size:10px;"></i>
                                        @s.StartTime.ToLocalTime().ToString("hh:mm tt")
                                    </div>
                                </td>
                                <td>
                                    <span class="dur-val">
                                        <i class="bi bi-hourglass-split"></i> @durStr
                                    </span>
                                </td>
                                <td>
                                    <span class="orders-val">@s.TotalOrders</span>
                                </td>
                                <td>
                                    <div class="amount-main">$@s.OpeningCash.ToString("N2")</div>
                                    <div class="amount-khr">@(Math.Round(s.OpeningCash * 4100).ToString("N0")) ៛</div>
                                </td>
                                <td>
                                    <div class="amount-main brand">$@s.TotalSales.ToString("N2")</div>
                                    <div class="amount-khr">@(Math.Round(s.TotalSales * 4100).ToString("N0")) ៛</div>
                                </td>
                                <td>
                                    <div class="amount-main success">$@drawer.ToString("N2")</div>
                                    <div class="amount-khr">@(Math.Round(drawer * 4100).ToString("N0")) ៛</div>
                                </td>
                                <td>
                                    <div class="btn-actions">
                                        <a href="/Shift/ShiftSummary/@s.Id" class="btn-view">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        <button type="button" class="btn-delete"
                                                onclick="openDeleteModal(@s.Id, '@cashier', '@initials', '@s.StartTime.ToLocalTime().ToString("MMM dd, yyyy")')">
                                            <i class="bi bi-trash3"></i> Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10">
                                <div class="sr-empty">
                                    <div class="sr-empty-icon"><i class="bi bi-clock-history"></i></div>
                                    <strong>No shifts found</strong>
                                    <p>Try adjusting your date filter or check back later.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <!-- Footer -->
            @if (shifts.Any())
            {
                <div class="sr-footer">
                    <div class="sr-footer-stats">
                        <span class="sr-footer-stat">
                            <i class="bi bi-clock"></i>
                            @totalShifts shift@(totalShifts == 1 ? "" : "s")
                        </span>
                        <span class="sr-footer-stat">
                            <i class="bi bi-bag-check"></i>
                            @totalOrders order@(totalOrders == 1 ? "" : "s")
                        </span>
                        <span class="sr-footer-stat" style="color:var(--text-light);">
                            <i class="bi bi-clock"></i>
                            Updated: @DateTime.Now.ToString("MMM dd, yyyy")
                        </span>
                    </div>
                    <div class="sr-footer-total">
                        Total Revenue: <span>$@totalSales.ToString("N2")</span>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<!-- ── Delete Confirmation Modal ── -->
<div class="del-backdrop" id="deleteBackdrop">
    <div class="del-modal">
        <div class="del-modal-top">
            <div class="del-modal-icon"><i class="bi bi-trash3-fill"></i></div>
            <h3>Delete Shift?</h3>
            <p>This will permanently remove the shift and all associated data. This action cannot be undone.</p>
        </div>
        <div class="del-modal-info">
            <div class="del-modal-info-av" id="delModalInitials">—</div>
            <div class="del-modal-info-text">
                <span class="del-modal-info-name" id="delModalCashier">—</span>
                <span class="del-modal-info-meta" id="delModalMeta">—</span>
            </div>
        </div>
        <div class="del-modal-actions">
            <button type="button" class="btn-modal-cancel" onclick="closeDeleteModal()">
                Cancel
            </button>
            <form id="deleteForm" method="post" style="flex:1;display:flex;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-modal-confirm" style="width:100%;">
                    <i class="bi bi-trash3-fill"></i> Yes, Delete
                </button>
            </form>
        </div>
    </div>
</div>

<!-- ── PDF Generation Spinner ── -->
<div class="pdf-overlay" id="pdfOverlay">
    <div class="pdf-spinner-box">
        <div class="pdf-spinner"></div>
        <p>Generating PDF report…</p>
    </div>
</div>

<script>
/* ────────────────────────────────────────────────
   Delete modal
──────────────────────────────────────────────── */
function openDeleteModal(id, cashier, initials, date) {
    document.getElementById('delModalInitials').textContent = initials;
    document.getElementById('delModalCashier').textContent  = cashier;
    document.getElementById('delModalMeta').textContent     = 'Shift #' + id + ' · ' + date;
    document.getElementById('deleteForm').action            = '/Shift/Delete/' + id;
    document.getElementById('deleteBackdrop').classList.add('active');
}
function closeDeleteModal() {
    document.getElementById('deleteBackdrop').classList.remove('active');
}
document.getElementById('deleteBackdrop').addEventListener('click', function(e) {
    if (e.target === this) closeDeleteModal();
});
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeDeleteModal();
});

/* ────────────────────────────────────────────────
   PDF Export — full POS shift report
──────────────────────────────────────────────── */
function downloadShiftPDF() {
    document.getElementById('pdfOverlay').classList.add('active');

    setTimeout(function () {
        try {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a4' });

            const PAGE_W  = doc.internal.pageSize.getWidth();
            const PAGE_H  = doc.internal.pageSize.getHeight();
            const MARGIN  = 36;
            const CONTENT = PAGE_W - MARGIN * 2;

            // Brand colours
            const C_BRAND   = [255, 107,  53];
            const C_ACCENT  = [ 28,  35,  64];
            const C_SUCCESS = [  0, 184, 148];
            const C_WARN    = [240, 165,   0];
            const C_TEXT    = [ 24,  21,  15];
            const C_SUBTEXT = [110, 104,  95];
            const C_LIGHT   = [174, 168, 159];
            const C_BG      = [242, 239, 233];
            const C_WHITE   = [255, 255, 255];

            const KHR_RATE = 4100;
            function fmtUSD(v) { return '$' + parseFloat(v).toLocaleString('en-US', {minimumFractionDigits:2,maximumFractionDigits:2}); }
            function fmtKHR(v) { return Math.round(v * KHR_RATE).toLocaleString() + ' \u17DB'; }

            // Razor-injected values
            const kpiTotalShifts  = @totalShifts;
            const kpiTotalRevenue = @totalSales.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
            const kpiTotalOrders  = @totalOrders;
            const kpiOpening      = @totalOpening.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
            const kpiAvgSales     = @avgSales.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

            const now       = new Date();
            const printTs   = now.toLocaleString('en-US', {month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'});
            const fromDate  = '@fromDate';
            const toDate    = '@toDate';
            const dateRange = (fromDate || toDate) ? ((fromDate||'–') + '  \u2192  ' + (toDate||'–')) : 'All dates';
            const fileName  = 'ShiftReport' + (fromDate ? '_'+fromDate.replace(/-/g,'') : '') + (toDate ? '_'+toDate.replace(/-/g,'') : '') + '.pdf';

            // ═══════════════════════
            //  HEADER BANNER
            // ═══════════════════════
            doc.setFillColor(...C_ACCENT);
            doc.roundedRect(MARGIN, 22, CONTENT, 68, 8, 8, 'F');

            // Left orange stripe
            doc.setFillColor(...C_BRAND);
            doc.roundedRect(MARGIN, 22, 5, 68, 3, 3, 'F');

            // Icon box
            doc.setFillColor(...C_BRAND);
            doc.roundedRect(MARGIN+14, 31, 40, 40, 7, 7, 'F');
            // Draw a simple clock icon using lines
            doc.setDrawColor(...C_WHITE); doc.setLineWidth(2);
            doc.circle(MARGIN+34, 51, 11, 'S');
            doc.line(MARGIN+34, 51, MARGIN+34, 44); // hour hand
            doc.line(MARGIN+34, 51, MARGIN+40, 51); // minute hand

            // Title
            doc.setFontSize(17); doc.setFont('helvetica','bold'); doc.setTextColor(...C_WHITE);
            doc.text('SHIFT REPORT', MARGIN+64, 45);
            doc.setFontSize(8.5); doc.setFont('helvetica','normal'); doc.setTextColor(170,175,190);
            doc.text('Sandoo House POS  \u2022  Cashier Shift Summary', MARGIN+64, 59);

            // Date range badge
            doc.setFillColor(44, 54, 88);
            doc.roundedRect(PAGE_W - MARGIN - 160, 38, 160, 22, 5, 5, 'F');
            doc.setFontSize(8); doc.setFont('helvetica','bold'); doc.setTextColor(...C_BRAND);
            doc.text(dateRange, PAGE_W - MARGIN - 80, 51, { align: 'center' });

            // Print timestamp
            doc.setFontSize(7); doc.setFont('helvetica','normal'); doc.setTextColor(...C_LIGHT);
            doc.text('Generated: ' + printTs, PAGE_W - MARGIN, 19, { align: 'right' });

            let y = 108;

            // ═══════════════════════
            //  KPI CARDS
            // ═══════════════════════
            const KPI = [
                { label:'Total Shifts',   value:kpiTotalShifts.toString(),    sub:'all periods',              col:C_BRAND   },
                { label:'Total Revenue',  value:fmtUSD(kpiTotalRevenue),       sub:fmtKHR(kpiTotalRevenue),    col:C_SUCCESS },
                { label:'Total Orders',   value:kpiTotalOrders.toString(),     sub:'across all shifts',        col:C_BRAND   },
                { label:'Opening Cash',   value:fmtUSD(kpiOpening),            sub:fmtKHR(kpiOpening),         col:C_WARN    },
                { label:'Avg / Shift',    value:fmtUSD(kpiAvgSales),           sub:'revenue per shift',        col:C_SUCCESS },
            ];
            const kW = (CONTENT - 8*4) / 5;
            KPI.forEach(function(k, i) {
                const kx = MARGIN + i*(kW+8);
                // Card
                doc.setFillColor(...C_WHITE);
                doc.roundedRect(kx, y, kW, 56, 6, 6, 'F');
                // Accent bottom strip
                doc.setFillColor(...k.col);
                doc.roundedRect(kx+1, y+50, kW-2, 5, 2, 2, 'F');
                // Icon tinted bg
                const tint = k.col.map(function(c){ return c + Math.floor((255-c)*0.82); });
                doc.setFillColor(...tint);
                doc.roundedRect(kx+8, y+9, 24, 24, 5, 5, 'F');
                // Label
                doc.setFontSize(7); doc.setFont('helvetica','bold'); doc.setTextColor(...C_LIGHT);
                doc.text(k.label.toUpperCase(), kx+kW/2, y+13, {align:'center'});
                // Value
                doc.setFontSize(12.5); doc.setFont('helvetica','bold'); doc.setTextColor(...C_TEXT);
                doc.text(k.value, kx+kW/2, y+31, {align:'center'});
                // Sub
                doc.setFontSize(7); doc.setFont('helvetica','normal'); doc.setTextColor(...C_LIGHT);
                doc.text(k.sub, kx+kW/2, y+43, {align:'center'});
            });

            y += 70;

            // ═══════════════════════
            //  SECTION TITLE
            // ═══════════════════════
            doc.setFillColor(...C_BRAND);
            doc.rect(MARGIN, y, 4, 17, 'F');
            doc.setFontSize(11); doc.setFont('helvetica','bold'); doc.setTextColor(...C_TEXT);
            doc.text('Shift Transactions', MARGIN+12, y+12);
            doc.setFontSize(8); doc.setFont('helvetica','normal'); doc.setTextColor(...C_LIGHT);
            doc.text('Sorted by latest date', MARGIN+130, y+12);
            y += 24;

            // ═══════════════════════
            //  BUILD TABLE ROWS FROM DOM
            // ═══════════════════════
            const tableRows = [];
            document.querySelectorAll('#shiftDataTable tbody tr').forEach(function(tr) {
                const tds = tr.querySelectorAll('td');
                if (tds.length < 9) return;
                const get  = function(td, sel) { var el = td.querySelector(sel); return el ? el.textContent.trim() : ''; };
                const text = function(td)       { return td.textContent.replace(/\s+/g,' ').trim(); };

                const shiftId  = get(tds[0], '.shift-num');
                const cashier  = get(tds[1], '.cashier-nm');
                const status   = get(tds[2], '.s-badge').replace(/^\s*[\u25CF\u2022]\s*/,'');
                const dateStr  = get(tds[3], '.date-main') + '\n' + get(tds[3],'.date-time').replace(/\s+/g,' ');
                const dur      = text(tds[4]);
                const orders   = get(tds[5], '.orders-val');
                const openUSD  = get(tds[6], '.amount-main');
                const openKHR  = get(tds[6], '.amount-khr');
                const revUSD   = get(tds[7], '.amount-main');
                const revKHR   = get(tds[7], '.amount-khr');
                const drwUSD   = get(tds[8], '.amount-main');
                const drwKHR   = get(tds[8], '.amount-khr');

                tableRows.push([
                    shiftId, cashier, status, dateStr, dur, orders,
                    openUSD+'\n'+openKHR, revUSD+'\n'+revKHR, drwUSD+'\n'+drwKHR,
                ]);
            });

            // ═══════════════════════
            //  AUTOTABLE
            // ═══════════════════════
            doc.autoTable({
                startY: y,
                margin: { left: MARGIN, right: MARGIN },
                head: [['Shift','Cashier','Status','Date & Time','Duration','Orders','Opening Cash','Revenue','Est. Drawer']],
                body: tableRows,
                theme: 'plain',
                styles: {
                    font: 'helvetica', fontSize: 8,
                    cellPadding: { top:6, bottom:6, left:7, right:7 },
                    valign: 'middle', textColor: C_TEXT,
                    lineColor: [234,229,220], lineWidth: 0.5, overflow: 'linebreak',
                },
                headStyles: {
                    fillColor: [250,248,245], textColor: C_LIGHT,
                    fontStyle: 'bold', fontSize: 7.5,
                    cellPadding: { top:7, bottom:7, left:7, right:7 },
                },
                alternateRowStyles: { fillColor: [250,248,245] },
                columnStyles: {
                    0: { cellWidth:42,  fontStyle:'bold' },
                    1: { cellWidth:78 },
                    2: { cellWidth:46,  halign:'center' },
                    3: { cellWidth:78 },
                    4: { cellWidth:52,  halign:'center' },
                    5: { cellWidth:38,  halign:'center', textColor:C_BRAND, fontStyle:'bold', fontSize:10 },
                    6: { cellWidth:70,  halign:'right' },
                    7: { cellWidth:70,  halign:'right', textColor:C_BRAND },
                    8: { cellWidth:70,  halign:'right', textColor:C_SUCCESS },
                },
                didParseCell: function(d) {
                    if (d.column.index === 2 && d.section === 'body') {
                        var v = (d.cell.raw||'').toString().toLowerCase();
                        if (v.includes('closed')) {
                            d.cell.styles.textColor = C_SUCCESS;
                            d.cell.styles.fillColor = [230,250,245];
                            d.cell.styles.fontStyle = 'bold';
                        } else {
                            d.cell.styles.textColor = C_BRAND;
                            d.cell.styles.fillColor = [255,240,234];
                            d.cell.styles.fontStyle = 'bold';
                        }
                    }
                },
                willDrawPage: function(d) {
                    if (d.pageNumber > 1) {
                        doc.setFillColor(...C_ACCENT);
                        doc.rect(0, 0, PAGE_W, 22, 'F');
                        doc.setFontSize(8.5); doc.setFont('helvetica','bold'); doc.setTextColor(...C_WHITE);
                        doc.text('SHIFT REPORT  \u2013  Sandoo House POS', MARGIN, 15);
                        doc.setFontSize(8); doc.setFont('helvetica','normal'); doc.setTextColor(170,175,190);
                        doc.text(dateRange, PAGE_W-MARGIN, 15, {align:'right'});
                    }
                },
                didDrawPage: function(d) {
                    // Page footer
                    var pg = doc.internal.getCurrentPageInfo().pageNumber;
                    doc.setFillColor(...C_BG);
                    doc.rect(0, PAGE_H-22, PAGE_W, 22, 'F');
                    doc.setDrawColor(...C_LIGHT); doc.setLineWidth(0.5);
                    doc.line(MARGIN, PAGE_H-22, PAGE_W-MARGIN, PAGE_H-22);
                    doc.setFontSize(7.5); doc.setFont('helvetica','normal'); doc.setTextColor(...C_LIGHT);
                    doc.text('Sandoo House POS  \u2022  Shift Report  \u2022  ' + printTs, MARGIN, PAGE_H-8);
                    doc.text('Page ' + pg + ' of {total_pages_count_string}', PAGE_W-MARGIN, PAGE_H-8, {align:'right'});

                    // Summary bar after last table row
                    if (d.cursor && d.cursor.y + 44 < PAGE_H - 26) {
                        var fy = d.cursor.y + 10;
                        doc.setFillColor(250,248,245);
                        doc.setDrawColor(...C_BRAND); doc.setLineWidth(1);
                        doc.roundedRect(MARGIN, fy, CONTENT, 32, 5, 5, 'FD');

                        var summaryItems = [
                            { label:'SHIFTS',    value:kpiTotalShifts.toString(),  col:C_TEXT    },
                            { label:'ORDERS',    value:kpiTotalOrders.toString(),   col:C_TEXT    },
                            { label:'REVENUE',   value:fmtUSD(kpiTotalRevenue),     col:C_SUCCESS },
                            { label:'OPENING',   value:fmtUSD(kpiOpening),          col:C_TEXT    },
                            { label:'AVG/SHIFT', value:fmtUSD(kpiAvgSales),         col:C_SUCCESS },
                        ];
                        var sw = (CONTENT - 100) / summaryItems.length;
                        doc.setFontSize(7.5); doc.setFont('helvetica','bold'); doc.setTextColor(...C_SUBTEXT);
                        doc.text('SUMMARY', MARGIN + 14, fy + 13);
                        doc.setDrawColor(...C_LIGHT); doc.setLineWidth(0.5);
                        doc.line(MARGIN+72, fy+4, MARGIN+72, fy+28);

                        summaryItems.forEach(function(si, idx) {
                            var sx = MARGIN + 80 + idx * sw + sw/2;
                            doc.setFontSize(6.5); doc.setFont('helvetica','normal'); doc.setTextColor(...C_LIGHT);
                            doc.text(si.label, sx, fy+12, {align:'center'});
                            doc.setFontSize(9.5); doc.setFont('helvetica','bold'); doc.setTextColor(...si.col);
                            doc.text(si.value, sx, fy+25, {align:'center'});
                        });
                    }
                },
            });

            if (typeof doc.putTotalPages === 'function') {
                doc.putTotalPages('{total_pages_count_string}');
            }

            doc.save(fileName);

        } catch (err) {
            console.error('PDF generation failed:', err);
            alert('PDF generation failed: ' + err.message);
        } finally {
            document.getElementById('pdfOverlay').classList.remove('active');
        }
    }, 80);
}
</script>
