@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <title>Login</title>
    <link rel="icon" href="@Url.Content("~/assets/img/kaiadmin/SandooHouse.ico")" type="image/x-icon"/>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        :root {
            --brand:       #FF6B35;
            --brand-dark:  #E85520;
            --brand-light: #FFF0EA;
            --brand-mid:   rgba(255,107,53,.14);
            --accent:      #2D3561;
            --bg:          #F7F4F0;
            --surface:     #FFFFFF;
            --surface2:    #FAF8F5;
            --border:      #EDE8E0;
            --border-s:    #DDD7CE;
            --text:        #1A1714;
            --text-sub:    #7A736B;
            --text-light:  #B5AFA8;
            --danger:      #E84545;
            --danger-bg:   rgba(232,69,69,.08);
            --success:     #00B894;
            --font:        'Sora','Noto Sans Khmer',sans-serif;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: var(--font);
            min-height: 100vh;
            background: var(--bg);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            /* subtle dot grid */
            background-image: radial-gradient(circle, #DDD7CE 1px, transparent 1px);
            background-size: 28px 28px;
        }

        /* ── Outer wrapper ── */
        .login-wrap {
            width: 100%;
            max-width: 440px;
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        /* ── Brand bar on top ── */
        .login-brand {
            background: var(--accent);
            border-radius: 22px 22px 0 0;
            padding: 28px 32px 24px;
            display: flex;
            align-items: center;
            gap: 16px;
            position: relative;
            overflow: hidden;
        }
        .login-brand::before,
        .login-brand::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
            pointer-events: none;
        }
        .login-brand::before { width: 200px; height: 200px; top: -80px; right: -40px; }
        .login-brand::after  { width: 120px; height: 120px; bottom: -50px; left: 160px; }

        .brand-icon {
            width: 48px; height: 48px;
            border-radius: 14px;
            background: var(--brand);
            display: flex; align-items: center; justify-content: center;
            font-size: 22px; color: #fff;
            flex-shrink: 0; z-index: 1;
            box-shadow: 0 4px 16px rgba(255,107,53,.4);
        }
        .brand-text { z-index: 1; }
        .brand-text h2 {
            font-size: 18px; font-weight: 700; color: #fff;
            margin: 0 0 2px; letter-spacing: -.3px;
        }
        .brand-text p {
            font-size: 12px; color: rgba(255,255,255,.55);
            font-weight: 500; margin: 0;
        }

        /* ── Card ── */
        .login-card {
            background: var(--surface);
            border-radius: 0 0 22px 22px;
            border: 1.5px solid var(--border);
            border-top: none;
            padding: 32px 32px 28px;
            box-shadow: 0 16px 48px rgba(26,23,20,.13);
        }

        /* ── Greeting ── */
        .login-greeting {
            margin-bottom: 26px;
        }
        .login-greeting h3 {
            font-size: 20px; font-weight: 700; color: var(--text);
            margin: 0 0 4px; letter-spacing: -.4px;
        }
        .login-greeting p { font-size: 13px; color: var(--text-light); font-weight: 500; margin: 0; }

        /* ── Error alert ── */
        .login-alert {
            display: flex; align-items: center; gap: 10px;
            background: var(--danger-bg);
            border: 1px solid rgba(232,69,69,.2);
            border-left: 3px solid var(--danger);
            border-radius: 10px;
            padding: 11px 14px;
            margin-bottom: 20px;
            font-size: 13px; font-weight: 500; color: var(--danger);
        }
        .login-alert i { font-size: 15px; flex-shrink: 0; }

        /* ── Field ── */
        .login-field { margin-bottom: 18px; }
        .login-label {
            display: block;
            font-size: 12px; font-weight: 600;
            color: var(--text-sub);
            margin-bottom: 7px;
            letter-spacing: .01em;
        }

        .login-input-wrap {
            display: flex; align-items: center;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            background: var(--surface2);
            overflow: hidden;
            transition: border-color .15s, box-shadow .15s;
        }
        .login-input-wrap:focus-within {
            border-color: var(--brand);
            box-shadow: 0 0 0 3px var(--brand-mid);
            background: var(--surface);
        }

        .login-input-icon {
            width: 44px; height: 46px;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px; color: var(--text-light);
            flex-shrink: 0;
            border-right: 1.5px solid var(--border);
            background: var(--surface);
            transition: color .15s, border-color .15s;
        }
        .login-input-wrap:focus-within .login-input-icon {
            color: var(--brand);
            border-color: var(--brand);
        }

        .login-input {
            flex: 1; height: 46px;
            padding: 0 14px;
            border: none; background: none; outline: none;
            font-family: var(--font); font-size: 13px; color: var(--text);
        }
        .login-input::placeholder { color: var(--text-light); }

        .login-eye-btn {
            width: 44px; height: 46px;
            border: none; background: none;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px; color: var(--text-light);
            cursor: pointer; flex-shrink: 0;
            transition: color .15s;
        }
        .login-eye-btn:hover { color: var(--brand); }

        /* ── Remember + forgot ── */
        .login-row {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 24px; flex-wrap: wrap; gap: 8px;
        }
        .login-remember {
            display: flex; align-items: center; gap: 8px;
            cursor: pointer;
        }
        .login-remember input[type="checkbox"] {
            width: 16px; height: 16px;
            accent-color: var(--brand);
            cursor: pointer;
        }
        .login-remember span {
            font-size: 12px; font-weight: 500; color: var(--text-sub);
        }
        .login-forgot {
            font-size: 12px; font-weight: 600;
            color: var(--brand); text-decoration: none;
            transition: color .15s;
        }
        .login-forgot:hover { color: var(--brand-dark); }

        /* ── Submit ── */
        .btn-login {
            width: 100%; height: 48px;
            background: var(--brand); color: #fff;
            border: none; border-radius: 12px;
            font-family: var(--font); font-size: 14px; font-weight: 700;
            cursor: pointer; letter-spacing: .01em;
            display: flex; align-items: center; justify-content: center; gap: 8px;
            box-shadow: 0 5px 20px rgba(255,107,53,.35);
            transition: all .18s;
        }
        .btn-login:hover { background: var(--brand-dark); transform: translateY(-1px); box-shadow: 0 8px 28px rgba(255,107,53,.4); }
        .btn-login:active { transform: translateY(0); }

        /* ── Footer ── */
        .login-footer {
            text-align: center;
            margin-top: 22px;
            font-size: 12px; font-weight: 500;
            color: var(--text-light);
            display: flex; align-items: center; justify-content: center; gap: 6px;
        }
        .login-footer span { color: var(--brand); font-weight: 700; }

        /* ── Divider ── */
        .login-divider {
            display: flex; align-items: center; gap: 12px;
            margin: 20px 0;
        }
        .login-divider::before,
        .login-divider::after {
            content: ''; flex: 1; height: 1px; background: var(--border);
        }
        .login-divider span {
            font-size: 11px; font-weight: 600; color: var(--text-light);
            white-space: nowrap;
        }

        /* ── Responsive ── */
        @@media (max-width: 480px) {
        .login-brand { padding: 22px 22px 20px; }
        .login-card  { padding: 24px 22px 22px; }
        .login-wrap  { max-width: 100%; }
        }
    </style>
</head>
<body>

<div class="login-wrap">

    <!-- Brand header -->
    <div class="login-brand">
        <div class="brand-icon">
            <i class="bi bi-house-heart-fill"></i>
        </div>
        <div class="brand-text">
            <h2>Sandoo House</h2>
            <p>Admin Management System</p>
        </div>
    </div>

    <!-- Card -->
    <div class="login-card">

        <div class="login-greeting">
            <h3>Welcome back 👋</h3>
            <p>Sign in to continue to your dashboard</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
        <div class="login-alert" id="loginAlert">
            <i class="bi bi-exclamation-circle-fill"></i>
            @TempData["ErrorMessage"]
        </div>
        }

        <form asp-controller="Home" asp-action="Login" method="post">

            <!-- Email -->
            <div class="login-field">
                <label class="login-label">Email address</label>
                <div class="login-input-wrap">
                    <span class="login-input-icon"><i class="bi bi-envelope"></i></span>
                    <input type="email" name="Email" class="login-input"
                           placeholder="name@example.com" required autocomplete="email" />
                </div>
            </div>

            <!-- Password -->
            <div class="login-field">
                <label class="login-label">Password</label>
                <div class="login-input-wrap">
                    <span class="login-input-icon"><i class="bi bi-lock"></i></span>
                    <input type="password" name="Password" id="passwordInput"
                           class="login-input" placeholder="Enter your password"
                           required autocomplete="current-password" />
                    <button type="button" class="login-eye-btn" onclick="togglePwd()" aria-label="Toggle password">
                        <i class="bi bi-eye" id="eyeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Remember + Forgot -->
            <div class="login-row">
                <label class="login-remember">
                    <input type="checkbox" id="remember" name="remember" />
                    <span>Remember me</span>
                </label>
                <a asp-controller="Account" asp-action="ForgotPassword" class="login-forgot">
                    Forgot password?
                </a>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn-login">
                <i class="bi bi-box-arrow-in-right"></i>
                Sign In
            </button>

        </form>

        <!-- Footer -->
        <div class="login-footer">
            <i class="bi bi-c-circle"></i>
            2026 <span>Sandoo House</span> · All rights reserved
        </div>

    </div><!-- /.login-card -->
</div><!-- /.login-wrap -->

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Auto-dismiss error alert
    setTimeout(function () {
        const a = document.getElementById('loginAlert');
        if (a) { a.style.transition = 'opacity .4s'; a.style.opacity = '0'; setTimeout(() => a.remove(), 400); }
    }, 3500);

    // Toggle password visibility
    function togglePwd() {
        const inp  = document.getElementById('passwordInput');
        const icon = document.getElementById('eyeIcon');
        const show = inp.type === 'password';
        inp.type = show ? 'text' : 'password';
        icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
    }
</script>
</body>
</html>
