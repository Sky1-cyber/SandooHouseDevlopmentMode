<!-- ── SCRIPTS ── -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
<script>
    function showLogoutModal() {
        document.getElementById('logoutModal').style.display = 'flex';
    }

    $(document).ready(function () {

        /* ═══════════════════════════════════════════════
           EXCHANGE RATES & HELPERS
           - EXCHANGE_RATE        : 4100  → used by cashier for ALL KHR calculations
           - CHANGE_RATE_CUSTOMER : 4000  → used ONLY for customer display change rounding
           - floorKhr100          : floor KHR to nearest 100 (e.g. 4150 → 4100, 4050 → 4000)
        ═══════════════════════════════════════════════ */
        const EXCHANGE_RATE = 4100;   // cashier rate (unchanged)
        const CHANGE_RATE_CUSTOMER = 4000;   // customer display change rate base

        const toKhr = usd => Math.round(usd * EXCHANGE_RATE);
        const fmtKhr = n => Math.round(n).toLocaleString() + ' ៛';
        const fmtUsd = n => '$' + parseFloat(n).toFixed(2);

        /**
         * roundKhr100(khr)
         * Rounds KHR to the NEAREST 100.
         *   4040 → 4000   (49 and below → round down)
         *   4050 → 4100   (50 and above → round up)
         *   4100 → 4100   (already on boundary)
         *   5250 → 5300
         */
        const roundKhr100 = khr => Math.round(khr / 100) * 100;

        /**
         * customerChangeKhr(changeUsd, changeKhr, payCurrency)
         * Returns the KHR change to show on the customer display,
         * rounded to nearest 100.
         *  - USD payment → convert USD change × CHANGE_RATE_CUSTOMER, round to 100
         *  - KHR payment → use changeKhr directly, round to 100
         */
        function customerChangeKhr(changeUsd, changeKhr, payCurrency) {
            if (payCurrency === 'usd') {
                return roundKhr100(changeUsd * CHANGE_RATE_CUSTOMER);
            }
            return roundKhr100(changeKhr);
        }

        /* ── live clocks ── */
        function updateClocks() {
            const now = new Date();
            const h = now.getHours() % 12 || 12;
            const m = String(now.getMinutes()).padStart(2, '0');
            const s = String(now.getSeconds()).padStart(2, '0');
            const ap = now.getHours() >= 12 ? 'PM' : 'AM';
            $('#liveClock').text(`${h}:${m} ${ap}`);
            $('#cdClock').text(`${String(now.getHours()).padStart(2, '0')}:${m}:${s}`);
        }

        setInterval(updateClocks, 1000);
        updateClocks();

        /* ── products from server ── */
        const products = [
            @if (ViewBag.Menus != null)
            {
                var index = 0;
                string[] colors = { "#FF6B35", "#E85520", "#2D3561", "#00B894", "#FDCB6E", "#6C5CE7", "#0984E3", "#E17055", "#00CEC9", "#A29BFE" };
                foreach (var menu in ViewBag.Menus)
                {
                    var color = colors[index % colors.Length];
                    string categoryName = menu.Category?.CategoryName ?? "Uncategorized";
                    string brandName = menu.Category?.Brand?.BrandName ?? "Uncategorized";
                    string imageUrl = menu.ImageMenuUrl ?? "";
                    if (!string.IsNullOrEmpty(imageUrl) && !imageUrl.StartsWith("http") && !imageUrl.StartsWith("/"))
                        imageUrl = "/Menu/" + imageUrl;
                    <text>
                        ,{
                        id:@menu.Id,
                        name: '@Html.Raw(menu.MenuName.Replace("'", "\\'"))',
                        priceUsd:@((menu.Price - (menu.DiscountPrice ?? 0)).ToString("F2")),
                        category: '@Html.Raw(categoryName.Replace("'", "\\'"))',
                        categoryId:@(menu.CategoryId ?? 0),
                        brand: '@Html.Raw(brandName.Replace("'", "\\'"))',
                        brandId:@(menu.Category?.BrandId ?? 0),
                        icon: '@Html.Raw(imageUrl)',
                        color: '@color'
                    },
                    </text>
                    index++;
                }
            }
        ];

        const categoriesByBrand = {};
        const allCategories = [];
        products.forEach(p => {
            if (!categoriesByBrand[p.brand]) categoriesByBrand[p.brand] = new Set();
            categoriesByBrand[p.brand].add(p.category);
            if (!allCategories.includes(p.category)) allCategories.push(p.category);
        });

        let cart = [], currentPaymentMethod = 'cash', displayCurrency = 'usd', paymentCurrency = 'usd';
        let discountAmount = 0, discountType = 'fixed';
        let orderCounter = 4580, lastOrder = null;
        let currentBrand = 'all', currentCategory = 'all';

        function calcDiscount(sub) {
            if (!discountAmount || discountAmount <= 0) return 0;
            return discountType === 'fixed'
                ? Math.min(discountAmount, sub)
                : Math.min(sub * discountAmount / 100, sub);
        }

        /* ════════════════════════════════════════
           CUSTOMER DISPLAY SYNC
        ════════════════════════════════════════ */
        function syncCustomerDisplay() {
            const isEmpty = cart.length === 0;

            /* ── Always update the live currency pill ── */
            const pill = document.getElementById('cdPayCurrencyPill');
            if (pill) {
                pill.textContent = paymentCurrency === 'usd' ? 'USD' : 'KHR ៛';
                pill.className = 'cd-pay-currency-pill ' + paymentCurrency;
            }

            /* Toggle idle vs order */
            $('#cdIdle').toggle(isEmpty);
            $('#cdOrderArea').toggle(!isEmpty);
            $('#cdSummaryFooter').toggle(!isEmpty);

            if (isEmpty) return;

            const sub = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const disc = calcDiscount(sub);
            const total = sub - disc;

            /* Build items list */
            let html = '';
            cart.forEach(item => {
                const lineTotal = item.price * item.quantity;
                const imgHtml = item.icon
                    ? `<img src="${item.icon}" alt="${item.name}" onerror="this.onerror=null;this.style.display='none';this.parentElement.innerHTML='<i class=\\'fas fa-utensils\\'></i>';">`
                    : '<i class="fas fa-utensils"></i>';
                html += `
<div class="cd-item" style="--item-color:${item.color}">
    <div class="cd-item-thumb" style="background:linear-gradient(135deg,${item.color},#2D3561)">${imgHtml}</div>
    <div class="cd-item-info">
        <div class="cd-item-name">${item.name}</div>
        <div class="cd-item-unit">${fmtUsd(item.price)} × ${item.quantity}</div>
    </div>
    <div class="cd-item-right">
        <div class="cd-item-qty">${item.quantity}</div>
        <div class="cd-item-total">${fmtUsd(lineTotal)}</div>
    </div>
</div>`;
            });
            $('#cdItemsList').html(html);

            /* Summary — show KHR equivalent using CHANGE_RATE_CUSTOMER when paying in KHR,
               and round to nearest 100 so customer always sees a clean number */
            const cdKhrRate = paymentCurrency === 'khr' ? CHANGE_RATE_CUSTOMER : EXCHANGE_RATE;
            const toKhrCd = usd => roundKhr100(usd * cdKhrRate);

            $('#cdSubtotal').text(fmtUsd(sub));
            $('#cdSubtotalKhr').text(fmtKhr(toKhrCd(sub)));

            if (disc > 0) {
                const label = discountType === 'percentage'
                    ? `បញ្ចុះ ${discountAmount}%`
                    : 'បញ្ចុះ';
                $('#cdDiscountLabel').text(label);
                $('#cdDiscountVal').text('-' + fmtUsd(disc));
                $('#cdDiscountRow').show();
            } else {
                $('#cdDiscountRow').hide();
            }

            $('#cdTotal').text(fmtUsd(total));
            $('#cdTotalKhr').text(fmtKhr(toKhrCd(total)));
        }

        /* ════════════════════════════════════════
           CUSTOMER THANK-YOU SCREEN
           Shows after successful payment.
           Always displays:
             • Total paid (USD)
             • Change in USD  (exact, cashier rate 4100)
             • Change in KHR  (floored to nearest 100)
           The KHR change uses CHANGE_RATE_CUSTOMER (4000)
           as its base so the displayed amount is always
           a clean, conservative number the customer can
           immediately verify with their notes.
        ════════════════════════════════════════ */
        function showCustomerThankYou(order) {
            /* Total amount paid */
            $('#cdTyAmount').text(fmtUsd(order.total));

            if (order.paymentMethod === 'សាច់ប្រាក់' && order.changeUsd > 0) {

                /* ── USD change (exact, no rounding) ── */
                $('#cdTyChangeUsd').text(fmtUsd(order.changeUsd));

                /* ── KHR change (floored to nearest 100)
                   Uses customerChangeKhr() which applies CHANGE_RATE_CUSTOMER
                   when the cashier paid in USD, or floors the raw KHR
                   change when the cashier paid in KHR. ── */
                const khrChange = customerChangeKhr(
                    order.changeUsd,
                    order.changeKhr,
                    order.paymentCurrency === 'ដុល្លារ' ? 'usd' : 'khr'
                );
                $('#cdTyChangeKhr').text(fmtKhr(khrChange));

                $('#cdTyChangeBox').show();
            } else {
                $('#cdTyChangeBox').hide();
            }

            $('#cdThankyou').addClass('show');

            /* Auto-hide after 4 seconds and return to idle */
            setTimeout(function () {
                $('#cdThankyou').removeClass('show');
                syncCustomerDisplay();
            }, 4000);
        }

        /* ── category tabs ── */
        function updateCategoryTabs(brand) {
            const cats = brand === 'all' ? allCategories : Array.from(categoriesByBrand[brand] || []);
            let html = '<button class="tab-pill active" data-category="all">ទាំងអស់</button>';
            cats.forEach(c => {
                html += `<button class="tab-pill" data-category="${c}">${c}</button>`;
            });
            $('#categoryTabs').html(html);
            currentCategory = 'all';
        }

        /* ── product grid ── */
        function loadProducts() {
            if (!products.length) {
                $('#productsGrid').html('<div class="state-placeholder"><i class="fas fa-box-open"></i><p>មិនមានផលិតផល</p></div>');
                return;
            }
            const q = $('#productSearch').val().toLowerCase();
            const filtered = products.filter(p =>
                (currentBrand === 'all' || p.brand === currentBrand) &&
                (currentCategory === 'all' || p.category === currentCategory) &&
                p.name.toLowerCase().includes(q)
            );
            if (!filtered.length) {
                $('#productsGrid').html('<div class="state-placeholder"><i class="fas fa-search"></i><p>រកមិនឃើញ</p><small>ប្ដូរតម្រង</small></div>');
                return;
            }
            let html = '';
            filtered.forEach(p => {
                const imgHtml = p.icon
                    ? `<img src="${p.icon}" alt="${p.name}" onerror="this.onerror=null;this.style.display='none';this.parentElement.innerHTML='<i class=\\'fas fa-utensils\\'></i>';">`
                    : '<i class="fas fa-utensils"></i>';
                html += `
<div class="product-card"
     data-id="${p.id}" data-name="${p.name.replace(/'/g, '&apos;')}"
     data-price="${p.priceUsd}" data-brand-id="${p.brandId || 0}"
     data-icon="${p.icon || ''}" data-color="${p.color}">
    <div class="prod-img" style="background:linear-gradient(135deg,${p.color},#2D3561)">${imgHtml}</div>
    <div class="prod-price"><span style="color: #0b0b0b">${p.name}</span> (${fmtUsd(p.priceUsd)})</div>
    <div class="prod-price-khr">${fmtKhr(roundKhr100(parseFloat(p.priceUsd) * (paymentCurrency === 'khr' ? CHANGE_RATE_CUSTOMER : EXCHANGE_RATE)))}</div>
    <button class="prod-add-btn"><i class="fas fa-plus"></i></button>
</div>`;
            });
            $('#productsGrid').fadeOut(80, function () {
                $(this).html(html).fadeIn(120);
            });
        }

        updateCategoryTabs('all');
        loadProducts();

        /* filter events */
        $('#brandTabs').on('click', '.tab-pill', function () {
            $('#brandTabs .tab-pill').removeClass('brand-active');
            $(this).addClass('brand-active');
            currentBrand = $(this).data('brand') || 'all';
            updateCategoryTabs(currentBrand);
            loadProducts();
        });
        $(document).on('click', '#categoryTabs .tab-pill', function () {
            $('#categoryTabs .tab-pill').removeClass('active');
            $(this).addClass('active');
            currentCategory = $(this).data('category') || 'all';
            loadProducts();
        });
        let searchTimeout;
        $('#productSearch').on('input', function () {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(loadProducts, 280);
        });
        $('#productSearch').on('keydown', function (e) {
            if (e.key === 'Escape') {
                $(this).val('');
                loadProducts();
            }
        });

        /* ── cart ── */
        $(document).on('click', '.product-card', function (e) {
            if ($(e.target).is('button,i')) return;
            addToCart(this);
        });
        $(document).on('click', '.prod-add-btn', function (e) {
            e.stopPropagation();
            addToCart($(this).closest('.product-card')[0]);
        });

        function addToCart(el) {
            const $el = $(el);
            $el.addClass('pulse');
            setTimeout(() => $el.removeClass('pulse'), 300);
            const item = {
                id: $el.data('id'), name: $el.data('name'),
                price: parseFloat($el.data('price')),
                brandId: $el.data('brand-id') || 0,
                icon: $el.data('icon') || '',
                color: $el.data('color') || 'var(--brand)'
            };
            const existing = cart.find(i => i.id === item.id);
            if (existing) {
                existing.quantity++;
                notify(`+1 ${item.name}`, 'info');
            } else {
                cart.push({...item, quantity: 1});
                notify(`បន្ថែម ${item.name}`, 'success');
            }
            renderCart();
        }

        function renderCart() {
            let html = '';
            if (cart.length === 0) {
                html = `<div class="empty-cart"><i class="fas fa-utensils"></i><p>ថ្ងៃសួស្ដី! ជ្រើសអាហារ</p><small>ចុចលើផលិតផលដើម្បីបន្ថែម</small></div>`;
            } else {
                cart.forEach((item, idx) => {
                    const tot = item.price * item.quantity;
                    const imgHtml = item.icon
                        ? `<img src="${item.icon}" alt="${item.name}" onerror="this.onerror=null;this.style.display='none';this.parentElement.innerHTML='<i class=\\'fas fa-utensils\\'></i>';">`
                        : '<i class="fas fa-utensils"></i>';
                    html += `
<div class="cart-item" data-index="${idx}" style="--product-color:${item.color}">
    <div class="ci-thumb" style="background:linear-gradient(135deg,${item.color},#2D3561)">${imgHtml}</div>
    <div class="ci-info">
        <div class="ci-name">${item.name}</div>
        <div class="ci-price">${fmtUsd(item.price)}</div>
    </div>
    <div class="ci-qty">
        <button class="ci-qty-btn decrease-qty"><i class="fas fa-minus"></i></button>
        <span class="ci-qty-num">${item.quantity}</span>
        <button class="ci-qty-btn increase-qty"><i class="fas fa-plus"></i></button>
    </div>
    <div class="ci-total">${displayCurrency === 'usd' ? fmtUsd(tot) : fmtKhr(toKhr(tot))}</div>
    <div class="ci-remove"><i class="fas fa-trash-alt"></i></div>
</div>`;
                });
            }
            $('#cartItems').html(html);
            updateSummary();
            updateFab();
            syncCustomerDisplay(); /* ← keep customer panel in sync */
        }

        $(document).on('click', '.increase-qty', function () {
            const idx = $(this).closest('.cart-item').data('index');
            cart[idx].quantity++;
            renderCart();
        });
        $(document).on('click', '.decrease-qty', function () {
            const idx = $(this).closest('.cart-item').data('index');
            if (cart[idx].quantity > 1) {
                cart[idx].quantity--;
            } else {
                notify(`លុប ${cart[idx].name}`, 'warning');
                cart.splice(idx, 1);
            }
            renderCart();
        });
        $(document).on('click', '.ci-remove', function () {
            const idx = $(this).closest('.cart-item').data('index');
            notify(`លុប ${cart[idx].name}`, 'warning');
            cart.splice(idx, 1);
            renderCart();
        });

        function updateSummary() {
            const sub = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const disc = calcDiscount(sub);
            const total = sub - disc;
            $('#subtotal').text(fmtUsd(sub));
            $('#subtotalKhr').text(fmtKhr(roundKhr100(toKhr(sub))));
            $('#total').text(fmtUsd(total));
            $('#totalKhr').text(fmtKhr(roundKhr100(toKhr(total))));
            if (disc > 0) {
                $('#discountDisplay').show();
                $('#discountValue').text('-' + fmtUsd(disc));
                $('#discountKhr').text(fmtKhr(roundKhr100(toKhr(disc))));
            } else {
                $('#discountDisplay').hide();
            }
            const cnt = cart.reduce((s, i) => s + i.quantity, 0);
            $('#cartCount').text(cnt + ' មុខ');
            updatePayState();
        }

        function updatePayState() {
            const sub = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const disc = calcDiscount(sub);
            const totalUsd = sub - disc;
            const totalKhr = roundKhr100(toKhr(totalUsd));   /* cashier 4100 rate, rounded to 100 */
            const cash = parseFloat($('#cashReceived').val()) || 0;

            if (cart.length === 0) {
                $('#payBtn').prop('disabled', true);
                $('#changeDisplay').removeClass('show');
                return;
            }

            if (currentPaymentMethod !== 'cash') {
                $('#payBtn').prop('disabled', false);
                $('#changeDisplay').removeClass('show');
                return;
            }

            const needed = paymentCurrency === 'usd' ? totalUsd : totalKhr;
            $('#payBtn').prop('disabled', cash < needed);

            if (cash >= needed && cash > 0) {
                /* ── Cashier change display (4100 rate, rounded to nearest 100) ── */
                let changeUsd, changeKhr;
                if (paymentCurrency === 'usd') {
                    changeUsd = cash - totalUsd;
                    changeKhr = roundKhr100(toKhr(changeUsd));
                } else {
                    changeKhr = roundKhr100(cash - totalKhr);
                    changeUsd = changeKhr / EXCHANGE_RATE;
                }
                $('#changeAmount').text(fmtUsd(changeUsd));
                $('#changeAmountKhr').text(fmtKhr(changeKhr));
                $('#changeDisplay').addClass('show');
            } else {
                $('#changeDisplay').removeClass('show');
            }
        }

        function updateFab() {
            const cnt = cart.reduce((s, i) => s + i.quantity, 0);
            $('#fabBadge').text(cnt);
        }

        /* payment controls */
        $(document).on('click', '.curr-btn', function () {
            $('.curr-btn').removeClass('active');
            $(this).addClass('active');
            displayCurrency = $(this).data('currency');
            renderCart();
        });

        /* ── Pay-currency toggle (USD / KHR) ──
           Updates paymentCurrency and syncs quick-amount buttons.
           The customer display change will automatically use the
           correct rate when showCustomerThankYou() is called. */
        $(document).on('click', '[data-pay-currency]', function () {
            $('[data-pay-currency]').removeClass('active');
            $(this).addClass('active');
            paymentCurrency = $(this).data('pay-currency');
            if (paymentCurrency === 'usd') {
                $('.usd-amt').show();
                $('.khr-amt').hide();
                $('#cashReceived').attr('placeholder', 'ទទួលប្រាក់ (USD)').val('');
            } else {
                $('.usd-amt').hide();
                $('.khr-amt').show();
                $('#cashReceived').attr('placeholder', 'ទទួលប្រាក់ (រៀល)').val('');
            }
            /* Reload products so KHR price on cards uses correct rate */
            loadProducts();
            /* Sync customer display immediately */
            syncCustomerDisplay();
            updatePayState();
        });

        $(document).on('click', '.pay-method', function () {
            $('.pay-method').removeClass('active');
            $(this).addClass('active');
            currentPaymentMethod = $(this).data('method');
            if (currentPaymentMethod === 'cash') $('#cashPaymentSection').slideDown(180);
            else $('#cashPaymentSection').slideUp(180);
            $('#changeDisplay').removeClass('show');
            updatePayState();
        });
        $('#cashReceived').on('input', updatePayState);
        $(document).on('click', '.exact-btn, .quick-btn', function () {
            const amt = $(this).data('amount');
            if (amt === 'exact') {
                const sub = cart.reduce((s, i) => s + i.price * i.quantity, 0);
                const tot = sub - calcDiscount(sub);
                $('#cashReceived').val(paymentCurrency === 'usd' ? tot.toFixed(2) : toKhr(tot));
            } else {
                $('#cashReceived').val(amt);
            }
            updatePayState();
        });
        $('#discountAmount').on('input', function () {
            discountAmount = Math.max(parseFloat($(this).val()) || 0, 0);
            updateSummary();
            syncCustomerDisplay();
        });
        $('#discountTypeSelect').on('change', function () {
            discountType = $(this).val();
            $('#discountTypeBadge').text(discountType === 'fixed' ? 'ដុល្លារ' : 'ភាគរយ');
            updateSummary();
            syncCustomerDisplay();
        });

        /* ── cancel / hold ── */
        $('#cancelOrderBtn').click(function () {
            if (!cart.length) return;
            if (confirm('បោះបង់ការកម្មង់?')) {
                resetCart();
                notify('បោះបង់ការកម្មង់', 'warning');
            }
        });
        $('#holdOrderBtn').click(function () {
            if (!cart.length) {
                notify('គ្មានទំនិញ', 'warning');
                return;
            }
            const sub = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const disc = calcDiscount(sub);
            const held = JSON.parse(localStorage.getItem('heldOrders') || '[]');
            held.push({
                id: 'HOLD' + Date.now(),
                items: cart,
                discount: {amount: discountAmount, type: discountType, value: disc},
                total: sub - disc
            });
            localStorage.setItem('heldOrders', JSON.stringify(held));
            resetCart();
            notify('ផ្អាកការកម្មង់', 'success');
        });

        /* ════════════════════════════════════════
           PAY BUTTON — routes to correct modal
        ════════════════════════════════════════ */
        $('#payBtn').on('click', function () {
            const sub = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const totalUsd = sub - calcDiscount(sub);
            if (currentPaymentMethod === 'qr') {
                openKhqrFlow(totalUsd);          /* → show QR on customer screen + cashier waiting */
            } else {
                openCashConfirm();               /* → show order summary confirm modal */
            }
        });

        /* ════════════════════════════════════════
           CASH / CARD CONFIRM MODAL
        ════════════════════════════════════════ */
        function openCashConfirm() {
            const sub = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const disc = calcDiscount(sub);
            const totalUsd = sub - disc;
            const totalKhr = roundKhr100(toKhr(totalUsd));
            const cash = parseFloat($('#cashReceived').val()) || totalUsd;

            /* ── Cashier-side change (4100 rate, rounded to 100) ── */
            let changeUsd = 0, changeKhr = 0;
            if (currentPaymentMethod === 'cash') {
                if (paymentCurrency === 'usd') {
                    changeUsd = Math.max(0, cash - totalUsd);
                    changeKhr = roundKhr100(toKhr(changeUsd));
                } else {
                    changeKhr = roundKhr100(Math.max(0, cash - totalKhr));
                    changeUsd = changeKhr / EXCHANGE_RATE;
                }
            }

            /* Build items list */
            let itemsHtml = '';
            cart.forEach(item => {
                itemsHtml += `
<div class="cc-order-item">
    <span class="cc-item-name">${item.name}</span>
    <span class="cc-item-qty">×${item.quantity}</span>
    <span class="cc-item-price">${fmtUsd(item.price * item.quantity)}</span>
</div>`;
            });
            $('#ccOrderItems').html(itemsHtml);

            /* Build summary */
            let sumHtml = `<div class="cc-sum-row"><span>សរុប</span><span>${fmtUsd(sub)}<span class="cc-sum-khr">${fmtKhr(roundKhr100(toKhr(sub)))}</span></span></div>`;
            if (disc > 0) {
                const dLabel = discountType === 'percentage' ? `បញ្ចុះ ${discountAmount}%` : 'បញ្ចុះ';
                sumHtml += `<div class="cc-sum-row" style="color:#8B6914;"><span>${dLabel}</span><span>-${fmtUsd(disc)}</span></div>`;
            }
            sumHtml += `<div class="cc-sum-row total"><span><i class="fas fa-calculator" style="margin-right:5px;"></i>សរុបទាំងអស់</span><span>${fmtUsd(totalUsd)}<span class="cc-sum-khr">${fmtKhr(totalKhr)}</span></span></div>`;
            $('#ccSummary').html(sumHtml);

            /* Payment box (cashier sees rounded amounts) */
            if (currentPaymentMethod === 'cash') {
                const cashDisp = paymentCurrency === 'usd' ? fmtUsd(cash) : fmtKhr(cash);
                const cashKhr = paymentCurrency === 'usd' ? fmtKhr(roundKhr100(toKhr(cash))) : '';
                const changeDisp = paymentCurrency === 'usd' ? fmtUsd(changeUsd) : fmtKhr(changeKhr);
                const changeKhrD = paymentCurrency === 'usd' ? fmtKhr(changeKhr) : '';
                $('#ccCashVal').text(cashDisp);
                $('#ccCashKhr').text(cashKhr);
                $('#ccChangeVal').text(changeDisp);
                $('#ccChangeKhr').text(changeKhrD);
                $('#ccPaymentBox').show();
            } else {
                $('#ccCashVal').text('Card');
                $('#ccCashKhr').text('');
                $('#ccChangeVal').text('—');
                $('#ccChangeKhr').text('');
                $('#ccPaymentBox').hide();
            }

            $('#cashConfirmModal').addClass('show');
        }

        /* Cancel cash confirm → go back */
        $('#ccCancelBtn').on('click', function () {
            $('#cashConfirmModal').removeClass('show');
        });

        /* Confirm cash → actually save to DB */
        $('#ccConfirmBtn').on('click', function () {
            $('#cashConfirmModal').removeClass('show');
            runPayFlow();
        });

        /* ════════════════════════════════════════
           ACTUAL PAY → FETCH (called after confirm)
        ════════════════════════════════════════ */
        async function runPayFlow() {
            const $btn = $('#payBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> កំពុងរក្សាទុក...');
            try {
                const sub = cart.reduce((s, i) => s + i.price * i.quantity, 0);
                const disc = calcDiscount(sub);
                const totalUsd = sub - disc;
                const totalKhr = roundKhr100(toKhr(totalUsd));
                const cash = parseFloat($('#cashReceived').val()) || totalUsd;

                /* ── Cashier change (4100 rate, rounded to 100) ── */
                let changeUsd = 0, changeKhr = 0;
                if (currentPaymentMethod === 'cash') {
                    if (paymentCurrency === 'usd') {
                        changeUsd = Math.max(0, cash - totalUsd);
                        changeKhr = roundKhr100(toKhr(changeUsd));
                    } else {
                        changeKhr = roundKhr100(Math.max(0, cash - totalKhr));
                        changeUsd = changeKhr / EXCHANGE_RATE;
                    }
                }

                const items = cart.map(i => ({
                    menuItemId: i.id,
                    brandId: i.brandId || 0,
                    quantity: i.quantity,
                    price: i.price,
                    subtotal: i.price * i.quantity
                }));
                const cashUsd = paymentCurrency === 'usd' ? cash : cash / EXCHANGE_RATE;

                const res = await fetch('/Order/CreateOrder', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({items, cashReceived: cashUsd, discountAmount: disc})
                });
                if (!res.ok) {
                    const e = await res.json().catch(() => ({}));
                    throw new Error(e.error || `Server ${res.status}`);
                }
                const result = await res.json();

                orderCounter++;
                const orderNum = result.orderNumber || 'ORD' + orderCounter;
                const pmLabel = currentPaymentMethod === 'cash' ? 'សាច់ប្រាក់' : currentPaymentMethod === 'card' ? 'Card' : 'KHQR';

                lastOrder = {
                    number: orderNum, date: new Date(), items: [...cart],
                    subtotal: sub, discount: disc, discountType, discountAmount,
                    total: totalUsd, totalKhr,
                    paymentMethod: pmLabel,
                    paymentCurrency: paymentCurrency === 'usd' ? 'ដុល្លារ' : 'រៀល',
                    cashReceived: cash, changeUsd, changeKhr,
                    cashier: '@firstName @lastName'
                };

                /* Customer screen: thank-you with both USD and KHR change */
                showCustomerThankYou(lastOrder);
                showInvoice(lastOrder);
                addRecentChip(orderNum, totalUsd);
                resetCart();
                notify('ការទូទាត់បានជោគជ័យ! ✓', 'success');
            } catch (err) {
                notify('មានបញ្ហា: ' + err.message, 'error');
            } finally {
                $btn.prop('disabled', false).html('<i class="fas fa-check-circle"></i> បញ្ចប់ការទូទាត់ <span class="shortcut-tag">F8</span>');
                updatePayState();
            }
        }

        function resetCart() {
            cart = [];
            discountAmount = 0;
            $('#discountAmount').val('0');
            $('#discountDisplay').hide();
            $('#cashReceived').val('0');
            $('#changeDisplay').removeClass('show');
            renderCart();
        }

        /* ════════════════════════════════════════
           KHQR FLOW
           1. Show QR on customer panel (second screen)
           2. Show cashier waiting modal
           3. Cashier confirms → runPayFlow()  OR  cancels
        ════════════════════════════════════════ */
        let khqrTimer = null;

        function drawQROnCanvas(canvasId, totalUsd) {
            const canvas = document.getElementById(canvasId);
            if (!canvas) return;
            const size = parseInt(canvas.getAttribute('width')) || 186;
            canvas.width = size;
            canvas.height = size;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#fff';
            ctx.fillRect(0, 0, size, size);
            ctx.fillStyle = '#FF6B35';
            ctx.font = `700 12px Sora,sans-serif`;
            ctx.textAlign = 'center';
            ctx.fillText('Loading...', size / 2, size / 2);
            if (typeof QRCode === 'undefined' || !QRCode.toCanvas) {
                setTimeout(() => drawQROnCanvas(canvasId, totalUsd), 300);
                return;
            }
            const qrText = 'KHQR|SandooHouse|ABA|0000123456|USD|' + totalUsd.toFixed(2) + '|' + Date.now();
            QRCode.toCanvas(canvas, qrText, {
                width: size,
                margin: 1,
                color: {dark: '#12100D', light: '#ffffff'},
                errorCorrectionLevel: 'H'
            }, function () {
            });
        }

        function openKhqrFlow(totalUsd) {
            /* ── 1. Customer panel: show QR overlay ── */
            $('#cdQrAmount').text(fmtUsd(totalUsd));
            $('#cdQrKhr').text(fmtKhr(toKhr(totalUsd)));
            drawQROnCanvas('cdQrCanvas', totalUsd);

            /* Reset customer panel timer bar */
            const cdFill = document.getElementById('cdQrTimerFill');
            cdFill.style.transition = 'none';
            cdFill.style.width = '100%';
            void cdFill.offsetWidth;
            cdFill.style.transition = 'width 120s linear';
            cdFill.style.width = '0%';

            $('#cdQrOverlay').addClass('show');

            /* ── 2. Cashier modal: show waiting screen ── */
            $('#cqrAmount').text(fmtUsd(totalUsd));
            $('#cqrKhr').text(fmtKhr(toKhr(totalUsd)));

            /* Reset cashier timer bar */
            const cFill = document.getElementById('cqrTimerFill');
            cFill.style.transition = 'none';
            cFill.style.width = '100%';
            void cFill.offsetWidth;
            cFill.style.transition = 'width 120s linear';
            cFill.style.width = '0%';

            startKhqrCountdown(120);
            $('#cashierQrModal').addClass('show');
        }

        function closeKhqrFlow() {
            clearInterval(khqrTimer);
            $('#cashierQrModal').removeClass('show');
            $('#cdQrOverlay').removeClass('show');
        }

        function startKhqrCountdown(secs) {
            clearInterval(khqrTimer);
            let rem = secs;
            updateKhqrDisplay(rem);
            khqrTimer = setInterval(function () {
                rem--;
                updateKhqrDisplay(rem);
                if (rem <= 0) {
                    clearInterval(khqrTimer);
                    document.getElementById('cqrCountdown').textContent = 'ផុតកំណត់!';
                    document.getElementById('cqrCountdownSub').textContent = 'ផុតកំណត់!';
                    document.getElementById('cqrTimerText').style.color = '#FF7675';
                    setTimeout(closeKhqrFlow, 2000);
                }
            }, 1000);
        }

        function updateKhqrDisplay(s) {
            const m = Math.floor(s / 60), sec = String(s % 60).padStart(2, '0');
            const t = m + ':' + sec;
            document.getElementById('cqrCountdown').textContent = t;
            document.getElementById('cqrCountdownSub').textContent = t;
            const red = s <= 30 ? '#FF7675' : '';
            document.getElementById('cqrTimerText').style.color = red;
            if (document.getElementById('cqrCountdown')) document.getElementById('cqrCountdown').style.color = red || '#FF6B35';
        }

        /* Cashier confirms QR payment was received → save to DB */
        $('#cqrConfirmBtn').on('click', function () {
            closeKhqrFlow();
            runPayFlow();
        });

        /* Cashier cancels QR → close both, back to cart */
        $('#cqrCancelBtn').on('click', function () {
            closeKhqrFlow();
            notify('បោះបង់ KHQR — ជ្រើសរើសវិធីបង់ម្តងទៀត', 'warning');
        });

        /* ── invoice ── */
        function showInvoice(order) {
            const now = new Date();
            $('#invoiceDate').text(now.toLocaleDateString('en-GB', {day: '2-digit', month: 'short', year: 'numeric'}));
            $('#invoiceTime').text(now.toLocaleTimeString('en-US', {hour: '2-digit', minute: '2-digit'}));
            $('#invoiceNumber').text('#' + order.number);
            $('#invoicePaymentMethod').text(order.paymentMethod);

            let itemsHtml = '';
            order.items.forEach(item => {
                const tot = item.price * item.quantity;
                itemsHtml += `<div class="inv-item"><span class="inv-item-name">${item.name}</span><span class="inv-item-qty">${item.quantity} × ${fmtUsd(item.price)}</span><span class="inv-item-total">${fmtUsd(tot)}</span></div>`;
            });
            $('#invoiceItems').html(itemsHtml);

            let sumHtml = `<div class="inv-sum-row"><span>សរុបរង</span><span>${fmtUsd(order.subtotal)}</span></div>`;
            if (order.discount > 0) sumHtml += `<div class="inv-sum-row discount"><span>បញ្ចុះ ${order.discountType === 'percentage' ? '(' + order.discountAmount + '%)' : ''}</span><span>-${fmtUsd(order.discount)}</span></div>`;
            sumHtml += `<div class="inv-sum-row total"><span>សរុប</span><span>${fmtUsd(order.total)}</span></div><div style="text-align:right;font-size:11px;color:var(--text-light);margin-top:4px;">${fmtKhr(order.totalKhr)}</div>`;
            $('#invoiceSummary').html(sumHtml);

            let payHtml = '';
            if (order.paymentMethod === 'សាច់ប្រាក់') {
                const cd = order.paymentCurrency === 'ដុល្លារ' ? fmtUsd(order.cashReceived) : fmtKhr(order.cashReceived);
                const ch = order.paymentCurrency === 'ដុល្លារ' ? fmtUsd(order.changeUsd) : fmtKhr(order.changeKhr);
                payHtml = `<div class="inv-sum-row"><span>ទទួល (${order.paymentCurrency})</span><span>${cd}</span></div><div class="inv-sum-row"><span>អាប់</span><span>${ch}</span></div>`;
            } else {
                payHtml = `<div class="inv-sum-row"><span>វិធីបង់</span><span>${order.paymentMethod}</span></div>`;
            }
            $('#invoicePaymentDetails').html(payHtml);
            $('#invoiceModal').addClass('show');
        }

        /* ── print ── */
        $('#printInvoiceBtn').click(function () {
            if (!lastOrder) return;
            $('#invoiceModal').removeClass('show');
            const order = lastOrder, now = new Date();
            const dateStr = now.toLocaleDateString('en-GB', {day: '2-digit', month: 'short', year: 'numeric'});
            const timeStr = now.toLocaleTimeString('en-US', {hour: '2-digit', minute: '2-digit'});
            const fu = n => '$' + parseFloat(n).toFixed(2), fk = n => Math.round(n).toLocaleString() + ' ៛';
            let itH = '';
            order.items.forEach(i => {
                const t = i.price * i.quantity;
                itH += `<tr><td style="padding:8px 4px;border-bottom:1px solid #eee;">${i.name}</td><td style="text-align:center;padding:8px 4px;border-bottom:1px solid #eee;">${i.quantity}</td><td style="text-align:right;padding:8px 4px;border-bottom:1px solid #eee;">${fu(i.price)}</td><td style="text-align:right;padding:8px 4px;border-bottom:1px solid #eee;">${fu(t)}</td></tr>`;
            });
            let sumH = `<div style="display:flex;justify-content:space-between;margin:5px 0;"><span>សរុប</span><span>${fu(order.subtotal)}</span></div>`;
            if (order.discount > 0) sumH += `<div style="display:flex;justify-content:space-between;margin:5px 0;color:#F59E0B;"><span>បញ្ចុះ</span><span>-${fu(order.discount)}</span></div>`;
            sumH += `<div style="display:flex;justify-content:space-between;margin:5px 0;font-weight:bold;font-size:16px;border-top:2px dashed #333;padding-top:8px;"><span>សរុបទាំងអស់</span><span>${fu(order.total)}</span></div><div style="text-align:right;font-size:11px;font-weight:bold;">${fk(order.totalKhr)}</div>`;
            let payH = '';
            if (order.paymentMethod === 'សាច់ប្រាក់') {
                const cd = order.paymentCurrency === 'ដុល្លារ' ? fu(order.cashReceived) : fk(order.cashReceived);
                const ch = order.paymentCurrency === 'ដុល្លារ' ? fu(order.changeUsd) : fk(order.changeKhr);
                payH = `<div style="display:flex;justify-content:space-between;margin:5px 0;"><span>ទទួល</span><span>${cd}</span></div><div style="display:flex;justify-content:space-between;margin:5px 0;"><span>អាប់</span><span>${ch}</span></div>`;
            } else {
                payH = `<div style="display:flex;justify-content:space-between;margin:5px 0;"><span>វិធីបង់</span><span>${order.paymentMethod}</span></div>`;
            }
            const pf = document.createElement('iframe');
            pf.style.cssText = 'position:absolute;width:0;height:0;border:none;visibility:hidden';
            document.body.appendChild(pf);
            const doc = pf.contentWindow.document;
            doc.open();
            doc.write(`
            <!DOCTYPE html>
            <html>
            <head>
            <meta charset="utf-8">
            <title>Invoice</title>
            <style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:'Khmer OS','Leelawadee UI',Arial,sans-serif;font-size:13px;font-weight:bold;width:72mm;margin:0 auto;padding:4mm 3mm;color:#000}.hdr{text-align:center;padding-bottom:8px;border-bottom:3px solid #000;margin-bottom:8px}.shop{font-size:22px;font-weight:900;letter-spacing:1px;margin-bottom:3px}.det{font-size:12px;margin:1px 0}.ord-num{font-size:15px;font-weight:900;text-align:center;margin:6px 0;border:2px solid #000;padding:4px 0}.info{margin-bottom:7px;border-bottom:2px dashed #000;padding-bottom:7px}.row{display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px}table{width:100%;border-collapse:collapse;margin-bottom:4px;table-layout:fixed}thead tr{border-bottom:2px solid #000;border-top:2px solid #000}th{font-size:12px;font-weight:900;padding:5px 2px;text-align:left}th:nth-child(1){width:38%}th:nth-child(2){width:13%;text-align:center}th:nth-child(3){width:22%;text-align:right}th:nth-child(4){width:27%;text-align:right}tbody tr{border-bottom:1px dashed #000}td{font-size:13px;font-weight:bold;padding:5px 2px}td:nth-child(2){text-align:center}td:nth-child(3){text-align:right}td:last-child{text-align:right;font-weight:900}.sum{padding:6px 0;border-bottom:2px dashed #000;margin-bottom:6px}.pay{padding:6px 0;border-bottom:2px dashed #000;margin-bottom:7px}.ftr{text-align:center;padding-top:7px;border-top:2px dashed #000}.ty{font-size:17px;font-weight:900;margin-bottom:4px}.fs{font-size:11px;margin:3px 0}@@media print{body{width:72mm;padding:2mm;margin:0}}</style></head><body><div class="hdr"><div class="shop">ផ្ទះបាយសេនឌូ</div><div class="det">ទូរស័ព្ទ: 086 262 828</div><div class="det">ភ្នំពេញ, កម្ពុជា</div></div><div class="ord-num">លេខ #${order.number}</div><div class="info"><div class="row"><span>កាលបរិច្ឆេទ:</span><span>${dateStr} ${timeStr}</span></div><div class="row"><span>អ្នកលក់:</span><span>${order.cashier}</span></div></div><table><thead><tr><th>មុខទំនិញ</th><th style="text-align:center">ចំនួន</th><th style="text-align:right">តម្លៃ</th><th style="text-align:right">សរុប</th></tr></thead><tbody>${itH}</tbody></table><div class="sum">${sumH}</div><div class="pay">${payH}</div><div class="ftr"><div class="ty">សូមអរគុណ! 🙏</div><div class="fs">ទំនិញដែលបានទិញ មិនអាចដូរបានទេ</div><div class="fs">សូមអញ្ជើញមកម្តងទៀត</div></div></body></html>`);
            doc.close();
            pf.onload = function () {
                setTimeout(function () {
                    pf.contentWindow.focus();
                    pf.contentWindow.print();
                    pf.contentWindow.onafterprint = () => document.body.removeChild(pf);
                }, 100);
            };
        });

        $('#closeInvoiceBtn').click(() => $('#invoiceModal').removeClass('show'));
        $(document).on('click', '.modal-overlay', function (e) {
            if ($(e.target).hasClass('modal-overlay')) $('#invoiceModal').removeClass('show');
        });

        /* ── recent chips ── */
        function addRecentChip(num, amt) {
            const html = `<div class="recent-chip" data-order="${num}"><span class="rord-num">#${num}</span><span>${fmtUsd(amt)}</span><span class="rord-status">✓</span></div>`;
            $('#recentOrders').prepend(html);
            if ($('#recentOrders .recent-chip').length > 6) $('#recentOrders .recent-chip:last').remove();
        }

        $(document).on('click', '.recent-chip', () => {
            if (lastOrder) showInvoice(lastOrder);
        });
        addRecentChip('4582', 45.97);
        addRecentChip('4581', 23.50);
        addRecentChip('4580', 67.48);

        /* ── mobile sheet ── */
        $('#cartFab').click(function () {
            $('#mobileCartContent').html($('#cartPanel').html());
            updateSummary();
            $('#cartSheet').addClass('open');
        });
        $('#sheetBackdrop').click(() => $('#cartSheet').removeClass('open'));

        /* ── toast ── */
        function notify(msg, type = 'info') {
            $('.toast').remove();
            const icons = {
                success: 'fa-check-circle',
                warning: 'fa-exclamation-triangle',
                error: 'fa-times-circle',
                info: 'fa-info-circle'
            };
            const $t = $(`<div class="toast t-${type}"><i class="fas ${icons[type] || icons.info}"></i><span>${msg}</span></div>`);
            $('body').append($t);
            setTimeout(() => $t.addClass('show'), 10);
            setTimeout(() => {
                $t.removeClass('show');
                setTimeout(() => $t.remove(), 300);
            }, 2800);
        }

        /* ── keyboard ── */
        $(document).on('keydown', function (e) {
            if (e.key === 'F2') {
                e.preventDefault();
                if (cart.length && confirm('ចាប់ផ្តើមថ្មី?')) {
                    resetCart();
                    notify('ចាប់ផ្តើមការកម្មង់ថ្មី', 'info');
                }
            }
            if (e.key === 'F4') {
                e.preventDefault();
                $('#holdOrderBtn').click();
            }
            if (e.key === 'F8') {
                e.preventDefault();
                if (!$('#payBtn').prop('disabled')) $('#payBtn').click();
            }
            if (e.key === 'Escape') {
                e.preventDefault();
                if ($('#cashierQrModal').hasClass('show')) {
                    closeKhqrFlow();
                } else if ($('#cashConfirmModal').hasClass('show')) {
                    $('#cashConfirmModal').removeClass('show');
                } else if ($('#invoiceModal').hasClass('show')) {
                    $('#invoiceModal').removeClass('show');
                } else {
                    $('#cancelOrderBtn').click();
                }
            }
            if (e.key === '/' && !$(e.target).is('input,textarea,select')) {
                e.preventDefault();
                $('#productSearch').focus();
            }
        });

        console.log('✅ POS + Customer Display Ready — Rate: 4100 (cashier) / 4000 round-100 (customer change)');
    });
</script>
</body>
</html>
