@model Sandoohouse.Models.ModelViewer.MenuModelViewer.MenuViewerModel

@{
ViewData["Title"] = "Create Menu";
}

<!-- Add Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="page-inner">
    <div class="page-header">
        <h3 class="fw-bold mb-3">Create Menu</h3>
        <ul class="breadcrumbs mb-3">
            <li class="nav-home">
                <a asp-controller="Home" asp-action="Index">
                    <i class="icon-home"></i>
                </a>
            </li>
            <li class="separator">
                <i class="icon-arrow-right"></i>
            </li>
            <li class="nav-item">
                <a asp-controller="Menu" asp-action="Index">Menu</a>
            </li>
            <li class="separator">
                <i class="icon-arrow-right"></i>
            </li>
            <li class="nav-item">Create Menu</li>
        </ul>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-11">
            <!-- Main Form Card -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Card Header with Gradient -->
                <div class="card-header bg-gradient-primary text-white border-0 py-4">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                            <i class="bi bi-egg-fried fs-3"></i>
                        </div>
                        <div>
                            <h4 class="mb-1 fw-bold">New Menu Item</h4>
                            <p class="mb-0 small opacity-75">Add a new food item to your menu collection</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-5">
                    <form asp-controller="Menu" asp-action="CreateMenu" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                        <div class="row">
                            <!-- Left Column: Form Fields -->
                            <div class="col-lg-7">
                                <div class="row g-4">
                                    <!-- Menu Name -->
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold text-muted">
                                            Menu Name <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-2">
                                                <i class="bi bi-tag text-primary"></i>
                                            </span>
                                            <input asp-for="MenuName"
                                                   class="form-control form-control-lg border-2 @(ViewData.ModelState["MenuName"]?.Errors.Any() == true ? "is-invalid" : "")"
                                                   placeholder="e.g., Margherita Pizza" />
                                        </div>
                                        <span asp-validation-for="MenuName" class="text-danger small"></span>
                                    </div>

                                    <!-- Category -->
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold text-muted">
                                            Category <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-2">
                                                <i class="bi bi-grid text-primary"></i>
                                            </span>
                                            <select asp-for="CategoryId"
                                                    class="form-select form-select-lg border-2 @(ViewData.ModelState["CategoryId"]?.Errors.Any() == true ? "is-invalid" : "")">
                                                <option value="">-- Select Category --</option>
                                                @if (ViewBag.Categories != null)
                                                {
                                                @foreach (var category in ViewBag.Categories)
                                                {
                                                <option value="@category.Id">@category.CategoryName</option>
                                                }
                                                }
                                            </select>
                                        </div>
                                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                                    </div>

                                    <!-- Price -->
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold text-muted">
                                            Regular Price <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-2">
                                                <i class="bi bi-currency-dollar text-primary"></i>
                                            </span>
                                            <input asp-for="Price"
                                                   class="form-control form-control-lg border-2 @(ViewData.ModelState["Price"]?.Errors.Any() == true ? "is-invalid" : "")"
                                                   placeholder="0.00"
                                                   type="number"
                                                   step="0.01" />
                                        </div>
                                        <span asp-validation-for="Price" class="text-danger small"></span>
                                        <div class="form-text">
                                            <i class="bi bi-info-circle me-1"></i>Enter the base price
                                        </div>
                                    </div>

                                    <!-- Discount Price -->
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold text-muted">
                                            Discount Price
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-2">
                                                <i class="bi bi-percent text-primary"></i>
                                            </span>
                                            <input asp-for="DiscountPrice"
                                                   class="form-control form-control-lg border-2"
                                                   placeholder="0.00"
                                                   type="number"
                                                   step="0.01" />
                                        </div>
                                        <span asp-validation-for="DiscountPrice" class="text-danger small"></span>
                                        <div class="form-text">
                                            <i class="bi bi-info-circle me-1"></i>Optional
                                        </div>
                                    </div>

                                    <!-- Price Summary Card -->
                                    <div class="col-12 mt-3">
                                        <div class="bg-light rounded-3 p-3">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <span class="small fw-semibold">Price Summary:</span>
                                                    <div class="mt-2">
                                                        <span class="text-muted me-3">Regular:</span>
                                                        <span class="fw-bold" id="regularPriceDisplay">$0.00</span>
                                                    </div>
                                                    <div>
                                                        <span class="text-muted me-3">Discount:</span>
                                                        <span class="fw-bold text-success" id="discountPriceDisplay">$0.00</span>
                                                    </div>
                                                    <div class="mt-2 pt-2 border-top">
                                                        <span class="text-muted me-3">Final:</span>
                                                        <span class="fw-bold text-primary" id="finalPriceDisplay">$0.00</span>
                                                    </div>
                                                </div>
                                                <div class="text-end">
                                                    <span class="badge bg-success bg-opacity-10 px-3 py-2" id="savingsBadge" style="display: none;">
                                                        <i class="bi bi-tag me-1"></i>Save <span id="savingsAmount">$0.00</span>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Status Toggle -->
                                    <div class="col-12 mt-4">
                                        <div class="bg-light rounded-3 p-4">
                                            <div class="d-flex align-items-center">
                                                <div class="flex-grow-1">
                                                    <h6 class="fw-bold mb-1">
                                                        <i class="bi bi-toggle-on text-primary me-2"></i>Menu Status
                                                    </h6>
                                                    <p class="text-muted small mb-0">Enable to make this item visible and available for orders</p>
                                                </div>
                                                <div class="form-check form-switch ms-3">
                                                    <input asp-for="Status" class="form-check-input" type="checkbox" checked style="width: 3rem; height: 1.5rem;" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column: Image Upload -->
                            <div class="col-lg-5">
                                <div class="sticky-top" style="top: 2rem;">
                                    <div class="card border-0 bg-light rounded-4 p-4">
                                        <div class="text-center">
                                            <label class="form-label fw-semibold text-muted mb-3">
                                                <i class="bi bi-image text-primary me-2"></i>Menu Image
                                            </label>

                                            <!-- Image Upload Area -->
                                            <div class="position-relative d-inline-block w-100">
                                                <div class="menu-image-wrapper rounded-4 border-4 border-primary shadow-lg mx-auto"
                                                     style="width: 250px; height: 250px; overflow: hidden; cursor: pointer;"
                                                     onclick="document.getElementById('menuImageInput').click();">
                                                    <img id="previewImage"
                                                         src="~/no-image.png.jpg"
                                                         class="w-100 h-100"
                                                         alt="Menu Image"
                                                         style="object-fit: cover;" />
                                                    <div class="menu-image-overlay">
                                                        <i class="bi bi-camera-fill text-white fs-1"></i>
                                                        <span class="d-block text-white mt-2 small">Click to upload</span>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Image Input -->
                                            <input asp-for="ImageFile"
                                                   id="menuImageInput"
                                                   type="file"
                                                   class="d-none"
                                                   accept="image/*"
                                                   onchange="previewFile(event)" />

                                            <!-- Upload Button -->
                                            <div class="mt-4">
                                                <label for="menuImageInput" class="btn btn-outline-primary rounded-pill w-100">
                                                    <i class="bi bi-cloud-upload me-2"></i>Choose Image
                                                </label>
                                                <p class="text-muted small mt-3 mb-0">
                                                    <i class="bi bi-info-circle me-1"></i>JPG, PNG, GIF up to 2MB
                                                </p>
                                                <p class="text-muted small mb-0">
                                                    <i class="bi bi-arrows-angle-expand me-1"></i>Recommended 500x500px
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="row mt-5 g-3">
                            <div class="col-md-6">
                                <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill shadow-sm hover-scale">
                                    <i class="bi bi-check-circle me-2"></i>Create Menu Item
                                </button>
                            </div>
                            <div class="col-md-6">
                                <a asp-controller="Menu" asp-action="Index"
                                   class="btn btn-outline-danger w-100 py-3 rounded-pill">
                                    <i class="bi bi-x-circle me-2"></i>Cancel
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Custom Styles - Matching Account Create */
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .card-body {
        border: 1px solid #e9ecef;
        background: #ffffff;
    }

    .menu-image-wrapper {
        border: 4px solid #0d6efd;
        transition: all 0.3s ease;
        position: relative;
    }

    .menu-image-wrapper:hover {
        transform: scale(1.02);
        border-color: #0b5ed7;
    }

    .menu-image-wrapper:hover .menu-image-overlay {
        opacity: 1;
    }

    .menu-image-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.6);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
        border-radius: 1rem;
    }

    .input-group {
        border: 1px solid #dee2e6;
        border-radius: 0.6rem;
    }

    .input-group:focus-within {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.15rem rgba(13,110,253,.15);
    }

    .hover-scale:hover {
        transform: scale(1.02);
        transition: 0.2s;
    }

    .border-2 {
        border-width: 2px !important;
    }

    .border-4 {
        border-width: 4px !important;
    }

    .hover-scale {
        transition: transform 0.2s;
    }

    .hover-scale:hover {
        transform: translateY(-2px);
    }

    .form-control-lg, .input-group-text, .form-select-lg {
        border-radius: 0.5rem;
    }

    .form-control:focus, .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #5a6fd6 0%, #6a4292 100%);
    }

    .btn-outline-primary {
        border: 2px solid #667eea;
        color: #667eea;
    }

    .btn-outline-primary:hover {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-color: transparent;
        color: white;
    }

    .btn-outline-danger {
        border: 2px solid #dc3545;
    }

    .rounded-pill {
        border-radius: 50rem !important;
    }

    .form-check-input:checked {
        background-color: #667eea;
        border-color: #667eea;
    }

    /* Sticky column */
    .sticky-top {
        position: sticky;
        top: 2rem;
        z-index: 1;
    }

    /* Animation for preview image */
    #previewImage {
        transition: all 0.3s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: scale(0.9); }
        to { opacity: 1; transform: scale(1); }
    }
</style>

<script>
    function previewFile(event) {
        const reader = new FileReader();
        const file = event.target.files[0];

        if (file) {
            // Validate file size (max 2MB)
            if (file.size > 2 * 1024 * 1024) {
                alert('File size must be less than 2MB');
                event.target.value = '';
                return;
            }

            // Validate file type
            if (!file.type.match('image.*')) {
                alert('Please select an image file');
                event.target.value = '';
                return;
            }

            reader.onload = function() {
                const preview = document.getElementById("previewImage");
                preview.src = reader.result;
                preview.style.animation = "fadeIn 0.5s";
                document.getElementById("removeImage").style.display = "block";
            };

            reader.readAsDataURL(file);
        }
    }

    function removeImage() {
        const preview = document.getElementById("previewImage");
        preview.src = "~/images/no-image.png";
        document.getElementById("menuImageInput").value = "";
        document.getElementById("removeImage").style.display = "none";
    }

    // Price calculation and display
    document.addEventListener('DOMContentLoaded', function() {
        const priceInput = document.querySelector('[name="Price"]');
        const discountInput = document.querySelector('[name="DiscountPrice"]');

        function updatePriceDisplay() {
            const price = parseFloat(priceInput.value) || 0;
            const discount = parseFloat(discountInput.value) || 0;
            const finalPrice = discount > 0 ? discount : price;
            const savings = price - finalPrice;

            document.getElementById('regularPriceDisplay').textContent = '$' + price.toFixed(2);
            document.getElementById('discountPriceDisplay').textContent = discount > 0 ? '$' + discount.toFixed(2) : 'No discount';
            document.getElementById('finalPriceDisplay').textContent = '$' + finalPrice.toFixed(2);

            const savingsBadge = document.getElementById('savingsBadge');
            const savingsAmount = document.getElementById('savingsAmount');

            if (discount > 0 && discount < price) {
                savingsBadge.style.display = 'inline-block';
                savingsAmount.textContent = '$' + savings.toFixed(2);
            } else {
                savingsBadge.style.display = 'none';
            }
        }

        if (priceInput) {
            priceInput.addEventListener('input', updatePriceDisplay);
            priceInput.addEventListener('blur', function() {
                if (this.value) {
                    this.value = parseFloat(this.value).toFixed(2);
                    updatePriceDisplay();
                }
            });
        }

        if (discountInput) {
            discountInput.addEventListener('input', updatePriceDisplay);
            discountInput.addEventListener('blur', function() {
                if (this.value) {
                    this.value = parseFloat(this.value).toFixed(2);
                    updatePriceDisplay();
                }
            });
        }

        // Initial update
        updatePriceDisplay();
    });

    // Form validation
    (function() {
        'use strict';
        const forms = document.querySelectorAll('.needs-validation');
        Array.from(forms).forEach(form => {
            form.addEventListener('submit', event => {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();
</script>