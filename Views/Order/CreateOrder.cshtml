@using System.Security.Claims
@{
    ViewData["Title"] = "POS ផ្ទះបាយសេនឌូ";
    Layout = null;
    var firstName = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Name)?.Value;
    var lastName = User.Claims.FirstOrDefault(c => c.Type == "LastName")?.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
    <title>@ViewData["Title"]</title>
    <link rel="icon" href="~/assets/img/kaiadmin/SandooHouse.ico" type="image/x-icon"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link
        href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800;900&family=Noto+Sans+Khmer:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
    <link rel="stylesheet" href="~/css/CreateOrder.css"/>
</head>
<body>
<div class="pos-shell">

    <!-- ── TOP BAR ── -->
    <header class="topbar">
        <img src="~/assets/img/kaiadmin/SandooHouse.ico" alt="Logo" height="33"
             onerror="this.src='https://via.placeholder.com/100x32?text=POS'">
        <div class="topbar-divider"></div>
        <div class="topbar-info">
            <span class="topbar-date"><i class="fas fa-calendar-alt"
                                         style="margin-right:4px;color:var(--brand)"></i>@DateTime.Now.ToString("dd MMM yyyy")</span>
            <span class="topbar-time" id="liveClock">@DateTime.Now.ToString("hh:mm tt")</span>
        </div>
        <div class="topbar-spacer"></div>
        <div class="topbar-hide-sm" style="display:flex;align-items:center;gap:8px;">
            <span class="exrate-chip"><i class="fas fa-exchange-alt" style="margin-right:5px;"></i>1$ = 4,100៛</span>
            <div class="curr-toggle">
                <button class="curr-btn active" data-currency="usd">USD</button>
                <button class="curr-btn" data-currency="khr">KHR</button>
            </div>
        </div>
        <div class="user-chip">
            <i class="fas fa-user-circle"></i>
            <span>@firstName @lastName</span>
        </div>
        <button class="shift-btn" id="customerScreenBtn" onclick="toggleCustomerDisplay(); return false;"
                title="Customer Display">
            <i class="fas fa-desktop"></i>
            <span class="topbar-hide-sm">Customer Screen</span>
            <span id="customerScreenStatus" style="margin-left:5px;font-size:10px;"></span>
        </button>
        <button class="shift-btn" id="shiftBtn" onclick="showShiftModal(); return false;" title="Shift">
            <i class="fas fa-clock"></i>
            <span class="topbar-hide-sm">វេនលក់</span>
        </button>
        <a href="#" class="logout-btn" onclick="showLogoutModal(); return false;" title="Logout">
            <i class="fas fa-sign-out-alt"></i>
            <span class="topbar-hide-sm">Logout</span>
        </a>
    </header>

    <!-- ── MAIN BODY ── -->
    <div class="pos-body">

        <!-- ══ LEFT: PRODUCTS PANEL ══ -->
        <div class="panel-products">
            <div class="filter-bar">
                <div class="filter-label"><i class="fas fa-tag" style="margin-right:4px;color:var(--brand)"></i>ម៉ាក
                </div>
                <div class="scroll-tabs" id="brandTabs">
                    <button class="tab-pill brand-active" data-brand="all">ទាំងអស់</button>
                    @if (ViewBag.Brands != null)
                    {
                        foreach (var brand in ViewBag.Brands)
                        {
                            <button class="tab-pill" data-brand="@brand.BrandName"
                                    data-brand-id="@brand.Id">@brand.BrandName</button>
                        }
                    }
                </div>
            </div>
            <div class="filter-bar" style="border-bottom:none;padding-top:6px;">
                <div class="filter-label"><i class="fas fa-list" style="margin-right:4px;color:var(--brand)"></i>ប្រភេទ
                </div>
                <div class="scroll-tabs" id="categoryTabs">
                    <button class="tab-pill active" data-category="all">ទាំងអស់</button>
                </div>
            </div>
            <div class="search-wrap">
                <div class="search-inner">
                    <i class="fas fa-search"></i>
                    <input type="text" id="productSearch" placeholder="ស្វែងរកមុខទំនិញ..." autocomplete="off"
                           spellcheck="false">
                </div>
            </div>
            <div class="products-grid" id="productsGrid">
                <div class="state-placeholder">
                    <i class="fas fa-circle-notch fa-spin" style="color:var(--brand)"></i>
                    <p>កំពុងផ្ទុក...</p>
                </div>
            </div>
        </div>

        <!-- ══ RIGHT: CASHIER CART PANEL ══ -->
        <div class="panel-cart" id="cartPanel">
            <div class="cart-head">
                <span class="cart-title"><i class="fas fa-shopping-cart"></i>ការកម្មង់</span>
                <span class="cart-badge" id="cartCount">0 មុខ</span>
            </div>
            <div class="cart-items" id="cartItems">
                <div class="empty-cart">
                    <i class="fas fa-utensils"></i>
                    <p>ថ្ងៃសួស្ដី! ជ្រើសអាហារ</p>
                    <small>ចុចលើផលិតផលដើម្បីបន្ថែម</small>
                </div>
            </div>
            <div class="cart-summary">
                <div class="sum-row">
                    <span>សរុប</span>
                    <span>
                        <span id="subtotal">$0.00</span>
                        <div class="sum-khr" id="subtotalKhr">0 ៛</div>
                    </span>
                </div>
                <div class="disc-box">
                    <div class="disc-box-head">
                        <span><i class="fas fa-tags" style="margin-right:5px;"></i>បញ្ចុះតម្លៃ</span>
                        <span class="disc-type-badge" id="discountTypeBadge">ដុល្លារ</span>
                    </div>
                    <div class="disc-inputs">
                        <input type="number" id="discountAmount" placeholder="0" min="0" step="0.01" value="0">
                        <select id="discountTypeSelect">
                            <option value="fixed">USD</option>
                            <option value="percentage">%</option>
                        </select>
                    </div>
                    <div id="discountDisplay" style="display:none;margin-top:5px;">
                        <div class="sum-row" style="font-size:11px;color:#92400E;margin-bottom:0;">
                            <span>ចំនួនបញ្ចុះ</span>
                            <span>
                                <span id="discountValue">-$0.00</span>
                                <div class="sum-khr" id="discountKhr">0 ៛</div>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="sum-row total">
                    <span><i class="fas fa-calculator" style="margin-right:5px;font-size:13px;"></i>សរុបទាំងអស់</span>
                    <span>
                        <span id="total" class="total-usd">$0.00</span>
                        <div class="sum-khr" id="totalKhr">0 ៛</div>
                    </span>
                </div>
            </div>
            <div class="pay-section">
                <div class="pay-methods">
                    <div class="pay-method active" data-method="cash">
                        <i class="fas fa-money-bill-wave"></i><span>សាច់ប្រាក់</span>
                    </div>
                    <div class="pay-method" data-method="card">
                        <i class="fas fa-credit-card"></i><span>Card</span>
                    </div>
                    <div class="pay-method" data-method="qr">
                        <i class="fas fa-qrcode"></i><span>KHQR</span>
                    </div>
                </div>
                <div class="pay-currency-row">
                    <button class="pay-curr-btn active" data-pay-currency="usd">បង់ USD</button>
                    <button class="pay-curr-btn" data-pay-currency="khr">បង់ រៀល</button>
                </div>
                <div class="cash-section" id="cashPaymentSection">
                    <div class="cash-input-row">
                        <input type="number" id="cashReceived" placeholder="ទទួលប្រាក់" min="0" step="0.01" value="0">
                        <button class="exact-btn" data-amount="exact">ចំនួនពិតប្រាកដ</button>
                    </div>
                    <div class="quick-row" id="quickAmounts">
                        <button class="quick-btn usd-amt" data-amount="5">$5</button>
                        <button class="quick-btn usd-amt" data-amount="10">$10</button>
                        <button class="quick-btn usd-amt" data-amount="20">$20</button>
                        <button class="quick-btn usd-amt" data-amount="50">$50</button>
                        <button class="quick-btn usd-amt" data-amount="100">$100</button>
                        <button class="quick-btn khr-amt" data-amount="5000" style="display:none;">5k ៛</button>
                        <button class="quick-btn khr-amt" data-amount="10000" style="display:none;">10k ៛</button>
                        <button class="quick-btn khr-amt" data-amount="20000" style="display:none;">20k ៛</button>
                        <button class="quick-btn khr-amt" data-amount="50000" style="display:none;">50k ៛</button>
                        <button class="quick-btn khr-amt" data-amount="100000" style="display:none;">100k ៛</button>
                    </div>
                </div>
                <div class="change-box" id="changeDisplay">
                    <i class="fas fa-hand-holding-usd" style="margin-right:4px;"></i>
                    ប្រាក់សល់: <strong id="changeAmount">$0.00</strong>
                    <div class="change-khr" id="changeAmountKhr">0 ៛</div>
                </div>
                <div class="action-row">
                    <button class="act-btn act-hold" id="holdOrderBtn">
                        <i class="fas fa-pause-circle"></i> ផ្អាក <span class="shortcut-tag">F4</span>
                    </button>
                    <button class="act-btn act-cancel" id="cancelOrderBtn">
                        <i class="fas fa-times-circle"></i> បោះបង់
                    </button>
                    <button class="act-btn act-pay" id="payBtn" disabled>
                        <i class="fas fa-check-circle"></i>
                        បញ្ចប់ការទូទាត់
                        <span class="shortcut-tag">F8</span>
                    </button>
                </div>
            </div>
            <div class="recent-bar">
                <div class="recent-label"><i class="fas fa-history" style="margin-right:4px;"></i>ប្រតិបត្តិការថ្មីៗ
                </div>
                <div class="recent-scroll" id="recentOrders"></div>
            </div>
        </div>

    </div>
</div>

<!-- ── MOBILE FAB ── -->
<button class="cart-fab" id="cartFab">
    <i class="fas fa-shopping-cart"></i>
    <span class="cart-fab-badge" id="fabBadge">0</span>
</button>

<!-- ── MOBILE CART SHEET ── -->
<div class="cart-sheet" id="cartSheet">
    <div class="sheet-backdrop" id="sheetBackdrop"></div>
    <div class="sheet-body">
        <div class="sheet-handle"></div>
        <div id="mobileCartContent"
             style="overflow-y:auto;flex:1;display:flex;flex-direction:column;min-height:0;"></div>
    </div>
</div>

<!-- ══ CASHIER KHQR WAITING MODAL ══ -->
<div class="cashier-qr-modal" id="cashierQrModal">
    <div class="cashier-qr-box">
        <div class="cashier-qr-head">
            <h3><i class="fas fa-qrcode" style="margin-right:7px;color:#FF6B35;"></i>រង់ចាំការស្កែន KHQR</h3>
            <p>QR បានបង្ហាញនៅ Customer Display រួចហើយ</p>
            <div class="cashier-qr-amount-badge">
                <i class="fas fa-dollar-sign" style="color:#FF6B35;font-size:13px;"></i>
                <span class="cashier-qr-amount-val" id="cqrAmount">$0.00</span>
                <span style="font-size:11px;color:rgba(255,255,255,.38);font-weight:600;" id="cqrKhr">0 ៛</span>
            </div>
        </div>
        <div class="cashier-qr-body">
            <div style="display:flex;flex-direction:column;align-items:center;gap:12px;width:100%;">
                <div style="background:rgba(255,107,53,0.1);border-radius:12px;padding:12px;text-align:center;">
                    <i class="fas fa-mobile-alt"
                       style="font-size:32px;color:#FF6B35;margin-bottom:8px;display:block;"></i>
                    <span style="font-size:12px;color:#E8F0F8;">សូមឱ្យអតិថិជនស្កែន QR</span>
                </div>
                <div class="timer-waiting" style="font-size:13px;color:#6B7F96;">
                    <i class="fas fa-hourglass-half"></i> រង់ចាំការបញ្ជាក់...
                </div>
            </div>
        </div>
        <div class="cashier-qr-footer">
            <button class="cashier-qr-confirm" id="cqrConfirmBtn">
                <i class="fas fa-check-circle"></i> បង្ហាញបានទូទាត់
            </button>
            <button class="cashier-qr-cancel-pay" id="cqrCancelBtn">
                <i class="fas fa-times"></i> បោះបង់
            </button>
        </div>
    </div>
</div>

<!-- ══ CASH CONFIRM MODAL ══ -->
<div class="cash-confirm-modal" id="cashConfirmModal">
    <div class="cash-confirm-box">
        <div class="cash-confirm-head">
            <div class="cash-confirm-head-icon"><i class="fas fa-receipt"></i></div>
            <div>
                <h3>បញ្ជាក់ការទូទាត់</h3>
                <p>សូមពិនិត្យបញ្ជីការកម្មង់ម្តងទៀតមុននឹងបញ្ចប់</p>
            </div>
        </div>
        <div class="cash-confirm-body">
            <div
                style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.9px;color:var(--text-muted);margin-bottom:6px;">
                <i class="fas fa-list" style="margin-right:4px;"></i>បញ្ជីការកម្មង់
            </div>
            <div class="cc-order-items" id="ccOrderItems"></div>
            <div class="cc-summary" id="ccSummary"></div>
            <div class="cc-payment-box" id="ccPaymentBox">
                <div class="cc-pay-cell">
                    <div class="cc-pay-label">ទទួល</div>
                    <div class="cc-pay-val" id="ccCashVal">$0.00</div>
                    <div class="cc-pay-khr" id="ccCashKhr">0 ៛</div>
                </div>
                <div class="cc-pay-divider"></div>
                <div class="cc-pay-cell">
                    <div class="cc-pay-label">អាប់</div>
                    <div class="cc-pay-val" id="ccChangeVal">$0.00</div>
                    <div class="cc-pay-khr" id="ccChangeKhr">0 ៛</div>
                </div>
            </div>
        </div>
        <div class="cash-confirm-footer">
            <button class="cc-btn-cancel" id="ccCancelBtn"><i class="fas fa-arrow-left"></i> ត្រលប់</button>
            <button class="cc-btn-confirm" id="ccConfirmBtn"><i class="fas fa-check-circle"></i> បញ្ជាក់ &amp; រក្សាទុក
            </button>
        </div>
    </div>
</div>

<!-- ── INVOICE MODAL ── -->
<div class="modal-overlay" id="invoiceModal">
    <div class="invoice-box">
        <div class="inv-head">
            <h2><i class="fas fa-receipt" style="margin-right:7px;"></i>ផ្ទះបាយសេនឌូ</h2>
            <div class="inv-num" id="invoiceNumber">#ORD-0000</div>
        </div>
        <div class="inv-body">
            <div class="inv-meta">
                <span><i class="fas fa-calendar"></i><span id="invoiceDate"></span></span>
                <span><i class="fas fa-clock"></i><span id="invoiceTime"></span></span>
            </div>
            <div class="inv-meta" style="border-bottom:none;margin-bottom:10px;">
                <span><i class="fas fa-user"></i><span>@firstName @lastName</span></span>
                <span><i class="fas fa-credit-card"></i><span id="invoicePaymentMethod">សាច់ប្រាក់</span></span>
            </div>
            <div class="inv-items-head"><span>មុខ</span><span>ចំនួន × តម្លៃ</span><span>សរុប</span></div>
            <div id="invoiceItems"></div>
            <div class="inv-summary" id="invoiceSummary"></div>
            <div class="inv-pay-box" id="invoicePaymentDetails"></div>
        </div>
        <div class="inv-footer">
            <div class="thanks">🙏 សូមអរគុណសម្រាប់ការទិញ!</div>
            <div>ទំនិញដែលបានទិញ មិនអាចដូរបានទេ</div>
        </div>
        <div class="inv-actions">
            <button class="inv-btn print" id="printInvoiceBtn"><i class="fas fa-print"></i> បោះពុម្ព</button>
            <button class="inv-btn close-btn" id="closeInvoiceBtn"><i class="fas fa-times"></i> បិទ</button>
        </div>
    </div>
</div>

<!-- ══ SHIFT MODAL ══ -->
<div id="shiftModal" class="shift-modal">
    <div class="shift-box">
        <div class="shift-head">
            <div class="shift-head-icon"><i class="fas fa-clock"></i></div>
            <div>
                <h3>វេនការងារ</h3>
                <p>Shift Management · <span id="shiftCurrentDate">@DateTime.Now.ToString("dd MMM yyyy")</span></p>
            </div>
        </div>

        <!-- NO SHIFT OPEN state -->
        <div id="shiftClosedView">
            <div class="shift-body">
                <div class="shift-note">
                    <i class="fas fa-info-circle"></i>
                    <span>មិនទាន់មានវេនការងារបើក។ បញ្ចូលប្រាក់ចំណូលដំបូង ហើយចុច <strong>«ចាប់ផ្តើម»</strong> ដើម្បីបើកវេន។</span>
                </div>
                <div class="shift-cash-row">
                    <div class="shift-cash-label"><i class="fas fa-dollar-sign"
                                                     style="margin-right:5px;color:var(--warning);"></i>ប្រាក់ក្នុងកន្ត្រក
                        (Opening Cash)
                    </div>
                    <div class="shift-cash-input-wrap">
                        <span class="shift-cash-prefix">$</span>
                        <input type="number" id="shiftOpeningCash" class="shift-cash-input" placeholder="0.00" min="0"
                               step="0.01" value="0">
                    </div>
                </div>
                <div class="shift-stats">
                    <div class="shift-stat-card">
                        <div class="shift-stat-label">Cashier</div>
                        <div class="shift-stat-val" style="font-size:14px;">@firstName @lastName</div>
                        <div class="shift-stat-sub">អ្នកគ្រប់គ្រង</div>
                    </div>
                    <div class="shift-stat-card">
                        <div class="shift-stat-label">ម៉ោង</div>
                        <div class="shift-stat-val" id="shiftCurrentTime">@DateTime.Now.ToString("hh:mm tt")</div>
                        <div class="shift-stat-sub">ពេលចាប់ផ្ដើម</div>
                    </div>
                </div>
            </div>
            <div class="shift-footer">
                <button class="shift-btn-start" id="shiftStartBtn">
                    <i class="fas fa-play-circle"></i> ចាប់ផ្ដើមវេន
                </button>
                <button class="shift-btn-close" onclick="hideShiftModal()">
                    <i class="fas fa-times"></i> បិទ
                </button>
            </div>
        </div>

        <!-- SHIFT OPEN state -->
        <div id="shiftOpenView" style="display:none;">
            <div class="shift-body">
                <div class="shift-status-card">
                    <div class="shift-status-dot"></div>
                    <div>
                        <div class="shift-status-label">វេនការងារកំពុងដំណើរការ</div>
                        <div class="shift-status-time" id="shiftStartedTime">ចាប់ផ្ដើម — —</div>
                    </div>
                    <div class="shift-status-hrs" id="shiftElapsed">0:00</div>
                </div>
                <div class="shift-stats">
                    <div class="shift-stat-card">
                        <div class="shift-stat-label">ការកម្មង់</div>
                        <div class="shift-stat-val brand" id="shiftOrderCount">0</div>
                        <div class="shift-stat-sub">ការលក់</div>
                    </div>
                    <div class="shift-stat-card">
                        <div class="shift-stat-label">ចំណូលរួម</div>
                        <div class="shift-stat-val brand" id="shiftRevenue">$0.00</div>
                        <div class="shift-stat-sub">USD</div>
                    </div>
                    <div class="shift-stat-card">
                        <div class="shift-stat-label">ប្រាក់ចំណូលដំបូង</div>
                        <div class="shift-stat-val" id="shiftOpenCashDisplay">$0.00</div>
                        <div class="shift-stat-sub">Opening cash</div>
                    </div>
                    <div class="shift-stat-card">
                        <div class="shift-stat-label">សរុបក្នុងកន្ត្រក</div>
                        <div class="shift-stat-val brand" id="shiftTotalCash">$0.00</div>
                        <div class="shift-stat-sub">Est. cash in drawer</div>
                    </div>
                </div>
            </div>
            <div class="shift-footer">
                <button class="shift-btn-end" id="shiftEndBtn">
                    <i class="fas fa-stop-circle"></i> បញ្ចប់វេន
                </button>
                <button class="shift-btn-close" onclick="hideShiftModal()">
                    <i class="fas fa-times"></i> បិទ
                </button>
            </div>
        </div>
    </div>
</div>

