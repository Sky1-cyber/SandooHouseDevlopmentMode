@model IEnumerable<Admin>
@using Sandoohouse.Models.Enum
@using System.Globalization
@{
    ViewData["Title"] = "Account List";
}

<div class="page-inner">
    <div class="page-header d-flex justify-content-between align-items-center">
        <h3 class="fw-bold mb-3">Account Management</h3>
        <ul class="breadcrumbs mb-3">
            <li class="nav-home">
                <a asp-controller="Home" asp-action="Index"><i class="icon-home"></i></a>
            </li>
            <li class="separator"><i class="icon-arrow-right"></i></li>
            <li class="nav-item"><a asp-controller="Account" asp-action="ListAccount">Account List</a></li>
        </ul>
        <div class="ms-md-auto py-2 py-md-0">
            <a asp-controller="Account" asp-action="CreateAccount" class="btn btn-primary btn-round">
                <i class="fas fa-plus me-2"></i>Add Account
            </a>
        </div>
    </div>

    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-12">

                <!-- Accounts Card -->
                <div class="card shadow-lg rounded-4 overflow-hidden">

                    <!-- Card Header -->
                    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center p-4">
                        <div>
                            <h4 class="fw-bold mb-1">Admin Management</h4>
                            <small class="text-muted">Manage system administrators</small>
                        </div>
                    </div>

                    <!-- Table Section -->
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table id="adminTable" class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">Admin</th>
                                        <th>Email</th>
                                        <th>Phone</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                        <th class="text-center pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var admin in Model)
                                    {
                                        <tr>
                                            <!-- Profile -->
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="rounded overflow-hidden bg-white border shadow-sm me-3"
                                                         style="width: 45px; height: 45px;">
                                                        <img src="@Url.Content(admin.ProfileImageFile != null ? $"~/Admin/{admin.ProfileImageFile}" : "~/l60Hf.png")"
                                                             alt="@admin.FirstName @admin.LastName"
                                                             class="w-100 h-100"
                                                             style="object-fit: cover;" />
                                                    </div>
                                                    <div>
                                                        <div class="fw-semibold">
                                                            @admin.FirstName @admin.LastName
                                                            @if (admin.IsOnline)
                                                            {
                                                                <span class="badge ms-2" style="background-color: rgba(40, 167, 69, 0.1); color: #28a745; font-size:0.7rem;">
                                                                    <i class="fas fa-circle me-1" style="font-size: 6px;"></i>Online
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge ms-2" style="background-color: rgba(108, 117, 125, 0.1); color: #6c757d; font-size:0.7rem;">
                                                                    <i class="fas fa-circle me-1" style="font-size: 6px;"></i>Offline
                                                                </span>
                                                            }
                                                        </div>
                                                        <small class="text-muted">ID: #@admin.Id</small>
                                                    </div>
                                                </div>
                                            </td>

                                            <!-- Email -->
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-envelope text-primary me-2" style="font-size: 14px;"></i>
                                                    <span class="text-muted">@admin.Email</span>
                                                </div>
                                            </td>

                                            <!-- Phone -->
                                            <td>
                                                @if (!string.IsNullOrEmpty(admin.PhoneNumber))
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <i class="fas fa-phone text-primary me-2" style="font-size: 14px;"></i>
                                                        <span class="text-muted">@admin.PhoneNumber</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted fst-italic">Not provided</span>
                                                }
                                            </td>

                                            <!-- Status -->
                                            <td>
                                                @if (admin.Status == Status.Active)
                                                {
                                                    <span class="badge rounded-pill px-3 py-2" 
                                                          style="background-color: rgba(40, 167, 69, 0.1); color: #28a745;">
                                                        <i class="fas fa-check-circle me-1"></i> Active
                                                    </span>
                                                }
                                                else if (admin.Status == Status.Inactive)
                                                {
                                                    <span class="badge rounded-pill px-3 py-2" 
                                                          style="background-color: rgba(108, 117, 125, 0.1); color: #6c757d;">
                                                        <i class="fas fa-user-clock me-1"></i> Inactive
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge rounded-pill px-3 py-2" 
                                                          style="background-color: rgba(220, 53, 69, 0.1); color: #dc3545;">
                                                        <i class="fas fa-ban me-1"></i> Suspended
                                                    </span>
                                                }
                                            </td>

                                            <!-- Created -->
                                            <td>
                                                <div class="fw-semibold">@admin.CreatedAt.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture)</div>
                                                <small class="text-muted">@((int)(DateTime.UtcNow - admin.CreatedAt).TotalDays) days ago</small>
                                            </td>

                                            <!-- Actions -->
                                            <td class="text-center pe-4">
                                                <!-- Desktop & Mobile Unified Actions -->
                                                <div class="d-flex gap-2 justify-content-center">
                                                    <a asp-controller="Account"
                                                       asp-action="EditAccount"
                                                       asp-route-id="@admin.Id"
                                                       class="btn btn-sm btn-outline-primary"
                                                       title="Edit admin">
                                                        <i class="fas fa-edit"></i>
                                                    </a>

                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Delete admin"
                                                            onclick="confirmDelete('@admin.Id', '@admin.FirstName @admin.LastName')">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Footer with Summary -->
                    <div class="card-footer bg-white border-0 p-3 d-flex justify-content-between align-items-center">
                        <div class="text-muted">
                            <small><i class="fas fa-users me-1"></i>Total administrators: @Model.Count()</small>
                        </div>
                        <div class="text-muted">
                            <small>
                                <i class="fas fa-check-circle text-success me-1"></i>Active: @Model.Count(a => a.Status == Status.Active) | 
                                <i class="fas fa-user-clock text-secondary me-1"></i>Inactive: @Model.Count(a => a.Status == Status.Inactive) | 
                                <i class="fas fa-ban text-danger me-1"></i>Suspended: @Model.Count(a => a.Status == Status.Suspended)
                            </small>
                        </div>
                    </div>

                </div> <!-- End Accounts Card -->

            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="adminNameDisplay"></strong>?</p>
                <p class="text-danger small"><i class="fas fa-info-circle me-1"></i>This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <form id="deleteForm" method="post" asp-controller="Account" asp-action="Delete">
                    <input type="hidden" name="id" id="adminIdToDelete" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-2"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Styles -->
<style>
    .table td, .table th {
        vertical-align: middle;
    }
    
    .table-hover tbody tr:hover {
        background-color: #f8fafc;
    }
    
    .badge {
        font-weight: 500;
        font-size: 13px;
    }
    
    .btn-outline-primary, .btn-outline-danger, .btn-outline-info {
        border-width: 1px;
        padding: 0.375rem 0.75rem;
    }
    
    .btn-outline-primary:hover {
        background-color: #0d6efd;
        color: white;
    }
    
    .btn-outline-danger:hover {
        background-color: #dc3545;
        color: white;
    }
    
    .btn-outline-info:hover {
        background-color: #0dcaf0;
        color: white;
    }
    
    .card-footer {
        border-top: 1px solid rgba(0,0,0,0.05);
    }
</style>
<!-- jQuery & DataTables -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script>
    $(document).ready(function () {
        $('#adminTable').DataTable({
            pageLength: 10,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,
            language: {
                search: "<i class='fas fa-search'></i> Search",
                searchPlaceholder: "Search administrators...",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_ to _END_ of _TOTAL_ administrators",
                infoEmpty: "Showing 0 to 0 of 0 administrators",
                infoFiltered: "(filtered from _MAX_ total administrators)"
            }
        });
    });

    // Delete confirmation function
    function confirmDelete(adminId, adminName) {
        // Set the admin name in the modal
        document.getElementById('adminNameDisplay').textContent = adminName;
        // Set the admin ID in the hidden input
        document.getElementById('adminIdToDelete').value = adminId;
        
        // Show the modal
        var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        deleteModal.show();
    }
</script>