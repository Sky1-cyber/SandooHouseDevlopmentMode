@{
Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <title>Forgot Password</title>
    <link rel="icon" href="~/assets/img/kaiadmin/SandooHouse.ico" type="image/x-icon"/>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="@Url.Content("~/assets/img/kaiadmin/SandooHouse.ico")" type="image/x-icon"/>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        :root {
            --brand:       #FF6B35;
            --brand-dark:  #E85520;
            --brand-light: #FFF0EA;
            --brand-mid:   rgba(255,107,53,.14);
            --accent:      #2D3561;
            --bg:          #F7F4F0;
            --surface:     #FFFFFF;
            --surface2:    #FAF8F5;
            --border:      #EDE8E0;
            --border-s:    #DDD7CE;
            --text:        #1A1714;
            --text-sub:    #7A736B;
            --text-light:  #B5AFA8;
            --danger:      #E84545;
            --danger-bg:   rgba(232,69,69,.08);
            --success:     #00B894;
            --success-bg:  rgba(0,184,148,.1);
            --font:        'Sora','Noto Sans Khmer',sans-serif;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: var(--font);
            min-height: 100vh;
            background: var(--bg);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background-image: radial-gradient(circle, #DDD7CE 1px, transparent 1px);
            background-size: 28px 28px;
        }

        /* ── Wrapper ── */
        .fp-wrap {
            width: 100%;
            max-width: 440px;
            display: flex;
            flex-direction: column;
        }

        /* ── Brand bar — identical to Login & ResetPassword ── */
        .fp-brand {
            background: var(--accent);
            border-radius: 22px 22px 0 0;
            padding: 28px 32px 24px;
            display: flex;
            align-items: center;
            gap: 16px;
            position: relative;
            overflow: hidden;
        }
        .fp-brand::before,
        .fp-brand::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
            pointer-events: none;
        }
        .fp-brand::before { width: 200px; height: 200px; top: -80px; right: -40px; }
        .fp-brand::after  { width: 120px; height: 120px; bottom: -50px; left: 160px; }

        .brand-icon {
            width: 48px; height: 48px;
            border-radius: 14px;
            background: var(--brand);
            display: flex; align-items: center; justify-content: center;
            font-size: 22px; color: #fff;
            flex-shrink: 0; z-index: 1;
            box-shadow: 0 4px 16px rgba(255,107,53,.4);
        }
        .brand-text { z-index: 1; }
        .brand-text h2 {
            font-size: 18px; font-weight: 700; color: #fff;
            margin: 0 0 2px; letter-spacing: -.3px;
        }
        .brand-text p {
            font-size: 12px; color: rgba(255,255,255,.55);
            font-weight: 500; margin: 0;
        }

        /* ── Card ── */
        .fp-card {
            background: var(--surface);
            border-radius: 0 0 22px 22px;
            border: 1.5px solid var(--border);
            border-top: none;
            padding: 32px 32px 28px;
            box-shadow: 0 16px 48px rgba(26,23,20,.13);
        }

        /* ── Greeting ── */
        .fp-greeting { margin-bottom: 24px; }
        .fp-greeting h3 {
            font-size: 20px; font-weight: 700; color: var(--text);
            margin: 0 0 4px; letter-spacing: -.4px;
        }
        .fp-greeting p { font-size: 13px; color: var(--text-light); font-weight: 500; margin: 0; }

        /* ── How it works strip ── */
        .fp-how {
            display: flex;
            gap: 0;
            margin-bottom: 26px;
            background: var(--surface2);
            border: 1.5px solid var(--border);
            border-radius: 12px;
            padding: 14px 16px;
        }
        .fp-how-step {
            display: flex; flex-direction: column; align-items: center;
            gap: 5px; flex: 1; text-align: center;
        }
        .fp-how-icon {
            width: 32px; height: 32px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 13px;
        }
        .fp-how-icon.s1 { background: var(--brand-light); color: var(--brand); }
        .fp-how-icon.s2 { background: rgba(45,53,97,.1);  color: var(--accent); }
        .fp-how-icon.s3 { background: var(--success-bg);  color: var(--success); }
        .fp-how-label { font-size: 10px; font-weight: 600; color: var(--text-light); line-height: 1.3; }
        .fp-how-arrow {
            font-size: 12px; color: var(--border-s);
            display: flex; align-items: center;
            padding-bottom: 14px;
            flex-shrink: 0;
        }

        /* ── Success alert ── */
        .fp-success {
            display: flex; align-items: flex-start; gap: 12px;
            background: var(--success-bg);
            border: 1px solid rgba(0,184,148,.2);
            border-left: 3px solid var(--success);
            border-radius: 10px;
            padding: 14px 16px;
            margin-bottom: 20px;
            font-size: 13px; color: var(--success); font-weight: 500;
        }
        .fp-success i { font-size: 18px; flex-shrink: 0; margin-top: 1px; }
        .fp-success-body strong { font-weight: 700; display: block; margin-bottom: 2px; }
        .fp-success-body span { font-size: 12px; color: var(--text-sub); font-weight: 400; }

        /* ── Field ── */
        .fp-field { margin-bottom: 20px; }
        .fp-label {
            display: block;
            font-size: 12px; font-weight: 600;
            color: var(--text-sub); margin-bottom: 7px;
        }

        .fp-input-wrap {
            display: flex; align-items: center;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            background: var(--surface2);
            overflow: hidden;
            transition: border-color .15s, box-shadow .15s;
        }
        .fp-input-wrap:focus-within {
            border-color: var(--brand);
            box-shadow: 0 0 0 3px var(--brand-mid);
            background: var(--surface);
        }

        .fp-input-icon {
            width: 44px; height: 46px;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px; color: var(--text-light);
            flex-shrink: 0;
            border-right: 1.5px solid var(--border);
            background: var(--surface);
            transition: color .15s, border-color .15s;
        }
        .fp-input-wrap:focus-within .fp-input-icon { color: var(--brand); border-color: var(--brand); }

        .fp-input {
            flex: 1; height: 46px; padding: 0 14px;
            border: none; background: none; outline: none;
            font-family: var(--font); font-size: 13px; color: var(--text);
        }
        .fp-input::placeholder { color: var(--text-light); }

        /* ── Submit ── */
        .btn-send {
            width: 100%; height: 48px;
            background: var(--brand); color: #fff;
            border: none; border-radius: 12px;
            font-family: var(--font); font-size: 14px; font-weight: 700;
            cursor: pointer; letter-spacing: .01em;
            display: flex; align-items: center; justify-content: center; gap: 8px;
            box-shadow: 0 5px 20px rgba(255,107,53,.35);
            transition: all .18s;
        }
        .btn-send:hover { background: var(--brand-dark); transform: translateY(-1px); box-shadow: 0 8px 28px rgba(255,107,53,.4); }
        .btn-send:active { transform: translateY(0); }

        /* ── Back link ── */
        .fp-back {
            text-align: center; margin-top: 20px;
        }
        .fp-back a {
            font-size: 12px; font-weight: 600;
            color: var(--text-light); text-decoration: none;
            display: inline-flex; align-items: center; gap: 5px;
            transition: color .15s;
        }
        .fp-back a:hover { color: var(--brand); }

        /* ── Footer ── */
        .fp-footer {
            text-align: center; margin-top: 22px;
            font-size: 12px; font-weight: 500; color: var(--text-light);
            display: flex; align-items: center; justify-content: center; gap: 6px;
        }
        .fp-footer span { color: var(--brand); font-weight: 700; }

        /* ── Responsive ── */
        @@media (max-width: 480px) {
        .fp-brand { padding: 22px 22px 20px; }
        .fp-card  { padding: 24px 22px 22px; }
        .fp-wrap  { max-width: 100%; }
        }
    </style>
</head>
<body>

<div class="fp-wrap">

    <!-- Brand header — same as Login & ResetPassword -->
    <div class="fp-brand">
        <div class="brand-icon">
            <i class="bi bi-key-fill"></i>
        </div>
        <div class="brand-text">
            <h2>Sandoo House</h2>
            <p>Admin Management System</p>
        </div>
    </div>

    <!-- Card -->
    <div class="fp-card">

        <div class="fp-greeting">
            <h3>Forgot your password? 🔑</h3>
            <p>No worries — we'll send you a reset link instantly</p>
        </div>

        <!-- How it works -->
        <div class="fp-how">
            <div class="fp-how-step">
                <div class="fp-how-icon s1"><i class="bi bi-envelope-fill"></i></div>
                <span class="fp-how-label">Enter email</span>
            </div>
            <div class="fp-how-arrow"><i class="bi bi-chevron-right"></i></div>
            <div class="fp-how-step">
                <div class="fp-how-icon s2"><i class="bi bi-inbox-fill"></i></div>
                <span class="fp-how-label">Check inbox</span>
            </div>
            <div class="fp-how-arrow"><i class="bi bi-chevron-right"></i></div>
            <div class="fp-how-step">
                <div class="fp-how-icon s3"><i class="bi bi-shield-check-fill"></i></div>
                <span class="fp-how-label">Reset password</span>
            </div>
        </div>

        <!-- Success message -->
        @if (TempData["Message"] != null)
        {
        <div class="fp-success" id="successAlert">
            <i class="bi bi-check-circle-fill"></i>
            <div class="fp-success-body">
                <strong>Email sent successfully!</strong>
                <span>@TempData["Message"]</span>
            </div>
        </div>
        }

        <!-- Form -->
        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            <div class="fp-field">
                <label class="fp-label">Email Address</label>
                <div class="fp-input-wrap">
                    <span class="fp-input-icon"><i class="bi bi-envelope"></i></span>
                    <input type="email"
                           name="Email"
                           class="fp-input"
                           placeholder="name@example.com"
                           required autocomplete="email" />
                </div>
            </div>

            <button type="submit" class="btn-send">
                <i class="bi bi-send-fill"></i>
                Send Reset Link
            </button>
        </form>

        <!-- Back -->
        <div class="fp-back">
            <a asp-controller="Home" asp-action="Login">
                <i class="bi bi-arrow-left"></i> Back to login
            </a>
        </div>

        <!-- Footer -->
        <div class="fp-footer">
            <i class="bi bi-c-circle"></i>
            2026 <span>Sandoo House</span> · All rights reserved
        </div>

    </div><!-- /.fp-card -->
</div><!-- /.fp-wrap -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Auto-fade success alert
    const sa = document.getElementById('successAlert');
    if (sa) setTimeout(() => { sa.style.transition = 'opacity .4s'; sa.style.opacity = '0'; setTimeout(() => sa.remove(), 400); }, 4000);
</script>

</body>
</html>
