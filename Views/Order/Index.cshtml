@section Scripts {
<script>
// ══════════════════════════════════════════════
//  DATA FROM SERVER
// ══════════════════════════════════════════════
const DAYS_IN_MONTH = @daysInMonth;
const MONTH_NAME    = "@curMonthName";
const DAILY_REVENUE = @Html.Raw("[" + string.Join(",", Enumerable.Range(1, daysInMonth).Select(d => dailyRevenue[d].ToString("F2", System.Globalization.CultureInfo.InvariantCulture))) + "]");
const DAILY_COUNTS  = @Html.Raw("[" + string.Join(",", Enumerable.Range(1, daysInMonth).Select(d => dailyCount[d])) + "]");
const STATUS_DATA   = [@mPaid, @mPending, @mCanceled];

// ══════════════════════════════════════════════
//  CHART 1 — Daily Revenue Bar Chart
// ══════════════════════════════════════════════
(function(){
    const labels = Array.from({length: DAYS_IN_MONTH}, (_, i) => String(i + 1));
    const ctx    = document.getElementById("dailyRevenueChart").getContext("2d");

    const grad = ctx.createLinearGradient(0, 0, 0, 280);
    grad.addColorStop(0,   "rgba(102,126,234,0.75)");
    grad.addColorStop(0.5, "rgba(118,75,162,0.55)");
    grad.addColorStop(1,   "rgba(102,126,234,0.08)");

    new Chart(ctx, {
        type: "bar",
        data: {
            labels,
            datasets: [{
                label: "Revenue",
                data:  DAILY_REVENUE,
                backgroundColor: grad,
                borderColor: "#667eea",
                borderWidth: 1.5,
                borderRadius: 6,
                borderSkipped: false,
                hoverBackgroundColor: "rgba(118,75,162,0.85)"
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: "#1e2340",
                    titleColor: "#fff",
                    bodyColor: "rgba(255,255,255,0.75)",
                    padding: 10,
                    cornerRadius: 10,
                    callbacks: {
                        title: ctx => "Day " + ctx[0].label,
                        label: ctx => " Revenue: $" + parseFloat(ctx.parsed.y).toFixed(2),
                        afterLabel: ctx => {
                            const c = DAILY_COUNTS[ctx.dataIndex];
                            return c > 0 ? " Orders: " + c : "";
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { font: { size: 11 }, color: "#9ca3b0",
                             callback: (v, i) => (i % 5 === 0 || i === DAYS_IN_MONTH - 1) ? labels[i] : "" }
                },
                y: {
                    grid: { color: "#f0f4fb", drawBorder: false },
                    ticks: { font: { size: 11 }, color: "#9ca3b0", callback: v => "$" + v }
                }
            }
        }
    });
})();

// ══════════════════════════════════════════════
//  CHART 2 — Status Doughnut
// ══════════════════════════════════════════════
(function(){
    const total = STATUS_DATA[0] + STATUS_DATA[1] + STATUS_DATA[2];
    const ctx   = document.getElementById("statusChart").getContext("2d");
    new Chart(ctx, {
        type: "doughnut",
        data: {
            labels: ["Paid","Pending","Canceled"],
            datasets: [{
                data: total > 0 ? STATUS_DATA : [1, 0, 0],
                backgroundColor: ["#28a745","#ffc107","#dc3545"],
                borderWidth: 0,
                hoverOffset: 10
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            cutout: "72%",
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: "#1e2340",
                    titleColor: "#fff",
                    bodyColor: "rgba(255,255,255,0.75)",
                    cornerRadius: 10,
                    callbacks: {
                        label: ctx => {
                            const pct = total > 0 ? Math.round(ctx.parsed / total * 100) : 0;
                            return " " + ctx.label + ": " + ctx.parsed + " (" + pct + "%)";
                        }
                    }
                }
            }
        }
    });
})();

// ══════════════════════════════════════════════
//  PAGINATION
// ══════════════════════════════════════════════
$(document).ready(function(){
    let PAGE_SIZE   = 20;
    let currentPage = 1;
    let filteredRows = [];
    const allRows = $("#ordersTable tbody tr").toArray();

    function applyFilters(){
        const search   = $("#searchInput").val().toLowerCase().trim();
        const status   = $("#statusFilter").val().toLowerCase().trim();
        const dateVal  = $("#dateFilter").val();
        const now      = new Date();
        const today    = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const weekStart = new Date(today); weekStart.setDate(today.getDate() - today.getDay());
        const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);

        filteredRows = allRows.filter(function(row){
            const text = row.innerText.toLowerCase();
            if (search && !text.includes(search)) return false;
            if (status){
                const badge = $(row).find(".status-badge").text().toLowerCase().trim();
                if (!badge.includes(status)) return false;
            }
            if (dateVal){
                const rawDate = $(row).find(".date-main").text().trim();
                const rd = new Date(rawDate);
                if (!isNaN(rd)){
                    const rowDay = new Date(rd.getFullYear(), rd.getMonth(), rd.getDate());
                    if (dateVal==="today" && rowDay.getTime()!==today.getTime()) return false;
                    if (dateVal==="week"  && rowDay < weekStart)                 return false;
                    if (dateVal==="month" && rowDay < monthStart)                return false;
                }
            }
            return true;
        });
        currentPage = 1;
        renderPage();
    }

    function renderPage(){
        const total      = filteredRows.length;
        const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
        currentPage      = Math.min(currentPage, totalPages);
        const start      = (currentPage - 1) * PAGE_SIZE;
        const end        = Math.min(start + PAGE_SIZE, total);
        allRows.forEach(r => $(r).hide());
        filteredRows.slice(start, end).forEach(r => $(r).show());
        $("#visibleCount").text(total + " total");
        $("#showingText").html(total === 0
            ? "No entries found"
            : "Showing <strong>" + (start+1) + "–" + end + "</strong> of <strong>" + total + "</strong> entries");
        renderPager(totalPages);
    }

    function renderPager(totalPages){
        const $p = $("#pager").empty();
        $p.append(makePage("‹ Prev", currentPage-1, currentPage===1));
        const W = 2;
        const rs = Math.max(1, currentPage-W);
        const re = Math.min(totalPages, currentPage+W);
        if (rs > 1){ $p.append(makePage("1",1,false)); if(rs>2) $p.append(ellipsis()); }
        for (let p=rs; p<=re; p++) $p.append(makePage(String(p), p, false, p===currentPage));
        if (re < totalPages){ if(re<totalPages-1) $p.append(ellipsis()); $p.append(makePage(String(totalPages),totalPages,false)); }
        $p.append(makePage("Next ›", currentPage+1, currentPage===totalPages));
    }

    function ellipsis(){ return $('<li class="page-item disabled"><span class="page-lnk">…</span></li>'); }

    function makePage(label, target, disabled, isActive){
        const $li = $('<li class="page-item"></li>');
        if (disabled) $li.addClass("disabled");
        if (isActive)  $li.addClass("active");
        const $a = $('<a class="page-lnk" href="#">' + label + '</a>');
        if (!disabled && !isActive){
            $a.on("click", function(e){
                e.preventDefault();
                currentPage = target;
                renderPage();
                document.querySelector(".table-card").scrollIntoView({behavior:"smooth",block:"start"});
            });
        } else { $a.on("click", e => e.preventDefault()); }
        $li.append($a);
        return $li;
    }

    let searchTimer;
    $("#searchInput").on("input", function(){ clearTimeout(searchTimer); searchTimer = setTimeout(applyFilters, 250); });
    $("#statusFilter,#dateFilter").on("change", applyFilters);
    $("#pageSizeSelect").on("change", function(){ PAGE_SIZE = parseInt(this.value); applyFilters(); });
    $("#clearFilters").on("click", function(){
        $("#searchInput").val(""); $("#statusFilter").val(""); $("#dateFilter").val("");
        applyFilters();
    });
    applyFilters();
});

// ══════════════════════════════════════════════
//  PDF DOWNLOAD (jsPDF + autoTable)
// ══════════════════════════════════════════════
async function downloadPDF(){
    document.getElementById("pdfOverlay").classList.add("show");
    await new Promise(r => setTimeout(r, 50)); // let overlay render

    try {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: "landscape", unit: "mm", format: "a4" });

        const now     = new Date();
        const months  = ["January","February","March","April","May","June","July","August","September","October","November","December"];
        const curMon  = months[now.getMonth()] + " " + now.getFullYear();
        const printed = now.toLocaleDateString("en-GB", {day:"2-digit",month:"short",year:"numeric"}) +
                        " " + now.toLocaleTimeString("en-US", {hour:"2-digit",minute:"2-digit"});

        // ── Header band ──
        doc.setFillColor(102, 126, 234);
        doc.rect(0, 0, 297, 22, "F");
        doc.setTextColor(255,255,255);
        doc.setFontSize(16); doc.setFont("helvetica","bold");
        doc.text("Order Management Report", 14, 10);
        doc.setFontSize(9); doc.setFont("helvetica","normal");
        doc.text("Generated: " + printed, 14, 16);
        doc.text("Period: All orders up to " + curMon, 297 - 14, 16, { align:"right" });

        // ── KPI summary boxes ──
        const allRows  = document.querySelectorAll("#ordersTable tbody tr");
        let totalOrders = 0, totalRevenue = 0, totalDiscount = 0;
        allRows.forEach(row => {
            const tot  = parseFloat(row.getAttribute("data-total")?.replace("$","")) || 0;
            totalOrders++;
            totalRevenue += tot;
        });
        // get discount from stat card text
        const discText = document.querySelector(".stat-blue .stat-value")?.innerText || "$0.00";
        totalDiscount  = parseFloat(discText.replace("$","").replace(",","")) || 0;
        const avgOrder = totalOrders > 0 ? (totalRevenue / totalOrders) : 0;

        const kpis = [
            { label:"Total Orders",   val: String(totalOrders) },
            { label:"Total Revenue",  val: "$" + totalRevenue.toFixed(2) },
            { label:"Avg. Order",     val: "$" + avgOrder.toFixed(2) },
            { label:"Total Discount", val: "$" + totalDiscount.toFixed(2) }
        ];
        const kpiW = (297 - 28 - 9) / 4;
        const colors = [[102,126,234],[40,167,69],[23,162,184],[255,193,7]];
        kpis.forEach((k,i) => {
            const x = 14 + i*(kpiW+3);
            doc.setFillColor(...colors[i]);
            doc.roundedRect(x, 26, kpiW, 18, 3, 3, "F");
            doc.setTextColor(255,255,255);
            doc.setFontSize(8); doc.setFont("helvetica","normal");
            doc.text(k.label.toUpperCase(), x+4, 32);
            doc.setFontSize(13); doc.setFont("helvetica","bold");
            doc.text(k.val, x+4, 40);
        });

        // ── Month chart summary (daily text) ──
        doc.setTextColor(30,35,64);
        doc.setFontSize(9); doc.setFont("helvetica","bold");
        doc.text("Monthly Summary (" + MONTH_NAME + ")", 14, 52);
        doc.setDrawColor(230,232,244); doc.setLineWidth(0.3);
        doc.line(14, 54, 283, 54);

        // daily mini table
        const dayLabels = DAILY_REVENUE
            .map((v, i) => v > 0 ? { day: i+1, rev: v, cnt: DAILY_COUNTS[i] } : null)
            .filter(Boolean);

        if (dayLabels.length > 0){
            doc.autoTable({
                startY: 56,
                head: [["Day","Orders","Revenue ($)"]],
                body: dayLabels.map(d => [d.day, d.cnt, "$" + d.rev.toFixed(2)]),
                styles: { fontSize:8, cellPadding:2 },
                headStyles: { fillColor:[102,126,234], textColor:255, fontStyle:"bold", fontSize:8 },
                columnStyles: { 0:{cellWidth:15}, 1:{cellWidth:18}, 2:{cellWidth:28} },
                tableWidth: 65,
                margin: { left:14 },
                theme: "striped",
                alternateRowStyles: { fillColor:[246,248,255] }
            });
        }

        // ── Orders table ──
        const tableStartY = (doc.lastAutoTable?.finalY || 56) + 8;
        doc.setFontSize(9); doc.setFont("helvetica","bold"); doc.setTextColor(30,35,64);
        doc.text("Order Details", 14, tableStartY - 2);

        // Collect all visible rows from DOM (respecting current filter)
        const visibleRows = Array.from(document.querySelectorAll("#ordersTable tbody tr"))
            .filter(r => r.style.display !== "none");

        const tableBody = visibleRows.map((row, idx) => {
            const cells = row.querySelectorAll("td");
            const orderText = cells[0]?.querySelector(".order-num")?.innerText || "";
            const idText    = cells[0]?.querySelector(".order-id")?.innerText || "";
            const date      = cells[1]?.querySelector(".date-main")?.innerText || "";
            const time      = cells[1]?.querySelector(".date-time")?.innerText || "";
            const items     = cells[2]?.innerText?.trim() || "";
            const total     = cells[3]?.innerText?.trim() || "";
            const status    = cells[4]?.querySelector(".status-badge")?.innerText?.trim() || "";
            const cash      = cells[5]?.querySelector(".pay-row:first-child .pay-amt")?.innerText || "";
            const change    = cells[5]?.querySelector(".pay-row.muted .pay-amt")?.innerText || "";
            return [idx+1, orderText + "\n" + idText, date + "\n" + time, items, total, status, cash, change];
        });

        doc.autoTable({
            startY: tableStartY + 2,
            head: [["#","Order No.","Date & Time","Items","Total","Status","Cash","Change"]],
            body: tableBody,
            styles: { fontSize:8, cellPadding:3, overflow:"linebreak" },
            headStyles: { fillColor:[102,126,234], textColor:255, fontStyle:"bold", fontSize:8 },
            columnStyles: {
                0:{ cellWidth:8,  halign:"center" },
                1:{ cellWidth:42 },
                2:{ cellWidth:32 },
                3:{ cellWidth:20, halign:"center" },
                4:{ cellWidth:24, halign:"right" },
                5:{ cellWidth:24, halign:"center" },
                6:{ cellWidth:24, halign:"right" },
                7:{ cellWidth:24, halign:"right" }
            },
            theme: "striped",
            alternateRowStyles: { fillColor:[246,248,255] },
            didParseCell: function(data){
                if (data.section === "body" && data.column.index === 5){
                    const txt = (data.cell.raw || "").toLowerCase();
                    if      (txt.includes("paid"))     data.cell.styles.textColor = [10,103,65];
                    else if (txt.includes("pending"))  data.cell.styles.textColor = [122,82,0];
                    else if (txt.includes("cancel"))   data.cell.styles.textColor = [139,0,0];
                }
            },
            // Footer totals row
            foot: [["","","","","$" + visibleRows.reduce((s,r) => {
                const t = parseFloat(r.getAttribute("data-total")?.replace("$","")) || 0;
                return s + t;
            }, 0).toFixed(2),"","",""]],
            footStyles: { fillColor:[240,244,255], textColor:[30,35,64], fontStyle:"bold", fontSize:8 }
        });

        // page numbers
        const pageCount = doc.internal.getNumberOfPages();
        for (let i=1; i<=pageCount; i++){
            doc.setPage(i);
            doc.setFontSize(8); doc.setTextColor(155,163,176); doc.setFont("helvetica","normal");
            doc.text("Page " + i + " of " + pageCount, 297-14, 205, { align:"right" });
            doc.text("ផ្ទុះបាយសេនឌូ — Order Report", 14, 205);
        }

        // ── Save ──
        const fname = "orders-" + now.getFullYear() + "-" + String(now.getMonth()+1).padStart(2,"0") + ".pdf";
        doc.save(fname);

    } catch(err){
        console.error("PDF error:", err);
        alert("PDF generation failed: " + err.message);
    } finally {
        document.getElementById("pdfOverlay").classList.remove("show");
    }
}

