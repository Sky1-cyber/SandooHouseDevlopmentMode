<script>
    /* ── exposed so shift observer can read it ── */
    window.lastOrder = null;
    let customerWindow = null;
    let customerDisplayAutoOpen = false;

    function showLogoutModal() {
        document.getElementById('logoutModal').style.display = 'flex';
    }

    /* ════════════════════════════════════════════════════════════
       CUSTOMER DISPLAY — ALWAYS ON SECOND MONITOR
    ════════════════════════════════════════════════════════════ */

    // Function to get second screen coordinates
    async function getSecondScreenCoordinates() {
        try {
            // Try to get screen details using modern API
            if (window.getScreenDetails) {
                const details = await window.getScreenDetails();
                if (details.screens.length > 1) {
                    const secondScreen = details.screens.find(s => !s.isPrimary) || details.screens[1];
                    if (secondScreen) {
                        return {
                            left: secondScreen.availLeft !== undefined ? secondScreen.availLeft : (secondScreen.left || 0),
                            top: secondScreen.availTop !== undefined ? secondScreen.availTop : (secondScreen.top || 0),
                            width: secondScreen.availWidth !== undefined ? secondScreen.availWidth : (secondScreen.width || 1024),
                            height: secondScreen.availHeight !== undefined ? secondScreen.availHeight : (secondScreen.height || 768)
                        };
                    }
                }
            }

            // Fallback: try to detect second monitor by checking if screen width is larger than window
            if (window.screen.availWidth > window.screen.width) {
                return {
                    left: window.screen.width,
                    top: 0,
                    width: window.screen.availWidth - window.screen.width,
                    height: window.screen.availHeight
                };
            }

            // Default: place on right side of primary monitor
            return {
                left: window.screen.availWidth,
                top: 0,
                width: 1024,
                height: 768
            };
        } catch(e) {
            console.warn('Error detecting second screen:', e);
            return {
                left: window.screen.availWidth,
                top: 0,
                width: 1024,
                height: 768
            };
        }
    }

    // Open customer display on second monitor
    async function openCustomerDisplay() {
        const coords = await getSecondScreenCoordinates();
        const w = coords.width;
        const h = coords.height;
        const left = coords.left;
        const top = coords.top;

        if (customerWindow && !customerWindow.closed) {
            // Try to move existing window to second monitor
            try {
                customerWindow.moveTo(left, top);
                customerWindow.resizeTo(w, h);
                customerWindow.focus();
            } catch(e) {
                console.warn('Cannot move existing window, reopening');
                customerWindow.close();
                customerWindow = null;
            }
        }

        if (!customerWindow || customerWindow.closed) {
            customerWindow = window.open(
                '', 'SandooCustomerDisplay',
                'width='+w+',height='+h+',left='+left+',top='+top+
                ',resizable=yes,scrollbars=no,toolbar=no,menubar=no,location=no,status=no'
            );

            if (!customerWindow) {
                notify('Browser ទប់ Popup — សូម Allow popup', 'error');
                return false;
            }

            customerWindow.document.open();
            customerWindow.document.write(buildCustomerWindowHtml());
            customerWindow.document.close();

            // Update status indicator
            document.getElementById('customerScreenStatus').innerHTML = '🟢';
            document.getElementById('customerScreenBtn').classList.add('shift-open');

            // Watch for close
            var checkClosed = setInterval(function() {
                if (!customerWindow || customerWindow.closed) {
                    clearInterval(checkClosed);
                    customerWindow = null;
                    document.getElementById('customerScreenStatus').innerHTML = '🔴';
                    document.getElementById('customerScreenBtn').classList.remove('shift-open');

                    // Auto-reopen if shift is still open
                    if (customerDisplayAutoOpen && shift.isOpen) {
                        setTimeout(() => openCustomerDisplay(), 2000);
                    }
                }
            }, 1000);
        }

        return true;
    }

    // Close customer display
    function closeCustomerDisplay() {
        if (customerWindow && !customerWindow.closed) {
            customerWindow.close();
        }
        customerWindow = null;
        document.getElementById('customerScreenStatus').innerHTML = '🔴';
        document.getElementById('customerScreenBtn').classList.remove('shift-open');
    }

    // Toggle customer display
    async function toggleCustomerDisplay() {
        if (customerWindow && !customerWindow.closed) {
            closeCustomerDisplay();
            customerDisplayAutoOpen = false;
        } else {
            await openCustomerDisplay();
            customerDisplayAutoOpen = true;
        }
    }

    // Keep customer display alive while shift is open
    function maintainCustomerDisplay() {
        if (shift.isOpen && customerDisplayAutoOpen) {
            if (!customerWindow || customerWindow.closed) {
                openCustomerDisplay();
            } else {
                // Keep it on second monitor
                getSecondScreenCoordinates().then(coords => {
                    try {
                        customerWindow.moveTo(coords.left, coords.top);
                        customerWindow.resizeTo(coords.width, coords.height);
                    } catch(e) {}
                });
            }
        }
        setTimeout(maintainCustomerDisplay, 5000);
    }

    function postToCustomer(data) {
        if (customerWindow && !customerWindow.closed) {
            try { customerWindow.postMessage(data, '*'); } catch(e) {}
        }
    }

