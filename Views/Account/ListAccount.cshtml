@model IEnumerable<Admin>
@using Sandoohouse.Models.Enum
@using System.Globalization

@{
    ViewData["Title"] = "Account List";
}
<style>
    .card {
        transition: 0.2s;
    }

    .card:hover {
        transform: translateY(-2px);
    }

    .table td, .table th {
        vertical-align: middle;
    }

    .table-hover tbody tr:hover {
        background-color: #f8fafc;
    }

    .badge {
        font-weight: 500;
        font-size: 13px;
    }

    .btn-light {
        background: #fff;
    }

    .btn-light:hover {
        background: #f1f5f9;
    }
</style>
<div class="page-inner">
    <div class="page-header d-flex justify-content-between align-items-center">
        <h3 class="fw-bold mb-3">Account Table</h3>
        <ul class="breadcrumbs mb-3">
            <li class="nav-home">
                <a asp-controller="Home" asp-action="Index"><i class="icon-home"></i></a>
            </li>
            <li class="separator"><i class="icon-arrow-right"></i></li>
            <li class="nav-item"><a asp-controller="Account" asp-action="ListAccount">Account Table</a></li>
        </ul>
        <div class="ms-md-auto py-2 py-md-0">
            <a asp-controller="Account" asp-action="CreateAccount" class="btn btn-primary btn-round">Add Account</a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow border-0 rounded-4">

                <!-- Header -->
                <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold mb-0">Admin Management</h4>
                        <small class="text-muted">Manage system administrators</small>
                    </div>
                </div>

                <!-- Body -->
                <div class="card-body bg-dark-subtle pt-0">

                    <div class="table-responsive">

                        <table id="adminTable" class="table align-middle table-hover">

                            <thead class="table-light">
                            <tr>
                                <th>Admin</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-center">Actions</th>
                            </tr>
                            </thead>

                            <tbody>

                            @foreach (var admin in Model)
                            {
                                <tr>

                                    <!-- Profile -->
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@Url.Content(admin.ProfileImageFile != null ? $"~/Admin/{admin.ProfileImageFile}" : "~/l60Hf.png")"
                                                 alt="@admin.ProfileImageFile"
                                                 class="rounded-circle shadow-sm me-3"
                                                 style="width:45px;height:45px;object-fit:cover; position: relative;" />

                                            <div>
                                                <div class="fw-semibold">
                                                    @admin.FirstName @admin.LastName
                                                    @if (admin.IsOnline)
                                                    {
                                                        <span class="badge bg-success ms-2" style="font-size:0.7rem;">Online</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary ms-2" style="font-size:0.7rem;">Offline</span>
                                                    }
                                                </div>

                                                <small class="text-muted">
                                                    ID: #@admin.Id
                                                </small>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Email -->
                                    <td>
                                        <span class="text-muted">@admin.Email</span>
                                    </td>

                                    <!-- Phone -->
                                    <td>
                                        @(string.IsNullOrEmpty(admin.PhoneNumber) ? "N/A" : admin.PhoneNumber)
                                    </td>

                                    <!-- Status -->
                                    <td>
                                        @if (admin.Status == Status.Active)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                            <i class="fas fa-check-circle me-1"></i> Active
                                        </span>
                                        }
                                        else if (admin.Status == Status.Inactive)
                                        {
                                            <span
                                                class="badge rounded-pill bg-secondary-subtle text-secondary px-3 py-2">
                                            <i class="fas fa-user-clock me-1"></i> Inactive
                                        </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">
                                            <i class="fas fa-ban me-1"></i> Suspended
                                        </span>
                                        }
                                    </td>

                                    <!-- Created -->
                                    <td>
                                        <span class="text-muted">
                                            @admin.CreatedAt.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture)
                                        </span>
                                    </td>
                                    <td class="text-center">

                                        <!-- Desktop Buttons -->
                                        <div class="d-none d-md-inline-block">

                                            <a asp-controller="Account"
                                               asp-action="EditAccount"
                                               asp-route-id="@admin.Id"
                                               class="btn btn-sm btn-light border me-1"
                                               title="Edit">
                                                <i class="fas fa-edit text-primary"></i>
                                            </a>

                                            <form method="post"
                                                  asp-action="Delete"
                                                  asp-route-id="@admin.Id"
                                                  class="d-inline"
                                                  onsubmit="return confirmDelete(this);">

                                                <button type="submit"
                                                        class="btn btn-sm btn-light border"
                                                        title="Delete">
                                                    <i class="fas fa-trash text-danger"></i>
                                                </button>

                                            </form>

                                        </div>

                                        <!-- Mobile Dropdown -->
                                        <div class="dropdown d-md-none">

                                            <button class="btn btn-sm btn-light border"
                                                    type="button"
                                                    data-bs-toggle="dropdown">
                                                <i class="fas fa-ellipsis-h"></i>
                                            </button>

                                            <ul class="dropdown-menu dropdown-menu-end shadow">

                                                <li>
                                                    <a class="dropdown-item"
                                                       asp-controller="Account"
                                                       asp-action="EditAccount"
                                                       asp-route-id="@admin.Id">

                                                        <i class="fas fa-edit text-primary me-2"></i>
                                                        Edit
                                                    </a>
                                                </li>

                                                <li>
                                                    <form method="post"
                                                          asp-action="Delete"
                                                          asp-route-id="@admin.Id"
                                                          onsubmit="return confirmDelete(this);">

                                                        <button type="submit" class="dropdown-item text-danger">

                                                            <i class="fas fa-trash me-2"></i>
                                                            Delete

                                                        </button>

                                                    </form>
                                                </li>

                                            </ul>

                                        </div>

                                    </td>
                                </tr>
                            }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this admin? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>
<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css"/>
<script src="~/assets/js/plugin/datatables/datatables.min.js"></script>
<script>
    let formToSubmit;

    // Show delete modal
    function confirmDelete(form) {
        formToSubmit = form;
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
        return false;
    }

    // Confirm delete
    document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
        if (formToSubmit) {
            formToSubmit.submit();
        }
    });

    // DataTable
    $(document).ready(function () {
        $('#adminTable').DataTable({
            pageLength: 10,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,
            columnDefs: [
                {orderable: false, targets: [0, 6]}
            ]
        });
    });
</script>