@model Sandoohouse.Models.Admin
@using Sandoohouse.Models.Enum
@{
    ViewData["Title"] = "Edit Account";
}

<div class="page-inner">
    <div class="page-header">
        <h3 class="fw-bold mb-3">Edit Profile</h3>
        <ul class="breadcrumbs mb-3">
            <li class="nav-home">
                <a asp-controller="Home" asp-action="Index">
                    <i class="icon-home"></i>
                </a>
            </li>
            <li class="separator">
                <i class="icon-arrow-right"></i>
            </li>
            <li class="nav-item">
                <a asp-controller="Account" asp-action="ListAccount">Account</a>
            </li>
            <li class="separator">
                <i class="icon-arrow-right"></i>
            </li>
            <li class="nav-item">Edit Account</li>
        </ul>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg bg-dark-subtle">
                <div class="card-body">

                    <form asp-controller="Account" asp-action="EditAccount" method="post" enctype="multipart/form-data">

                        <input type="hidden" asp-for="Id"/>

                        <!-- Profile Image -->
                        <div class="text-center mb-3">
                            <img id="previewImage"
                                 src="@Url.Content(Model.ProfileImageFile != null ? $"~/Admin/{Model.ProfileImageFile}" : "~/l60Hf.png")"
                                 class="rounded-circle"
                                 alt="Admin Image"
                                 style="width:100px;height:100px;object-fit:cover;" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Change Profile Image</label>
                            <input type="file" name="ProfileImageUrl" class="form-control" onchange="previewFile(event)" />
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label class="form-label">First Name</label>
                                <input asp-for="FirstName" class="form-control"/>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Last Name</label>
                                <input asp-for="LastName" class="form-control"/>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Email</label>
                                <input asp-for="Email" class="form-control"/>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Phone</label>
                                <input asp-for="PhoneNumber" class="form-control"/>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">New Password (Optional)</label>
                                <div class="input-group">
                                    <input type="password" name="Password" id="password" class="form-control"/>
                                    <span class="input-group-text" style="cursor:pointer;"
                                          onclick="togglePassword('password','toggleIcon')">
                                        <i class="bi bi-eye" id="toggleIcon"></i>
                                    </span>
                                </div>
                                <small class="text-muted">Leave empty if you don't want to change password</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-group">
                                    <label class="form-label">Status</label>

                                    <div class="selectgroup w-100">

                                        @foreach (var status in Enum.GetValues(typeof(Status)).Cast<Status>())
                                        {
                                            <label class="selectgroup-item">
                                                <input type="radio"
                                                       asp-for="Status"
                                                       value="@status"
                                                       class="selectgroup-input" />

                                                <span class="selectgroup-button">
                                                    @status
                                                </span>
                                            </label>
                                        }

                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-md-6">
                                <button type="submit" class="btn btn-primary w-100">
                                    Update Account
                                </button>
                            </div>

                            <div class="col-md-6">
                                <a asp-controller="Account" asp-action="ListAccount"
                                   class="btn btn-danger w-100">
                                    Cancel
                                </a>
                            </div>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

<script>
function previewFile(event) {
    const reader = new FileReader();
    reader.onload = () => document.getElementById("previewImage").src = reader.result;
    reader.readAsDataURL(event.target.files[0]);
}

function togglePassword(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);

    if (input.type === "password") {
        input.type = "text";
        icon.classList.replace("bi-eye", "bi-eye-slash");
    } else {
        input.type = "password";
        icon.classList.replace("bi-eye-slash", "bi-eye");
    }
}
</script>