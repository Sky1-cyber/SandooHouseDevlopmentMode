<!-- ── SCRIPTS ── -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
<script>
    /* ── exposed so shift observer can read it ── */
    window.lastOrder = null;

    function showLogoutModal() {
        document.getElementById('logoutModal').style.display = 'flex';
    }

    $(document).ready(function () {

        /* ═══════════════════════════════════════════════
           RATES & HELPERS
        ═══════════════════════════════════════════════ */
        const EXCHANGE_RATE        = 4100;
        const CHANGE_RATE_CUSTOMER = 4000;

        const toKhr       = usd => Math.round(usd * EXCHANGE_RATE);
        const fmtKhr      = n   => Math.round(n).toLocaleString() + ' ៛';
        const fmtUsd      = n   => '$' + parseFloat(n).toFixed(2);
        const roundKhr100 = khr => Math.round(khr / 100) * 100;

        function customerChangeKhr(changeUsd, changeKhr, payCurrency) {
            if (payCurrency === 'usd') return roundKhr100(changeUsd * CHANGE_RATE_CUSTOMER);
            return roundKhr100(changeKhr);
        }

        /* ── Live clocks ── */
        function updateClocks() {
            const now = new Date();
            const h   = now.getHours() % 12 || 12;
            const m   = String(now.getMinutes()).padStart(2, '0');
            const s   = String(now.getSeconds()).padStart(2, '0');
            const ap  = now.getHours() >= 12 ? 'PM' : 'AM';
            $('#liveClock').text(`${h}:${m} ${ap}`);
            $('#cdClock').text(`${String(now.getHours()).padStart(2,'0')}:${m}:${s}`);
        }
        setInterval(updateClocks, 1000);
        updateClocks();

        /* ── Products from server ── */
        const products = [
            @if (ViewBag.Menus != null)
            {
            var index = 0;
            string[] colors = { "#FF6B35","#E85520","#2D3561","#00B894","#FDCB6E","#6C5CE7","#0984E3","#E17055","#00CEC9","#A29BFE" };
            foreach (var menu in ViewBag.Menus)
            {
            var color = colors[index % colors.Length];
            string categoryName = menu.Category?.CategoryName ?? "Uncategorized";
            string brandName = menu.Category?.Brand?.BrandName ?? "Uncategorized";
            string imageUrl = menu.ImageMenuUrl ?? "";
            if (!string.IsNullOrEmpty(imageUrl) && !imageUrl.StartsWith("http") && !imageUrl.StartsWith("/"))
            imageUrl = "/Menu/" + imageUrl;
            <text>
            ,{
                id:@menu.Id,
                name: '@Html.Raw(menu.MenuName.Replace("'", "\\'"))',
                priceUsd:@((menu.Price - (menu.DiscountPrice ?? 0)).ToString("F2")),
                category: '@Html.Raw(categoryName.Replace("'", "\\'"))',
                categoryId:@(menu.CategoryId ?? 0),
                brand: '@Html.Raw(brandName.Replace("'", "\\'"))',
                brandId:@(menu.Category?.BrandId ?? 0),
                icon: '@Html.Raw(imageUrl)',
                color: '@color'
            },
            </text>
            index++;
            }
            }
        ];

        const categoriesByBrand = {};
        const allCategories     = [];
        products.forEach(p => {
            if (!categoriesByBrand[p.brand]) categoriesByBrand[p.brand] = new Set();
            categoriesByBrand[p.brand].add(p.category);
            if (!allCategories.includes(p.category)) allCategories.push(p.category);
        });

        let cart = [], currentPaymentMethod = 'cash', displayCurrency = 'usd', paymentCurrency = 'usd';
        let discountAmount = 0, discountType = 'fixed';
        let orderCounter = 4580, lastOrderLocal = null;
        let currentBrand = 'all', currentCategory = 'all';

        function calcDiscount(sub) {
            if (!discountAmount || discountAmount <= 0) return 0;
            return discountType === 'fixed'
                ? Math.min(discountAmount, sub)
                : Math.min(sub * discountAmount / 100, sub);
        }

        /* ════ CUSTOMER DISPLAY SYNC ════ */
        function syncCustomerDisplay() {
            const isEmpty = cart.length === 0;
            const pill = document.getElementById('cdPayCurrencyPill');
            if (pill) {
                pill.textContent = paymentCurrency === 'usd' ? 'USD' : 'KHR ៛';
                pill.className   = 'cd-pay-currency-pill ' + paymentCurrency;
            }
            $('#cdIdle').toggle(isEmpty);
            $('#cdOrderArea').toggle(!isEmpty);
            $('#cdSummaryFooter').toggle(!isEmpty);
            if (isEmpty) return;

            const sub   = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const disc  = calcDiscount(sub);
            const total = sub - disc;

            let html = '';
            cart.forEach(item => {
                const lineTotal = item.price * item.quantity;
                const imgHtml   = item.icon
                    ? `<img src="${item.icon}" alt="${item.name}" onerror="this.onerror=null;this.style.display='none';this.parentElement.innerHTML='<i class=\\'fas fa-utensils\\'></i>';">`
                    : '<i class="fas fa-utensils"></i>';
                html += `
<div class="cd-item" style="--item-color:${item.color}">
    <div class="cd-item-thumb" style="background:linear-gradient(135deg,${item.color},#2D3561)">${imgHtml}</div>
    <div class="cd-item-info">
        <div class="cd-item-name">${item.name}</div>
        <div class="cd-item-unit">${fmtUsd(item.price)} × ${item.quantity}</div>
    </div>
    <div class="cd-item-right">
        <div class="cd-item-qty">${item.quantity}</div>
        <div class="cd-item-total">${fmtUsd(lineTotal)}</div>
    </div>
</div>`;
            });
            $('#cdItemsList').html(html);

            const cdKhrRate = paymentCurrency === 'khr' ? CHANGE_RATE_CUSTOMER : EXCHANGE_RATE;
            const toKhrCd   = usd => roundKhr100(usd * cdKhrRate);

            $('#cdSubtotal').text(fmtUsd(sub));
            $('#cdSubtotalKhr').text(fmtKhr(toKhrCd(sub)));

            if (disc > 0) {
                const label = discountType === 'percentage' ? `បញ្ចុះ ${discountAmount}%` : 'បញ្ចុះ';
                $('#cdDiscountLabel').text(label);
                $('#cdDiscountVal').text('-' + fmtUsd(disc));
                $('#cdDiscountRow').show();
            } else {
                $('#cdDiscountRow').hide();
            }
            $('#cdTotal').text(fmtUsd(total));
            $('#cdTotalKhr').text(fmtKhr(toKhrCd(total)));

            if (qrWindow && !qrWindow.closed) updateQrWindow(total);
        }

        function updateQrWindow(totalUsd) {
            if (!qrWindow || qrWindow.closed) return;
            try {
                qrWindow.postMessage({
                    type: 'KHQR_UPDATE_AMOUNT',
                    usd:  fmtUsd(totalUsd),
                    khr:  fmtKhr(roundKhr100(toKhr(totalUsd)))
                }, '*');
            } catch(e) { console.warn('KHQR postMessage:', e.message); }
        }

        /* ════ CUSTOMER THANK-YOU ════ */
        function showCustomerThankYou(order) {
            $('#cdTyAmount').text(fmtUsd(order.total));
            if (order.paymentMethod === 'សាច់ប្រាក់' && order.changeUsd > 0) {
                $('#cdTyChangeUsd').text(fmtUsd(order.changeUsd));
                const khrChange = customerChangeKhr(order.changeUsd, order.changeKhr,
                    order.paymentCurrency === 'ដុល្លារ' ? 'usd' : 'khr');
                $('#cdTyChangeKhr').text(fmtKhr(khrChange));
                $('#cdTyChangeBox').show();
            } else {
                $('#cdTyChangeBox').hide();
            }
            $('#cdThankyou').addClass('show');
            setTimeout(() => { $('#cdThankyou').removeClass('show'); syncCustomerDisplay(); }, 4000);
        }

        /* ── Category tabs ── */
        function updateCategoryTabs(brand) {
            const cats = brand === 'all' ? allCategories : Array.from(categoriesByBrand[brand] || []);
            let html   = '<button class="tab-pill active" data-category="all">ទាំងអស់</button>';
            cats.forEach(c => { html += `<button class="tab-pill" data-category="${c}">${c}</button>`; });
            $('#categoryTabs').html(html);
            currentCategory = 'all';
        }

        /* ── Product grid ── */
        function loadProducts() {
            if (!products.length) {
                $('#productsGrid').html('<div class="state-placeholder"><i class="fas fa-box-open"></i><p>មិនមានផលិតផល</p></div>');
                return;
            }
            const q        = $('#productSearch').val().toLowerCase();
            const filtered = products.filter(p =>
                (currentBrand    === 'all' || p.brand    === currentBrand)    &&
                (currentCategory === 'all' || p.category === currentCategory) &&
                p.name.toLowerCase().includes(q)
            );
            if (!filtered.length) {
                $('#productsGrid').html('<div class="state-placeholder"><i class="fas fa-search"></i><p>រកមិនឃើញ</p><small>ប្ដូរតម្រង</small></div>');
                return;
            }
            let html = '';
            filtered.forEach(p => {
                const imgHtml = p.icon
                    ? `<img src="${p.icon}" alt="${p.name}" onerror="this.onerror=null;this.style.display='none';this.parentElement.innerHTML='<i class=\\'fas fa-utensils\\'></i>';">`
                    : '<i class="fas fa-utensils"></i>';
                html += `
<div class="product-card" style="--product-color:${p.color}"
     data-id="${p.id}" data-name="${p.name.replace(/'/g,'&apos;')}"
     data-price="${p.priceUsd}" data-brand-id="${p.brandId||0}"
     data-icon="${p.icon||''}" data-color="${p.color}">
    <div class="prod-img" style="background:linear-gradient(160deg,${p.color},#2D3561)">${imgHtml}</div>
    <div class="prod-price">${p.name}</div>
    <div class="prod-price-khr">${p.priceUsd}$ = ${fmtKhr(roundKhr100(parseFloat(p.priceUsd) * (paymentCurrency==='khr'?CHANGE_RATE_CUSTOMER:EXCHANGE_RATE)))}</div>
    <button class="prod-add-btn"><i class="fas fa-plus"></i></button>
</div>`;
            });
            $('#productsGrid').fadeOut(70, function () { $(this).html(html).fadeIn(110); });
        }

        updateCategoryTabs('all');
        loadProducts();

        /* Filter events */
        $('#brandTabs').on('click', '.tab-pill', function () {
            $('#brandTabs .tab-pill').removeClass('brand-active');
            $(this).addClass('brand-active');
            currentBrand = $(this).data('brand') || 'all';
            updateCategoryTabs(currentBrand);
            loadProducts();
        });
        $(document).on('click', '#categoryTabs .tab-pill', function () {
            $('#categoryTabs .tab-pill').removeClass('active');
            $(this).addClass('active');
            currentCategory = $(this).data('category') || 'all';
            loadProducts();
        });
        let searchTimeout;
        $('#productSearch').on('input', function () {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(loadProducts, 280);
        });
        $('#productSearch').on('keydown', function (e) {
            if (e.key === 'Escape') { $(this).val(''); loadProducts(); }
        });

        /* ── Cart ── */
        $(document).on('click', '.product-card', function (e) { if ($(e.target).is('button,i')) return; addToCart(this); });
        $(document).on('click', '.prod-add-btn', function (e) { e.stopPropagation(); addToCart($(this).closest('.product-card')[0]); });

        function addToCart(el) {
            const $el  = $(el);
            $el.addClass('pulse');
            setTimeout(() => $el.removeClass('pulse'), 300);
            const item = {
                id:      $el.data('id'),
                name:    $el.data('name'),
                price:   parseFloat($el.data('price')),
                brandId: $el.data('brand-id') || 0,
                icon:    $el.data('icon') || '',
                color:   $el.data('color') || 'var(--brand)'
            };
            const existing = cart.find(i => i.id === item.id);
            if (existing) { existing.quantity++; notify(`+1 ${item.name}`, 'info'); }
            else { cart.push({ ...item, quantity: 1 }); notify(`បន្ថែម ${item.name}`, 'success'); }
            renderCart();
        }

        function renderCart() {
            let html = '';
            if (cart.length === 0) {
                html = `<div class="empty-cart"><i class="fas fa-utensils"></i><p>ថ្ងៃសួស្ដី! ជ្រើសអាហារ</p><small>ចុចលើផលិតផលដើម្បីបន្ថែម</small></div>`;
            } else {
                cart.forEach((item, idx) => {
                    const tot     = item.price * item.quantity;
                    const imgHtml = item.icon
                        ? `<img src="${item.icon}" alt="${item.name}" onerror="this.onerror=null;this.style.display='none';this.parentElement.innerHTML='<i class=\\'fas fa-utensils\\'></i>';">`
                        : '<i class="fas fa-utensils"></i>';
                    html += `
<div class="cart-item" data-index="${idx}" style="--product-color:${item.color}">
    <div class="ci-thumb" style="background:linear-gradient(135deg,${item.color},#2D3561)">${imgHtml}</div>
    <div class="ci-info">
        <div class="ci-name">${item.name}</div>
        <div class="ci-price">${fmtUsd(item.price)}</div>
    </div>
    <div class="ci-qty">
        <button class="ci-qty-btn decrease-qty"><i class="fas fa-minus"></i></button>
        <span class="ci-qty-num">${item.quantity}</span>
        <button class="ci-qty-btn increase-qty"><i class="fas fa-plus"></i></button>
    </div>
    <div class="ci-total">${displayCurrency==='usd' ? fmtUsd(tot) : fmtKhr(toKhr(tot))}</div>
    <div class="ci-remove"><i class="fas fa-trash-alt"></i></div>
</div>`;
                });
            }
            $('#cartItems').html(html);
            updateSummary();
            updateFab();
            syncCustomerDisplay();
        }

        $(document).on('click', '.increase-qty', function () {
            const idx = $(this).closest('.cart-item').data('index');
            cart[idx].quantity++;
            renderCart();
        });
        $(document).on('click', '.decrease-qty', function () {
            const idx = $(this).closest('.cart-item').data('index');
            if (cart[idx].quantity > 1) { cart[idx].quantity--; }
            else { notify(`លុប ${cart[idx].name}`, 'warning'); cart.splice(idx, 1); }
            renderCart();
        });
        $(document).on('click', '.ci-remove', function () {
            const idx = $(this).closest('.cart-item').data('index');
            notify(`លុប ${cart[idx].name}`, 'warning');
            cart.splice(idx, 1);
            renderCart();
        });

        function updateSummary() {
            const sub   = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const disc  = calcDiscount(sub);
            const total = sub - disc;
            $('#subtotal').text(fmtUsd(sub));
            $('#subtotalKhr').text(fmtKhr(roundKhr100(toKhr(sub))));
            $('#total').text(fmtUsd(total));
            $('#totalKhr').text(fmtKhr(roundKhr100(toKhr(total))));
            if (disc > 0) {
                $('#discountDisplay').show();
                $('#discountValue').text('-' + fmtUsd(disc));
                $('#discountKhr').text(fmtKhr(roundKhr100(toKhr(disc))));
            } else { $('#discountDisplay').hide(); }
            const cnt = cart.reduce((s, i) => s + i.quantity, 0);
            $('#cartCount').text(cnt + ' មុខ');
            updatePayState();
        }

        function updatePayState() {
            const sub      = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const totalUsd = sub - calcDiscount(sub);
            const totalKhr = roundKhr100(toKhr(totalUsd));
            const cash     = parseFloat($('#cashReceived').val()) || 0;

            if (cart.length === 0) { $('#payBtn').prop('disabled', true); $('#changeDisplay').removeClass('show'); return; }
            if (currentPaymentMethod !== 'cash') { $('#payBtn').prop('disabled', false); $('#changeDisplay').removeClass('show'); return; }

            const needed = paymentCurrency === 'usd' ? totalUsd : totalKhr;
            $('#payBtn').prop('disabled', cash < needed);

            if (cash >= needed && cash > 0) {
                let changeUsd, changeKhr;
                if (paymentCurrency === 'usd') { changeUsd = cash - totalUsd; changeKhr = roundKhr100(toKhr(changeUsd)); }
                else { changeKhr = roundKhr100(cash - totalKhr); changeUsd = changeKhr / EXCHANGE_RATE; }
                $('#changeAmount').text(fmtUsd(changeUsd));
                $('#changeAmountKhr').text(fmtKhr(changeKhr));
                $('#changeDisplay').addClass('show');
            } else { $('#changeDisplay').removeClass('show'); }
        }

        function updateFab() {
            const cnt = cart.reduce((s, i) => s + i.quantity, 0);
            $('#fabBadge').text(cnt);
        }

        /* Currency toggles */
        $(document).on('click', '.curr-btn', function () {
            $('.curr-btn').removeClass('active'); $(this).addClass('active');
            displayCurrency = $(this).data('currency');
            renderCart();
        });
        $(document).on('click', '[data-pay-currency]', function () {
            $('[data-pay-currency]').removeClass('active'); $(this).addClass('active');
            paymentCurrency = $(this).data('pay-currency');
            if (paymentCurrency === 'usd') { $('.usd-amt').show(); $('.khr-amt').hide(); $('#cashReceived').attr('placeholder', 'ទទួលប្រាក់ (USD)').val(''); }
            else { $('.usd-amt').hide(); $('.khr-amt').show(); $('#cashReceived').attr('placeholder', 'ទទួលប្រាក់ (រៀល)').val(''); }
            loadProducts();
            syncCustomerDisplay();
            updatePayState();
        });
        $(document).on('click', '.pay-method', function () {
            $('.pay-method').removeClass('active'); $(this).addClass('active');
            currentPaymentMethod = $(this).data('method');
            if (currentPaymentMethod === 'cash') $('#cashPaymentSection').slideDown(160);
            else $('#cashPaymentSection').slideUp(160);
            $('#changeDisplay').removeClass('show');
            updatePayState();
        });
        $('#cashReceived').on('input', updatePayState);
        $(document).on('click', '.exact-btn, .quick-btn', function () {
            const amt = $(this).data('amount');
            if (amt === 'exact') {
                const sub = cart.reduce((s, i) => s + i.price * i.quantity, 0);
                const tot = sub - calcDiscount(sub);
                $('#cashReceived').val(paymentCurrency === 'usd' ? tot.toFixed(2) : toKhr(tot));
            } else { $('#cashReceived').val(amt); }
            updatePayState();
        });
        $('#discountAmount').on('input', function () {
            discountAmount = Math.max(parseFloat($(this).val()) || 0, 0);
            updateSummary(); syncCustomerDisplay();
        });
        $('#discountTypeSelect').on('change', function () {
            discountType = $(this).val();
            $('#discountTypeBadge').text(discountType === 'fixed' ? 'ដុល្លារ' : 'ភាគរយ');
            updateSummary(); syncCustomerDisplay();
        });

        /* Cancel / Hold */
        $('#cancelOrderBtn').click(function () {
            if (!cart.length) return;
            if (confirm('បោះបង់ការកម្មង់?')) { resetCart(); notify('បោះបង់ការកម្មង់', 'warning'); }
        });
        $('#holdOrderBtn').click(function () {
            if (!cart.length) { notify('គ្មានទំនិញ', 'warning'); return; }
            const sub  = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const disc = calcDiscount(sub);
            const held = JSON.parse(localStorage.getItem('heldOrders') || '[]');
            held.push({ id: 'HOLD' + Date.now(), items: cart, discount: { amount: discountAmount, type: discountType, value: disc }, total: sub - disc });
            localStorage.setItem('heldOrders', JSON.stringify(held));
            resetCart();
            notify('ផ្អាកការកម្មង់', 'success');
        });

        /* ════ PAY BUTTON ════ */
        $('#payBtn').on('click', async function () {
            const sub      = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const totalUsd = sub - calcDiscount(sub);
            if (currentPaymentMethod === 'qr') {
                await openKhqrFlow(totalUsd);
            } else {
                openCashConfirm();
            }
        });

        /* ════ CASH CONFIRM MODAL ════ */
        function openCashConfirm() {
            const sub      = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const disc     = calcDiscount(sub);
            const totalUsd = sub - disc;
            const totalKhr = roundKhr100(toKhr(totalUsd));
            const cash     = parseFloat($('#cashReceived').val()) || totalUsd;

            let changeUsd = 0, changeKhr = 0;
            if (currentPaymentMethod === 'cash') {
                if (paymentCurrency === 'usd') { changeUsd = Math.max(0, cash - totalUsd); changeKhr = roundKhr100(toKhr(changeUsd)); }
                else { changeKhr = roundKhr100(Math.max(0, cash - totalKhr)); changeUsd = changeKhr / EXCHANGE_RATE; }
            }

            let itemsHtml = '';
            cart.forEach(item => {
                itemsHtml += `<div class="cc-order-item"><span class="cc-item-name">${item.name}</span><span class="cc-item-qty">×${item.quantity}</span><span class="cc-item-price">${fmtUsd(item.price * item.quantity)}</span></div>`;
            });
            $('#ccOrderItems').html(itemsHtml);

            let sumHtml = `<div class="cc-sum-row"><span>សរុប</span><span>${fmtUsd(sub)}<span class="cc-sum-khr">${fmtKhr(roundKhr100(toKhr(sub)))}</span></span></div>`;
            if (disc > 0) {
                const dLabel = discountType === 'percentage' ? `បញ្ចុះ ${discountAmount}%` : 'បញ្ចុះ';
                sumHtml += `<div class="cc-sum-row" style="color:#92400E;"><span>${dLabel}</span><span>-${fmtUsd(disc)}</span></div>`;
            }
            sumHtml += `<div class="cc-sum-row total"><span><i class="fas fa-calculator" style="margin-right:4px;"></i>សរុបទាំងអស់</span><span>${fmtUsd(totalUsd)}<span class="cc-sum-khr">${fmtKhr(totalKhr)}</span></span></div>`;
            $('#ccSummary').html(sumHtml);

            if (currentPaymentMethod === 'cash') {
                const cashDisp = paymentCurrency === 'usd' ? fmtUsd(cash) : fmtKhr(cash);
                const cashKhr  = paymentCurrency === 'usd' ? fmtKhr(roundKhr100(toKhr(cash))) : '';
                const chDisp   = paymentCurrency === 'usd' ? fmtUsd(changeUsd) : fmtKhr(changeKhr);
                const chKhrD   = paymentCurrency === 'usd' ? fmtKhr(changeKhr) : '';
                $('#ccCashVal').text(cashDisp); $('#ccCashKhr').text(cashKhr);
                $('#ccChangeVal').text(chDisp);  $('#ccChangeKhr').text(chKhrD);
                $('#ccPaymentBox').show();
            } else {
                $('#ccCashVal').text('Card'); $('#ccCashKhr').text('');
                $('#ccChangeVal').text('—');   $('#ccChangeKhr').text('');
                $('#ccPaymentBox').hide();
            }
            $('#cashConfirmModal').addClass('show');
        }

        $('#ccCancelBtn').on('click', function () { $('#cashConfirmModal').removeClass('show'); });
        $('#ccConfirmBtn').on('click', function () { $('#cashConfirmModal').removeClass('show'); runPayFlow(); });

        /* ════ ACTUAL PAY ════ */
        async function runPayFlow() {
            const $btn = $('#payBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> កំពុងរក្សាទុក...');
            try {
                const sub      = cart.reduce((s, i) => s + i.price * i.quantity, 0);
                const disc     = calcDiscount(sub);
                const totalUsd = sub - disc;
                const totalKhr = roundKhr100(toKhr(totalUsd));
                const cash     = parseFloat($('#cashReceived').val()) || totalUsd;

                let changeUsd = 0, changeKhr = 0;
                if (currentPaymentMethod === 'cash') {
                    if (paymentCurrency === 'usd') { changeUsd = Math.max(0, cash - totalUsd); changeKhr = roundKhr100(toKhr(changeUsd)); }
                    else { changeKhr = roundKhr100(Math.max(0, cash - totalKhr)); changeUsd = changeKhr / EXCHANGE_RATE; }
                }

                const items   = cart.map(i => ({ menuItemId: i.id, brandId: i.brandId || 0, quantity: i.quantity, price: i.price, subtotal: i.price * i.quantity }));
                const cashUsd = paymentCurrency === 'usd' ? cash : cash / EXCHANGE_RATE;

                const res = await fetch('/Order/CreateOrder', {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify({ items, cashReceived: cashUsd, discountAmount: disc })
                });
                if (!res.ok) { const e = await res.json().catch(() => ({})); throw new Error(e.error || `Server ${res.status}`); }
                const result = await res.json();

                orderCounter++;
                const orderNum = result.orderNumber || 'ORD' + orderCounter;
                const pmLabel  = currentPaymentMethod === 'cash' ? 'សាច់ប្រាក់' : currentPaymentMethod === 'card' ? 'Card' : 'KHQR';

                /* Build lastOrder BEFORE resetCart so the shift observer can read it */
                const completedOrder = {
                    number:          orderNum,
                    date:            new Date(),
                    items:           [...cart],
                    subtotal:        sub,
                    discount:        disc,
                    discountType,
                    discountAmount,
                    total:           totalUsd,
                    totalKhr,
                    paymentMethod:   pmLabel,
                    paymentCurrency: paymentCurrency === 'usd' ? 'ដុល្លារ' : 'រៀល',
                    cashReceived:    cash,
                    changeUsd,
                    changeKhr,
                    cashier:         '@firstName @lastName'
                };

                /* Expose globally so the shift MutationObserver can read it */
                window.lastOrder = completedOrder;
                lastOrderLocal   = completedOrder;

                showCustomerThankYou(completedOrder);
                showInvoice(completedOrder);
                addRecentChip(orderNum, totalUsd);
                resetCart();
                notify('ការទូទាត់បានជោគជ័យ! ✓', 'success');

            } catch(err) {
                notify('មានបញ្ហា: ' + err.message, 'error');
            } finally {
                $btn.prop('disabled', false).html('<i class="fas fa-check-circle"></i> បញ្ចប់ការទូទាត់ <span class="shortcut-tag">F8</span>');
                updatePayState();
            }
        }

        function resetCart() {
            cart = []; discountAmount = 0;
            $('#discountAmount').val('0'); $('#discountDisplay').hide();
            $('#cashReceived').val('0'); $('#changeDisplay').removeClass('show');
            renderCart();
        }

        /* ════════════════════════════════════════════════════════
           KHQR DUAL-SCREEN FLOW
        ════════════════════════════════════════════════════════ */
        let qrWindow      = null;
        let _pendingQrUsd = null;
        let _khqrActive   = false;

        async function getScreenDetails() {
            if (window.getScreenDetails) {
                try { return await window.getScreenDetails(); } catch(e) { return null; }
            }
            return null;
        }

        async function hasSecondScreen() {
            const details = await getScreenDetails();
            if (details) return details.screens.length > 1;
            try {
                return window.screen.availWidth > window.screen.width ||
                    window.screen.width > window.innerWidth + 200;
            } catch(e) { return false; }
        }

        function buildQrWindowHtml(totalUsd) {
            const totalKhrStr = fmtKhr(roundKhr100(toKhr(totalUsd)));
            const amountStr   = fmtUsd(totalUsd);
            const qrImgUrl    = window.location.origin + '/khqr-code.png';

            return `<!DOCTYPE html>
<html lang="km">
