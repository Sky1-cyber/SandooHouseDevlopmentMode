{
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASS};SSL Mode=Require;Trust Server Certificate=true;"
  },
  "EmailSettings": {
    "From": "noreply@sandookitchen.com",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "587",
    "Username": "${EMAIL_USER}",
    "Password": "${EMAIL_PASS}"
  },
  "Cloudinary": {
    "CloudName": "${CloudinaryName}",
    "ApiKey": "${Cloudinary_API}",
    "ApiSecret": "${Cloudinary_SecretKey"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}