@using System.Security.Claims
@{
    ViewData["Title"] = "POS ផ្ទះបាយសេនឌូ";
    Layout = null;
    var firstName = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Name)?.Value;
    var lastName = User.Claims.FirstOrDefault(c => c.Type == "LastName")?.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
    <title>@ViewData["Title"]</title>
    <link rel="icon" href="~/assets/img/kaiadmin/SandooHouse.ico" type="image/x-icon"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link
        href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Noto+Sans+Khmer:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
    <link rel="stylesheet" href="~/css/CreateOrder.css"/>
</head>
<body>
<div class="pos-shell">

    <!-- ── TOP BAR ── -->
    <header class="topbar">
        <img src="~/assets/img/kaiadmin/SandooHouse.ico" alt="Logo" class="topbar-logo"
             onerror="this.src='https://via.placeholder.com/100x32?text=POS'">
        <div class="topbar-divider"></div>
        <div class="topbar-info">
            <span class="topbar-date"><i class="fas fa-calendar-alt"
                                         style="margin-right:4px;color:var(--brand)"></i>@DateTime.Now.ToString("dd MMM yyyy")</span>
            <span class="topbar-time" id="liveClock">@DateTime.Now.ToString("hh:mm tt")</span>
        </div>
        <div class="topbar-spacer"></div>
        <div class="topbar-hide-sm" style="display:flex;align-items:center;gap:8px;">
            <span class="exrate-chip"><i class="fas fa-exchange-alt" style="margin-right:5px;"></i>1$ = 4,100៛</span>
            <div class="curr-toggle">
                <button class="curr-btn active" data-currency="usd">USD</button>
                <button class="curr-btn" data-currency="khr">KHR</button>
            </div>
        </div>
        <div class="user-chip">
            <i class="fas fa-user-circle"></i>
            <span>@firstName @lastName</span>
        </div>
        <a href="#" class="logout-btn" onclick="showLogoutModal(); return false;" title="Logout">
            <i class="fas fa-sign-out-alt"></i>
            <span class="topbar-hide-sm">Logout</span>
        </a>
    </header>

    <!-- ── MAIN BODY ── -->
    <div class="pos-body">

        <!-- ══════════════════════════════════
             LEFT: PRODUCTS PANEL
        ══════════════════════════════════ -->
        <div class="panel-products">
            <div class="filter-bar">
                <div class="filter-label"><i class="fas fa-tag" style="margin-right:4px;color:var(--brand)"></i>ម៉ាក
                </div>
                <div class="scroll-tabs" id="brandTabs">
                    <button class="tab-pill brand-active" data-brand="all">ទាំងអស់</button>
                    @if (ViewBag.Brands != null)
                    {
                        foreach (var brand in ViewBag.Brands)
                        {
                            <button class="tab-pill" data-brand="@brand.BrandName"
                                    data-brand-id="@brand.Id">@brand.BrandName</button>
                        }
                    }
                </div>
            </div>
            <div class="filter-bar" style="border-bottom:none;padding-top:6px;">
                <div class="filter-label"><i class="fas fa-list" style="margin-right:4px;color:var(--accent)"></i>ប្រភេទ
                </div>
                <div class="scroll-tabs" id="categoryTabs">
                    <button class="tab-pill active" data-category="all">ទាំងអស់</button>
                </div>
            </div>
            <div class="search-wrap">
                <div class="search-inner">
                    <i class="fas fa-search"></i>
                    <input type="text" id="productSearch" placeholder="ស្វែងរកមុខទំនិញ..." autocomplete="off"
                           spellcheck="false">
                </div>
            </div>
            <div class="products-grid" id="productsGrid">
                <div class="state-placeholder">
                    <i class="fas fa-circle-notch fa-spin" style="color:var(--brand)"></i>
                    <p>កំពុងផ្ទុក...</p>
                </div>
            </div>
        </div>

        <!-- ══════════════════════════════════
             MIDDLE: CUSTOMER DISPLAY
        ══════════════════════════════════ -->
        <div class="panel-customer" id="customerPanel">

            <!-- Header -->
            <div class="cd-header">
                <div class="cd-header-top">
                    <div class="cd-logo-area">
                        <div class="cd-logo-dot"></div>
                        <div class="cd-logo-text">ផ្ទះបាយ<span>សេនឌូ</span></div>
                    </div>
                    <div class="cd-clock" id="cdClock">00:00:00</div>
                </div>
                <div class="cd-header-sub">
                    <div class="cd-welcome-line1">Customer Display</div>
                    <div style="display:flex;align-items:center;gap:7px;">
                        <span class="cd-pay-currency-pill usd" id="cdPayCurrencyPill">USD</span>
                        <div class="cd-live-dot">LIVE</div>
                    </div>
                </div>
            </div>

            <!-- Items / Idle area -->
            <div class="cd-items-area" id="cdItemsArea">
                <!-- Idle screen — shown when cart is empty -->
                <div class="cd-idle" id="cdIdle">
                    <div class="cd-idle-icon">
                        <i class="fas fa-concierge-bell" style="font-size:32px;color:var(--cd-brand);"></i>
                    </div>
                    <div>
                        <div class="cd-idle-title">សូមស្វាគមន៍!</div>
                        <div class="cd-idle-sub">ជ្រើសរើសមុខអាហារ<br>ហើយយើងនឹងបម្រើអ្នក</div>
                    </div>
                    <!-- Date chip -->
                    <div
                        style="background:#161B22;border:1.5px solid #30363D;border-radius:10px;padding:10px 14px;width:100%;display:flex;align-items:center;gap:10px;">
                        <div
                            style="width:32px;height:32px;background:rgba(255,107,53,.1);border:1.5px solid rgba(255,107,53,.2);border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="fas fa-calendar-day" style="font-size:13px;color:var(--cd-brand);"></i>
                        </div>
                        <div>
                            <div
                                style="font-size:12px;font-weight:700;color:var(--cd-text);">@DateTime.Now.ToString("dd MMMM yyyy")</div>
                            <div
                                style="font-size:10px;font-weight:600;color:var(--cd-muted);margin-top:1px;">@DateTime.Now.ToString("dddd")</div>
                        </div>
                    </div>
                    <!-- Promo strip -->
                    <div class="cd-promo-strip">
                        <div class="cd-promo-label">ប្រម៉ូសិយ៉ូន</div>
                        <div class="cd-promo-text">ទទួលការបញ្ចុះតម្លៃ 10%<br>នៅពេលបញ្ជាទិញលើសពី $20</div>
                    </div>
                </div>

                <!-- Active order — shown when items in cart -->
                <div id="cdOrderArea" style="display:none;">
                    <div class="cd-section-label">បញ្ជីការកម្មង់</div>
                    <div id="cdItemsList"></div>
                </div>
            </div>

            <!-- Summary footer -->
            <div class="cd-summary" id="cdSummaryFooter" style="display:none;">
                <div class="cd-sum-row">
                    <span>សរុប</span>
                    <span>
                        <span id="cdSubtotal">$0.00</span>
                        <div class="cd-sum-khr" id="cdSubtotalKhr">0 ៛</div>
                    </span>
                </div>
                <div class="cd-sum-row" id="cdDiscountRow" style="display:none;">
                    <span class="cd-discount-pill">
                        <i class="fas fa-tag" style="font-size:9px;"></i>
                        <span id="cdDiscountLabel">បញ្ចុះ</span>
                    </span>
                    <span style="color:#F0A500;font-weight:800;" id="cdDiscountVal">-$0.00</span>
                </div>
                <div class="cd-sum-row total">
                    <span><i class="fas fa-calculator" style="margin-right:5px;font-size:13px;"></i>សរុបទាំងអស់</span>
                    <span>
                        <span class="cd-total-usd" id="cdTotal">$0.00</span>
                        <div class="cd-sum-khr" id="cdTotalKhr">0 ៛</div>
                    </span>
                </div>
            </div>

            <!-- Thank you overlay -->
            <div class="cd-thankyou" id="cdThankyou">
                <div class="cd-thankyou-check">
                    <i class="fas fa-check"></i>
                </div>
                <div class="cd-thankyou-title">សូមអរគុណ! 🙏</div>
                <div class="cd-thankyou-amount" id="cdTyAmount">$0.00</div>
                <!-- Change box: shows both USD and KHR change -->
                <div class="cd-thankyou-change" id="cdTyChangeBox" style="display:none;">
                    <div class="cd-thankyou-change-label">ប្រាក់អាប់</div>
                    <div class="cd-thankyou-change-usd" id="cdTyChangeUsd">$0.00</div>
                    <div class="cd-thankyou-change-khr" id="cdTyChangeKhr">0 ៛</div>
                </div>
                <div class="cd-thankyou-sub">អរគុណសម្រាប់ការញ៉ាំ<br>សូមអញ្ជើញមកម្តងទៀត!</div>
            </div>

            <!-- KHQR QR overlay — shown on customer screen when QR payment selected -->
            <div class="cd-qr-overlay" id="cdQrOverlay">
                <div class="cd-qr-title">ទូទាត់តាម KHQR</div>
                <div class="cd-qr-subtitle">ស្កែ QR Code ខាងក្រោម</div>
                <div class="cd-qr-frame">
                    <span class="cd-qr-corner-bl"></span>
                    <span class="cd-qr-corner-br"></span>
                    <div class="cd-qr-pulse"></div>
                    <div class="cd-qr-inner">
                        <img src="~/khqr-code.png"
                             alt="KHQR"
                             id="cdQrImg"
                             style="width:100%;height:100%;object-fit:contain;border-radius:6px;display:block;"
                             onerror="this.style.display='none';document.getElementById('cdQrCanvas').style.display='block';">
                        <canvas id="cdQrCanvas" width="184" height="184"
                                style="display:none;border-radius:6px;"></canvas>
                    </div>
                </div>
                <div class="cd-qr-amount" id="cdQrAmount">$0.00</div>
                <div class="cd-qr-khr" id="cdQrKhr">0 ៛</div>
                <div class="cd-qr-merchant">ផ្ទះបាយសេនឌូ</div>
                <div class="cd-qr-bank"><i class="fas fa-university" style="margin-right:4px;"></i>ABA Bank · 0000123456
                </div>
                <div class="cd-qr-timer-bar" style="width:100%;">
                    <div class="cd-qr-timer-fill" id="cdQrTimerFill"></div>
                </div>
            </div>

        </div><!-- /.panel-customer -->

        <!-- ══════════════════════════════════
             RIGHT: CASHIER CART PANEL
        ══════════════════════════════════ -->
        <div class="panel-cart" id="cartPanel">
            <div class="cart-head">
                <span class="cart-title"><i class="fas fa-shopping-cart"></i>ការកម្មង់</span>
                <span class="cart-badge" id="cartCount">0 មុខ</span>
            </div>
            <div class="cart-items" id="cartItems">
                <div class="empty-cart">
                    <i class="fas fa-utensils"></i>
                    <p>ថ្ងៃសួស្ដី! ជ្រើសអាហារ</p>
                    <small>ចុចលើផលិតផលដើម្បីបន្ថែម</small>
                </div>
            </div>
            <!-- Summary -->
            <div class="cart-summary">
                <div class="sum-row">
                    <span>សរុប</span>
                    <span>
                        <span id="subtotal">$0.00</span>
                        <div class="sum-khr" id="subtotalKhr">0 ៛</div>
                    </span>
                </div>
                <div class="disc-box">
                    <div class="disc-box-head">
                        <span><i class="fas fa-tags" style="margin-right:5px;"></i>បញ្ចុះតម្លៃ</span>
                        <span class="disc-type-badge" id="discountTypeBadge">ដុល្លារ</span>
                    </div>
                    <div class="disc-inputs">
                        <input type="number" id="discountAmount" placeholder="0" min="0" step="0.01" value="0">
                        <select id="discountTypeSelect">
                            <option value="fixed">USD</option>
                            <option value="percentage">%</option>
                        </select>
                    </div>
                    <div id="discountDisplay" style="display:none;margin-top:6px;">
                        <div class="sum-row" style="font-size:12px;color:#8B6914;margin-bottom:0;">
                            <span>ចំនួនបញ្ចុះ</span>
                            <span>
                                <span id="discountValue">-$0.00</span>
                                <div class="sum-khr" id="discountKhr">0 ៛</div>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="sum-row total">
                    <span><i class="fas fa-calculator" style="margin-right:6px;font-size:14px;"></i>សរុបទាំងអស់</span>
                    <span>
                        <span id="total" class="total-usd">$0.00</span>
                        <div class="sum-khr" id="totalKhr">0 ៛</div>
                    </span>
                </div>
            </div>
            <!-- Payment -->
            <div class="pay-section">
                <div class="pay-methods">
                    <div class="pay-method active" data-method="cash">
                        <i class="fas fa-money-bill-wave"></i><span>សាច់ប្រាក់</span>
                    </div>
                    <div class="pay-method" data-method="card">
                        <i class="fas fa-credit-card"></i><span>Card</span>
                    </div>
                    <div class="pay-method" data-method="qr">
                        <i class="fas fa-qrcode"></i><span>KHQR</span>
                    </div>
                </div>
                <div class="pay-currency-row">
                    <button class="pay-curr-btn active" data-pay-currency="usd">បង់ USD</button>
                    <button class="pay-curr-btn" data-pay-currency="khr">បង់ រៀល</button>
                </div>
                <div class="cash-section" id="cashPaymentSection">
                    <div class="cash-input-row">
                        <input type="number" id="cashReceived" placeholder="ទទួលប្រាក់" min="0" step="0.01" value="0">
                        <button class="exact-btn" data-amount="exact">ចំនួនពិតប្រាកដ</button>
                    </div>
                    <div class="quick-row" id="quickAmounts">
                        <button class="quick-btn usd-amt" data-amount="5">$5</button>
                        <button class="quick-btn usd-amt" data-amount="10">$10</button>
                        <button class="quick-btn usd-amt" data-amount="20">$20</button>
                        <button class="quick-btn usd-amt" data-amount="50">$50</button>
                        <button class="quick-btn usd-amt" data-amount="100">$100</button>
                        <button class="quick-btn khr-amt" data-amount="5000" style="display:none;">5k ៛</button>
                        <button class="quick-btn khr-amt" data-amount="10000" style="display:none;">10k ៛</button>
                        <button class="quick-btn khr-amt" data-amount="20000" style="display:none;">20k ៛</button>
                        <button class="quick-btn khr-amt" data-amount="50000" style="display:none;">50k ៛</button>
                        <button class="quick-btn khr-amt" data-amount="100000" style="display:none;">100k ៛</button>
                    </div>
                </div>
                <div class="change-box" id="changeDisplay">
                    <i class="fas fa-hand-holding-usd" style="margin-right:5px;"></i>
                    ប្រាក់សល់: <strong id="changeAmount">$0.00</strong>
                    <div class="change-khr" id="changeAmountKhr">0 ៛</div>
                </div>
                <div class="action-row">
                    <button class="act-btn act-hold" id="holdOrderBtn">
                        <i class="fas fa-pause-circle"></i> ផ្អាក <span class="shortcut-tag">F4</span>
                    </button>
                    <button class="act-btn act-cancel" id="cancelOrderBtn">
                        <i class="fas fa-times-circle"></i> បោះបង់
                    </button>
                    <button class="act-btn act-pay" id="payBtn" disabled>
                        <i class="fas fa-check-circle"></i>
                        បញ្ចប់ការទូទាត់
                        <span class="shortcut-tag">F8</span>
                    </button>
                </div>
            </div>
            <!-- Recent orders -->
            <div class="recent-bar">
                <div class="recent-label"><i class="fas fa-history" style="margin-right:5px;"></i>ប្រតិបត្តិការថ្មីៗ
                </div>
                <div class="recent-scroll" id="recentOrders"></div>
            </div>
        </div>

    </div><!-- end pos-body -->
</div><!-- end pos-shell -->

<!-- ── MOBILE FAB ── -->
<button class="cart-fab" id="cartFab">
    <i class="fas fa-shopping-cart"></i>
    <span class="cart-fab-badge" id="fabBadge">0</span>
</button>

<!-- ── MOBILE CART SHEET ── -->
<div class="cart-sheet" id="cartSheet">
    <div class="sheet-backdrop" id="sheetBackdrop"></div>
    <div class="sheet-body">
        <div class="sheet-handle"></div>
        <div id="mobileCartContent"
             style="overflow-y:auto;flex:1;display:flex;flex-direction:column;min-height:0;"></div>
    </div>
</div>

<!-- ── CASHIER KHQR WAITING MODAL ══════════
     Shown on the CASHIER screen while customer scans
     Customer sees the QR on their panel (second screen)
═════════════════════════════════════════════════ -->
<div class="cashier-qr-modal" id="cashierQrModal">
    <div class="cashier-qr-box">
        <div class="cashier-qr-head">
            <h3><i class="fas fa-qrcode" style="margin-right:8px;color:#FF6B35;"></i>រង់ចាំការស្កែន KHQR</h3>
            <p>QR បានបង្ហាញនៅ Customer Display រួចហើយ</p>
            <div class="cashier-qr-amount-badge">
                <i class="fas fa-dollar-sign" style="color:#FF6B35;font-size:14px;"></i>
                <span class="cashier-qr-amount-val" id="cqrAmount">$0.00</span>
                <span style="font-size:12px;color:rgba(255,255,255,.4);font-weight:700;" id="cqrKhr">0 ៛</span>
            </div>
        </div>
        <div class="cashier-qr-body">

            <!-- ── QR Code image ── -->
            <div style="display:flex;flex-direction:column;align-items:center;gap:8px;width:100%;">
                <div style="
                    position:relative;
                    width:200px;height:200px;
                    background:#fff;
                    border-radius:16px;
                    padding:10px;
                    border:3px solid #FF6B35;
                    box-shadow:0 0 0 4px rgba(255,107,53,.12), 0 8px 24px rgba(0,0,0,.18);
                    flex-shrink:0;
                ">
                    <!-- Animated corner brackets -->
                    <span
                        style="position:absolute;top:-3px;left:-3px;width:22px;height:22px;border-top:4px solid #FF6B35;border-left:4px solid #FF6B35;border-radius:5px 0 0 0;"></span>
                    <span
                        style="position:absolute;top:-3px;right:-3px;width:22px;height:22px;border-top:4px solid #FF6B35;border-right:4px solid #FF6B35;border-radius:0 5px 0 0;"></span>
                    <span
                        style="position:absolute;bottom:-3px;left:-3px;width:22px;height:22px;border-bottom:4px solid #FF6B35;border-left:4px solid #FF6B35;border-radius:0 0 0 5px;"></span>
                    <span
                        style="position:absolute;bottom:-3px;right:-3px;width:22px;height:22px;border-bottom:4px solid #FF6B35;border-right:4px solid #FF6B35;border-radius:0 0 5px 0;"></span>
                    <img src="~/khqr-code.png"
                         alt="KHQR"
                         style="width:100%;height:100%;object-fit:contain;border-radius:8px;display:block;"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                    <!-- Fallback canvas if image fails -->
                    <canvas id="cqrFallbackCanvas" width="176" height="176"
                            style="display:none;width:100%;height:100%;border-radius:8px;"></canvas>
                </div>
                <!-- Scan prompt -->
                <div
                    style="display:flex;align-items:center;gap:6px;background:rgba(255,107,53,.08);border:1.5px solid rgba(255,107,53,.2);border-radius:20px;padding:5px 14px;">
                    <i class="fas fa-mobile-alt" style="color:#FF6B35;font-size:12px;"></i>
                    <span style="font-size:11px;font-weight:800;color:#FF6B35;">ស្កែន QR ដោយ ABA / ACLEDA / Wing</span>
                </div>
            </div>

            <!-- Status indicator -->
            <div class="cashier-qr-status">
                <div class="cashier-qr-status-icon">
                    <i class="fas fa-spinner fa-spin"></i>
                </div>
                <div class="cashier-qr-status-text">
                    <div class="cashier-qr-status-title">កំពុងរង់ចាំការស្កែ...</div>
                    <div class="cashier-qr-status-sub">អតិថិជនកំពុងស្កែ QR នៅ Screen ផ្ទាល់ខ្លួន</div>
                </div>
                <div class="cashier-qr-countdown" id="cqrCountdown">2:00</div>
            </div>

            <!-- Timer bar -->
            <div style="width:100%;">
                <div style="background:#EDE8E0;border-radius:20px;height:6px;overflow:hidden;border:1px solid #e0dbd3;">
                    <div id="cqrTimerFill"
                         style="height:100%;background:linear-gradient(90deg,#FF6B35,#E85520);border-radius:20px;width:100%;transition:width 120s linear;"></div>
                </div>
                <div style="font-size:11px;font-weight:700;color:#A09990;text-align:center;margin-top:5px;"
                     id="cqrTimerText">
                    QR នឹងផុតកំណត់ក្នុង <span id="cqrCountdownSub">2:00</span>
