@model Sandoohouse.Models.ModelViewer.AdminModelViewer.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/CreateAccount.css"/>

<div class="ca-page">
    <!-- ── Top bar ── -->
    <div class="ca-topbar">
        <div>
            <h1>Create Account</h1>
            <nav class="ca-breadcrumb">
                <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door-fill"></i></a>
                <span class="sep">›</span>
                <a asp-controller="Account" asp-action="ListAccount">Account</a>
                <span class="sep">›</span>
                <span class="cur">Create Account</span>
            </nav>
        </div>
    </div>

    <!-- ── Card ── -->
    <div class="ca-card">

        <!-- Header -->
        <div class="ca-card-head">
            <div class="ca-head-icon">
                <i class="bi bi-person-plus-fill"></i>
            </div>
            <div class="ca-head-text">
                <h4>New Account Registration</h4>
                <p>Fill in the information below to create a new administrator account</p>
            </div>
        </div>

        <!-- Body -->
        <div class="ca-body">
            <form asp-controller="Account" asp-action="CreateAccount"
                  method="post" enctype="multipart/form-data"
                  class="needs-validation" novalidate>

                <!-- ── Avatar upload ── -->
                <div class="ca-avatar-section">
                    <div class="ca-avatar-wrap" onclick="document.getElementById('profileImageInput').click();">
                        <div class="ca-avatar">
                            <img id="previewImage" src="~/l60Hf.png" alt="Profile" />
                        </div>
                        <div class="ca-avatar-overlay">
                            <i class="bi bi-camera-fill"></i>
                            <span>Change</span>
                        </div>
                    </div>
                    <div class="ca-avatar-hint">
                        <label for="profileImageInput" class="btn-photo">
                            <i class="bi bi-camera"></i> Upload Photo
                        </label>
                        <input asp-for="ProfileImageUrl"
                               id="profileImageInput"
                               type="file"
                               style="display:none;"
                               accept="image/*"
                               onchange="previewFile(event)" />
                        <p><i class="bi bi-info-circle"></i> JPG, PNG or GIF · Max 2 MB</p>
                    </div>
                </div>

                <!-- ── Personal info ── -->
                <div class="ca-section-title">Personal Information</div>

                <div class="ca-grid">
                    <!-- First name -->
                    <div class="ca-field">
                        <label class="ca-label">
                            First Name <span class="req">*</span>
                        </label>
                        <div class="ca-input-wrap @(ViewData.ModelState["FirstName"]?.Errors.Any() == true ? "has-error" : "")">
                            <span class="ca-input-icon"><span class="fas fa-user"></span></span>
                            <input asp-for="FirstName" class="ca-input" placeholder="Enter first name" />
                        </div>
                        <span asp-validation-for="FirstName" class="ca-error"></span>
                    </div>

                    <!-- Last name -->
                    <div class="ca-field">
                        <label class="ca-label">
                            Last Name <span class="req">*</span>
                        </label>
                        <div class="ca-input-wrap @(ViewData.ModelState["LastName"]?.Errors.Any() == true ? "has-error" : "")">
                            <span class="ca-input-icon"><i class="bi bi-person"></i></span>
                            <input asp-for="LastName" class="ca-input" placeholder="Enter last name" />
                        </div>
                        <span asp-validation-for="LastName" class="ca-error"></span>
                    </div>

                    <!-- Email -->
                    <div class="ca-field">
                        <label class="ca-label">
                            Email Address <span class="req">*</span>
                        </label>
                        <div class="ca-input-wrap @(ViewData.ModelState["Email"]?.Errors.Any() == true ? "has-error" : "")">
                            <span class="ca-input-icon"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="ca-input" placeholder="name@example.com" type="email" />
                        </div>
                        <span asp-validation-for="Email" class="ca-error"></span>
                    </div>

                    <!-- Phone -->
                    <div class="ca-field">
                        <label class="ca-label">
                            Phone Number <span class="req">*</span>
                        </label>
                        <div class="ca-input-wrap @(ViewData.ModelState["PhoneNumber"]?.Errors.Any() == true ? "has-error" : "")">
                            <span class="ca-input-icon"><i class="bi bi-telephone"></i></span>
                            <input asp-for="PhoneNumber" class="ca-input" placeholder="+855 000 000 000" type="tel" />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="ca-error"></span>
                    </div>
                </div>

                <!-- ── Security ── -->
                <div class="ca-section-title" style="margin-top:8px;">Security</div>

                <div class="ca-grid">
                    <!-- Password -->
                    <div class="ca-field">
                        <label class="ca-label">
                            Password <span class="req">*</span>
                        </label>
                        <div class="ca-input-wrap @(ViewData.ModelState["Password"]?.Errors.Any() == true ? "has-error" : "")">
                            <span class="ca-input-icon"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" type="password" id="passwordInput"
                                   class="ca-input" placeholder="Create a password" />
                            <button type="button" class="ca-eye-btn"
                                    onclick="togglePwd('passwordInput','eyeIcon1')">
                                <i class="bi bi-eye" id="eyeIcon1"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="ca-error"></span>
                        <span class="ca-hint"><i class="bi bi-shield-lock"></i> At least 8 characters</span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="ca-field">
                        <label class="ca-label">
                            Confirm Password <span class="req">*</span>
                        </label>
                        <div class="ca-input-wrap @(ViewData.ModelState["ConfirmPassword"]?.Errors.Any() == true ? "has-error" : "")">
                            <span class="ca-input-icon"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="ConfirmPassword" type="password" id="confirmInput"
                                   class="ca-input" placeholder="Re-enter password" />
                            <button type="button" class="ca-eye-btn"
                                    onclick="togglePwd('confirmInput','eyeIcon2')">
                                <i class="bi bi-eye" id="eyeIcon2"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="ca-error"></span>
                    </div>

                    <!-- Password strength — full width -->
                    <div class="ca-field full">
                        <div class="ca-strength-box">
                            <div class="ca-strength-top">
                                <span class="ca-strength-label">Password strength</span>
                                <span class="ca-strength-badge" id="strengthBadge">Not entered</span>
                            </div>
                            <div class="ca-strength-track">
                                <div class="ca-strength-bar" id="strengthBar"></div>
                            </div>
                            <div class="ca-checks">
                                <div class="ca-check-item" id="chk-len">
                                    <i class="bi bi-circle"></i> At least 8 characters
                                </div>
                                <div class="ca-check-item" id="chk-upper">
                                    <i class="bi bi-circle"></i> Uppercase letter
                                </div>
                                <div class="ca-check-item" id="chk-lower">
                                    <i class="bi bi-circle"></i> Lowercase letter
                                </div>
                                <div class="ca-check-item" id="chk-num">
                                    <i class="bi bi-circle"></i> Number
                                </div>
                                <div class="ca-check-item" id="chk-special">
                                    <i class="bi bi-circle"></i> Special character
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── Action buttons ── -->
                <div class="ca-actions">
                    <button type="submit" class="btn-submit">
                        <i class="bi bi-check-circle"></i> Create Account
                    </button>
                    <a asp-controller="Account" asp-action="ListAccount" class="btn-cancel">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>

            </form>
        </div><!-- /.ca-body -->
    </div><!-- /.ca-card -->

</div><!-- /.ca-page -->

<script src="~/js/CreateAccount.js"></script>
