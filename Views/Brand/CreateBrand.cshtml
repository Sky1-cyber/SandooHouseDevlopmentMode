@model Sandoohouse.Models.ModelViewer.BrandModelViewer.BrandViewerModel
@{
    ViewData["Title"] = "Create Brand";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
:root {
    --brand:        #FF6B35;
    --brand-dark:   #E85520;
    --brand-light:  #FFF0EA;
    --brand-mid:    rgba(255,107,53,.13);
    --accent:       #1C2340;
    --success:      #00B894;
    --success-bg:   rgba(0,184,148,.1);
    --warning:      #F0A500;
    --warning-bg:   rgba(240,165,0,.1);
    --danger:       #E84545;
    --danger-bg:    rgba(232,69,69,.1);
    --bg:           #F2EFE9;
    --surface:      #FFFFFF;
    --surface2:     #FAF8F5;
    --surface3:     #F4F1EC;
    --border:       #EAE5DC;
    --border-s:     #D8D2C8;
    --text:         #18150F;
    --text-sub:     #6E685F;
    --text-light:   #AEA89F;
    --shadow-xs:    0 1px 3px rgba(24,21,15,.05);
    --shadow-sm:    0 2px 8px rgba(24,21,15,.07);
    --shadow-md:    0 6px 24px rgba(24,21,15,.10);
    --shadow-lg:    0 16px 48px rgba(24,21,15,.14);
    --shadow-brand: 0 6px 20px rgba(255,107,53,.32);
    --r-xs: 6px; --r-sm: 10px; --r-md: 16px; --r-lg: 24px; --r-xl: 32px;
    --font: 'Sora', sans-serif;
}

*, *::before, *::after { box-sizing: border-box; }

.cb-page {
    font-family: var(--font);
    background: var(--bg);
    background-image: radial-gradient(circle, #D8D2C8 1px, transparent 1px);
    background-size: 28px 28px;
    min-height: 100vh;
    padding: 28px 24px;
    color: var(--text);
}

/* ── Top bar ── */
.cb-topbar {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 26px; flex-wrap: wrap; gap: 12px;
    max-width: 1020px; margin-left: auto; margin-right: auto;
}
.cb-topbar-left h1 {
    font-size: 20px; font-weight: 700; color: var(--text);
    margin: 0 0 5px; letter-spacing: -.4px;
}
.cb-breadcrumb {
    display: flex; align-items: center; gap: 6px;
    font-size: 12px; font-weight: 500; margin: 0; padding: 0; list-style: none;
}
.cb-breadcrumb a { color: var(--text-light); text-decoration: none; transition: color .14s; }
.cb-breadcrumb a:hover { color: var(--brand); }
.cb-breadcrumb .sep { color: var(--border-s); }
.cb-breadcrumb .cur { color: var(--text-sub); font-weight: 600; }

/* ── Outer wrapper ── */
.cb-wrap {
    max-width: 1020px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
}

/* ── Hero header strip ── */
.cb-hero {
    background: var(--accent);
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    padding: 32px 36px;
    display: flex; align-items: center; gap: 20px;
    position: relative; overflow: hidden;
}
.cb-hero::before {
    content: '';
    position: absolute; inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Ccircle cx='30' cy='30' r='1' fill='rgba(255,255,255,0.04)'/%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
}
.cb-hero::after {
    content: '';
    position: absolute; width: 280px; height: 280px;
    border-radius: 50%; background: rgba(255,107,53,.08);
    top: -100px; right: -60px; pointer-events: none;
}
.cb-hero-circle {
    position: absolute; width: 200px; height: 200px; border-radius: 50%;
    background: rgba(255,255,255,.03); bottom: -80px; left: 160px; pointer-events: none;
}

.cb-hero-badge {
    width: 58px; height: 58px; border-radius: 16px;
    background: var(--brand);
    display: flex; align-items: center; justify-content: center;
    font-size: 26px; color: #fff;
    flex-shrink: 0; z-index: 1;
    box-shadow: var(--shadow-brand);
}
.cb-hero-text { z-index: 1; flex: 1; }
.cb-hero-text h2 {
    font-size: 20px; font-weight: 800; color: #fff;
    margin: 0 0 5px; letter-spacing: -.3px; line-height: 1.2;
}
.cb-hero-text p { font-size: 12px; color: rgba(255,255,255,.5); margin: 0; font-weight: 500; }

/* New brand pill */
.cb-hero-pill {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 14px; border-radius: 20px; z-index: 1; flex-shrink: 0;
    background: var(--brand-mid); color: var(--brand);
    border: 1px solid rgba(255,107,53,.25);
    font-size: 11px; font-weight: 700;
}

/* ── Main form area ── */
.cb-form-area {
    background: var(--surface);
    border: 1.5px solid var(--border); border-top: none;
    border-radius: 0 0 var(--r-lg) var(--r-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
}

/* ── Two-panel layout ── */
.cb-panels {
    display: grid;
    grid-template-columns: 1fr 300px;
    min-height: 520px;
}

/* ── LEFT panel ── */
.cb-left {
    padding: 32px 36px;
    border-right: 1.5px solid var(--border);
}

/* Section heading */
.cb-sec {
    font-size: 9px; font-weight: 800; text-transform: uppercase;
    letter-spacing: .12em; color: var(--text-light);
    margin: 0 0 18px; padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; gap: 8px;
}
.cb-sec i { font-size: 12px; color: var(--brand); }

/* Field */
.cb-field { margin-bottom: 22px; }
.cb-label {
    display: flex; align-items: baseline; gap: 5px;
    font-size: 11px; font-weight: 700; color: var(--text-sub);
    text-transform: uppercase; letter-spacing: .05em;
    margin-bottom: 8px;
}
.cb-label .req { color: var(--brand); font-size: 14px; line-height: .8; text-transform: none; letter-spacing: 0; }
.cb-label .opt { font-size: 10px; color: var(--text-light); font-weight: 500; text-transform: none; letter-spacing: 0; }

.cb-control {
    display: flex; align-items: stretch;
    border: 1.5px solid var(--border); border-radius: var(--r-sm);
    background: var(--surface2); overflow: hidden;
    transition: border-color .15s, box-shadow .15s, background .15s;
}
.cb-control:focus-within {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-mid);
    background: var(--surface);
}
.cb-control.err { border-color: var(--danger); }
.cb-control.err:focus-within { box-shadow: 0 0 0 3px var(--danger-bg); }
.cb-control.textarea-mode { align-items: flex-start; }
.cb-control.textarea-mode .cb-prefix { padding-top: 13px; align-self: flex-start; }

.cb-prefix {
    width: 44px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 15px; color: var(--text-light);
    border-right: 1.5px solid var(--border); background: var(--surface);
    transition: color .15s, border-color .15s;
}
.cb-control:focus-within .cb-prefix { color: var(--brand); border-color: var(--brand); }

.cb-inp {
    flex: 1; height: 46px; padding: 0 14px;
    border: none; background: none; outline: none;
    font-family: var(--font); font-size: 13px; color: var(--text); font-weight: 500;
}
.cb-inp::placeholder { color: var(--text-light); font-weight: 400; }

.cb-area {
    flex: 1; padding: 13px 14px; min-height: 100px; resize: vertical;
    border: none; background: none; outline: none;
    font-family: var(--font); font-size: 13px; color: var(--text);
    line-height: 1.65; font-weight: 500;
}
.cb-area::placeholder { color: var(--text-light); font-weight: 400; }

.cb-val-msg { font-size: 11px; color: var(--danger); font-weight: 600; margin-top: 5px; display: flex; align-items: center; gap: 4px; }
.cb-hint    { font-size: 11px; color: var(--text-light); margin-top: 5px; display: flex; align-items: center; gap: 4px; }

/* ── Status toggle ── */
.cb-toggle-card {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 18px;
    background: var(--surface2); border: 1.5px solid var(--border); border-radius: var(--r-sm);
    gap: 16px; transition: border-color .15s;
}
.cb-toggle-card:hover { border-color: var(--border-s); }
.cb-toggle-desc h6 {
    font-size: 13px; font-weight: 700; color: var(--text); margin: 0 0 3px;
    display: flex; align-items: center; gap: 7px;
}
.cb-toggle-desc h6 i { color: var(--brand); }
.cb-toggle-desc p { font-size: 11px; color: var(--text-light); margin: 0; }

.sw-wrap { flex-shrink: 0; }
.sw-wrap input[type="checkbox"] { display: none; }
.sw-track {
    display: block; width: 52px; height: 28px; border-radius: 14px;
    background: var(--border-s); cursor: pointer;
    transition: background .22s; position: relative;
}
.sw-track::after {
    content: ''; position: absolute; top: 4px; left: 4px;
    width: 20px; height: 20px; border-radius: 50%;
    background: #fff; box-shadow: var(--shadow-sm);
    transition: transform .22s, box-shadow .22s;
}
.sw-wrap input:checked + .sw-track { background: var(--success); }
.sw-wrap input:checked + .sw-track::after {
    transform: translateX(24px);
    box-shadow: 0 3px 10px rgba(0,184,148,.4);
}

/* ── Creation info notice ── */
.cb-notice {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 15px;
    background: var(--warning-bg);
    border: 1px solid rgba(240,165,0,.22);
    border-left: 3px solid var(--warning);
    border-radius: var(--r-sm);
    margin-top: 22px;
    font-size: 12px; color: var(--text-sub); font-weight: 500;
}
.cb-notice i { color: var(--warning); font-size: 15px; flex-shrink: 0; }
.cb-notice strong { color: var(--text); }

/* ── Action buttons ── */
.cb-actions { display: flex; gap: 10px; margin-top: 28px; flex-wrap: wrap; }

.btn-create {
    flex: 1; height: 48px; min-width: 160px;
    background: var(--brand); color: #fff;
    border: none; border-radius: var(--r-xl);
    font-family: var(--font); font-size: 14px; font-weight: 700;
    cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
    box-shadow: var(--shadow-brand); transition: all .18s; letter-spacing: .01em;
}
.btn-create:hover { background: var(--brand-dark); transform: translateY(-2px); box-shadow: 0 10px 28px rgba(255,107,53,.4); }
.btn-create:active { transform: translateY(0); }

.btn-discard {
    flex: 1; height: 48px; min-width: 140px;
    background: var(--surface); color: var(--text-sub);
    border: 1.5px solid var(--border); border-radius: var(--r-xl);
    font-family: var(--font); font-size: 14px; font-weight: 600;
    cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
    text-decoration: none; transition: all .18s;
}
.btn-discard:hover { border-color: var(--danger); color: var(--danger); background: var(--danger-bg); text-decoration: none; }

/* ── RIGHT panel: logo ── */
.cb-right {
    background: var(--surface3);
    padding: 32px 28px;
    display: flex; flex-direction: column; align-items: center;
    border-left: 1.5px solid var(--border);
}

.cb-logo-heading {
    font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: .12em;
    color: var(--text-light); margin-bottom: 20px; align-self: flex-start;
    display: flex; align-items: center; gap: 7px;
}
.cb-logo-heading i { color: var(--brand); font-size: 12px; }

.cb-logo-box {
    width: 200px; height: 200px; border-radius: var(--r-md);
    overflow: hidden; cursor: pointer; position: relative;
    border: 2px dashed var(--border-s);
    background: var(--surface); transition: all .2s;
    box-shadow: var(--shadow-xs);
    display: flex; align-items: center; justify-content: center;
}
.cb-logo-box:hover { border-color: var(--brand); border-style: solid; box-shadow: var(--shadow-brand); transform: translateY(-2px); }
.cb-logo-box img { width: 100%; height: 100%; object-fit: cover; display: block; }

/* Empty state inside box */
.cb-logo-empty {
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    pointer-events: none;
}
.cb-logo-empty i { font-size: 36px; color: var(--text-light); }
.cb-logo-empty span { font-size: 11px; color: var(--text-light); font-weight: 600; }

.cb-logo-cover {
    position: absolute; inset: 0; border-radius: calc(var(--r-md) - 2px);
    background: rgba(24,21,15,.55);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
    opacity: 0; transition: opacity .2s;
}
.cb-logo-cover i    { font-size: 30px; color: #fff; }
.cb-logo-cover span { font-size: 11px; color: rgba(255,255,255,.85); font-weight: 700; }
.cb-logo-box:hover .cb-logo-cover { opacity: 1; }

.cb-logo-div {
    width: 100%; height: 1px; background: var(--border); margin: 20px 0;
}

.cb-logo-btns { display: flex; flex-direction: column; gap: 8px; width: 100%; }

.btn-pick {
    height: 40px; width: 100%;
    border: 1.5px solid var(--brand); border-radius: var(--r-xl);
    background: var(--brand-light); color: var(--brand);
    font-family: var(--font); font-size: 12px; font-weight: 700;
    cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 7px;
    transition: all .16s;
}
.btn-pick:hover { background: var(--brand); color: #fff; }

.cb-logo-hints { margin-top: 16px; width: 100%; display: flex; flex-direction: column; gap: 5px; }
.cb-logo-hints span {
    font-size: 11px; color: var(--text-light);
    display: flex; align-items: center; gap: 6px;
}

.cb-fname {
    margin-top: 12px; font-size: 11px; color: var(--text-sub);
    display: none; align-items: center; gap: 5px; width: 100%;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.cb-fname i { color: var(--brand); flex-shrink: 0; }

/* ── Responsive ── */
@@media (max-width: 820px) {
    .cb-panels { grid-template-columns: 1fr; }
    .cb-right { border-left: none; border-top: 1.5px solid var(--border); }
    .cb-logo-box { width: 160px; height: 160px; }
}
@@media (max-width: 600px) {
    .cb-page { padding: 16px 14px; }
    .cb-hero { padding: 24px 22px; gap: 14px; }
    .cb-hero-badge { width: 46px; height: 46px; font-size: 20px; border-radius: 12px; }
    .cb-left { padding: 24px 20px; }
    .cb-right { padding: 24px 20px; }
    .cb-hero-text h2 { font-size: 17px; }
    .cb-actions { flex-direction: column; }
    .btn-create, .btn-discard { min-width: unset; }
}
</style>

<div class="cb-page">

    <!-- Top bar -->
    <div class="cb-topbar">
        <div class="cb-topbar-left">
            <h1>Create Brand</h1>
            <nav class="cb-breadcrumb">
                <a asp-controller="Home"  asp-action="Index"><i class="bi bi-house-door-fill"></i></a>
                <span class="sep">›</span>
                <a asp-controller="Brand" asp-action="Index">Brand</a>
                <span class="sep">›</span>
                <span class="cur">Create Brand</span>
            </nav>
        </div>
    </div>

    <div class="cb-wrap">

        <!-- ── Hero header ── -->
        <div class="cb-hero">
            <div class="cb-hero-circle"></div>
            <div class="cb-hero-badge"><i class="bi bi-building-add"></i></div>
            <div class="cb-hero-text">
                <h2>New Brand</h2>
                <p>Add a new brand to your restaurant catalog</p>
            </div>
            <span class="cb-hero-pill">
                <i class="bi bi-plus-circle-fill" style="font-size:11px;"></i> New Brand
            </span>
        </div>

        <!-- ── Form area ── -->
        <div class="cb-form-area">
            <form asp-action="CreateBrand" method="post" enctype="multipart/form-data"
                  class="needs-validation" novalidate>

                <div class="cb-panels">

                    <!-- ════ LEFT PANEL ════ -->
                    <div class="cb-left">

                        <div class="cb-sec"><i class="bi bi-tag-fill"></i> Brand Information</div>

                        <!-- Brand name -->
                        <div class="cb-field">
                            <label class="cb-label">Brand Name <span class="req">*</span></label>
                            <div class="cb-control @(ViewData.ModelState["BrandName"]?.Errors.Any() == true ? "err" : "")">
                                <span class="cb-prefix"><i class="bi bi-tag"></i></span>
                                <input asp-for="BrandName" class="cb-inp"
                                       placeholder="e.g. Sandoo Coffee, Bake House…" autocomplete="off" />
                            </div>
                            <span asp-validation-for="BrandName" class="cb-val-msg"></span>
                        </div>

                        <!-- Description -->
                        <div class="cb-field">
                            <label class="cb-label">Description <span class="opt">&nbsp;optional</span></label>
                            <div class="cb-control textarea-mode">
                                <span class="cb-prefix"><i class="bi bi-card-text"></i></span>
                                <textarea asp-for="Description" class="cb-area"
                                          placeholder="Brief description of this brand…"></textarea>
                            </div>
                            <span asp-validation-for="Description" class="cb-val-msg"></span>
                            <span class="cb-hint"><i class="bi bi-info-circle"></i> Helps team members identify the brand quickly</span>
                        </div>

                        <!-- Settings -->
                        <div class="cb-sec" style="margin-top:8px;"><i class="bi bi-sliders"></i> Settings</div>

                        <div class="cb-field">
                            <div class="cb-toggle-card">
                                <div class="cb-toggle-desc">
                                    <h6><i class="bi bi-toggle-on"></i> Brand Visibility</h6>
                                    <p>Enable to make this brand active and visible in the system</p>
                                </div>
                                <div class="sw-wrap">
                                    <input asp-for="Status" type="checkbox" id="statusSwitch" checked />
                                    <label class="sw-track" for="statusSwitch"></label>
                                </div>
                            </div>
                        </div>

                        <!-- Creation notice -->
                        <div class="cb-notice">
                            <i class="bi bi-calendar-event"></i>
                            <span>Will be created on <strong id="currentDateTime">—</strong></span>
                        </div>

                        <!-- Actions -->
                        <div class="cb-actions">
                            <button type="submit" class="btn-create">
                                <i class="bi bi-check-circle-fill"></i> Create Brand
                            </button>
                            <a asp-controller="Brand" asp-action="Index" class="btn-discard">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>

                    </div>
                    <!-- ════ END LEFT ════ -->

                    <!-- ════ RIGHT PANEL ════ -->
                    <div class="cb-right">

                        <div class="cb-logo-heading">
                            <i class="bi bi-image-fill"></i> Brand Logo
                        </div>

                        <div class="cb-logo-box" id="logoBox" onclick="document.getElementById('logoInput').click();">
                            <!-- Empty state shown before upload -->
                            <div class="cb-logo-empty" id="emptyState">
                                <i class="bi bi-cloud-arrow-up"></i>
                                <span>Click to upload</span>
                            </div>
                            <!-- Preview image (hidden until file selected) -->
                            <img id="previewImage" src="" alt="Brand Logo"
                                 style="display:none; width:100%; height:100%; object-fit:cover;" />
                            <div class="cb-logo-cover">
                                <i class="bi bi-camera-fill"></i>
                                <span>Change image</span>
                            </div>
                        </div>

                        <!-- File input -->
                        <input asp-for="LogoFile" id="logoInput" type="file"
                               style="display:none;" accept="image/*" onchange="previewLogo(event)" />

                        <div class="cb-logo-div"></div>

                        <div class="cb-logo-btns">
                            <label for="logoInput" class="btn-pick">
                                <i class="bi bi-cloud-arrow-up-fill"></i> Choose Logo
                            </label>
                        </div>

                        <div class="cb-logo-hints">
                            <span><i class="bi bi-file-earmark-image"></i> JPG, PNG or GIF · Max 2 MB</span>
                            <span><i class="bi bi-aspect-ratio"></i> Recommended 500 × 500 px</span>
                            <span><i class="bi bi-info-circle"></i> Logo is optional</span>
                        </div>

                        <div class="cb-fname" id="fileNameRow">
                            <i class="bi bi-paperclip"></i>
                            <span id="selectedFileName"></span>
                        </div>

                    </div>
                    <!-- ════ END RIGHT ════ -->

                </div><!-- /.cb-panels -->
            </form>
        </div><!-- /.cb-form-area -->

    </div><!-- /.cb-wrap -->

</div><!-- /.cb-page -->

@section Scripts {
<script>
function previewLogo(e) {
    const file = e.target.files[0];
    if (!file) return;
    if (file.size > 2 * 1024 * 1024) { alert('File must be under 2 MB.'); e.target.value = ''; return; }
    if (!file.type.match('image.*'))  { alert('Please select an image file.'); e.target.value = ''; return; }
    const r = new FileReader();
    r.onload = ev => {
        const img = document.getElementById('previewImage');
        img.src = ev.target.result;
        img.style.display = 'block';
        document.getElementById('emptyState').style.display = 'none';
        document.getElementById('selectedFileName').textContent = file.name;
        document.getElementById('fileNameRow').style.display = 'flex';
    };
    r.readAsDataURL(file);
}

/* Show formatted creation date */
document.addEventListener('DOMContentLoaded', function () {
    const el = document.getElementById('currentDateTime');
    if (el) {
        const now = new Date();
        el.textContent = now.toLocaleDateString('en-US', {
            year: 'numeric', month: 'long', day: 'numeric',
            hour: '2-digit', minute: '2-digit'
        });
    }
});

/* Auto-resize textarea */
const ta = document.querySelector('.cb-area');
if (ta) {
    ta.addEventListener('input', function () {
        this.style.height = 'auto';
        this.style.height = this.scrollHeight + 'px';
    });
}

/* Native validation */
document.querySelectorAll('.needs-validation').forEach(form => {
    form.addEventListener('submit', e => {
        if (!form.checkValidity()) { e.preventDefault(); e.stopPropagation(); }
        form.classList.add('was-validated');
    }, false);
});
</script>
<partial name="_ValidationScriptsPartial" />
}
