@model Sandoohouse.Models.Category
@{
    ViewData["Title"] = Model.CategoryName + " — Details";
    int totalMenus  = Model.Menus?.Count ?? 0;
    int activeMenus = Model.Menus?.Count(m => m.Status) ?? 0;
    int discounted  = Model.Menus?.Count(m => m.DiscountPrice.HasValue) ?? 0;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
:root {
    --brand:        #FF6B35;
    --brand-dark:   #E85520;
    --brand-light:  #FFF0EA;
    --brand-mid:    rgba(255,107,53,.13);
    --accent:       #1C2340;
    --success:      #00B894;
    --success-bg:   rgba(0,184,148,.1);
    --warning:      #F0A500;
    --warning-bg:   rgba(240,165,0,.1);
    --danger:       #E84545;
    --danger-bg:    rgba(232,69,69,.1);
    --bg:           #F2EFE9;
    --surface:      #FFFFFF;
    --surface2:     #FAF8F5;
    --surface3:     #F4F1EC;
    --border:       #EAE5DC;
    --border-s:     #D8D2C8;
    --text:         #18150F;
    --text-sub:     #6E685F;
    --text-light:   #AEA89F;
    --shadow-xs:    0 1px 3px rgba(24,21,15,.05);
    --shadow-sm:    0 2px 8px rgba(24,21,15,.07);
    --shadow-md:    0 6px 24px rgba(24,21,15,.10);
    --shadow-lg:    0 16px 48px rgba(24,21,15,.14);
    --shadow-brand: 0 6px 20px rgba(255,107,53,.32);
    --r-xs: 6px; --r-sm: 10px; --r-md: 16px; --r-lg: 24px; --r-xl: 32px;
    --font: 'Sora', sans-serif;
}

*, *::before, *::after { box-sizing: border-box; }

.cd-page {
    font-family: var(--font);
    background: var(--bg);
    background-image: radial-gradient(circle, #D8D2C8 1px, transparent 1px);
    background-size: 28px 28px;
    min-height: 100vh;
    padding: 28px 24px;
    color: var(--text);
}

/* ── Topbar ── */
.cd-topbar {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 26px; flex-wrap: wrap; gap: 12px;
    max-width: 960px; margin-left: auto; margin-right: auto;
}
.cd-topbar-left h1 { font-size: 20px; font-weight: 700; color: var(--text); margin: 0 0 5px; letter-spacing: -.4px; }
.cd-breadcrumb {
    display: flex; align-items: center; gap: 6px;
    font-size: 12px; font-weight: 500; margin: 0; padding: 0; list-style: none;
}
.cd-breadcrumb a { color: var(--text-light); text-decoration: none; transition: color .14s; }
.cd-breadcrumb a:hover { color: var(--brand); }
.cd-breadcrumb .sep { color: var(--border-s); }
.cd-breadcrumb .cur { color: var(--text-sub); font-weight: 600; }

.btn-back {
    display: inline-flex; align-items: center; gap: 7px;
    height: 38px; padding: 0 18px;
    border: 1.5px solid var(--border); border-radius: var(--r-xl);
    background: var(--surface); color: var(--text-sub);
    font-family: var(--font); font-size: 13px; font-weight: 600;
    text-decoration: none; transition: all .16s;
}
.btn-back:hover { border-color: var(--brand); color: var(--brand); background: var(--brand-light); text-decoration: none; }

/* ── Wrapper ── */
.cd-wrap { max-width: 960px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }

/* ── Hero card ── */
.cd-hero {
    background: var(--accent);
    border-radius: var(--r-lg);
    padding: 32px 36px;
    display: flex; align-items: center; gap: 24px;
    position: relative; overflow: hidden;
    box-shadow: var(--shadow-md);
}
.cd-hero::before {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,.04) 1px, transparent 1px);
    background-size: 22px 22px; pointer-events: none;
}
.cd-hero-orb1 { position: absolute; width: 300px; height: 300px; border-radius: 50%; background: rgba(255,107,53,.07); top: -110px; right: -70px; pointer-events: none; }
.cd-hero-orb2 { position: absolute; width: 180px; height: 180px; border-radius: 50%; background: rgba(255,255,255,.03); bottom: -70px; left: 200px; pointer-events: none; }

/* Category image / placeholder */
.cd-logo-wrap {
    width: 80px; height: 80px; border-radius: var(--r-md);
    overflow: hidden; flex-shrink: 0; z-index: 1;
    border: 2px solid rgba(255,255,255,.15);
    background: rgba(255,255,255,.08); box-shadow: var(--shadow-md);
}
.cd-logo-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
.cd-logo-placeholder {
    width: 80px; height: 80px; border-radius: var(--r-md); flex-shrink: 0; z-index: 1;
    background: var(--brand); border: 2px solid rgba(255,255,255,.15);
    display: flex; align-items: center; justify-content: center;
    font-size: 30px; color: #fff; box-shadow: var(--shadow-brand);
}

.cd-hero-info { z-index: 1; flex: 1; min-width: 0; }
.cd-hero-info h2 { font-size: 24px; font-weight: 800; color: #fff; margin: 0 0 6px; letter-spacing: -.4px; line-height: 1.2; }
.cd-hero-info p  { font-size: 12px; color: rgba(255,255,255,.5); margin: 0 0 12px; font-weight: 500; line-height: 1.6; }

.cd-hero-meta { display: flex; gap: 10px; flex-wrap: wrap; }
.cd-meta-chip {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700;
    background: rgba(255,255,255,.08); color: rgba(255,255,255,.7);
    border: 1px solid rgba(255,255,255,.12);
}
.cd-meta-chip i { font-size: 10px; }
.cd-meta-chip.active   { background: var(--success-bg); color: var(--success); border-color: rgba(0,184,148,.25); }
.cd-meta-chip.inactive { background: rgba(255,255,255,.06); color: rgba(255,255,255,.4); }
.cd-meta-chip.brand    { background: var(--brand-mid); color: var(--brand); border-color: rgba(255,107,53,.25); }

/* Hero actions */
.cd-hero-actions { display: flex; flex-direction: column; gap: 8px; z-index: 1; flex-shrink: 0; }
.btn-edit-hero {
    height: 38px; padding: 0 18px;
    background: var(--brand); color: #fff;
    border: none; border-radius: var(--r-xl);
    font-family: var(--font); font-size: 12px; font-weight: 700;
    cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 7px;
    text-decoration: none; box-shadow: var(--shadow-brand); transition: all .16s; white-space: nowrap;
}
.btn-edit-hero:hover { background: var(--brand-dark); color: #fff; transform: translateY(-1px); text-decoration: none; }

/* ── KPI strip ── */
.cd-kpi-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
.cd-kpi {
    background: var(--surface); border: 1.5px solid var(--border);
    border-radius: var(--r-md); padding: 18px 20px;
    display: flex; align-items: center; gap: 14px;
    box-shadow: var(--shadow-xs); transition: all .2s;
    position: relative; overflow: hidden;
}
.cd-kpi::after {
    content: ''; position: absolute; bottom: 0; left: 0;
    height: 3px; width: 100%;
    background: var(--kc, var(--brand));
    transform: scaleX(0); transform-origin: left; transition: transform .3s;
}
.cd-kpi:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
.cd-kpi:hover::after { transform: scaleX(1); }

.cd-kpi-icon {
    width: 42px; height: 42px; border-radius: var(--r-sm);
    background: var(--ki, var(--brand-light)); color: var(--kc, var(--brand));
    display: flex; align-items: center; justify-content: center;
    font-size: 17px; flex-shrink: 0;
}
.cd-kpi-text { min-width: 0; }
.cd-kpi-label { font-size: 10px; font-weight: 600; color: var(--text-light); text-transform: uppercase; letter-spacing: .06em; }
.cd-kpi-val   { font-size: 22px; font-weight: 800; color: var(--text); letter-spacing: -.4px; line-height: 1; margin-top: 3px; }
.kpi-brand   { --kc: var(--brand);   --ki: var(--brand-light); }
.kpi-green   { --kc: var(--success); --ki: var(--success-bg); }
.kpi-accent  { --kc: var(--accent);  --ki: rgba(28,35,64,.08); }
.kpi-danger  { --kc: var(--danger);  --ki: var(--danger-bg); }

/* ── Main content card ── */
.cd-content {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
}
.cd-content-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 28px; border-bottom: 1.5px solid var(--border);
    background: var(--surface2);
}
.cd-content-title { display: flex; align-items: center; gap: 10px; }
.cd-title-bar { width: 4px; height: 20px; background: var(--brand); border-radius: 4px; }
.cd-content-title h3 { font-size: 15px; font-weight: 700; color: var(--text); margin: 0; }
.cd-content-title small { font-size: 12px; color: var(--text-light); margin-top: 2px; }
.cd-count-pill {
    font-size: 11px; font-weight: 700; color: var(--brand);
    background: var(--brand-light); padding: 3px 10px; border-radius: 20px;
}

/* ── Empty state ── */
.cd-empty {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 64px 24px; gap: 12px;
}
.cd-empty-icon {
    width: 60px; height: 60px; border-radius: var(--r-md);
    background: var(--surface2); color: var(--text-light);
    display: flex; align-items: center; justify-content: center; font-size: 26px;
}
.cd-empty strong { font-size: 15px; color: var(--text-sub); }
.cd-empty p { font-size: 13px; color: var(--text-light); text-align: center; margin: 0; max-width: 280px; }

/* ── Menu items grid ── */
.cd-menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
    padding: 24px 28px;
}

/* Menu item card */
.cd-menu-card {
    background: var(--surface); border: 1.5px solid var(--border);
    border-radius: var(--r-md); overflow: hidden;
    transition: all .2s; position: relative;
}
.cd-menu-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: var(--border-s); }

.cd-menu-img {
    width: 100%; height: 130px; overflow: hidden;
    background: var(--surface3);
    display: flex; align-items: center; justify-content: center;
}
.cd-menu-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .3s; }
.cd-menu-card:hover .cd-menu-img img { transform: scale(1.04); }
.cd-menu-img-placeholder { font-size: 34px; color: var(--text-light); }

.cd-menu-body { padding: 14px 16px; }
.cd-menu-name { font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 6px; line-height: 1.3; }

.cd-menu-price-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.cd-price-final    { font-size: 16px; font-weight: 800; color: var(--brand); letter-spacing: -.3px; }
.cd-price-original { font-size: 11px; font-weight: 500; color: var(--text-light); text-decoration: line-through; }
.cd-price-save {
    font-size: 10px; font-weight: 700;
    background: var(--success-bg); color: var(--success);
    padding: 2px 7px; border-radius: 20px; margin-left: auto;
}

.cd-menu-id { font-size: 10px; color: var(--text-light); font-weight: 500; }

.cd-menu-foot {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 16px; border-top: 1px solid var(--border);
    background: var(--surface2);
}
.cd-menu-status {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 10px; font-weight: 700;
    padding: 3px 10px; border-radius: 20px;
}
.cd-menu-status.active   { background: var(--success-bg); color: var(--success); }
.cd-menu-status.inactive { background: var(--surface2); color: var(--text-light); border: 1px solid var(--border); }

/* ── Brand info section ── */
.cd-brand-section {
    border-top: 1.5px solid var(--border);
    padding: 20px 28px;
    background: var(--surface2);
}
.cd-brand-row {
    display: flex; align-items: center; gap: 14px;
}
.cd-brand-thumb {
    width: 44px; height: 44px; border-radius: var(--r-sm);
    overflow: hidden; border: 1.5px solid var(--border);
    background: var(--surface3); flex-shrink: 0;
}
.cd-brand-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.cd-brand-thumb-placeholder {
    width: 44px; height: 44px; border-radius: var(--r-sm);
    background: var(--brand-light); color: var(--brand);
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; flex-shrink: 0;
}
.cd-brand-info { display: flex; flex-direction: column; gap: 2px; }
.cd-brand-sub  { font-size: 10px; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: .06em; }
.cd-brand-name { font-size: 14px; font-weight: 700; color: var(--text); }

/* ── Responsive ── */
@@media (max-width: 820px) {
    .cd-kpi-strip { grid-template-columns: 1fr 1fr; }
    .cd-menu-grid { grid-template-columns: 1fr 1fr; padding: 16px 18px; }
    .cd-hero { flex-direction: column; align-items: flex-start; padding: 24px 22px; gap: 16px; }
    .cd-hero-actions { flex-direction: row; }
}
@@media (max-width: 500px) {
    .cd-page { padding: 14px 12px; }
    .cd-kpi-strip { grid-template-columns: 1fr 1fr; }
    .cd-menu-grid { grid-template-columns: 1fr; }
}
</style>

<div class="cd-page">

    <!-- ── Topbar ── -->
    <div class="cd-topbar">
        <div class="cd-topbar-left">
            <h1>Category Details</h1>
            <nav class="cd-breadcrumb">
                <a asp-controller="Home"     asp-action="Index"><i class="bi bi-house-door-fill"></i></a>
                <span class="sep">›</span>
                <a asp-controller="Category" asp-action="Index">Category</a>
                <span class="sep">›</span>
                <span class="cur">@Model.CategoryName</span>
            </nav>
        </div>
        <a asp-controller="Category" asp-action="Index" class="btn-back">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="cd-wrap">

        <!-- ── Hero ── -->
        <div class="cd-hero">
            <div class="cd-hero-orb1"></div>
            <div class="cd-hero-orb2"></div>

            @if (!string.IsNullOrEmpty(Model.CategoryImageUrl))
            {
                <div class="cd-logo-wrap">
                    <img src="@Url.Content($"{Model.CategoryImageUrl}")" alt="@Model.CategoryName" />
                </div>
            }
            else
            {
                <div class="cd-logo-placeholder"><i class="bi bi-folder2-open"></i></div>
            }

            <div class="cd-hero-info">
                <h2>@Model.CategoryName</h2>
                <p>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    { @Model.Description }
                    else
                    { <text>No description provided</text> }
                </p>
                <div class="cd-hero-meta">
                    <span class="cd-meta-chip @(Model.Status ? "active" : "inactive")">
                        <i class="bi bi-circle-fill" style="font-size:7px;"></i>
                        @(Model.Status ? "Active" : "Inactive")
                    </span>
                    @if (Model.Brand != null)
                    {
                        <span class="cd-meta-chip brand">
                            <i class="bi bi-building"></i> @Model.Brand.BrandName
                        </span>
                    }
                    <span class="cd-meta-chip">
                        <i class="bi bi-calendar-check"></i>
                        Created @Model.CreatedAt.ToString("MMM dd, yyyy")
                    </span>
                    <span class="cd-meta-chip">
                        <i class="bi bi-tag"></i>
                        ID #@Model.Id
                    </span>
                </div>
            </div>

            <div class="cd-hero-actions">
                <a asp-controller="Category" asp-action="EditCategory" asp-route-id="@Model.Id"
                   class="btn-edit-hero">
                    <i class="bi bi-pencil-fill"></i> Edit Category
                </a>
            </div>
        </div>

        <!-- ── KPI strip ── -->
        <div class="cd-kpi-strip">
            <div class="cd-kpi kpi-brand">
                <div class="cd-kpi-icon"><i class="bi bi-grid"></i></div>
                <div class="cd-kpi-text">
                    <div class="cd-kpi-label">Total Items</div>
                    <div class="cd-kpi-val">@totalMenus</div>
                </div>
            </div>
            <div class="cd-kpi kpi-green">
                <div class="cd-kpi-icon"><i class="bi bi-check-circle"></i></div>
                <div class="cd-kpi-text">
                    <div class="cd-kpi-label">Active Items</div>
                    <div class="cd-kpi-val">@activeMenus</div>
                </div>
            </div>
            <div class="cd-kpi kpi-accent">
                <div class="cd-kpi-icon"><i class="bi bi-moon-stars"></i></div>
                <div class="cd-kpi-text">
                    <div class="cd-kpi-label">Inactive Items</div>
                    <div class="cd-kpi-val">@(totalMenus - activeMenus)</div>
                </div>
            </div>
            <div class="cd-kpi kpi-danger">
                <div class="cd-kpi-icon"><i class="bi bi-percent"></i></div>
                <div class="cd-kpi-text">
                    <div class="cd-kpi-label">On Discount</div>
                    <div class="cd-kpi-val">@discounted</div>
                </div>
            </div>
        </div>

        <!-- ── Menu items content card ── -->
        <div class="cd-content">

            <div class="cd-content-head">
                <div class="cd-content-title">
                    <span class="cd-title-bar"></span>
                    <div>
                        <h3>Menu Items</h3>
                        <small>All items under this category</small>
                    </div>
                </div>
                <span class="cd-count-pill">@totalMenus item@(totalMenus == 1 ? "" : "s")</span>
            </div>

            @if (Model.Menus == null || !Model.Menus.Any())
            {
                <div class="cd-empty">
                    <div class="cd-empty-icon"><i class="bi bi-inbox"></i></div>
                    <strong>No menu items yet</strong>
                    <p>This category doesn't have any menu items assigned to it yet.</p>
                </div>
            }
            else
            {
                <div class="cd-menu-grid">
                    @foreach (var menu in Model.Menus)
                    {
                        decimal finalPrice  = menu.DiscountPrice ?? menu.Price;
                        bool    hasDiscount = menu.DiscountPrice.HasValue && menu.DiscountPrice < menu.Price;
                        decimal savings     = menu.Price - finalPrice;

                        <div class="cd-menu-card">
                            <!-- Image -->
                            <div class="cd-menu-img">
                                @if (!string.IsNullOrEmpty(menu.ImageMenuUrl))
                                {
                                    <img src="@Url.Content($"{menu.ImageMenuUrl}")" alt="@menu.MenuName" />
                                }
                                else
                                {
                                    <span class="cd-menu-img-placeholder"><i class="bi bi-image"></i></span>
                                }
                            </div>

                            <!-- Body -->
                            <div class="cd-menu-body">
                                <div class="cd-menu-name">@menu.MenuName</div>
                                <div class="cd-menu-price-row">
                                    <span class="cd-price-final">$@finalPrice.ToString("F2")</span>
                                    @if (hasDiscount)
                                    {
                                        <span class="cd-price-original">$@menu.Price.ToString("F2")</span>
                                        <span class="cd-price-save">-$@savings.ToString("F2")</span>
                                    }
                                </div>
                                <div class="cd-menu-id">ID #@menu.Id</div>
                            </div>

                            <!-- Footer -->
                            <div class="cd-menu-foot">
                                <span class="cd-menu-status @(menu.Status ? "active" : "inactive")">
                                    <i class="bi bi-circle-fill" style="font-size:6px;"></i>
                                    @(menu.Status ? "Active" : "Inactive")
                                </span>
                                @if (hasDiscount)
                                {
                                    <span style="font-size:10px;color:var(--danger);font-weight:700;">
                                        <i class="bi bi-percent" style="font-size:9px;"></i> Discounted
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Brand info footer -->
            @if (Model.Brand != null)
            {
                <div class="cd-brand-section">
                    <div class="cd-brand-row">
                        @if (!string.IsNullOrEmpty(Model.Brand.LogoBrandUrl))
                        {
                            <div class="cd-brand-thumb">
                                <img src="@Url.Content($"{Model.Brand.LogoBrandUrl}")" alt="@Model.Brand.BrandName" />
                            </div>
                        }
                        else
                        {
                            <div class="cd-brand-thumb-placeholder"><i class="bi bi-building"></i></div>
                        }
                        <div class="cd-brand-info">
                            <span class="cd-brand-sub">Parent Brand</span>
                            <span class="cd-brand-name">@Model.Brand.BrandName</span>
                        </div>
                        <a asp-controller="Brand" asp-action="ViewBrand" asp-route-id="@Model.Brand.Id"
                           style="margin-left:auto;display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:var(--brand);text-decoration:none;">
                            View Brand <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            }

        </div><!-- /.cd-content -->

    </div><!-- /.cd-wrap -->
</div><!-- /.cd-page -->
