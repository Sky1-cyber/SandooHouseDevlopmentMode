@model Sandoohouse.Models.ModelViewer.AdminModelViewer.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Reset Password</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="@Url.Content("~/assets/img/kaiadmin/SandooHouse.ico")" type="image/x-icon"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
    :root {
        --brand:       #FF6B35;
        --brand-dark:  #E85520;
        --brand-light: #FFF0EA;
        --brand-mid:   rgba(255,107,53,.14);
        --accent:      #2D3561;
        --bg:          #F7F4F0;
        --surface:     #FFFFFF;
        --surface2:    #FAF8F5;
        --border:      #EDE8E0;
        --border-s:    #DDD7CE;
        --text:        #1A1714;
        --text-sub:    #7A736B;
        --text-light:  #B5AFA8;
        --danger:      #E84545;
        --danger-bg:   rgba(232,69,69,.08);
        --success:     #00B894;
        --success-bg:  rgba(0,184,148,.1);
        --font:        'Sora','Noto Sans Khmer',sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        font-family: var(--font);
        min-height: 100vh;
        background: var(--bg);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background-image: radial-gradient(circle, #DDD7CE 1px, transparent 1px);
        background-size: 28px 28px;
    }

    /* ── Wrapper ── */
    .rp-wrap {
        width: 100%;
        max-width: 440px;
        display: flex;
        flex-direction: column;
    }

    /* ── Brand bar ── */
    .rp-brand {
        background: var(--accent);
        border-radius: 22px 22px 0 0;
        padding: 28px 32px 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        position: relative;
        overflow: hidden;
    }
    .rp-brand::before,
    .rp-brand::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        background: rgba(255,255,255,.05);
        pointer-events: none;
    }
    .rp-brand::before { width: 200px; height: 200px; top: -80px; right: -40px; }
    .rp-brand::after  { width: 120px; height: 120px; bottom: -50px; left: 160px; }

    .brand-icon {
        width: 48px; height: 48px;
        border-radius: 14px;
        background: var(--brand);
        display: flex; align-items: center; justify-content: center;
        font-size: 22px; color: #fff;
        flex-shrink: 0; z-index: 1;
        box-shadow: 0 4px 16px rgba(255,107,53,.4);
    }
    .brand-text { z-index: 1; }
    .brand-text h2 {
        font-size: 18px; font-weight: 700; color: #fff;
        margin: 0 0 2px; letter-spacing: -.3px;
    }
    .brand-text p {
        font-size: 12px; color: rgba(255,255,255,.55);
        font-weight: 500; margin: 0;
    }

    /* ── Card ── */
    .rp-card {
        background: var(--surface);
        border-radius: 0 0 22px 22px;
        border: 1.5px solid var(--border);
        border-top: none;
        padding: 32px 32px 28px;
        box-shadow: 0 16px 48px rgba(26,23,20,.13);
    }

    /* ── Greeting ── */
    .rp-greeting { margin-bottom: 24px; }
    .rp-greeting h3 {
        font-size: 20px; font-weight: 700; color: var(--text);
        margin: 0 0 4px; letter-spacing: -.4px;
    }
    .rp-greeting p { font-size: 13px; color: var(--text-light); font-weight: 500; margin: 0; }

    /* ── Steps indicator ── */
    .rp-steps {
        display: flex; align-items: center; gap: 0;
        margin-bottom: 26px;
    }
    .rp-step {
        display: flex; flex-direction: column; align-items: center; gap: 4px;
        flex: 1;
    }
    .step-dot {
        width: 28px; height: 28px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 11px; font-weight: 700;
    }
    .step-dot.done {
        background: var(--success-bg); color: var(--success);
        border: 2px solid rgba(0,184,148,.3);
    }
    .step-dot.active {
        background: var(--brand); color: #fff;
        box-shadow: 0 3px 10px rgba(255,107,53,.35);
    }
    .step-dot.pending {
        background: var(--surface2); color: var(--text-light);
        border: 2px solid var(--border);
    }
    .step-label { font-size: 10px; font-weight: 600; color: var(--text-light); white-space: nowrap; }
    .step-label.active { color: var(--brand); }
    .step-label.done   { color: var(--success); }

    .step-line {
        flex: 1; height: 2px;
        background: var(--border);
        margin-bottom: 14px;
        max-width: 40px;
    }
    .step-line.done { background: var(--success); }

    /* ── Error alert ── */
    .rp-alert {
        display: flex; align-items: center; gap: 10px;
        background: var(--danger-bg);
        border: 1px solid rgba(232,69,69,.2);
        border-left: 3px solid var(--danger);
        border-radius: 10px;
        padding: 11px 14px;
        margin-bottom: 20px;
        font-size: 13px; font-weight: 500; color: var(--danger);
    }
    .rp-alert i { font-size: 15px; flex-shrink: 0; }

    /* ── Field ── */
    .rp-field { margin-bottom: 18px; }
    .rp-label {
        display: block;
        font-size: 12px; font-weight: 600;
        color: var(--text-sub);
        margin-bottom: 7px;
    }

    .rp-input-wrap {
        display: flex; align-items: center;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        background: var(--surface2);
        overflow: hidden;
        transition: border-color .15s, box-shadow .15s;
    }
    .rp-input-wrap:focus-within {
        border-color: var(--brand);
        box-shadow: 0 0 0 3px var(--brand-mid);
        background: var(--surface);
    }
    .rp-input-wrap.has-error { border-color: var(--danger); }
    .rp-input-wrap.has-error:focus-within { box-shadow: 0 0 0 3px var(--danger-bg); }

    .rp-input-icon {
        width: 44px; height: 46px;
        display: flex; align-items: center; justify-content: center;
        font-size: 15px; color: var(--text-light);
        flex-shrink: 0;
        border-right: 1.5px solid var(--border);
        background: var(--surface);
        transition: color .15s, border-color .15s;
    }
    .rp-input-wrap:focus-within .rp-input-icon { color: var(--brand); border-color: var(--brand); }

    .rp-input {
        flex: 1; height: 46px; padding: 0 14px;
        border: none; background: none; outline: none;
        font-family: var(--font); font-size: 13px; color: var(--text);
    }
    .rp-input::placeholder { color: var(--text-light); }

    .rp-eye-btn {
        width: 44px; height: 46px;
        border: none; background: none;
        display: flex; align-items: center; justify-content: center;
        font-size: 15px; color: var(--text-light);
        cursor: pointer; flex-shrink: 0; transition: color .15s;
    }
    .rp-eye-btn:hover { color: var(--brand); }

    .rp-error { font-size: 11px; color: var(--danger); font-weight: 500; margin-top: 5px; display: flex; align-items: center; gap: 4px; }

    /* ── Password strength bar ── */
    .rp-strength { margin-top: 10px; }
    .rp-strength-track {
        height: 4px; background: var(--border);
        border-radius: 4px; overflow: hidden; margin-bottom: 5px;
    }
    .rp-strength-bar {
        height: 100%; width: 0%;
        border-radius: 4px;
        background: var(--text-light);
        transition: width .3s ease, background .3s ease;
    }
    .rp-strength-hint {
        font-size: 11px; font-weight: 600; color: var(--text-light);
        display: flex; align-items: center; gap: 5px;
    }

    /* ── Match indicator ── */
    .rp-match {
        font-size: 11px; font-weight: 600;
        margin-top: 5px;
        display: flex; align-items: center; gap: 5px;
        transition: color .2s;
    }
    .rp-match.ok  { color: var(--success); }
    .rp-match.bad { color: var(--danger); }

    /* ── Submit ── */
    .btn-reset {
        width: 100%; height: 48px;
        background: var(--brand); color: #fff;
        border: none; border-radius: 12px;
        font-family: var(--font); font-size: 14px; font-weight: 700;
        cursor: pointer; letter-spacing: .01em;
        display: flex; align-items: center; justify-content: center; gap: 8px;
        box-shadow: 0 5px 20px rgba(255,107,53,.35);
        transition: all .18s;
        margin-top: 6px;
    }
    .btn-reset:hover { background: var(--brand-dark); transform: translateY(-1px); box-shadow: 0 8px 28px rgba(255,107,53,.4); }
    .btn-reset:active { transform: translateY(0); }

    /* ── Back link ── */
    .rp-back {
        text-align: center; margin-top: 20px;
    }
    .rp-back a {
        font-size: 12px; font-weight: 600;
        color: var(--text-light); text-decoration: none;
        display: inline-flex; align-items: center; gap: 5px;
        transition: color .15s;
    }
    .rp-back a:hover { color: var(--brand); }

    /* ── Footer ── */
    .rp-footer {
        text-align: center; margin-top: 22px;
        font-size: 12px; font-weight: 500; color: var(--text-light);
        display: flex; align-items: center; justify-content: center; gap: 6px;
    }
    .rp-footer span { color: var(--brand); font-weight: 700; }

    /* ── Responsive ── */
    @@media (max-width: 480px) {
        .rp-brand { padding: 22px 22px 20px; }
        .rp-card  { padding: 24px 22px 22px; }
        .rp-wrap  { max-width: 100%; }
    }
    </style>
</head>
<body>

<div class="rp-wrap">

    <!-- Brand header — same as Login -->
    <div class="rp-brand">
        <div class="brand-icon">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <div class="brand-text">
            <h2>Sandoo House</h2>
            <p>Admin Management System</p>
        </div>
    </div>

    <!-- Card -->
    <div class="rp-card">

        <div class="rp-greeting">
            <h3>Create new password 🔐</h3>
            <p>Choose a strong password to secure your account</p>
        </div>

        <!-- Step indicator -->
        <div class="rp-steps">
            <div class="rp-step">
                <div class="step-dot done"><i class="bi bi-check-lg"></i></div>
                <span class="step-label done">Verify</span>
            </div>
            <div class="step-line done"></div>
            <div class="rp-step">
                <div class="step-dot active">2</div>
                <span class="step-label active">New Password</span>
            </div>
            <div class="step-line"></div>
            <div class="rp-step">
                <div class="step-dot pending">3</div>
                <span class="step-label">Done</span>
            </div>
        </div>

        <!-- Error summary -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="rp-alert">
                <i class="bi bi-exclamation-circle-fill"></i>
                Please fix the errors below before continuing.
            </div>
        }

        <!-- Form -->
        <form asp-action="ResetPassword" method="post" id="resetForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <!-- New password -->
            <div class="rp-field">
                <label class="rp-label">New Password</label>
                <div class="rp-input-wrap @(ViewData.ModelState["NewPassword"]?.Errors.Any() == true ? "has-error" : "")">
                    <span class="rp-input-icon"><i class="bi bi-lock-fill"></i></span>
                    <input asp-for="NewPassword"
                           id="newPwd"
                           class="rp-input"
                           type="password"
                           placeholder="Create a strong password"
                           autocomplete="new-password" />
                    <button type="button" class="rp-eye-btn" onclick="togglePwd('newPwd','eye1')">
                        <i class="bi bi-eye" id="eye1"></i>
                    </button>
                </div>
                
                <!-- Strength bar -->
                <div class="rp-strength" id="strengthWrap" style="display:none;">
                    <div class="rp-strength-track">
                        <div class="rp-strength-bar" id="strengthBar"></div>
                    </div>
                    <div class="rp-strength-hint" id="strengthHint"></div>
                </div>
            </div>

            <!-- Confirm password -->
            <div class="rp-field">
                <label class="rp-label">Confirm New Password</label>
                <div class="rp-input-wrap @(ViewData.ModelState["ConfirmPassword"]?.Errors.Any() == true ? "has-error" : "")">
                    <span class="rp-input-icon"><i class="bi bi-eye" id="eyeIcon"></i></span>
                    <input asp-for="ConfirmPassword"
                           id="confirmPwd"
                           class="rp-input"
                           type="password"
                           placeholder="Re-enter your password"
                           autocomplete="new-password" />
                    <button type="button" class="rp-eye-btn" onclick="togglePwd('confirmPwd','eye2')">
                        <i class="bi bi-eye" id="eye2"></i>
                    </button>
                </div>
                
                <div class="rp-match" id="matchHint" style="display:none;"></div>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn-reset">
                <i class="bi bi-check-circle-fill"></i>
                Reset Password
            </button>
        </form>

        <!-- Back to login -->
        <div class="rp-back">
            <a asp-controller="Home" asp-action="Login">
                <i class="bi bi-arrow-left"></i> Back to login
            </a>
        </div>

        <!-- Footer -->
        <div class="rp-footer">
            <i class="bi bi-c-circle"></i>
            2026 <span>Sandoo House</span> · All rights reserved
        </div>

    </div><!-- /.rp-card -->
</div><!-- /.rp-wrap -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<partial name="_ValidationScriptsPartial" />

<script>
/* ── Toggle password visibility ── */
function togglePwd(inputId, iconId) {
    const inp  = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    const show = inp.type === 'password';
    inp.type = show ? 'text' : 'password';
    icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
}

/* ── Password strength ── */
const newPwd     = document.getElementById('newPwd');
const confirmPwd = document.getElementById('confirmPwd');
const bar        = document.getElementById('strengthBar');
const hint       = document.getElementById('strengthHint');
const wrap       = document.getElementById('strengthWrap');
const matchHint  = document.getElementById('matchHint');

const levels = [
    { label: '🔴 Too weak',  color: '#E84545', pct: '20%' },
    { label: '🟠 Weak',      color: '#E84545', pct: '35%' },
    { label: '🟡 Fair',      color: '#F0A500', pct: '55%' },
    { label: '🔵 Good',      color: '#2D3561', pct: '75%' },
    { label: '🟢 Strong',    color: '#00B894', pct: '100%' }
];

newPwd.addEventListener('input', function () {
    const v = this.value;
    if (!v.length) { wrap.style.display = 'none'; checkMatch(); return; }
    wrap.style.display = 'block';

    const score = [v.length >= 8, /[A-Z]/.test(v), /[a-z]/.test(v), /[0-9]/.test(v), /[^A-Za-z0-9]/.test(v)]
                  .filter(Boolean).length;

    const lvl = levels[Math.max(0, score - 1)];
    bar.style.width      = lvl.pct;
    bar.style.background = lvl.color;
    hint.textContent     = lvl.label;
    hint.style.color     = lvl.color;

    checkMatch();
});

confirmPwd.addEventListener('input', checkMatch);

function checkMatch() {
    const a = newPwd.value;
    const b = confirmPwd.value;
    if (!b.length) { matchHint.style.display = 'none'; return; }
    matchHint.style.display = 'flex';
    if (a === b) {
        matchHint.className     = 'rp-match ok';
        matchHint.innerHTML     = '<i class="bi bi-check-circle-fill"></i> Passwords match';
    } else {
        matchHint.className     = 'rp-match bad';
        matchHint.innerHTML     = '<i class="bi bi-x-circle-fill"></i> Passwords do not match';
    }
}
</script>

</body>
</html>
