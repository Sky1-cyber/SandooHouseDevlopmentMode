@model Sandoohouse.Models.Admin
@using Sandoohouse.Models.Enum
@{
ViewData["Title"] = "Edit Account";
}

<!-- Add Bootstrap Icons if not already included -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="page-inner">
    <div class="page-header">
        <h3 class="fw-bold mb-3">Edit Profile</h3>
        <ul class="breadcrumbs mb-3">
            <li class="nav-home">
                <a asp-controller="Home" asp-action="Index">
                    <i class="icon-home"></i>
                </a>
            </li>
            <li class="separator">
                <i class="icon-arrow-right"></i>
            </li>
            <li class="nav-item">
                <a asp-controller="Account" asp-action="ListAccount">Account</a>
            </li>
            <li class="separator">
                <i class="icon-arrow-right"></i>
            </li>
            <li class="nav-item">Edit Account</li>
        </ul>
    </div>
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Main Form Card -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Card Header with Gradient -->
                <div class="card-header bg-gradient-primary text-white border-0 py-4">
                    <div class="d-flex align-items-center">
                        <div class="p-3 me-3">
                            <i class="bi bi-person-fill-gear fs-3"></i>
                        </div>
                        <div>
                            <h4 class="mb-1 fw-bold">Edit Account Information</h4>
                            <p class="mb-0 small opacity-75">Update user details and manage account settings</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-5">
                    <form asp-controller="Account" asp-action="EditAccount" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                        <input type="hidden" asp-for="Id" />

                        <!-- Profile Image Section -->
                        <div class="text-center mb-5">
                            <div class="position-relative d-inline-block">
                                <div class="profile-image-wrapper rounded-circle border-4 border-primary shadow-lg"
                                     style="width: 130px; height: 130px; overflow: hidden; cursor: pointer;"
                                     onclick="document.getElementById('profileImageInput').click();">
                                    <img id="previewImage"
                                         src="@Url.Content(Model.ProfileImageFile != null ? $"~/Admin/{Model.ProfileImageFile}" : "~/l60Hf.png")"
                                         class="w-100 h-100"
                                         alt="Admin Image"
                                         style="object-fit: cover;" />
                                    <div class="profile-image-overlay">
                                        <i class="bi bi-camera-fill text-white"></i>
                                    </div>
                                </div>
                                <div class="position-absolute bottom-0 end-0 bg-primary rounded-circle p-2 border border-2 border-white">
                                    <i class="bi bi-check-lg text-white small"></i>
                                </div>
                            </div>
                            <div class="mt-3">
                                <label for="profileImageInput" class="btn btn-outline-primary rounded-pill btn-sm">
                                    <i class="bi bi-camera me-2"></i>Change Photo
                                </label>
                                <input type="file"
                                       name="ProfileImageUrl"
                                       id="profileImageInput"
                                       class="d-none"
                                       accept="image/*"
                                       onchange="previewFile(event)" />
                                <p class="text-muted small mt-2 mb-0">
                                    <i class="bi bi-info-circle me-1"></i>Allowed JPG, PNG, GIF. Max 2MB
                                </p>
                            </div>
                        </div>

                        <!-- Form Fields -->
                        <div class="row g-4">
                            <!-- First Name -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">
                                    First Name <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-2">
                                        <i class="bi bi-person text-primary"></i>
                                    </span>
                                    <input asp-for="FirstName"
                                           class="form-control form-control-lg border-2"
                                           placeholder="Enter first name" />
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <!-- Last Name -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">
                                    Last Name <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-2">
                                        <i class="bi bi-person text-primary"></i>
                                    </span>
                                    <input asp-for="LastName"
                                           class="form-control form-control-lg border-2"
                                           placeholder="Enter last name" />
                                </div>
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">
                                    Email Address <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-2">
                                        <i class="bi bi-envelope text-primary"></i>
                                    </span>
                                    <input asp-for="Email"
                                           class="form-control form-control-lg border-2"
                                           placeholder="name@example.com"
                                           type="email" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <!-- Phone -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">
                                   Phone Number <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-2">
                                        <i class="bi bi-telephone text-primary"></i>
                                    </span>
                                    <input asp-for="PhoneNumber"
                                           class="form-control form-control-lg border-2"
                                           placeholder="+1 (555) 000-0000"
                                           type="tel" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <!-- New Password (Optional) -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">
                                    New Password
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-2">
                                        <i class="bi bi-lock text-primary"></i>
                                    </span>
                                    <input type="password"
                                           name="Password"
                                           id="password"
                                           class="form-control form-control-lg border-2"
                                           placeholder="Enter new password" />
                                    <button class="btn btn-outline-secondary border-2"
                                            type="button"
                                            onclick="togglePassword('password', 'toggleIcon')"
                                            style="border-top-right-radius: 0.5rem; border-bottom-right-radius: 0.5rem;">
                                        <i class="bi bi-eye" id="toggleIcon"></i>
                                    </button>
                                </div>
                                <small class="text-muted d-block mt-2">
                                    <i class="bi bi-info-circle me-1"></i>Leave empty to keep current password
                                </small>
                            </div>

                            <!-- Status with Modern Toggle -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted mb-3">
                                    <i class="bi bi-toggle-on me-2 text-primary"></i>Account Status
                                </label>
                                <div class="bg-light rounded-4 p-3">
                                    <div class="d-flex gap-3">
                                        @foreach (var status in Enum.GetValues(typeof(Status)).Cast<Status>())
                                        {
                                        <div class="form-check form-check-inline">
                                            <input type="radio"
                                                   class="form-check-input status-radio"
                                                   name="Status"
                                                   id="status@(status)"
                                                   value="@status"
                                                   @(Model.Status == status ? "checked" : "") />
                                            <label class="form-check-label" for="status@(status)">
                                                    <span class="badge @(status == Status.Active ? "bg-success" : "bg-secondary") status-badge px-3 py-2">
                                                        @status
                                                    </span>
                                            </label>
                                        </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Account Info Cards -->
                            <div class="col-12 mt-3">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="bg-light rounded-4 p-3">
                                            <small class="text-muted d-block mb-1">Account Created</small>
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-calendar-check text-primary me-2"></i>
                                                <span class="fw-semibold">@DateTime.Now.ToString("MMM dd, yyyy")</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="bg-light rounded-4 p-3">
                                            <small class="text-muted d-block mb-1">Last Login</small>
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-clock-history text-primary me-2"></i>
                                                <span class="fw-semibold">Today at 09:30 AM</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-muted">
                                Role Level
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-light border-2">
                                    <i class="bi bi-bar-chart-steps text-primary"></i>
                                </span>

                                <select asp-for="Role" class="form-select form-control-lg border-2">
                                    <option value="0">Level 0 - Super Admin</option>
                                    <option value="1">Level 1 - Admin</option>
                                    <option value="2">Level 2 - Manager</option>
                                    <option value="3">Level 3 - Staff</option>
                                    <option value="4">Level 4 - Viewer</option>
                                </select>
                            </div>
                        </div>
                        <!-- Action Buttons -->
                        <div class="row mt-5 g-3">
                            <div class="col-md-6">
                                <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill shadow-sm hover-scale">
                                    <i class="bi bi-check-circle me-2"></i>Update Account
                                </button>
                            </div>
                            <div class="col-md-6">
                                <a asp-controller="Account" asp-action="ListAccount"
                                   class="btn btn-outline-danger w-100 py-3 rounded-pill">
                                    <i class="bi bi-x-circle me-2"></i>Cancel
                                </a>
                            </div>
                        </div>

                        <!-- Warning Message -->
                        <div class="alert alert-warning bg-warning bg-opacity-10 border-0 rounded-4 mt-4 mb-0">
                            <div class="d-flex">
                                <i class="bi bi-exclamation-triangle-fill text-warning me-3 fs-5"></i>
                                <div>
                                    <strong>Important:</strong> Changes to account information will take effect immediately. The user will be notified of any changes via email.
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Custom Styles */
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .border-2 {
        border-width: 2px !important;
    }

    .card-body {
        border: 1px solid #e9ecef;
        background: #ffffff;
    }

    .profile-image-wrapper {
        border: 4px solid #0d6efd;
        transition: all 0.3s ease;
    }

    .profile-image-wrapper:hover {
        transform: scale(1.05);
        border-color: #0b5ed7;
    }

    .input-group {
        border: 1px solid #dee2e6;
        border-radius: 0.6rem;
    }

    .input-group:focus-within {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.15rem rgba(13,110,253,.15);
    }

    .hover-scale:hover {
        transform: scale(1.02);
        transition: 0.2s;
    }
    
    .border-4 {
        border-width: 4px !important;
    }

    .hover-scale {
        transition: transform 0.2s;
    }

    .hover-scale:hover {
        transform: translateY(-2px);
    }

    .profile-image-wrapper {
        position: relative;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .profile-image-wrapper:hover .profile-image-overlay {
        opacity: 1;
    }

    .profile-image-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
        border-radius: 50%;
    }

    .form-control-lg, .input-group-text {
        border-radius: 0.5rem;
    }

    .form-control:focus, .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #5a6fd6 0%, #6a4292 100%);
    }

    .btn-outline-primary {
        border: 2px solid #667eea;
        color: #667eea;
    }

    .btn-outline-primary:hover {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-color: transparent;
        color: white;
    }

    .btn-outline-danger {
        border: 2px solid #dc3545;
    }

    .rounded-pill {
        border-radius: 50rem !important;
    }

    .rounded-top-4 {
        border-top-left-radius: 1rem !important;
        border-top-right-radius: 1rem !important;
    }

    /* Status Radio Styling */
    .status-radio {
        display: none;
    }

    .status-radio:checked + label .status-badge {
        transform: scale(1.05);
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.25);
    }

    .status-badge {
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .status-badge:hover {
        transform: scale(1.02);
    }

    /* Danger Zone */
    .border-start.border-4 {
        border-left-width: 4px !important;
    }

    /* Animation */
    #previewImage {
        transition: all 0.3s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: scale(0.9); }
        to { opacity: 1; transform: scale(1); }
    }
</style>

<script>
    function previewFile(event) {
        const reader = new FileReader();
        const file = event.target.files[0];

        if (file) {
            // Validate file size (max 2MB)
            if (file.size > 2 * 1024 * 1024) {
                alert('File size must be less than 2MB');
                event.target.value = '';
                return;
            }

            // Validate file type
            if (!file.type.match('image.*')) {
                alert('Please select an image file');
                event.target.value = '';
                return;
            }

            reader.onload = function() {
                const preview = document.getElementById("previewImage");
                preview.src = reader.result;
                preview.style.animation = "fadeIn 0.5s";
            };

            reader.readAsDataURL(file);
        }
    }

    function togglePassword(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);

        if (input.type === "password") {
            input.type = "text";
            icon.classList.replace("bi-eye", "bi-eye-slash");
        } else {
            input.type = "password";
            icon.classList.replace("bi-eye-slash", "bi-eye");
        }
    }

    function deactivateAccount() {
        // Add your deactivation logic here
        alert('Account deactivation functionality would be implemented here');
        $('#deactivateModal').modal('hide');
    }

    // Form validation
    document.addEventListener('DOMContentLoaded', function() {
        const forms = document.querySelectorAll('.needs-validation');
        Array.from(forms).forEach(form => {
            form.addEventListener('submit', event => {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    });

    // Add animation style
    const style = document.createElement('style');
    style.textContent = `
    @@keyframes fadeIn {
        from { opacity: 0; transform: scale(0.9); }
        to { opacity: 1; transform: scale(1); }
    }
`;
    document.head.appendChild(style);
</script>