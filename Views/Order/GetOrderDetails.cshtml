@model Sandoohouse.Models.Order
@using Sandoohouse.Models.Enum
@{
ViewData["Title"] = "Order Details";
var statusClass = Model.OrderStatus switch {
OrderStatus.Pending  => "pending",
OrderStatus.Paid     => "paid",
OrderStatus.Canceled => "cancelled",
_                    => "pending"
};
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
        --brand:      #FF6B35;
        --brand-dark: #E85520;
        --brand-light:#FFF0EA;
        --accent:     #2D3561;
        --success:    #00B894;
        --warning:    #FDCB6E;
        --danger:     #FF7675;
        --bg:         #F7F4F0;
        --surface:    #FFFFFF;
        --surface2:   #FAF8F5;
        --border:     #EDE8E0;
        --text:       #1A1714;
        --text-sub:   #7A736B;
        --text-light: #B5AFA8;
        --shadow-sm:  0 2px 8px rgba(0,0,0,0.06);
        --shadow-md:  0 8px 24px rgba(0,0,0,0.10);
        --shadow-lg:  0 20px 48px rgba(0,0,0,0.14);
        --r-sm:  10px;
        --r-md:  16px;
        --r-lg:  22px;
        --r-xl:  30px;
        --font-main: 'Khmer OS battambang','Sora','Noto Sans Khmer',sans-serif;
    }

    body {
        font-family: var(--font-main);
        background: var(--bg);
        color: var(--text);
    }

    .od-page { padding: 28px 32px; }

    /* ── Header ── */
    .od-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }
    .od-header-left { display: flex; align-items: center; gap: 14px; }

    .od-icon-box {
        width: 44px; height: 44px;
        background: var(--brand-light);
        border: 1px solid #FFD5C2;
        border-radius: 12px;
        display: grid; place-items: center;
        color: var(--brand);
        flex-shrink: 0;
    }

    .od-title { font-size: 17px; font-weight: 700; letter-spacing: -.2px; color: var(--text); }

    .od-chips { display: flex; gap: 8px; margin-top: 5px; flex-wrap: wrap; }

    .chip-order {
        font-size: 11px; font-weight: 600;
        background: var(--brand-light);
        color: var(--brand-dark);
        border: 1px solid #FFD5C2;
        padding: 3px 10px; border-radius: 20px;
    }
    .chip-status {
        font-size: 11px; font-weight: 600;
        padding: 3px 10px; border-radius: 20px;
        text-transform: capitalize;
    }
    .chip-status.paid      { background: #E6FAF5; color: #00926A; border: 1px solid #B0E8D8; }
    .chip-status.pending   { background: #FFF8E6; color: #C9901A; border: 1px solid #FAE2A0; }
    .chip-status.cancelled { background: #FFF0F0; color: #D94F4F; border: 1px solid #FAC5C5; }

    .btn-back {
        display: flex; align-items: center; gap: 6px;
        font-family: var(--font-main);
        font-size: 12.5px; font-weight: 500;
        color: var(--text-sub);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-sm);
        padding: 8px 14px;
        text-decoration: none;
        transition: color .18s, border-color .18s;
    }
    .btn-back:hover { color: var(--text); border-color: var(--brand); }

    /* ── Info strip ── */
    .od-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 20px;
    }
    .strip-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 14px 16px;
        box-shadow: var(--shadow-sm);
    }
    .strip-label {
        font-size: 11px; font-weight: 500;
        color: var(--text-light);
        margin-bottom: 6px;
        text-transform: uppercase; letter-spacing: .5px;
    }
    .strip-value { font-size: 13.5px; font-weight: 700; color: var(--text); }
    .strip-value.brand     { color: var(--brand); }
    .strip-value.accent    { color: var(--accent); }
    .strip-value.paid      { color: var(--success); }
    .strip-value.pending   { color: #C9901A; }
    .strip-value.cancelled { color: #D94F4F; }

    /* ── Panel ── */
    .panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-md);
        overflow: hidden;
        margin-bottom: 16px;
        box-shadow: var(--shadow-sm);
    }
    .panel-head {
        display: flex; align-items: center; justify-content: space-between;
        padding: 14px 18px;
        border-bottom: 1px solid var(--border);
        background: var(--surface2);
    }
    .panel-title { font-size: 13px; font-weight: 700; color: var(--text); }
    .panel-badge {
        font-size: 11px; font-weight: 600;
        background: var(--brand-light);
        border: 1px solid #FFD5C2;
        color: var(--brand-dark);
        padding: 3px 10px; border-radius: 20px;
    }

    /* ── Items table ── */
    .items-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }
    .items-table thead tr { background: var(--surface2); }
    .items-table th {
        padding: 10px 18px;
        text-align: left;
        font-size: 11px; font-weight: 600;
        color: var(--text-light);
        text-transform: uppercase; letter-spacing: .5px;
        border-bottom: 1px solid var(--border);
    }
    .items-table th:not(:first-child) { text-align: right; }
    .items-table td {
        padding: 13px 18px;
        border-bottom: 1px solid var(--border);
        font-weight: 500;
        vertical-align: middle;
        color: var(--text);
    }
    .items-table td:not(:first-child) { text-align: right; }
    .items-table tbody tr:last-child td { border-bottom: none; }
    .items-table tbody tr:hover { background: var(--surface2); transition: background .12s; }

    .badge-brand {
        display: inline-block;
        font-size: 11px; font-weight: 600;
        background: var(--brand-light);
        color: var(--brand-dark);
        border: 1px solid #FFD5C2;
        padding: 2px 9px; border-radius: 20px;
        margin-right: 6px;
    }
    .price-tag { font-size: 12px; font-weight: 600; color: var(--text-sub); }

    .qty-badge {
        display: inline-block;
        font-size: 12px; font-weight: 700;
        width: 28px; height: 28px; line-height: 28px;
        text-align: center;
        background: #EEF0FF;
        color: var(--accent);
        border: 1px solid #C5CAF0;
        border-radius: 8px;
    }
    .subtotal-val { font-size: 13px; font-weight: 700; color: var(--text); }

    /* ── Summary ── */
    .summary-body {
        padding: 14px 18px;
        border-top: 1px solid var(--border);
        display: flex; flex-direction: column; gap: 10px;
    }
    .summary-row { display: flex; justify-content: space-between; align-items: center; }
    .summary-label { font-size: 12.5px; color: var(--text-sub); font-weight: 500; }
    .summary-val   { font-size: 13px; font-weight: 600; color: var(--text); }
    .summary-val.muted   { color: var(--text-light); }
    .summary-val.success { color: var(--success); font-weight: 700; }

    .summary-divider { height: 1px; background: var(--border); }

    .summary-total-bar {
        display: flex; justify-content: space-between; align-items: center;
        background: var(--accent);
        border-top: 1px solid #1e2447;
        padding: 15px 18px;
    }
    .summary-total-bar > span:first-child {
        font-size: 13px; font-weight: 600; color: #C5CAF0;
    }
    .total-amount { font-size: 18px; font-weight: 700; color: var(--brand); }

    .empty-state {
        padding: 36px 18px;
        text-align: center;
        color: var(--text-light);
        font-size: 13px;
    }

    @@media (max-width: 900px) { .od-strip { grid-template-columns: 1fr 1fr; } }
    @@media (max-width: 500px)  { .od-strip { grid-template-columns: 1fr; } .od-page { padding: 16px; } }
</style>

<div class="od-page">

    <!-- Header -->
    <div class="od-header">
        <div class="od-header-left">
            <div class="od-icon-box">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
            </div>
            <div>
                <div class="od-title">Order Details</div>
                <div class="od-chips">
                    <span class="chip-order">#@Model.OrderNumber</span>
                    <span class="chip-status @statusClass">@Model.OrderStatus</span>
                </div>
            </div>
        </div>

        <a asp-action="Index" asp-controller="Home" class="btn-back">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m15 18-6-6 6-6"/>
            </svg>
            Back to list
        </a>
    </div>

    <!-- Info strip -->
    <div class="od-strip">
        <div class="strip-card">
            <div class="strip-label">Order date</div>
            <div class="strip-value">@Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</div>
        </div>
        <div class="strip-card">
            <div class="strip-label">Order status</div>
            <div class="strip-value @statusClass">@Model.OrderStatus</div>
        </div>
        <div class="strip-card">
            <div class="strip-label">Items in order</div>
            <div class="strip-value brand">
                @(Model.OrderItems?.Count ?? 0) item@(Model.OrderItems?.Count == 1 ? "" : "s")
            </div>
        </div>
        <div class="strip-card">
            <div class="strip-label">Payment method</div>
            <div class="strip-value accent">Cash</div>
        </div>
    </div>

    <!-- Items panel -->
    <div class="panel">
        <div class="panel-head">
            <div class="panel-title">Order items</div>
            <span class="panel-badge">@(Model.OrderItems?.Count ?? 0) items</span>
        </div>

        @if (Model.OrderItems != null && Model.OrderItems.Any())
        {
        <table class="items-table">
            <thead>
            <tr>
                <th>Product</th>
                <th>Qty</th>
                <th>Price</th>
                <th>Total</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.OrderItems)
            {
            <tr>
                <td>
                    @if (item.Menu?.Category?.Brand?.BrandName != null)
                    {
                    <span class="badge-brand">@item.Menu.Category.Brand.BrandName</span>
                    }
                    @item.Menu?.MenuName
                </td>
                <td><span class="qty-badge">@item.Quantity</span></td>
                <td><span class="price-tag">$@item.Price.ToString("F2")</span></td>
                <td><span class="subtotal-val">$@((item.Quantity * item.Price).ToString("F2"))</span></td>
            </tr>
            }
            </tbody>
        </table>
        }
        else
        {
        <div class="empty-state">No items found for this order.</div>
        }

        <!-- Summary -->
        <div class="summary-body">
            <div class="summary-row">
                <span class="summary-label">Subtotal</span>
                <span class="summary-val">$@Model.TotalAmount.ToString("F2")</span>
            </div>
            <div class="summary-row">
                <span class="summary-label">Discount</span>
                <span class="summary-val muted">− $@Model.DiscountAmount.ToString("F2")</span>
            </div>
            <div class="summary-divider"></div>
            <div class="summary-row">
                <span class="summary-label">Cash received</span>
                <span class="summary-val">$@Model.CashReceived.ToString("F2")</span>
            </div>
            <div class="summary-row">
                <span class="summary-label">Change</span>
                <span class="summary-val success">$@Model.ChangeAmount.ToString("F2")</span>
            </div>
        </div>

        <div class="summary-total-bar">
            <span>Total amount</span>
            <span class="total-amount">$@Model.TotalAmount.ToString("F2")</span>
        </div>
    </div>

</div>
