        <div class="shop-details">ទូរស័ព្ទ: 086 262 828</div>
        <div class="shop-details">ភ្នំពេញ, កម្ពុជា</div>
    </div>

    <!-- Order Number -->
    <div class="order-number">លេខ #${order.number}</div>

    <!-- Order Info -->
    <div class="order-info">
        <div class="row">
            <span class="lbl">កាលបរិច្ឆេទ:</span>
            <span class="val">${dateStr} ${timeStr}</span>
        </div>
        <div class="row">
            <span class="lbl">អ្នកលក់:</span>
            <span class="val">${order.cashier || '@firstName @lastName'}</span>
        </div>
    </div>

    <!-- Items Table -->
    <table>
        <thead>
            <tr>
                <th>មុខទំនិញ</th>
                <th style="text-align:center;">ចំនួន</th>
                <th style="text-align:right;">តម្លៃ</th>
                <th style="text-align:right;">សរុប</th>
            </tr>
        </thead>
        <tbody>
            ${itemsHtml}
        </tbody>
