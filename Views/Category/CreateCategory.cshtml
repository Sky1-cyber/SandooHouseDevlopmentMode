@model Sandoohouse.Models.ModelViewer.CategoryModelViewer.CategoryViewerModel
@{
ViewData["Title"] = Model.Id == 0 ? "Create Category" : "Edit Category";
}

<!-- Add this in your layout or section for icons if not already included -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="page-inner">
    <div class="page-header">
        <h3 class="fw-bold mb-3">Create Category</h3>
        <ul class="breadcrumbs mb-3">
            <li class="nav-home">
                <a asp-controller="Home" asp-action="Index">
                    <i class="icon-home"></i>
                </a>
            </li>
            <li class="separator">
                <i class="icon-arrow-right"></i>
            </li>
            <li class="nav-item">
                <a asp-controller="Category" asp-action="Index">Category</a>
            </li>
            <li class="separator">
                <i class="icon-arrow-right"></i>
            </li>
            <li class="nav-item">Create Category</li>
        </ul>
    </div>

    <!-- Main Form Card -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <!-- Card Header with Gradient -->
        <div class="card-header bg-gradient-primary text-white border-0 py-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <h4 class="mb-0 fw-bold">
                <i class="fas fa-info-circle me-2"></i>Category Information
            </h4>
            <p class="mb-0 mt-1 small opacity-75">Fill in the details below to @(Model.Id == 0 ? "create a new" : "update the") category</p>
        </div>

        <div class="card-body p-4">
            <form asp-controller="Category" asp-action="CreateCategory" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                <input type="hidden" asp-for="Id" />

                <div class="row g-4">
                    <!-- Left Column - Form Fields -->
                    <div class="col-lg-8">
                        <!-- Category Name -->
                        <div class="mb-4">
                            <label asp-for="CategoryName" class="form-label fw-semibold text-muted mb-2">
                                <i class="fas fa-tag me-2 text-primary"></i>Category Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="CategoryName"
                                   class="form-control form-control-lg border-2 rounded-3 @(ViewData.ModelState["CategoryName"]?.Errors.Any() == true ? "is-invalid" : "")"
                                   placeholder="e.g., Electronics, Furniture, Clothing" />
                            <span asp-validation-for="CategoryName" class="invalid-feedback"></span>
                            <div class="form-text text-muted">
                                <i class="fas fa-info-circle me-1"></i>Choose a descriptive name for your category
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold text-muted mb-2">
                                <i class="fas fa-align-left me-2 text-primary"></i>Description
                            </label>
                            <textarea asp-for="Description"
                                      class="form-control border-2 rounded-3"
                                      rows="4"
                                      placeholder="Provide a detailed description of this category..."></textarea>
                            <div class="form-text text-muted">
                                <i class="fas fa-info-circle me-1"></i>Optional: Add more details about this category
                            </div>
                        </div>

                        <!-- Status with Toggle -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-muted mb-2">
                                <i class="fas fa-toggle-on me-2 text-primary"></i>Category Status
                            </label>
                            <div class="d-flex align-items-center gap-4 p-3 bg-light rounded-3">
                                <div class="form-check form-switch">
                                    <input asp-for="Status" class="form-check-input" type="checkbox" id="statusToggle" />
                                    <label class="form-check-label fw-semibold" for="statusToggle" id="statusLabel">
                                        @(Model.Status ? "Active" : "Inactive")
                                    </label>
                                </div>
                                <span class="badge @(Model.Status ? "bg-success" : "bg-secondary") px-3 py-2" id="statusBadge">
                                    @(Model.Status ? "Published" : "Draft")
                                </span>
                            </div>
                        </div>

                        <!-- Created Info (Read Only) -->
                        @if (Model.Id != 0)
                        {
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-user me-2 text-primary"></i>Created By
                                </label>
                                <div class="input-group">
                                        <span class="input-group-text bg-light border-2">
                                            <i class="fas fa-user-circle text-primary"></i>
                                        </span>
                                    <input class="form-control bg-light border-2"
                                           value="@Model.CreatedByName"
                                           readonly />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-calendar me-2 text-primary"></i>Created At
                                </label>
                                <div class="input-group">
                                        <span class="input-group-text bg-light border-2">
                                            <i class="fas fa-clock text-primary"></i>
                                        </span>
                                    <input class="form-control bg-light border-2"
                                           value="@Model.CreatedAt.ToString("MMM dd, yyyy 'at' hh:mm tt")"
                                           readonly />
                                </div>
                            </div>
                        </div>
                        }
                    </div>

                    <!-- Right Column - Image Upload (FIXED) -->
                    <div class="col-lg-4">
                        <div class="card border-2 rounded-4 bg-light">
                            <div class="card-body text-center p-4">
                                <label class="form-label fw-semibold text-muted mb-3 w-100">
                                    <i class="fas fa-image me-2 text-primary"></i>Category Image
                                </label>

                                <div class="image-upload-container mb-3">
                                    <div class="image-preview-wrapper mx-auto mb-3" style="width: 180px; height: 180px;">
                                        @if (!string.IsNullOrEmpty(Model.CategoryImageUrl))
                                        {
                                        <img src="@Url.Content(Model.CategoryImageUrl)"
                                             id="imagePreview"
                                             alt=""
                                             class="rounded-4 shadow-sm w-100 h-100"
                                             style="object-fit: cover; display: block;" />
                                        <div id="noImagePlaceholder"
                                             class="bg-white rounded-4 d-flex flex-column align-items-center justify-content-center h-100 border-2 border-dashed"
                                             style="display: none;">
                                            <i class="fas fa-cloud-upload-alt fa-3x text-muted mb-2"></i>
                                            <span class="text-muted small">No image selected</span>
                                        </div>
                                        }
                                        else
                                        {
                                        <img id="imagePreview"
                                             class="rounded-4 shadow-sm w-100 h-100"
                                             alt="Image"
                                             src=""
                                             style="object-fit: cover; display: none;" />
                                        <div id="noImagePlaceholder"
                                             class="bg-white rounded-4 d-flex flex-column align-items-center justify-content-center h-100 border-2 border-dashed">
                                            <i class="fas fa-cloud-upload-alt fa-3x text-muted mb-2"></i>
                                            <span class="text-muted small">No image selected</span>
                                        </div>
                                        }
                                    </div>

                                    <div class="upload-btn-wrapper">
                                        <input type="file"
                                               name="ImageFile"
                                               class="form-control d-none"
                                               id="imageUpload"
                                               accept="image/*"
                                               onchange="previewImage(event)" />
                                        <button type="button"
                                                class="btn btn-outline-primary rounded-pill px-4 py-2"
                                                onclick="document.getElementById('imageUpload').click();">
                                            <i class="fas fa-camera me-2"></i>Choose Image
                                        </button>
                                        @if (!string.IsNullOrEmpty(Model.CategoryImageUrl))
                                        {
                                        <button type="button"
                                                class="btn btn-outline-danger rounded-pill px-4 py-2 mt-2"
                                                onclick="removeImage()">
                                            <i class="fas fa-trash me-2"></i>Remove Image
                                        </button>
                                        }
                                    </div>

                                    <div class="form-text text-muted mt-3">
                                        <i class="fas fa-info-circle me-1"></i>Recommended: 500x500px, max 2MB
                                    </div>
                                    <div class="form-text text-muted">
                                        Supported formats: JPG, PNG, GIF
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary rounded-pill px-4 py-2">
                        <i class="fas fa-arrow-left me-2"></i>Back to List
                    </a>
                    <div>
                        <button type="reset"
                                class="btn btn-outline-secondary rounded-pill px-4 py-2 me-2">
                            <i class="fas fa-undo me-2"></i>Reset
                        </button>
                        <button type="submit"
                                class="btn btn-primary rounded-pill px-5 py-2 shadow-sm hover-scale">
                            <i class="fas fa-save me-2"></i>@(Model.Id == 0 ? "Create Category" : "Update Category")
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Custom Styles */
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .border-2 {
        border-width: 2px !important;
    }

    .border-3 {
        border-width: 3px !important;
    }

    .border-dashed {
        border-style: dashed !important;
    }

    .hover-scale {
        transition: transform 0.2s;
    }

    .card-body {
        border: 1px solid #e9ecef;
        background: #ffffff;
    }

    .profile-image-wrapper {
        border: 4px solid #0d6efd;
        transition: all 0.3s ease;
    }

    .profile-image-wrapper:hover {
        transform: scale(1.05);
        border-color: #0b5ed7;
    }

    /* Enhanced Input Group Styling with Borders */
    .input-group {
        border: 2px solid #e0e4e9;
        border-radius: 0.6rem;
        overflow: hidden;
        transition: all 0.3s ease;
        background: #ffffff;
    }

    .input-group:hover {
        border-color: #b3b9c4;
    }

    .input-group:focus-within {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }

    .input-group .form-control,
    .input-group .form-select {
        border: none;
        box-shadow: none;
        background: transparent;
    }

    .input-group .form-control:focus,
    .input-group .form-select:focus {
        border: none;
        box-shadow: none;
    }

    .input-group .input-group-text {
        border: none;
        background: #f8f9fa;
        border-right: 2px solid #e0e4e9;
        padding: 0.75rem 1rem;
    }

    .input-group:focus-within .input-group-text {
        border-right-color: #667eea;
        background: #e8f0fe;
    }

    /* Individual Form Control Styling (for non-input-group inputs) */
    .form-control:not(.input-group .form-control),
    .form-select:not(.input-group .form-select) {
        border: 2px solid #e0e4e9;
        border-radius: 0.6rem;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        background: #ffffff;
    }

    .form-control:not(.input-group .form-control):hover,
    .form-select:not(.input-group .form-select):hover {
        border-color: #b3b9c4;
    }

    .form-control:not(.input-group .form-control):focus,
    .form-select:not(.input-group .form-select):focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        outline: none;
    }

    /* Textarea specific styling */
    textarea.form-control {
        border: 2px solid #e0e4e9;
        border-radius: 0.6rem;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        background: #ffffff;
    }

    textarea.form-control:hover {
        border-color: #b3b9c4;
    }

    textarea.form-control:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        outline: none;
    }

    /* Form Select styling */
    .form-select {
        border: 2px solid #e0e4e9;
        border-radius: 0.6rem;
        padding: 0.75rem 2.25rem 0.75rem 1rem;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 1rem center;
        background-size: 16px 12px;
    }

    /* Form Check/Radio styling */
    .form-check-input {
        border: 2px solid #e0e4e9;
        width: 1.2em;
        height: 1.2em;
        margin-top: 0.15em;
    }

    .form-check-input:checked {
        background-color: #667eea;
        border-color: #667eea;
    }

    .form-check-input:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }

    /* Form Switch styling */
    .form-switch .form-check-input {
        border: 2px solid #e0e4e9;
        width: 2.5em;
        height: 1.5em;
    }

    .form-switch .form-check-input:checked {
        background-color: #28a745;
        border-color: #28a745;
    }

    /* Input Group Variants */
    .input-group-lg .form-control,
    .input-group-lg .input-group-text {
        padding: 0.75rem 1rem;
    }

    .input-group-sm .form-control,
    .input-group-sm .input-group-text {
        padding: 0.25rem 0.5rem;
    }

    /* Invalid state styling */
    .form-control.is-invalid,
    .was-validated .form-control:invalid {
        border-color: #dc3545;
        border-width: 2px;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }

    .input-group:has(.is-invalid) {
        border-color: #dc3545;
    }

    /* Valid state styling */
    .form-control.is-valid,
    .was-validated .form-control:valid {
        border-color: #28a745;
        border-width: 2px;
    }

    .input-group:has(.is-valid) {
        border-color: #28a745;
    }

    /* Disabled state styling */
    .form-control:disabled,
    .form-select:disabled {
        background-color: #f8f9fa;
        border-color: #dee2e6;
        opacity: 0.75;
    }

    /* Readonly state styling */
    .form-control[readonly] {
        background-color: #f8f9fa;
        border-color: #dee2e6;
        cursor: default;
    }

    .form-control[readonly]:focus {
        border-color: #dee2e6;
        box-shadow: none;
    }

    .hover-scale:hover {
        transform: scale(1.02);
        transition: 0.2s;
    }
    
    .hover-scale:hover {
        transform: translateY(-2px);
    }

    .image-preview-wrapper {
        position: relative;
        overflow: hidden;
        border-radius: 1rem !important;
        transition: all 0.3s ease;
    }

    .image-preview-wrapper:hover {
        transform: scale(1.02);
        box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
    }

    #noImagePlaceholder {
        transition: all 0.3s ease;
        cursor: pointer;
        border: 2px dashed #dee2e6 !important;
    }

    #noImagePlaceholder:hover {
        background-color: #f8f9fa !important;
        border-color: #667eea !important;
    }

    .form-control:focus, .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #5a6fd6 0%, #6a4292 100%);
    }

    .btn-outline-primary {
        border: 2px solid #667eea;
        color: #667eea;
    }

    .btn-outline-primary:hover {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-color: transparent;
        color: white;
    }

    .btn-outline-danger {
        border: 2px solid #dc3545;
    }

    .btn-outline-danger:hover {
        background-color: #dc3545;
        color: white;
        border-color: #dc3545;
    }

    .form-check-input:checked {
        background-color: #28a745;
        border-color: #28a745;
    }

    /* Animation for status badge */
    #statusBadge {
        transition: all 0.3s ease;
    }

    .rounded-pill {
        border-radius: 50rem !important;
    }

    /* Card border enhancements */
    .card {
        border: 1px solid rgba(0,0,0,.125);
    }

    .card.border-0 {
        border: none !important;
    }

    /* Background light card for image upload */
    .card.bg-light {
        border: 2px solid #e9ecef !important;
    }

    /* Additional border utilities */
    .border-primary-light {
        border-color: #cfe2ff !important;
    }

    .border-success-light {
        border-color: #d1e7dd !important;
    }

    .border-danger-light {
        border-color: #f8d7da !important;
    }

    .border-warning-light {
        border-color: #fff3cd !important;
    }

    /* Focus ring for better accessibility */
    *:focus-visible {
        outline: 2px solid #667eea;
        outline-offset: 2px;
    }
</style>
<script>
    // Fixed Image preview function
    function previewImage(event) {
        const reader = new FileReader();
        const file = event.target.files[0];
        const imagePreview = document.getElementById('imagePreview');
        const noImagePlaceholder = document.getElementById('noImagePlaceholder');

        if (file) {
            // Validate file size (max 2MB)
            if (file.size > 2 * 1024 * 1024) {
                alert('File size must be less than 2MB');
                event.target.value = '';
                return;
            }

            // Validate file type
            if (!file.type.match('image.*')) {
                alert('Please select an image file');
                event.target.value = '';
                return;
            }

            reader.onload = function(e) {
                // Show image preview and hide placeholder
                imagePreview.src = e.target.result;
                imagePreview.style.display = "block";
                noImagePlaceholder.style.display = "none";

                // Add animation effect
                imagePreview.style.animation = "fadeIn 0.5s";

                // Remove animation after it completes
                setTimeout(() => {
                    imagePreview.style.animation = "";
                }, 500);
            };

            reader.readAsDataURL(file);
        } else {
            // If no file selected, show placeholder and hide preview
            imagePreview.style.display = "none";
            noImagePlaceholder.style.display = "flex";
        }
    }

    // Function to remove image
    function removeImage() {
        const imagePreview = document.getElementById('imagePreview');
        const noImagePlaceholder = document.getElementById('noImagePlaceholder');
        const imageUpload = document.getElementById('imageUpload');

        // Clear the file input
        imageUpload.value = '';

        // Hide preview and show placeholder
        imagePreview.style.display = "none";
        noImagePlaceholder.style.display = "flex";

        // Optional: You might want to add a hidden field to indicate image removal
        // This depends on your backend implementation
    }

    // Status toggle label update
    document.addEventListener('DOMContentLoaded', function() {
        const statusToggle = document.getElementById('statusToggle');
        const statusLabel = document.getElementById('statusLabel');
        const statusBadge = document.getElementById('statusBadge');

        if (statusToggle) {
            // Initial setup
            updateStatusDisplay(statusToggle.checked);

            statusToggle.addEventListener('change', function() {
                updateStatusDisplay(this.checked);
            });
        }

        function updateStatusDisplay(isActive) {
            if (isActive) {
                statusLabel.innerText = 'Active';
                statusBadge.innerText = 'Published';
                statusBadge.className = 'badge bg-success px-3 py-2';
            } else {
                statusLabel.innerText = 'Inactive';
                statusBadge.innerText = 'Draft';
                statusBadge.className = 'badge bg-secondary px-3 py-2';
            }
        }

        // Form validation
        const forms = document.querySelectorAll('.needs-validation');
        Array.from(forms).forEach(form => {
            form.addEventListener('submit', event => {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });

        // Handle reset button
        const resetBtn = document.querySelector('button[type="reset"]');
        if (resetBtn) {
            resetBtn.addEventListener('click', function(e) {
                e.preventDefault();
                const form = this.closest('form');
                form.reset();

                // Reset image preview to original state
                const imagePreview = document.getElementById('imagePreview');
                const noImagePlaceholder = document.getElementById('noImagePlaceholder');

                @if (!string.IsNullOrEmpty(Model.CategoryImageUrl))
                {
                <text>
                imagePreview.src = '@Url.Content(Model.CategoryImageUrl)';
                imagePreview.style.display = "block";
                noImagePlaceholder.style.display = "none";
                </text>
                }
                else
                {
                <text>
                imagePreview.style.display = "none";
                noImagePlaceholder.style.display = "flex";
                </text>
                }
            });
        }
    });

    // CSS animation
    const style = document.createElement('style');
    style.textContent = `
    @@keyframes fadeIn {
        from { 
            opacity: 0; 
            transform: scale(0.9); 
        }
        to { 
            opacity: 1; 
            transform: scale(1); 
        }
    }
`;
    document.head.appendChild(style);
</script>