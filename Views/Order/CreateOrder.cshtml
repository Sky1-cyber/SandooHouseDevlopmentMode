            `;

            // Write to iframe and print
            const frameDoc = printFrame.contentWindow.document;
            frameDoc.open();
            frameDoc.write(printContent);
            frameDoc.close();

            // Print when content is loaded
            printFrame.onload = function () {
                setTimeout(function () {
                    printFrame.contentWindow.focus();
                    printFrame.contentWindow.print();

                    // Remove iframe after printing
                    printFrame.contentWindow.onafterprint = function () {
                        document.body.removeChild(printFrame);
                    };
                }, 100);
            };
        });

        $('#closeInvoiceBtn').click(function () {
            $('#invoiceModal').removeClass('show');
        });
        $(document).on('click', '.modal-overlay', function (e) {
            if ($(e.target).hasClass('modal-overlay')) $('#invoiceModal').removeClass('show');
        });

        // ─── RECENT ORDERS ───
        function addRecentChip(num, amt) {
            const html = `<div class="recent-chip" data-order="${num}">
                <span class="rord-num">#${num}</span>
                <span>${fmtUsd(amt)}</span>
                <span class="rord-status">✓</span>
            </div>`;
            $('#recentOrders').prepend(html);
            if ($('#recentOrders .recent-chip').length > 6) $('#recentOrders .recent-chip:last').remove();
        }

        $(document).on('click', '.recent-chip', function () {
            if (lastOrder) showInvoice(lastOrder);
        });

        // Sample recent orders
        addRecentChip('4582', 45.97);
        addRecentChip('4581', 23.50);
        addRecentChip('4580', 67.48);

        // ─── MOBILE SHEET ───
        $('#cartFab').click(function () {
            // Clone cart panel inner content into sheet
            const $sheet = $('#mobileCartContent');
            $sheet.html($('#cartPanel').html());
            // Sync state display
            updateSummary();
            $('#cartSheet').addClass('open');
        });

        $('#sheetBackdrop').click(function () {
            $('#cartSheet').removeClass('open');
        });

        // ─── NOTIFICATIONS ───
        function notify(msg, type = 'info') {
            $('.toast').remove();
            const icons = {
                success: 'fa-check-circle',
                warning: 'fa-exclamation-triangle',
                error: 'fa-times-circle',
                info: 'fa-info-circle'
            };
            const $t = $(`<div class="toast t-${type}"><i class="fas ${icons[type] || icons.info}"></i><span>${msg}</span></div>`);
            $('body').append($t);
            setTimeout(() => $t.addClass('show'), 10);
            setTimeout(() => {
                $t.removeClass('show');
                setTimeout(() => $t.remove(), 300);
            }, 2800);
        }

        // ─── KEYBOARD ───
        $(document).on('keydown', function (e) {
            if (e.key === 'F2') {
                e.preventDefault();
                if (cart.length && confirm('ចាប់ផ្តើមថ្មី?')) {
                    resetCart();
                    notify('ចាប់ផ្តើមការកម្មង់ថ្មី', 'info');
                }
            }
            if (e.key === 'F4') {
                e.preventDefault();
                $('#holdOrderBtn').click();
            }
            if (e.key === 'F8') {
                e.preventDefault();
                if (!$('#payBtn').prop('disabled')) $('#payBtn').click();
            }
            if (e.key === 'Escape') {
                e.preventDefault();
                if ($('#invoiceModal').hasClass('show')) {
                    $('#invoiceModal').removeClass('show');
                } else {
                    $('#cancelOrderBtn').click();
                }
            }
            if (e.key === '/' && !$(e.target).is('input,textarea,select')) {
                e.preventDefault();
                $('#productSearch').focus();
            }
        });

        console.log('✅ POS Ready');
    });
</script>
</body>
</html>