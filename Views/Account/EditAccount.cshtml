@model Sandoohouse.Models.Admin
@using Sandoohouse.Models.Enum
@{
    ViewData["Title"] = "Edit Account";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
:root {
    --brand:       #FF6B35;
    --brand-dark:  #E85520;
    --brand-light: #FFF0EA;
    --brand-mid:   rgba(255,107,53,.14);
    --accent:      #2D3561;
    --accent-mid:  rgba(45,53,97,.1);
    --success:     #00B894;
    --success-bg:  rgba(0,184,148,.1);
    --warning:     #F0A500;
    --warning-bg:  rgba(240,165,0,.1);
    --danger:      #E84545;
    --danger-bg:   rgba(232,69,69,.1);
    --bg:          #F7F4F0;
    --surface:     #FFFFFF;
    --surface2:    #FAF8F5;
    --border:      #EDE8E0;
    --border-s:    #DDD7CE;
    --text:        #1A1714;
    --text-sub:    #7A736B;
    --text-light:  #B5AFA8;
    --shadow-sm:   0 1px 4px rgba(26,23,20,.06);
    --shadow-md:   0 4px 20px rgba(26,23,20,.10);
    --shadow-lg:   0 12px 48px rgba(26,23,20,.14);
    --r-xs: 6px; --r-sm: 10px; --r-md: 16px; --r-lg: 24px; --r-xl: 32px;
    --font: 'Sora','Noto Sans Khmer',sans-serif;
}

*, *::before, *::after { box-sizing: border-box; }

/* ── Page ── */
.ea-page {
    font-family: var(--font);
    background: var(--bg);
    min-height: 100vh;
    padding: 28px 24px;
    color: var(--text);
}

/* ── Top bar ── */
.ea-topbar {
    display: flex; align-items: flex-start; justify-content: space-between;
    margin-bottom: 24px; flex-wrap: wrap; gap: 12px;
}
.ea-topbar h1 { font-size: 21px; font-weight: 700; color: var(--text); margin: 0 0 4px; letter-spacing: -.4px; }
.ea-breadcrumb {
    display: flex; align-items: center; gap: 6px;
    font-size: 12px; font-weight: 500; margin: 0; padding: 0; list-style: none;
}
.ea-breadcrumb a { color: var(--text-light); text-decoration: none; transition: color .15s; }
.ea-breadcrumb a:hover { color: var(--brand); }
.ea-breadcrumb .sep { color: var(--border-s); font-size: 10px; }
.ea-breadcrumb .cur { color: var(--text-sub); font-weight: 600; }

/* ── Card ── */
.ea-card {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    max-width: 860px;
    margin: 0 auto;
}

/* ── Card header ── */
.ea-card-head {
    background: var(--accent);
    padding: 26px 32px;
    display: flex; align-items: center; gap: 18px;
    position: relative; overflow: hidden;
}
.ea-card-head::before,
.ea-card-head::after {
    content: ''; position: absolute; border-radius: 50%;
    background: rgba(255,255,255,.05); pointer-events: none;
}
.ea-card-head::before { width: 220px; height: 220px; top: -80px; right: -50px; }
.ea-card-head::after  { width: 140px; height: 140px; bottom: -60px; left: 200px; }

.ea-head-icon {
    width: 50px; height: 50px; border-radius: var(--r-md);
    background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.18);
    display: flex; align-items: center; justify-content: center;
    font-size: 22px; color: #fff; flex-shrink: 0; z-index: 1;
}
.ea-head-text { z-index: 1; }
.ea-head-text h4 { font-size: 17px; font-weight: 700; color: #fff; margin: 0 0 4px; letter-spacing: -.2px; }
.ea-head-text p  { font-size: 12px; color: rgba(255,255,255,.55); margin: 0; font-weight: 500; }

/* ── Card body ── */
.ea-body { padding: 32px 32px 28px; }

/* ── Avatar upload ── */
.ea-avatar-section {
    display: flex; flex-direction: column; align-items: center;
    padding: 20px 0 24px; border-bottom: 1.5px solid var(--border); margin-bottom: 26px;
}
.ea-avatar-wrap { position: relative; cursor: pointer; }
.ea-avatar {
    width: 110px; height: 110px; border-radius: 50%;
    overflow: hidden; border: 3px solid var(--border);
    background: var(--surface2); box-shadow: var(--shadow-md);
    transition: border-color .2s;
}
.ea-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; transition: all .3s; }
.ea-avatar-overlay {
    position: absolute; inset: 0; border-radius: 50%;
    background: rgba(26,23,20,.5);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;
    opacity: 0; transition: opacity .2s;
}
.ea-avatar-overlay i { font-size: 20px; color: #fff; }
.ea-avatar-overlay span { font-size: 10px; color: rgba(255,255,255,.8); font-weight: 600; }
.ea-avatar-wrap:hover .ea-avatar { border-color: var(--brand); }
.ea-avatar-wrap:hover .ea-avatar-overlay { opacity: 1; }

.ea-avatar-hint { margin-top: 12px; text-align: center; }
.btn-photo {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 16px; border: 1.5px solid var(--brand); border-radius: var(--r-xl);
    background: none; color: var(--brand);
    font-family: var(--font); font-size: 12px; font-weight: 700;
    cursor: pointer; transition: all .18s;
}
.btn-photo:hover { background: var(--brand-light); }
.ea-avatar-hint p { font-size: 11px; color: var(--text-light); margin: 6px 0 0; }

/* ── Section title ── */
.ea-section-title {
    font-size: 10px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .08em; color: var(--text-light);
    margin: 0 0 16px;
    display: flex; align-items: center; gap: 8px;
}
.ea-section-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }

/* ── Form grid ── */
.ea-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 20px; }
.ea-grid .full { grid-column: 1 / -1; }

/* ── Field ── */
.ea-field { display: flex; flex-direction: column; gap: 6px; }
.ea-label {
    font-size: 12px; font-weight: 600; color: var(--text-sub);
    display: flex; align-items: center; gap: 4px;
}
.ea-label .req { color: var(--brand); font-size: 14px; line-height: 1; }
.ea-label .opt { color: var(--text-light); font-size: 10px; font-weight: 500; }

.ea-input-wrap {
    display: flex; align-items: center;
    border: 1.5px solid var(--border); border-radius: var(--r-sm);
    background: var(--surface2); overflow: hidden;
    transition: border-color .15s, box-shadow .15s;
}
.ea-input-wrap:focus-within {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-mid);
    background: var(--surface);
}
.ea-input-wrap.has-error { border-color: var(--danger); }
.ea-input-wrap.has-error:focus-within { box-shadow: 0 0 0 3px var(--danger-bg); }

.ea-input-icon {
    width: 42px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    font-size: 15px; color: var(--text-light); flex-shrink: 0;
    border-right: 1.5px solid var(--border); background: var(--surface);
    transition: color .15s, border-color .15s;
}
.ea-input-wrap:focus-within .ea-input-icon { color: var(--brand); border-color: var(--brand); }

.ea-input, .ea-select {
    flex: 1; height: 44px; padding: 0 14px;
    border: none; background: none; outline: none;
    font-family: var(--font); font-size: 13px; color: var(--text);
}
.ea-input::placeholder { color: var(--text-light); }
.ea-select { appearance: none; cursor: pointer; }

.ea-eye-btn {
    width: 42px; height: 44px; border: none; background: none;
    display: flex; align-items: center; justify-content: center;
    font-size: 15px; color: var(--text-light);
    cursor: pointer; flex-shrink: 0; transition: color .15s;
}
.ea-eye-btn:hover { color: var(--brand); }

.ea-error { font-size: 11px; color: var(--danger); font-weight: 500; display: flex; align-items: center; gap: 4px; }
.ea-hint  { font-size: 11px; color: var(--text-light); display: flex; align-items: center; gap: 4px; }

/* ── Status radios ── */
.ea-status-group {
    display: flex; gap: 10px; flex-wrap: wrap;
    padding: 14px; background: var(--surface2);
    border: 1.5px solid var(--border); border-radius: var(--r-sm);
}
.ea-status-opt { cursor: pointer; }
.ea-status-opt input[type="radio"] { display: none; }
.ea-status-chip {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 16px; border-radius: 20px;
    font-size: 12px; font-weight: 700;
    border: 1.5px solid var(--border);
    background: var(--surface); color: var(--text-sub);
    cursor: pointer; transition: all .16s;
    user-select: none;
}
.ea-status-chip::before {
    content: ''; width: 7px; height: 7px;
    border-radius: 50%; background: currentColor; flex-shrink: 0;
}
.ea-status-opt input[type="radio"]:checked + .ea-status-chip {
    box-shadow: 0 0 0 3px var(--brand-mid);
}
.ea-status-opt input[type="radio"][value="Active"]:checked  + .ea-status-chip { background: var(--success-bg); color: var(--success); border-color: rgba(0,184,148,.3); }
.ea-status-opt input[type="radio"][value="Inactive"]:checked + .ea-status-chip { background: var(--surface2); color: var(--text-sub); border-color: var(--border-s); }
.ea-status-opt input[type="radio"][value="Suspended"]:checked + .ea-status-chip { background: var(--danger-bg); color: var(--danger); border-color: rgba(232,69,69,.3); }

/* ── Info cells ── */
.ea-info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.ea-info-cell {
    padding: 14px 16px;
    background: var(--surface2); border: 1.5px solid var(--border); border-radius: var(--r-sm);
}
.ea-info-cell-label { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--text-light); margin-bottom: 5px; }
.ea-info-cell-val { font-size: 13px; font-weight: 600; color: var(--text); display: flex; align-items: center; gap: 7px; }
.ea-info-cell-val i { color: var(--brand); font-size: 14px; }

/* ── Warning notice ── */
.ea-notice {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 14px 16px;
    background: var(--warning-bg);
    border: 1px solid rgba(240,165,0,.25); border-left: 3px solid var(--warning);
    border-radius: var(--r-sm); margin-top: 22px;
    font-size: 13px; color: var(--text-sub); line-height: 1.6;
}
.ea-notice i { font-size: 17px; color: var(--warning); flex-shrink: 0; margin-top: 1px; }
.ea-notice strong { color: var(--text); }

/* ── Actions ── */
.ea-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 26px; }
.btn-save {
    height: 46px; background: var(--brand); color: #fff;
    border: none; border-radius: var(--r-xl);
    font-family: var(--font); font-size: 14px; font-weight: 700;
    cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
    box-shadow: 0 4px 16px rgba(255,107,53,.35); transition: all .18s;
}
.btn-save:hover { background: var(--brand-dark); transform: translateY(-1px); }
.btn-save:active { transform: translateY(0); }

.btn-cancel-edit {
    height: 46px; background: var(--surface); color: var(--text-sub);
    border: 1.5px solid var(--border); border-radius: var(--r-xl);
    font-family: var(--font); font-size: 14px; font-weight: 600;
    cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
    text-decoration: none; transition: all .18s;
}
.btn-cancel-edit:hover { border-color: var(--danger); color: var(--danger); background: var(--danger-bg); text-decoration: none; }

/* ── Responsive ── */
@@media (max-width: 640px) {
    .ea-body { padding: 22px 18px; }
    .ea-card-head { padding: 20px 18px; }
    .ea-grid { grid-template-columns: 1fr; }
    .ea-grid .full { grid-column: 1; }
    .ea-actions { grid-template-columns: 1fr; }
    .ea-info-grid { grid-template-columns: 1fr; }
}
</style>

<div class="ea-page">

    <!-- ── Top bar ── -->
    <div class="ea-topbar">
        <div>
            <h1>Edit Account</h1>
            <nav class="ea-breadcrumb">
                <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door-fill"></i></a>
                <span class="sep">›</span>
                <a asp-controller="Account" asp-action="ListAccount">Account</a>
                <span class="sep">›</span>
                <span class="cur">Edit Account</span>
            </nav>
        </div>
    </div>

    <!-- ── Card ── -->
    <div class="ea-card">

        <!-- Header -->
        <div class="ea-card-head">
            <div class="ea-head-icon"><i class="bi bi-person-fill-gear"></i></div>
            <div class="ea-head-text">
                <h4>Edit Account Information</h4>
                <p>Update user details and manage account settings</p>
            </div>
        </div>

        <!-- Body -->
        <div class="ea-body">
            <form asp-controller="Account" asp-action="EditAccount"
                  method="post" enctype="multipart/form-data"
                  class="needs-validation" novalidate>
                <input type="hidden" asp-for="Id" />

                <!-- ── Avatar upload ── -->
                <div class="ea-avatar-section">
                    <div class="ea-avatar-wrap" onclick="document.getElementById('profileImageInput').click();">
                        <div class="ea-avatar">
                            <img id="previewImage"
                                 src="@Url.Content(Model.ProfileImageFile != null ? $"{Model.ProfileImageFile}" : "~/l60Hf.png")"
                                 alt="@Model.FirstName @Model.LastName" />
                        </div>
                        <div class="ea-avatar-overlay">
                            <i class="bi bi-camera-fill"></i>
                            <span>Change</span>
                        </div>
                    </div>
                    <div class="ea-avatar-hint">
                        <label for="profileImageInput" class="btn-photo">
                            <i class="bi bi-camera"></i> Change Photo
                        </label>
                        <input type="file" name="ProfileImageUrl" id="profileImageInput"
                               style="display:none;" accept="image/*" onchange="previewFile(event)" />
                        <p><i class="bi bi-info-circle"></i> JPG, PNG or GIF · Max 2 MB</p>
                    </div>
                </div>

                <!-- ── Personal info ── -->
                <div class="ea-section-title">Personal Information</div>

                <div class="ea-grid">

                    <!-- First name -->
                    <div class="ea-field">
                        <label class="ea-label">First Name <span class="req">*</span></label>
                        <div class="ea-input-wrap">
                            <span class="ea-input-icon"><i class="bi bi-person"></i></span>
                            <input asp-for="FirstName" class="ea-input" placeholder="Enter first name" />
                        </div>
                        <span asp-validation-for="FirstName" class="ea-error"></span>
                    </div>

                    <!-- Last name -->
                    <div class="ea-field">
                        <label class="ea-label">Last Name <span class="req">*</span></label>
                        <div class="ea-input-wrap">
                            <span class="ea-input-icon"><i class="bi bi-person"></i></span>
                            <input asp-for="LastName" class="ea-input" placeholder="Enter last name" />
                        </div>
                        <span asp-validation-for="LastName" class="ea-error"></span>
                    </div>

                    <!-- Email -->
                    <div class="ea-field">
                        <label class="ea-label">Email Address <span class="req">*</span></label>
                        <div class="ea-input-wrap">
                            <span class="ea-input-icon"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="ea-input" type="email" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="ea-error"></span>
                    </div>

                    <!-- Phone -->
                    <div class="ea-field">
                        <label class="ea-label">Phone Number <span class="req">*</span></label>
                        <div class="ea-input-wrap">
                            <span class="ea-input-icon"><i class="bi bi-telephone"></i></span>
                            <input asp-for="PhoneNumber" class="ea-input" type="tel" placeholder="+855 000 000 000" />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="ea-error"></span>
                    </div>

                    <!-- New password -->
                    <div class="ea-field">
                        <label class="ea-label">New Password <span class="opt">(optional)</span></label>
                        <div class="ea-input-wrap">
                            <span class="ea-input-icon"><i class="bi bi-lock"></i></span>
                            <input type="password" name="Password" id="passwordInput"
                                   class="ea-input" placeholder="Leave empty to keep current" />
                            <button type="button" class="ea-eye-btn" onclick="togglePwd()">
                                <i class="bi bi-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                        <span class="ea-hint"><i class="bi bi-shield-lock"></i> Leave empty to keep current password</span>
                    </div>

                    <!-- Role -->
                    <div class="ea-field">
                        <label class="ea-label">Role Level</label>
                        <div class="ea-input-wrap">
                            <span class="ea-input-icon"><i class="bi bi-bar-chart-steps"></i></span>
                            <select asp-for="Role" class="ea-select">
                                <option value="0">Level 0 — Super Admin</option>
                                <option value="1">Level 1 — Admin</option>
                                <option value="2">Level 2 — Manager</option>
                                <option value="3">Level 3 — Staff</option>
                                <option value="4">Level 4 — Viewer</option>
                            </select>
                        </div>
                    </div>

                </div>

                <!-- ── Account settings ── -->
                <div class="ea-section-title" style="margin-top:8px;">Account Settings</div>

                <div class="ea-grid">

                    <!-- Status -->
                    <div class="ea-field full">
                        <label class="ea-label">Account Status</label>
                        <div class="ea-status-group">
                            @foreach (var status in Enum.GetValues(typeof(Status)).Cast<Status>())
                            {
                                <label class="ea-status-opt">
                                    <input type="radio" name="Status"
                                           value="@status"
                                           @(Model.Status == status ? "checked" : "") />
                                    <span class="ea-status-chip">@status</span>
                                </label>
                            }
                        </div>
                    </div>

                    <!-- Info cells -->
                    <div class="ea-field full">
                        <div class="ea-info-grid">
                            <div class="ea-info-cell">
                                <div class="ea-info-cell-label">Account Created</div>
                                <div class="ea-info-cell-val">
                                    <i class="bi bi-calendar-check"></i>
                                    @Model.CreatedAt.ToString("MMM dd, yyyy")
                                </div>
                            </div>
                            <div class="ea-info-cell">
                                <div class="ea-info-cell-label">Last Updated</div>
                                <div class="ea-info-cell-val">
                                    <i class="bi bi-clock-history"></i>
                                    @(Model.UpdatedAt == DateTime.MinValue ? "Never" : Model.UpdatedAt.ToString("MMM dd, yyyy"))
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- ── Warning notice ── -->
                <div class="ea-notice">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>
                        <strong>Important:</strong> Changes to account information take effect immediately.
                        The user will be notified of any updates via email.
                    </div>
                </div>

                <!-- ── Actions ── -->
                <div class="ea-actions">
                    <button type="submit" class="btn-save">
                        <i class="bi bi-check-circle"></i> Update Account
                    </button>
                    <a asp-controller="Account" asp-action="ListAccount" class="btn-cancel-edit">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>

            </form>
        </div><!-- /.ea-body -->
    </div><!-- /.ea-card -->

</div><!-- /.ea-page -->

<script>
/* ── Avatar preview ── */
function previewFile(e) {
    const file = e.target.files[0];
    if (!file) return;
    if (file.size > 2 * 1024 * 1024) { alert('File must be under 2 MB'); e.target.value = ''; return; }
    if (!file.type.match('image.*'))  { alert('Please select an image file'); e.target.value = ''; return; }
    const r = new FileReader();
    r.onload = ev => {
        const img = document.getElementById('previewImage');
        img.src = ev.target.result;
        img.style.animation = 'ea-fade .4s ease';
    };
    r.readAsDataURL(file);
}

/* ── Toggle password ── */
function togglePwd() {
    const inp  = document.getElementById('passwordInput');
    const icon = document.getElementById('eyeIcon');
    const show = inp.type === 'password';
    inp.type = show ? 'text' : 'password';
    icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
}

/* ── Native validation ── */
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.needs-validation').forEach(form => {
        form.addEventListener('submit', e => {
            if (!form.checkValidity()) { e.preventDefault(); e.stopPropagation(); }
            form.classList.add('was-validated');
        }, false);
    });
});

/* ── Fade animation ── */
const s = document.createElement('style');
s.textContent = '@@keyframes ea-fade { from { opacity:.5; transform:scale(.95); } to { opacity:1; transform:scale(1); } }';
document.head.appendChild(s);
</script>
