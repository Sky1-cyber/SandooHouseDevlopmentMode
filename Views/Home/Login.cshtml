@{
Layout = null;

bool   isLockout      = TempData["IsLockout"]      as bool?   ?? false;
int    lockoutSeconds = TempData["LockoutSeconds"] as int?    ?? 300;
string errorMessage   = TempData["ErrorMessage"]   as string  ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <title>Login</title>
    <link rel="icon" href="@Url.Content("~/assets/img/kaiadmin/SandooHouse.ico")" type="image/x-icon"/>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        :root {
            --brand:       #FF6B35;
            --brand-dark:  #E85520;
            --brand-light: #FFF0EA;
            --brand-mid:   rgba(255,107,53,.14);
            --accent:      #2D3561;
            --bg:          #F7F4F0;
            --surface:     #FFFFFF;
            --surface2:    #FAF8F5;
            --border:      #EDE8E0;
            --border-s:    #DDD7CE;
            --text:        #1A1714;
            --text-sub:    #7A736B;
            --text-light:  #B5AFA8;
            --danger:      #E84545;
            --danger-bg:   rgba(232,69,69,.08);
            --success:     #00B894;
            --font:        'Sora','Noto Sans Khmer',sans-serif;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: var(--font);
            min-height: 100vh;
            background: var(--bg);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background-image: radial-gradient(circle, #DDD7CE 1px, transparent 1px);
            background-size: 28px 28px;
        }

        /* ── Outer wrapper ── */
        .login-wrap {
            width: 100%;
            max-width: 440px;
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        /* ── Brand bar on top ── */
        .login-brand {
            background: var(--accent);
            border-radius: 22px 22px 0 0;
            padding: 28px 32px 24px;
            display: flex;
            align-items: center;
            gap: 16px;
            position: relative;
            overflow: hidden;
        }
        .login-brand::before,
        .login-brand::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
            pointer-events: none;
        }
        .login-brand::before { width: 200px; height: 200px; top: -80px; right: -40px; }
        .login-brand::after  { width: 120px; height: 120px; bottom: -50px; left: 160px; }

        .brand-icon {
            width: 48px; height: 48px;
            border-radius: 14px;
            background: var(--brand);
            display: flex; align-items: center; justify-content: center;
            font-size: 22px; color: #fff;
            flex-shrink: 0; z-index: 1;
            box-shadow: 0 4px 16px rgba(255,107,53,.4);
        }
        .brand-text { z-index: 1; }
        .brand-text h2 {
            font-size: 18px; font-weight: 700; color: #fff;
            margin: 0 0 2px; letter-spacing: -.3px;
        }
        .brand-text p {
            font-size: 12px; color: rgba(255,255,255,.55);
            font-weight: 500; margin: 0;
        }

        /* ── Card ── */
        .login-card {
            background: var(--surface);
            border-radius: 0 0 22px 22px;
            border: 1.5px solid var(--border);
            border-top: none;
            padding: 32px 32px 28px;
            box-shadow: 0 16px 48px rgba(26,23,20,.13);
        }

        /* ── Greeting ── */
        .login-greeting {
            margin-bottom: 26px;
        }
        .login-greeting h3 {
            font-size: 20px; font-weight: 700; color: var(--text);
            margin: 0 0 4px; letter-spacing: -.4px;
        }
        .login-greeting p { font-size: 13px; color: var(--text-light); font-weight: 500; margin: 0; }

        /* ── Normal error alert ── */
        .login-alert {
            display: flex; align-items: center; gap: 10px;
            background: var(--danger-bg);
            border: 1px solid rgba(232,69,69,.2);
            border-left: 3px solid var(--danger);
            border-radius: 10px;
            padding: 11px 14px;
            margin-bottom: 20px;
            font-size: 13px; font-weight: 500; color: var(--danger);
        }
        .login-alert i { font-size: 15px; flex-shrink: 0; }

        /* ── Lockout alert wrapper ── */
        .lockout-alert {
            background: var(--danger-bg);
            border: 1px solid rgba(232,69,69,.2);
            border-left: 3px solid var(--danger);
            border-radius: 10px;
            padding: 16px;
            margin-bottom: 20px;
            transition: background .4s, border-color .4s;
        }
        .lockout-alert.unlocked {
            background: rgba(0,184,148,.07);
            border-color: rgba(0,184,148,.25);
            border-left-color: var(--success);
        }
        .lockout-top {
            display: flex; align-items: center; gap: 9px;
            font-size: 13px; font-weight: 600; color: var(--danger);
            margin-bottom: 14px;
        }
        .lockout-top i { font-size: 15px; }
        .lockout-alert.unlocked .lockout-top { color: var(--success); }

        /* ── Clock ── */
        .cd-clock {
            display: flex; align-items: center; justify-content: center;
            gap: 8px;
        }
        .cd-seg {
            display: flex; flex-direction: column; align-items: center; gap: 5px;
        }
        .cd-num {
            width: 60px; height: 56px;
            background: var(--surface);
            border: 1.5px solid rgba(232,69,69,.22);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 28px; font-weight: 800;
            color: var(--danger);
            line-height: 1;
            transition: background .25s, border-color .25s;
        }
        .cd-num.urgent {
            animation: urgentPulse .55s ease infinite alternate;
        }
        @@keyframes urgentPulse {
            from { background: var(--surface);              border-color: rgba(232,69,69,.22); }
            to   { background: rgba(232,69,69,.14); border-color: rgba(232,69,69,.5); }
        }
        .cd-label {
            font-size: 9px; font-weight: 700; text-transform: uppercase;
            letter-spacing: .08em; color: var(--text-light);
        }
        .cd-colon {
            font-size: 26px; font-weight: 800;
            color: rgba(232,69,69,.3);
            margin-bottom: 16px;
            animation: colonBlink 1s step-end infinite;
        }
        @@keyframes colonBlink {
            0%, 100% { opacity: 1; }
            50%       { opacity: .2; }
        }
        .cd-hint {
            text-align: center; margin-top: 12px;
            font-size: 11px; font-weight: 500; color: var(--text-light);
            display: flex; align-items: center; justify-content: center; gap: 5px;
        }

        /* ── Disabled form ── */
        .form-locked {
            pointer-events: none;
            opacity: .42;
            user-select: none;
        }
        .btn-login:disabled {
            opacity: .5 !important;
            cursor: not-allowed;
            transform: none !important;
            box-shadow: none !important;
        }

        /* ── Field ── */
        .login-field { margin-bottom: 18px; }
        .login-label {
            display: block;
            font-size: 12px; font-weight: 600;
            color: var(--text-sub);
            margin-bottom: 7px;
            letter-spacing: .01em;
        }

        .login-input-wrap {
            display: flex; align-items: center;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            background: var(--surface2);
            overflow: hidden;
            transition: border-color .15s, box-shadow .15s;
        }
        .login-input-wrap:focus-within {
            border-color: var(--brand);
            box-shadow: 0 0 0 3px var(--brand-mid);
            background: var(--surface);
        }

        .login-input-icon {
            width: 44px; height: 46px;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px; color: var(--text-light);
            flex-shrink: 0;
            border-right: 1.5px solid var(--border);
            background: var(--surface);
            transition: color .15s, border-color .15s;
        }
        .login-input-wrap:focus-within .login-input-icon {
            color: var(--brand);
            border-color: var(--brand);
        }

        .login-input {
            flex: 1; height: 46px;
            padding: 0 14px;
            border: none; background: none; outline: none;
            font-family: var(--font); font-size: 13px; color: var(--text);
        }
        .login-input::placeholder { color: var(--text-light); }

        .login-eye-btn {
            width: 44px; height: 46px;
            border: none; background: none;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px; color: var(--text-light);
            cursor: pointer; flex-shrink: 0;
            transition: color .15s;
        }
        .login-eye-btn:hover { color: var(--brand); }

        /* ── Remember + forgot ── */
        .login-row {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 24px; flex-wrap: wrap; gap: 8px;
        }
        .login-remember {
            display: flex; align-items: center; gap: 8px;
            cursor: pointer;
        }
        .login-remember input[type="checkbox"] {
            width: 16px; height: 16px;
            accent-color: var(--brand);
            cursor: pointer;
        }
        .login-remember span {
            font-size: 12px; font-weight: 500; color: var(--text-sub);
        }
        .login-forgot {
            font-size: 12px; font-weight: 600;
            color: var(--brand); text-decoration: none;
            transition: color .15s;
        }
        .login-forgot:hover { color: var(--brand-dark); }

        /* ── Submit ── */
        .btn-login {
            width: 100%; height: 48px;
            background: var(--brand); color: #fff;
            border: none; border-radius: 12px;
            font-family: var(--font); font-size: 14px; font-weight: 700;
            cursor: pointer; letter-spacing: .01em;
            display: flex; align-items: center; justify-content: center; gap: 8px;
            box-shadow: 0 5px 20px rgba(255,107,53,.35);
            transition: all .18s;
        }
        .btn-login:hover:not(:disabled) { background: var(--brand-dark); transform: translateY(-1px); box-shadow: 0 8px 28px rgba(255,107,53,.4); }
        .btn-login:active:not(:disabled) { transform: translateY(0); }

        /* ── Footer ── */
        .login-footer {
            text-align: center;
            margin-top: 22px;
            font-size: 12px; font-weight: 500;
            color: var(--text-light);
            display: flex; align-items: center; justify-content: center; gap: 6px;
        }
        .login-footer span { color: var(--brand); font-weight: 700; }

        @@media (max-width: 480px) {
            .login-brand { padding: 22px 22px 20px; }
            .login-card  { padding: 24px 22px 22px; }
            .login-wrap  { max-width: 100%; }
            .cd-num      { width: 52px; height: 48px; font-size: 24px; }
        }
    </style>
</head>
<body>

<div class="login-wrap">

    <!-- Brand header -->
    <div class="login-brand">
        <div class="brand-icon">
            <i class="bi bi-house-heart-fill"></i>
        </div>
        <div class="brand-text">
            <h2>Sandoo House</h2>
            <p>Admin Management System</p>
        </div>
    </div>

    <!-- Card -->
    <div class="login-card">

        <div class="login-greeting">
            <h3>Welcome back 👋</h3>
            <p>Sign in to continue to your dashboard</p>
        </div>

        @* ── LOCKOUT ALERT with live countdown ── *@
        @if (isLockout)
        {
        <div class="lockout-alert" id="lockoutAlert">
            <div class="lockout-top" id="lockoutTop">
                <i class="bi bi-lock-fill" id="lockoutIcon"></i>
                <span id="lockoutTitle">Account temporarily locked</span>
            </div>
            <div class="cd-clock" id="cdClock">
                <div class="cd-seg">
                    <div class="cd-num" id="cdMin">05</div>
                    <div class="cd-label">Min</div>
                </div>
                <div class="cd-colon" id="cdColon">:</div>
                <div class="cd-seg">
                    <div class="cd-num" id="cdSec">00</div>
                    <div class="cd-label">Sec</div>
                </div>
            </div>
            <div class="cd-hint" id="cdHint">
                <i class="bi bi-hourglass-split"></i>
                Please wait before trying again
            </div>
        </div>
        }

        @* ── NORMAL ERROR ALERT (auto-dismiss after 3.5s) ── *@
        @if (!isLockout && !string.IsNullOrEmpty(errorMessage))
        {
        <div class="login-alert" id="loginAlert">
            <i class="bi bi-exclamation-circle-fill"></i>
            @Html.Raw(errorMessage)
        </div>
        }

        @* ── FORM — grayed out while locked ── *@
        <form asp-controller="Home" asp-action="Login" method="post"
              id="loginForm" class="@(isLockout ? "form-locked" : "")">

            <!-- Email -->
            <div class="login-field">
                <label class="login-label">Email address</label>
                <div class="login-input-wrap">
                    <span class="login-input-icon"><i class="bi bi-envelope"></i></span>
                    <input type="email" name="Email" class="login-input"
                           placeholder="name@example.com" required autocomplete="email" />
                </div>
            </div>

            <!-- Password -->
            <div class="login-field">
                <label class="login-label">Password</label>
                <div class="login-input-wrap">
                    <span class="login-input-icon"><i class="bi bi-lock"></i></span>
                    <input type="password" name="Password" id="passwordInput"
                           class="login-input" placeholder="Enter your password"
                           required autocomplete="current-password" />
                    <button type="button" class="login-eye-btn" onclick="togglePwd()" aria-label="Toggle password">
                        <i class="bi bi-eye" id="eyeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Remember + Forgot -->
            <div class="login-row">
                <label class="login-remember">
                    <input type="checkbox" id="remember" name="remember" />
                    <span>Remember me</span>
                </label>
                <a asp-controller="Account" asp-action="ForgotPassword" class="login-forgot">
                    Forgot password?
                </a>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn-login" id="loginBtn" @(isLockout ? "disabled" : "")>
                <i class="bi bi-box-arrow-in-right"></i>
                Sign In
            </button>

        </form>

        <!-- Footer -->
        <div class="login-footer">
            <i class="bi bi-c-circle"></i>
            2026 <span>Sandoo House</span> · All rights reserved
        </div>

    </div><!-- /.login-card -->
</div><!-- /.login-wrap -->

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    /* ── Auto-dismiss normal error alert after 3.5 s ── */
    setTimeout(function () {
        var a = document.getElementById('loginAlert');
        if (a) {
            a.style.transition = 'opacity .4s';
            a.style.opacity    = '0';
            setTimeout(function () { if (a) a.remove(); }, 400);
        }
    }, 3500);

    /* ── Toggle password visibility ── */
    function togglePwd() {
        var inp  = document.getElementById('passwordInput');
        var icon = document.getElementById('eyeIcon');
        var show = inp.type === 'password';
        inp.type       = show ? 'text' : 'password';
        icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
    }

    /* ══════════════════════════════════════════════════════
       COUNTDOWN TIMER
       totalSecs is injected directly by Razor from the
       exact remaining seconds stored in TempData.
    ══════════════════════════════════════════════════════ */
    (function () {
        var isLockout = @(isLockout ? "true" : "false");
        if (!isLockout) return;

        var totalSecs  = @lockoutSeconds;   /* e.g. 287 if 13 s have already passed */
        var elMin      = document.getElementById('cdMin');
        var elSec      = document.getElementById('cdSec');
        var elHint     = document.getElementById('cdHint');
        var elAlert    = document.getElementById('lockoutAlert');
        var elTop      = document.getElementById('lockoutTop');
        var elIcon     = document.getElementById('lockoutIcon');
        var elTitle    = document.getElementById('lockoutTitle');
        var elClock    = document.getElementById('cdClock');
        var elColon    = document.getElementById('cdColon');
        var loginForm  = document.getElementById('loginForm');
        var loginBtn   = document.getElementById('loginBtn');

        function pad(n) { return String(Math.max(0, n)).padStart(2, '0'); }

        function updateDisplay() {
            var m = Math.floor(totalSecs / 60);
            var s = totalSecs % 60;
            elMin.textContent = pad(m);
            elSec.textContent = pad(s);

            /* pulse both digit boxes when ≤ 30 s remain */
            [elMin, elSec].forEach(function (el) {
                if (totalSecs <= 30) el.classList.add('urgent');
                else                 el.classList.remove('urgent');
            });

            /* update hint */
            if (totalSecs <= 60) {
                elHint.innerHTML = '<i class="bi bi-hourglass-bottom"></i> Almost there, just a moment…';
            } else {
                elHint.innerHTML = '<i class="bi bi-hourglass-split"></i> Please wait before trying again';
            }
        }

        function unlock() {
            /* swap alert to success green */
            elAlert.classList.add('unlocked');
            elIcon.className  = 'bi bi-unlock-fill';
            elTitle.textContent = 'Lockout ended — you can try again!';
            elTop.style.color = 'var(--success)';
            elClock.style.display  = 'none';
            elColon.style.display  = 'none';
            elHint.style.color     = 'var(--success)';
            elHint.innerHTML = '<i class="bi bi-check-circle-fill"></i> Enter your credentials below';

            /* re-enable form */
            if (loginForm) loginForm.classList.remove('form-locked');
            if (loginBtn)  loginBtn.disabled = false;
        }

        function tick() {
            if (totalSecs <= 0) { unlock(); return; }
            updateDisplay();
            totalSecs--;
            setTimeout(tick, 1000);
        }

        /* start immediately */
        updateDisplay();
        totalSecs--;
        setTimeout(tick, 1000);
    })();
</script>
</body>
</html>
