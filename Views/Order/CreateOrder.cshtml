<!-- ── SCRIPTS ── -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
    window.lastOrder = null;
    let customerWindow = null;
    let customerDisplayAutoOpen = false;

    function showLogoutModal() {
        document.getElementById('logoutModal').style.display = 'flex';
    }

    /* ════════════════════════════════════════════════════════════
       CAMBODIA TIME HELPERS
    ════════════════════════════════════════════════════════════ */

    // Parse ISO string from server (already Cambodia local, no Z suffix)
    function parseCambodiaTime(isoStr) {
        if (!isoStr) return null;
        const clean = isoStr.replace('Z', '').split('+')[0];
        return new Date(clean);
    }

    function fmtCambodiaDateTime(dt) {
        if (!dt) return '—';
        return dt.toLocaleString('en-GB', {
            day: '2-digit', month: 'short', year: 'numeric',
            hour: '2-digit', minute: '2-digit', hour12: true
        });
    }

    function fmtCambodiaTime(dt) {
        if (!dt) return '—';
        return dt.toLocaleTimeString('en-US', {hour: '2-digit', minute: '2-digit'});
    }

    /* ════════════════════════════════════════════════════════════
       CUSTOMER DISPLAY
    ════════════════════════════════════════════════════════════ */
    async function getSecondScreenCoordinates() {
        try {
            if (window.getScreenDetails) {
                const details = await window.getScreenDetails();
                if (details.screens.length > 1) {
                    const secondScreen = details.screens.find(s => !s.isPrimary) || details.screens[1];
                    if (secondScreen) {
                        return {
                            left: secondScreen.availLeft !== undefined ? secondScreen.availLeft : (secondScreen.left || 0),
                            top: secondScreen.availTop !== undefined ? secondScreen.availTop : (secondScreen.top || 0),
                            width: secondScreen.availWidth !== undefined ? secondScreen.availWidth : (secondScreen.width || 1024),
                            height: secondScreen.availHeight !== undefined ? secondScreen.availHeight : (secondScreen.height || 768)
                        };
                    }
                }
            }
            if (window.screen.availWidth > window.screen.width) {
                return {
                    left: window.screen.width,
                    top: 0,
                    width: window.screen.availWidth - window.screen.width,
                    height: window.screen.availHeight
                };
            }
            return {left: window.screen.availWidth, top: 0, width: 1024, height: 768};
        } catch (e) {
            return {left: window.screen.availWidth, top: 0, width: 1024, height: 768};
        }
    }

    async function openCustomerDisplay() {
        const coords = await getSecondScreenCoordinates();
        if (customerWindow && !customerWindow.closed) {
            try {
                customerWindow.moveTo(coords.left, coords.top);
                customerWindow.resizeTo(coords.width, coords.height);
                customerWindow.focus();
            } catch (e) {
                customerWindow.close();
                customerWindow = null;
            }
        }
        if (!customerWindow || customerWindow.closed) {
            customerWindow = window.open('', 'SandooCustomerDisplay',
                'width=' + coords.width + ',height=' + coords.height + ',left=' + coords.left + ',top=' + coords.top +
                ',resizable=yes,scrollbars=no,toolbar=no,menubar=no,location=no,status=no');
            if (!customerWindow) {
                notify('Browser ទប់ Popup — សូម Allow popup', 'error');
                return false;
            }
            customerWindow.document.open();
            customerWindow.document.write(buildCustomerWindowHtml());
            customerWindow.document.close();
            document.getElementById('customerScreenStatus').innerHTML = '🟢';
            document.getElementById('customerScreenBtn').classList.add('shift-open');
            var checkClosed = setInterval(function () {
                if (!customerWindow || customerWindow.closed) {
                    clearInterval(checkClosed);
                    customerWindow = null;
                    document.getElementById('customerScreenStatus').innerHTML = '🔴';
                    document.getElementById('customerScreenBtn').classList.remove('shift-open');
                    if (customerDisplayAutoOpen && shift.isOpen) setTimeout(() => openCustomerDisplay(), 2000);
                }
            }, 1000);
        }
        return true;
    }

    function closeCustomerDisplay() {
        if (customerWindow && !customerWindow.closed) customerWindow.close();
        customerWindow = null;
        document.getElementById('customerScreenStatus').innerHTML = '🔴';
        document.getElementById('customerScreenBtn').classList.remove('shift-open');
    }

    async function toggleCustomerDisplay() {
        if (customerWindow && !customerWindow.closed) {
            closeCustomerDisplay();
            customerDisplayAutoOpen = false;
        } else {
            await openCustomerDisplay();
            customerDisplayAutoOpen = true;
        }
    }

    function maintainCustomerDisplay() {
        if (shift.isOpen && customerDisplayAutoOpen) {
            if (!customerWindow || customerWindow.closed) {
                openCustomerDisplay();
            } else {
                getSecondScreenCoordinates().then(coords => {
                    try {
                        customerWindow.moveTo(coords.left, coords.top);
                        customerWindow.resizeTo(coords.width, coords.height);
                    } catch (e) {
                    }
                });
            }
        }
        setTimeout(maintainCustomerDisplay, 5000);
    }

    function postToCustomer(data) {
        if (customerWindow && !customerWindow.closed) {
            try {
                customerWindow.postMessage(data, '*');
            } catch (e) {
            }
        }
    }

    function buildCustomerWindowHtml() {
        var origin = window.location.origin;
        return '<!DOCTYPE html>\n<html lang="km">\n<head>\n<meta charset="utf-8">\n<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">\n<title>Customer Display — ផ្ទះបាយសេនឌូ</title>\n<link rel="preconnect" href="https://fonts.googleapis.com">\n<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800;900&family=Noto+Sans+Khmer:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">\n<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{width:100%;height:100%;overflow:hidden;font-family:\'Sora\',\'Noto Sans Khmer\',sans-serif;background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased}\n:root{--brand:#FF6B35;--brand-dark:#E85520;--brand-light:#FFF3EE;--brand-glow:rgba(255,107,53,.18);--accent:#2D3561;--accent-dark:#1C2140;--success:#00B894;--warning:#F59E0B;--danger:#EF4444;--danger-light:#FEE2E2;--bg:#F4F1ED;--bg-2:#EDE9E3;--surface:#FFFFFF;--surface-2:#FAFAF8;--border:#E2DDD7;--border-light:#EDE9E4;--text:#1A1714;--text-sub:#574F47;--text-muted:#9C9189;--shadow-xs:0 1px 3px rgba(26,23,20,.06);--shadow-sm:0 2px 10px rgba(26,23,20,.08);--shadow-md:0 8px 24px rgba(26,23,20,.10);--shadow-lg:0 20px 48px rgba(26,23,20,.15);--shadow-brand:0 8px 24px rgba(255,107,53,.25);--r-xs:6px;--r-sm:10px;--r-md:14px;--r-lg:20px;--r-xl:28px}\n.pos-cd{position:fixed;top:0;left:0;right:0;bottom:0;width:100vw;height:100vh;display:flex;flex-direction:column;background:var(--bg);overflow:hidden}\n.fullscreen-btn{position:fixed;bottom:20px;right:20px;width:48px;height:48px;background:var(--surface);border:1px solid var(--border);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:1000;box-shadow:var(--shadow-sm);transition:all 0.3s ease;color:var(--brand);font-size:20px}\n.fullscreen-btn:hover{transform:scale(1.1);background:var(--brand);color:white;border-color:var(--brand)}\n.cd-header{background:var(--surface);border-bottom:1px solid var(--border);padding:16px 24px;flex-shrink:0;box-shadow:var(--shadow-xs)}\n.cd-header-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}\n.cd-logo-area{display:flex;align-items:center;gap:10px}\n.cd-logo-dot{width:10px;height:10px;background:var(--brand);border-radius:50%;box-shadow:0 0 14px rgba(255,107,53,0.9);animation:cdPulse 2.5s ease-in-out infinite}\n@keyframes cdPulse{0%,100%{opacity:1;box-shadow:0 0 8px rgba(255,107,53,0.6)}50%{opacity:0.7;box-shadow:0 0 22px rgba(255,107,53,0.9)}}\n.cd-logo-text{font-size:20px;font-weight:800;color:var(--text);letter-spacing:-0.3px}\n.cd-logo-text span{color:var(--brand)}\n.cd-clock{background:var(--bg-2);border:1px solid var(--border-light);border-radius:var(--r-xl);padding:6px 16px;font-size:15px;font-weight:600;color:var(--text);font-variant-numeric:tabular-nums;letter-spacing:0.5px}\n.cd-header-sub{display:flex;align-items:center;justify-content:space-between}\n.cd-welcome-line1{font-size:12px;font-weight:500;color:var(--text-muted);letter-spacing:0.3px}\n.cd-currency-toggle{display:flex;align-items:center;gap:6px;background:var(--bg-2);border-radius:var(--r-xl);padding:4px;border:1px solid var(--border-light)}\n.cd-currency-opt{padding:4px 14px;border-radius:30px;font-size:12px;font-weight:600;cursor:pointer;transition:all 0.2s;background:transparent;color:var(--text-sub)}\n.cd-currency-opt.active{background:var(--brand);color:white;box-shadow:var(--shadow-sm)}\n.cd-live-dot{font-size:10px;font-weight:600;color:var(--text-muted);display:flex;align-items:center;gap:5px}\n.cd-live-dot::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--success);animation:livePulse 2s infinite}\n@keyframes livePulse{0%,100%{opacity:1}50%{opacity:0.3}}\n.cd-main-content{flex:1;min-height:0;overflow-y:auto;transition:all 0.3s ease}\n.cd-main-content.qr-active{overflow:hidden}\n.cd-idle{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;padding:32px;text-align:center}\n.cd-idle-icon{width:100px;height:100px;background:var(--brand-light);border:1px solid var(--border);border-radius:50%;display:flex;align-items:center;justify-content:center}\n.cd-idle-icon i{font-size:42px;color:var(--brand)}\n.cd-idle-title{font-size:32px;font-weight:800;color:var(--text);letter-spacing:-0.5px}\n.cd-idle-sub{font-size:16px;font-weight:500;color:var(--text-sub);line-height:1.6}\n.cd-promo-strip{background:linear-gradient(135deg,var(--brand-light),#FFF);border:1px solid var(--border-light);border-radius:var(--r-md);padding:16px 24px;max-width:420px;width:100%;text-align:center}\n.cd-promo-label{font-size:11px;font-weight:700;color:var(--brand);text-transform:uppercase;letter-spacing:1px;margin-bottom:6px}\n.cd-promo-text{font-size:14px;font-weight:500;color:var(--text-sub);line-height:1.6}\n.cd-order-section{padding:20px 24px}\n.cd-section-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);margin-bottom:16px;display:flex;align-items:center;gap:8px}\n.cd-section-label::after{content:"";flex:1;height:1px;background:var(--border)}\n.cd-item{display:flex;align-items:center;gap:14px;padding:14px 16px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-md);margin-bottom:10px;animation:cdSlideIn 0.2s ease;border-left:4px solid var(--brand);box-shadow:var(--shadow-xs);transition:all 0.2s ease}\n.cd-item:hover{transform:translateX(2px);box-shadow:var(--shadow-sm)}\n@keyframes cdSlideIn{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:translateX(0)}}\n.cd-item-thumb{width:56px;height:56px;border-radius:var(--r-sm);overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:24px;color:white;background:linear-gradient(135deg,var(--brand),var(--brand-dark))}\n.cd-item-thumb img{width:100%;height:100%;object-fit:cover;display:block}\n.cd-item-info{flex:1;min-width:0}\n.cd-item-name{font-size:16px;font-weight:700;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.cd-item-unit{font-size:12px;font-weight:500;color:var(--text-muted);margin-top:4px}\n.cd-item-unit-khr{font-size:10px;font-weight:500;color:var(--text-muted);margin-top:2px}\n.cd-item-right{text-align:right;flex-shrink:0}\n.cd-item-qty{display:inline-flex;align-items:center;justify-content:center;min-width:36px;height:36px;background:var(--brand-light);border:1px solid var(--border);border-radius:var(--r-sm);font-size:16px;font-weight:700;color:var(--brand);margin-bottom:4px;padding:0 8px}\n.cd-item-total{font-size:16px;font-weight:700;color:var(--text)}\n.cd-item-total-khr{font-size:11px;font-weight:500;color:var(--text-muted);margin-top:2px}\n.cd-summary{background:var(--surface);border-top:1px solid var(--border);padding:20px 24px;flex-shrink:0;box-shadow:var(--shadow-sm)}\n.cd-sum-row{display:flex;justify-content:space-between;align-items:flex-start;font-size:15px;font-weight:600;color:var(--text-sub);margin-bottom:10px}\n.cd-sum-row.total{font-size:22px;font-weight:800;color:var(--text);border-top:2px solid var(--border);padding-top:14px;margin-top:8px;margin-bottom:0}\n.cd-sum-row.total .cd-total-usd{color:var(--brand)}\n.cd-sum-khr{font-size:12px;font-weight:500;color:var(--text-muted);text-align:right}\n.cd-discount-pill{display:inline-flex;align-items:center;gap:5px;background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.2);color:var(--warning);font-size:12px;font-weight:600;padding:4px 12px;border-radius:var(--r-xl)}\n.khqr-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:var(--surface);z-index:100;display:none;flex-direction:column;align-items:center;justify-content:center;gap:24px;padding:32px;animation:khqrFadeIn 0.35s ease}\n.khqr-overlay.show{display:flex}\n@keyframes khqrFadeIn{from{opacity:0;transform:scale(0.98)}to{opacity:1;transform:scale(1)}}\n.khqr-header{text-align:center;margin-bottom:8px}\n.khqr-title{font-size:32px;font-weight:800;color:var(--brand);letter-spacing:-0.5px}\n.khqr-subtitle{font-size:15px;font-weight:500;color:var(--text-sub);margin-top:8px}\n.khqr-qr-container{position:relative;margin:16px 0}\n.khqr-qr-frame{position:relative;width:300px;height:300px;background:white;border-radius:var(--r-lg);padding:20px;box-shadow:var(--shadow-lg);border:2px solid var(--brand)}\n.khqr-qr-corner{position:absolute;width:30px;height:30px;border-color:var(--brand);border-style:solid}\n.khqr-qr-corner.tl{top:-3px;left:-3px;border-width:5px 0 0 5px;border-radius:10px 0 0 0}\n.khqr-qr-corner.tr{top:-3px;right:-3px;border-width:5px 5px 0 0;border-radius:0 10px 0 0}\n.khqr-qr-corner.bl{bottom:-3px;left:-3px;border-width:0 0 5px 5px;border-radius:0 0 0 10px}\n.khqr-qr-corner.br{bottom:-3px;right:-3px;border-width:0 5px 5px 0;border-radius:0 0 10px 0}\n.khqr-qr-inner{width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:white;border-radius:var(--r-sm)}\n.khqr-qr-inner img,.khqr-qr-inner canvas{max-width:100%;max-height:100%;border-radius:8px}\n.khqr-pulse-ring{position:absolute;inset:-15px;border-radius:40px;border:2px solid var(--brand-glow);animation:khqrPulse 2s ease-in-out infinite;pointer-events:none}\n@keyframes khqrPulse{0%,100%{transform:scale(1);opacity:0.6}50%{transform:scale(1.05);opacity:0.2}}\n.khqr-amount{text-align:center;margin:20px 0 12px}\n.khqr-amount-usd{font-size:48px;font-weight:800;color:var(--brand);letter-spacing:-1px}\n.khqr-amount-khr{font-size:18px;font-weight:600;color:var(--text-muted);margin-top:-6px}\n.khqr-merchant{font-size:16px;font-weight:700;color:var(--text);margin:12px 0 4px}\n.khqr-bank{font-size:13px;font-weight:500;color:var(--text-muted);display:flex;align-items:center;gap:6px}\n.khqr-timer{width:100%;max-width:300px;margin:24px auto 0}\n.khqr-timer-bar{background:var(--bg-2);border-radius:var(--r-xl);height:8px;overflow:hidden}\n.khqr-timer-fill{height:100%;background:linear-gradient(90deg,var(--brand),var(--brand-dark));border-radius:var(--r-xl);width:100%;transition:width 120s linear}\n.khqr-timer-text{text-align:center;font-size:12px;font-weight:600;color:var(--text-muted);margin-top:10px}\n.khqr-timer-text span{color:var(--brand);font-weight:800}\n.khqr-close-btn{position:absolute;top:24px;right:24px;width:48px;height:48px;background:var(--surface);border:1px solid var(--border);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all 0.2s;color:var(--text);font-size:20px;z-index:101;box-shadow:var(--shadow-sm)}\n.khqr-close-btn:hover{background:var(--danger-light);border-color:var(--danger);color:var(--danger)}\n.khqr-instruction{background:var(--brand-light);border:1px solid var(--border);border-radius:var(--r-xl);padding:12px 24px;margin-top:20px;font-size:13px;font-weight:600;color:var(--brand)}\n.thankyou-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:var(--surface);z-index:200;display:none;flex-direction:column;align-items:center;justify-content:center;gap:24px;padding:32px;text-align:center;animation:thankyouFadeIn 0.4s ease}\n.thankyou-overlay.show{display:flex}\n@keyframes thankyouFadeIn{from{opacity:0;transform:scale(0.95)}to{opacity:1;transform:scale(1)}}\n.thankyou-check{width:100px;height:100px;background:rgba(0,184,148,0.1);border:3px solid var(--success);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:48px;color:var(--success);animation:thankyouBounce 0.5s cubic-bezier(0.34,1.2,0.64,1)}\n@keyframes thankyouBounce{0%{transform:scale(0.3);opacity:0}50%{transform:scale(1.1)}100%{transform:scale(1);opacity:1}}\n.thankyou-title{font-size:36px;font-weight:800;color:var(--text)}\n.thankyou-amount{font-size:52px;font-weight:800;color:var(--brand);letter-spacing:-1px;margin:8px 0}\n.thankyou-amount-khr{font-size:20px;font-weight:600;color:var(--text-muted);margin-top:-10px}\n.thankyou-change{background:var(--bg-2);border:1px solid var(--border);border-radius:var(--r-md);padding:20px 32px;margin-top:16px}\n.thankyou-change-label{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--success);margin-bottom:8px}\n.thankyou-change-usd{font-size:32px;font-weight:800;color:var(--success)}\n.thankyou-change-khr{font-size:14px;font-weight:600;color:var(--text-muted)}\n.thankyou-message{font-size:16px;font-weight:500;color:var(--text-sub);margin-top:20px;line-height:1.6}\n.cd-main-content::-webkit-scrollbar{width:6px}\n.cd-main-content::-webkit-scrollbar-track{background:var(--bg-2);border-radius:10px}\n.cd-main-content::-webkit-scrollbar-thumb{background:var(--border);border-radius:10px}\n.cd-main-content::-webkit-scrollbar-thumb:hover{background:var(--brand)}\n</style>\n</head>\n<body>\n<div class="pos-cd">\n<div class="cd-header">\n<div class="cd-header-top">\n<div class="cd-logo-area"><div class="cd-logo-dot"></div><div class="cd-logo-text">ផ្ទះបាយ<span>សេនឌូ</span></div></div>\n<div class="cd-clock" id="cdClock">00:00:00</div>\n</div>\n<div class="cd-header-sub">\n<div class="cd-welcome-line1">Customer Display</div>\n<div style="display:flex;align-items:center;gap:12px;">\n<div class="cd-currency-toggle" id="cdCurrencyToggle"><span class="cd-currency-opt active" data-cd-currency="usd">USD</span><span class="cd-currency-opt" data-cd-currency="khr">KHR</span></div>\n<div class="cd-live-dot">LIVE</div>\n</div>\n</div>\n</div>\n<div class="cd-main-content" id="cdMainContent">\n<div class="cd-idle" id="cdIdle">\n<div class="cd-idle-icon"><i class="fas fa-concierge-bell"></i></div>\n<div><div class="cd-idle-title">សូមស្វាគមន៍!</div><div class="cd-idle-sub">ជ្រើសរើសមុខអាហារ<br>ហើយយើងនឹងបម្រើអ្នក</div></div>\n<div style="background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md);padding:16px 20px;max-width:360px;width:100%;display:flex;align-items:center;gap:14px;">\n<div style="width:44px;height:44px;background:var(--brand-light);border:1px solid var(--border);border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-calendar-day" style="font-size:18px;color:var(--brand);"></i></div>\n<div><div id="cdIdleDate" style="font-size:15px;font-weight:600;color:var(--text);"></div><div id="cdIdleDay" style="font-size:13px;font-weight:500;color:var(--text-muted);margin-top:2px;"></div></div>\n</div>\n<div class="cd-promo-strip"><div class="cd-promo-label">ប្រម៉ូសិយ៉ូន</div><div class="cd-promo-text">ទទួលការបញ្ចុះតម្លៃ 10%<br>នៅពេលបញ្ជាទិញលើសពី $20</div></div>\n</div>\n<div id="cdOrderState" style="display:none;">\n<div class="cd-order-section"><div class="cd-section-label">បញ្ជីការកម្មង់</div><div id="cdItemsList"></div></div>\n<div class="cd-summary">\n<div class="cd-sum-row"><span>សរុប</span><span><span id="cdSubtotal">$0.00</span><div class="cd-sum-khr" id="cdSubtotalKhr">0 ៛</div></span></div>\n<div class="cd-sum-row" id="cdDiscountRow" style="display:none;"><span class="cd-discount-pill"><i class="fas fa-tag"></i><span id="cdDiscountLabel">បញ្ចុះ</span></span><span style="color:var(--warning);font-weight:700;" id="cdDiscountVal">-$0.00</span></div>\n<div class="cd-sum-row total"><span><i class="fas fa-calculator"></i>សរុបទាំងអស់</span><span><span class="cd-total-usd" id="cdTotal">$0.00</span><div class="cd-sum-khr" id="cdTotalKhr">0 ៛</div></span></div>\n</div>\n</div>\n</div>\n<button class="fullscreen-btn" id="fullscreenBtn"><i class="fas fa-expand"></i></button>\n<div class="khqr-overlay" id="khqrOverlay">\n<div class="khqr-close-btn" id="khqrCloseBtn"><i class="fas fa-times"></i></div>\n<div class="khqr-header"><div class="khqr-title">ទូទាត់តាម KHQR</div><div class="khqr-subtitle">ស្កែន QR Code ដើម្បីបង់ប្រាក់</div></div>\n<div class="khqr-qr-container"><div class="khqr-qr-frame"><div class="khqr-pulse-ring"></div><div class="khqr-qr-corner tl"></div><div class="khqr-qr-corner tr"></div><div class="khqr-qr-corner bl"></div><div class="khqr-qr-corner br"></div><div class="khqr-qr-inner"><img src="' + origin + '/khqr-code.png" alt="KHQR" id="khqrImage" style="width:100%;height:100%;object-fit:contain;display:block;" onerror="this.style.display=\'none\';document.getElementById(\'khqrCanvas\').style.display=\'block\';"><canvas id="khqrCanvas" width="240" height="240" style="display:none;"></canvas></div></div></div>\n<div class="khqr-amount"><div class="khqr-amount-usd" id="khqrAmountUsd">$0.00</div><div class="khqr-amount-khr" id="khqrAmountKhr">0 ៛</div></div>\n<div class="khqr-merchant">ផ្ទះបាយសេនឌូ</div>\n<div class="khqr-bank"><i class="fas fa-university"></i> ABA Bank · 0000 1234 5678</div>\n<div class="khqr-timer"><div class="khqr-timer-bar"><div class="khqr-timer-fill" id="khqrTimerFill"></div></div><div class="khqr-timer-text">ផុតកំណត់ក្នុង <span id="khqrTimerLabel">2:00</span></div></div>\n<div class="khqr-instruction"><i class="fas fa-mobile-alt"></i> បើកកម្មវិធី ABA / ACLEDA / Wing ហើយស្កែន QR</div>\n</div>\n<div class="thankyou-overlay" id="thankyouOverlay">\n<div class="thankyou-check"><i class="fas fa-check"></i></div>\n<div class="thankyou-title">សូមអរគុណ! 🙏</div>\n<div><div class="thankyou-amount" id="tyAmount">$0.00</div><div class="thankyou-amount-khr" id="tyAmountKhr">0 ៛</div></div>\n<div class="thankyou-change" id="tyChangeBox" style="display:none;"><div class="thankyou-change-label">ប្រាក់អាប់</div><div class="thankyou-change-usd" id="tyChangeUsd">$0.00</div><div class="thankyou-change-khr" id="tyChangeKhr">0 ៛</div></div>\n<div class="thankyou-message">អរគុណសម្រាប់ការញ៉ាំ<br>សូមអញ្ជើញមកម្តងទៀត!</div>\n</div>\n</div>\n<script>\nfunction loadQRCodeLibrary(){return new Promise((resolve,reject)=>{if(typeof QRCode!=="undefined"){resolve();return;}var script=document.createElement("script");script.src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js";script.onload=resolve;script.onerror=reject;document.head.appendChild(script);});}\nfunction toggleFullscreen(){const elem=document.documentElement;if(!document.fullscreenElement&&!document.webkitFullscreenElement){if(elem.requestFullscreen)elem.requestFullscreen();else if(elem.webkitRequestFullscreen)elem.webkitRequestFullscreen();}else{if(document.exitFullscreen)document.exitFullscreen();else if(document.webkitExitFullscreen)document.webkitExitFullscreen();}}\nfunction updateFullscreenIcon(){const btn=document.getElementById("fullscreenBtn");const isFs=document.fullscreenElement||document.webkitFullscreenElement;if(btn)btn.innerHTML=isFs?\'<i class="fas fa-compress"></i>\':\'<i class="fas fa-expand"></i>\';}\ndocument.addEventListener("fullscreenchange",updateFullscreenIcon);document.addEventListener("webkitfullscreenchange",updateFullscreenIcon);\ndocument.addEventListener("DOMContentLoaded",function(){const fb=document.getElementById("fullscreenBtn");if(fb)fb.addEventListener("click",toggleFullscreen);});\nloadQRCodeLibrary().catch(err=>console.warn("QR lib failed:",err));\n(function(){\nvar EXRATE=4100;var CHG_RATE=4000;var displayCurrency="usd";var currentOrderData=null;var qrTimerInterval=null;\nfunction fmtUsd(n){return"$"+parseFloat(n).toFixed(2);}\nfunction fmtKhr(n){return Math.round(n).toLocaleString()+" ៛";}\nfunction toKhr(usd){return Math.round(usd*EXRATE);}\nfunction toKhrCustomer(usd){return Math.round(usd*CHG_RATE);}\nfunction roundK(v){return Math.round(v/100)*100;}\nfunction setDisplayCurrency(currency){displayCurrency=currency;document.querySelectorAll(".cd-currency-opt").forEach(opt=>{if(opt.dataset.cdCurrency===currency)opt.classList.add("active");else opt.classList.remove("active");});if(currentOrderData&&!currentOrderData.isEmpty)renderOrder(currentOrderData);}\nvar toggle=document.getElementById("cdCurrencyToggle");if(toggle){toggle.addEventListener("click",function(e){var t=e.target.closest(".cd-currency-opt");if(t&&t.dataset.cdCurrency)setDisplayCurrency(t.dataset.cdCurrency);});}\nfunction updateClock(){var now=new Date();var h=String(now.getHours()).padStart(2,"0");var m=String(now.getMinutes()).padStart(2,"0");var s=String(now.getSeconds()).padStart(2,"0");var el=document.getElementById("cdClock");if(el)el.textContent=h+":"+m+":"+s;}\nsetInterval(updateClock,1000);updateClock();\n(function(){var now=new Date();var dEl=document.getElementById("cdIdleDate");var dayEl=document.getElementById("cdIdleDay");if(dEl)dEl.textContent=now.toLocaleDateString("en-GB",{day:"2-digit",month:"long",year:"numeric"});if(dayEl)dayEl.textContent=now.toLocaleDateString("en-GB",{weekday:"long"});})();\nfunction formatAmount(usdValue,khrValue){if(displayCurrency==="usd")return{main:fmtUsd(usdValue),secondary:fmtKhr(khrValue)};return{main:fmtKhr(khrValue),secondary:fmtUsd(usdValue)};}\nfunction generateQRCode(canvasId,text,width,height){var canvas=document.getElementById(canvasId);if(!canvas)return false;if(typeof QRCode!=="undefined"&&QRCode.toCanvas){try{QRCode.toCanvas(canvas,text,{width:width,margin:1,color:{dark:"#1A1714",light:"#FFFFFF"},errorCorrectionLevel:"H"},function(err){if(err)console.warn("QR error:",err);});return true;}catch(e){return false;}}return false;}\nfunction showKHQR(amountUsd,amountKhr){var overlay=document.getElementById("khqrOverlay");var mc=document.getElementById("cdMainContent");document.getElementById("khqrAmountUsd").textContent=fmtUsd(amountUsd);document.getElementById("khqrAmountKhr").textContent=fmtKhr(amountKhr);var qrText="KHQR|SandooHouse|ABA|0000123456|USD|"+amountUsd.toFixed(2)+"|"+Date.now();var canvas=document.getElementById("khqrCanvas");var img=document.getElementById("khqrImage");if(generateQRCode("khqrCanvas",qrText,240,240)){if(img)img.style.display="none";if(canvas)canvas.style.display="block";}else{if(img)img.style.display="block";if(canvas)canvas.style.display="none";}if(qrTimerInterval)clearInterval(qrTimerInterval);var seconds=120;var fill=document.getElementById("khqrTimerFill");var label=document.getElementById("khqrTimerLabel");if(fill){fill.style.transition="width 120s linear";fill.style.width="0%";}qrTimerInterval=setInterval(function(){seconds--;var m=Math.floor(seconds/60);var s=String(seconds%60).padStart(2,"0");if(label)label.textContent=m+":"+s;if(seconds<=0){clearInterval(qrTimerInterval);hideKHQR();}},1000);if(overlay)overlay.classList.add("show");if(mc)mc.classList.add("qr-active");}\nfunction hideKHQR(){var overlay=document.getElementById("khqrOverlay");var mc=document.getElementById("cdMainContent");if(qrTimerInterval){clearInterval(qrTimerInterval);qrTimerInterval=null;}if(overlay)overlay.classList.remove("show");if(mc)mc.classList.remove("qr-active");}\nfunction showThankYou(d){var totalFormatted=formatAmount(d.total,d.totalKhr||toKhrCustomer(d.total));document.getElementById("tyAmount").textContent=totalFormatted.main;document.getElementById("tyAmountKhr").textContent=totalFormatted.secondary;if(d.paymentMethod==="សាច់ប្រាក់"&&d.changeUsd>0){var khrChg=roundK(d.changeUsd*(d.paymentCurrency==="ដុល្លារ"?CHG_RATE:EXRATE));var chFmt=formatAmount(d.changeUsd,khrChg);document.getElementById("tyChangeUsd").textContent=chFmt.main;document.getElementById("tyChangeKhr").textContent=chFmt.secondary;document.getElementById("tyChangeBox").style.display="flex";}else{document.getElementById("tyChangeBox").style.display="none";}var ty=document.getElementById("thankyouOverlay");if(ty)ty.classList.add("show");setTimeout(function(){if(ty)ty.classList.remove("show");renderOrder({isEmpty:true,items:[]});},5000);}\nfunction escapeHtml(str){if(!str)return"";return str.replace(/[&<>]/g,function(m){if(m==="&")return"&amp;";if(m==="<")return"&lt;";if(m===">")return"&gt;";return m;});}\nfunction renderOrder(d){currentOrderData=d;var isEmpty=d.isEmpty||!d.items||d.items.length===0;var idleDiv=document.getElementById("cdIdle");var orderState=document.getElementById("cdOrderState");if(idleDiv)idleDiv.style.display=isEmpty?"flex":"none";if(orderState)orderState.style.display=isEmpty?"none":"block";if(isEmpty)return;var html="";d.items.forEach(function(item){var tot=item.price*item.quantity;var totKhr=toKhrCustomer(tot);var pFmt=formatAmount(item.price,toKhrCustomer(item.price));var tFmt=formatAmount(tot,totKhr);var imgHtml=item.icon?"<img src=\'"+item.icon+"\' alt=\'"+escapeHtml(item.name)+"\' onerror=\'this.onerror=null;this.parentElement.innerHTML=\\\"<i class=\\\\\\\"fas fa-utensils\\\\\\\"></i>\\\";\'>":"<i class=\'fas fa-utensils\'></i>";html+="<div class=\'cd-item\'>";html+="<div class=\'cd-item-thumb\' style=\'background:linear-gradient(135deg,"+item.color+",var(--accent-dark))\'>"+imgHtml+"</div>";html+="<div class=\'cd-item-info\'><div class=\'cd-item-name\'>"+escapeHtml(item.name)+"</div>";html+="<div class=\'cd-item-unit\'>"+pFmt.main+" × "+item.quantity+"</div>";html+="<div class=\'cd-item-unit-khr\'>"+pFmt.secondary+"</div></div>";html+="<div class=\'cd-item-right\'><div class=\'cd-item-qty\'>"+item.quantity+"</div>";html+="<div class=\'cd-item-total\'>"+tFmt.main+"</div>";html+="<div class=\'cd-item-total-khr\'>"+tFmt.secondary+"</div></div>";html+="</div>";});var il=document.getElementById("cdItemsList");if(il)il.innerHTML=html;var subKhr=toKhrCustomer(d.subtotal);var subFmt=formatAmount(d.subtotal,subKhr);document.getElementById("cdSubtotal").textContent=subFmt.main;document.getElementById("cdSubtotalKhr").textContent=subFmt.secondary;var discRow=document.getElementById("cdDiscountRow");if(d.discount>0){var lbl=d.discountType==="percentage"?"បញ្ចុះ "+d.discountAmount+"%":"បញ្ចុះ";document.getElementById("cdDiscountLabel").textContent=lbl;var dFmt=formatAmount(d.discount,toKhrCustomer(d.discount));document.getElementById("cdDiscountVal").textContent="-"+dFmt.main;discRow.style.display="flex";}else if(discRow){discRow.style.display="none";}var totKhr=toKhrCustomer(d.total);var totFmt=formatAmount(d.total,totKhr);document.getElementById("cdTotal").textContent=totFmt.main;document.getElementById("cdTotalKhr").textContent=totFmt.secondary;}\nwindow.addEventListener("message",function(e){if(!e.data||!e.data.type)return;switch(e.data.type){case"CD_SYNC":renderOrder(e.data);break;case"CD_THANKYOU":showThankYou(e.data);break;case"CD_QR":showKHQR(e.data.total,e.data.totalKhr);break;case"CD_QR_HIDE":hideKHQR();break;}});\nvar closeBtn=document.getElementById("khqrCloseBtn");if(closeBtn){closeBtn.addEventListener("click",function(){hideKHQR();if(window.opener)window.opener.postMessage({type:"KHQR_CANCELLED"},"*");});}\nconsole.log("✅ Customer Display ready");\n})();\n<\/script>\n</body>\n</html>';
    }

    $(document).ready(function () {

        /* ═══════════════════════════════════════════════
           RATES & HELPERS
        ═══════════════════════════════════════════════ */
        const EXCHANGE_RATE = 4100;
        const CHANGE_RATE_CUSTOMER = 4000;

        const toKhr = usd => Math.round(usd * EXCHANGE_RATE);
        const fmtKhr = n => Math.round(n).toLocaleString() + ' ៛';
        const fmtUsd = n => '$' + parseFloat(n).toFixed(2);
        const roundKhr100 = khr => Math.round(khr / 100) * 100;

        function customerChangeKhr(changeUsd, changeKhr, payCurrency) {
            if (payCurrency === 'usd') return roundKhr100(changeUsd * CHANGE_RATE_CUSTOMER);
            return roundKhr100(changeKhr);
        }

        /* ── Live clocks ── */
        function updateClocks() {
            const now = new Date();
            const h = now.getHours() % 12 || 12;
            const m = String(now.getMinutes()).padStart(2, '0');
            const ap = now.getHours() >= 12 ? 'PM' : 'AM';
            $('#liveClock').text(`${h}:${m} ${ap}`);
        }

        setInterval(updateClocks, 1000);
        updateClocks();

        /* ── Products from server ── */
        const products = [
            @if (ViewBag.Menus != null)
            {
                var index = 0;
                string[] colors = { "#FF6B35", "#E85520", "#2D3561", "#00B894", "#FDCB6E", "#6C5CE7", "#0984E3", "#E17055", "#00CEC9", "#A29BFE" };
                foreach (var menu in ViewBag.Menus)
                {
                    var color = colors[index % colors.Length];
                    string categoryName = menu.Category?.CategoryName ?? "Uncategorized";
                    string brandName = menu.Category?.Brand?.BrandName ?? "Uncategorized";
                    string imageUrl = menu.ImageMenuUrl ?? "";
                    if (!string.IsNullOrEmpty(imageUrl) && !imageUrl.StartsWith("http") && !imageUrl.StartsWith("/"))
                        imageUrl = "/Menu/" + imageUrl;
                    <text>
                        ,{
                        id:@menu.Id,
                        name: '@Html.Raw(menu.MenuName.Replace("'", "\\'"))',
                        priceUsd:@((menu.Price - (menu.DiscountPrice ?? 0)).ToString("F2")),
                        category: '@Html.Raw(categoryName.Replace("'", "\\'"))',
                        categoryId:@(menu.CategoryId ?? 0),
                        brand: '@Html.Raw(brandName.Replace("'", "\\'"))',
                        brandId:@(menu.Category?.BrandId ?? 0),
                        icon: '@Html.Raw(imageUrl)',
                        color: '@color'
                    },
                    </text>
                    index++;
                }
            }
        ];

        const categoriesByBrand = {};
        const allCategories = [];
        products.forEach(p => {
            if (!categoriesByBrand[p.brand]) categoriesByBrand[p.brand] = new Set();
            categoriesByBrand[p.brand].add(p.category);
            if (!allCategories.includes(p.category)) allCategories.push(p.category);
        });

        let cart = [], currentPaymentMethod = 'cash', displayCurrency = 'usd', paymentCurrency = 'usd';
        let discountAmount = 0, discountType = 'fixed';
        let orderCounter = 4580, lastOrderLocal = null;
        let currentBrand = 'all', currentCategory = 'all';

        function calcDiscount(sub) {
            if (!discountAmount || discountAmount <= 0) return 0;
            return discountType === 'fixed'
                ? Math.min(discountAmount, sub)
                : Math.min(sub * discountAmount / 100, sub);
        }

        /* ════ CUSTOMER DISPLAY SYNC ════ */
        function syncCustomerDisplay() {
            const sub = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const disc = calcDiscount(sub);
            const total = sub - disc;
            postToCustomer({
                type: 'CD_SYNC', isEmpty: cart.length === 0, paymentCurrency,
                items: cart.map(i => ({
                    id: i.id,
                    name: i.name,
                    price: i.price,
                    quantity: i.quantity,
                    icon: i.icon,
                    color: i.color
                })),
                subtotal: sub, discount: disc, discountType, discountAmount, total
            });
        }

        function showCustomerThankYou(order) {
            postToCustomer({
                type: 'CD_THANKYOU', total: order.total, totalKhr: order.totalKhr,
                paymentMethod: order.paymentMethod, paymentCurrency: order.paymentCurrency,
                changeUsd: order.changeUsd, changeKhr: order.changeKhr
            });
        }

        /* ── Category tabs ── */
        function updateCategoryTabs(brand) {
            const cats = brand === 'all' ? allCategories : Array.from(categoriesByBrand[brand] || []);
            let html = '<button class="tab-pill active" data-category="all">ទាំងអស់</button>';
            cats.forEach(c => {
                html += `<button class="tab-pill" data-category="${c}">${c}</button>`;
            });
            $('#categoryTabs').html(html);
            currentCategory = 'all';
        }

        /* ── Product grid ── */
        function loadProducts() {
            if (!products.length) {
                $('#productsGrid').html('<div class="state-placeholder"><i class="fas fa-box-open"></i><p>មិនមានផលិតផល</p></div>');
                return;
            }
            const q = $('#productSearch').val().toLowerCase();
            const filtered = products.filter(p =>
                (currentBrand === 'all' || p.brand === currentBrand) &&
                (currentCategory === 'all' || p.category === currentCategory) &&
                p.name.toLowerCase().includes(q)
            );
            if (!filtered.length) {
                $('#productsGrid').html('<div class="state-placeholder"><i class="fas fa-search"></i><p>រកមិនឃើញ</p><small>ប្ដូរតម្រង</small></div>');
                return;
            }
            let html = '';
            filtered.forEach(p => {
                const imgHtml = p.icon
                    ? `<img src="${p.icon}" alt="${p.name}" onerror="this.onerror=null;this.style.display='none';this.parentElement.innerHTML='<i class=\\'fas fa-utensils\\'></i>';">`
                    : '<i class="fas fa-utensils"></i>';
                html += `
<div class="product-card" style="--product-color:${p.color}"
     data-id="${p.id}" data-name="${p.name.replace(/'/g, '&apos;')}"
     data-price="${p.priceUsd}" data-brand-id="${p.brandId || 0}"
     data-icon="${p.icon || ''}" data-color="${p.color}">
    <div class="prod-img" style="background:linear-gradient(160deg,${p.color},#2D3561)">${imgHtml}</div>
    <div class="prod-price">${p.name}</div>
    <div class="prod-price-khr">${p.priceUsd}$ = ${fmtKhr(roundKhr100(parseFloat(p.priceUsd) * (paymentCurrency === 'khr' ? CHANGE_RATE_CUSTOMER : EXCHANGE_RATE)))}</div>
    <button class="prod-add-btn"><i class="fas fa-plus"></i></button>
</div>`;
            });
            $('#productsGrid').fadeOut(70, function () {
                $(this).html(html).fadeIn(110);
            });
        }

        updateCategoryTabs('all');
        loadProducts();

        $('#brandTabs').on('click', '.tab-pill', function () {
            $('#brandTabs .tab-pill').removeClass('brand-active');
            $(this).addClass('brand-active');
            currentBrand = $(this).data('brand') || 'all';
            updateCategoryTabs(currentBrand);
            loadProducts();
        });
        $(document).on('click', '#categoryTabs .tab-pill', function () {
            $('#categoryTabs .tab-pill').removeClass('active');
            $(this).addClass('active');
            currentCategory = $(this).data('category') || 'all';
            loadProducts();
        });
        let searchTimeout;
        $('#productSearch').on('input', function () {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(loadProducts, 280);
        });
        $('#productSearch').on('keydown', function (e) {
            if (e.key === 'Escape') {
                $(this).val('');
                loadProducts();
            }
        });

        /* ── Cart ── */
        $(document).on('click', '.product-card', function (e) {
            if ($(e.target).is('button,i')) return;
            addToCart(this);
        });
        $(document).on('click', '.prod-add-btn', function (e) {
            e.stopPropagation();
            addToCart($(this).closest('.product-card')[0]);
        });

        function addToCart(el) {
            const $el = $(el);
            $el.addClass('pulse');
            setTimeout(() => $el.removeClass('pulse'), 300);
            const item = {
                id: $el.data('id'), name: $el.data('name'),
                price: parseFloat($el.data('price')), brandId: $el.data('brand-id') || 0,
                icon: $el.data('icon') || '', color: $el.data('color') || 'var(--brand)'
            };
            const existing = cart.find(i => i.id === item.id);
            if (existing) {
                existing.quantity++;
                notify(`+1 ${item.name}`, 'info');
            } else {
                cart.push({...item, quantity: 1});
                notify(`បន្ថែម ${item.name}`, 'success');
            }
            renderCart();
        }

        function renderCart() {
            let html = '';
            if (cart.length === 0) {
                html = `<div class="empty-cart"><i class="fas fa-utensils"></i><p>ថ្ងៃសួស្ដី! ជ្រើសអាហារ</p><small>ចុចលើផលិតផលដើម្បីបន្ថែម</small></div>`;
            } else {
                cart.forEach((item, idx) => {
                    const tot = item.price * item.quantity;
                    const imgHtml = item.icon
                        ? `<img src="${item.icon}" alt="${item.name}" onerror="this.onerror=null;this.style.display='none';this.parentElement.innerHTML='<i class=\\'fas fa-utensils\\'></i>';">`
                        : '<i class="fas fa-utensils"></i>';
                    html += `
<div class="cart-item" data-index="${idx}" style="--product-color:${item.color}">
    <div class="ci-thumb" style="background:linear-gradient(135deg,${item.color},#2D3561)">${imgHtml}</div>
    <div class="ci-info">
        <div class="ci-name">${item.name}</div>
        <div class="ci-price">${fmtUsd(item.price)}</div>
    </div>
    <div class="ci-qty">
        <button class="ci-qty-btn decrease-qty"><i class="fas fa-minus"></i></button>
        <span class="ci-qty-num">${item.quantity}</span>
        <button class="ci-qty-btn increase-qty"><i class="fas fa-plus"></i></button>
    </div>
    <div class="ci-total">${displayCurrency === 'usd' ? fmtUsd(tot) : fmtKhr(toKhr(tot))}</div>
    <div class="ci-remove"><i class="fas fa-trash-alt"></i></div>
</div>`;
                });
            }
            $('#cartItems').html(html);
            updateSummary();
            updateFab();
            syncCustomerDisplay();
        }

        $(document).on('click', '.increase-qty', function () {
            const idx = $(this).closest('.cart-item').data('index');
            cart[idx].quantity++;
            renderCart();
        });
        $(document).on('click', '.decrease-qty', function () {
            const idx = $(this).closest('.cart-item').data('index');
            if (cart[idx].quantity > 1) {
                cart[idx].quantity--;
            } else {
                notify(`លុប ${cart[idx].name}`, 'warning');
                cart.splice(idx, 1);
            }
            renderCart();
        });
        $(document).on('click', '.ci-remove', function () {
            const idx = $(this).closest('.cart-item').data('index');
            notify(`លុប ${cart[idx].name}`, 'warning');
            cart.splice(idx, 1);
            renderCart();
        });

        function updateSummary() {
            const sub = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const disc = calcDiscount(sub);
            const total = sub - disc;
            $('#subtotal').text(fmtUsd(sub));
            $('#subtotalKhr').text(fmtKhr(roundKhr100(toKhr(sub))));
            $('#total').text(fmtUsd(total));
            $('#totalKhr').text(fmtKhr(roundKhr100(toKhr(total))));
            if (disc > 0) {
                $('#discountDisplay').show();
                $('#discountValue').text('-' + fmtUsd(disc));
                $('#discountKhr').text(fmtKhr(roundKhr100(toKhr(disc))));
            } else {
                $('#discountDisplay').hide();
            }
            const cnt = cart.reduce((s, i) => s + i.quantity, 0);
            $('#cartCount').text(cnt + ' មុខ');
            updatePayState();
        }

        function updatePayState() {
            const sub = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const totalUsd = sub - calcDiscount(sub);
            const totalKhr = roundKhr100(toKhr(totalUsd));
            const cash = parseFloat($('#cashReceived').val()) || 0;
            if (cart.length === 0) {
                $('#payBtn').prop('disabled', true);
                $('#changeDisplay').removeClass('show');
                return;
            }
            if (currentPaymentMethod !== 'cash') {
                $('#payBtn').prop('disabled', false);
                $('#changeDisplay').removeClass('show');
                return;
            }
            const needed = paymentCurrency === 'usd' ? totalUsd : totalKhr;
            $('#payBtn').prop('disabled', cash < needed);
            if (cash >= needed && cash > 0) {
                let changeUsd, changeKhr;
                if (paymentCurrency === 'usd') {
                    changeUsd = cash - totalUsd;
                    changeKhr = roundKhr100(toKhr(changeUsd));
                } else {
                    changeKhr = roundKhr100(cash - totalKhr);
                    changeUsd = changeKhr / EXCHANGE_RATE;
                }
                $('#changeAmount').text(fmtUsd(changeUsd));
                $('#changeAmountKhr').text(fmtKhr(changeKhr));
                $('#changeDisplay').addClass('show');
            } else {
                $('#changeDisplay').removeClass('show');
            }
        }

        function updateFab() {
            const cnt = cart.reduce((s, i) => s + i.quantity, 0);
            $('#fabBadge').text(cnt);
        }

        $(document).on('click', '.curr-btn', function () {
            $('.curr-btn').removeClass('active');
            $(this).addClass('active');
            displayCurrency = $(this).data('currency');
            renderCart();
        });
        $(document).on('click', '[data-pay-currency]', function () {
            $('[data-pay-currency]').removeClass('active');
            $(this).addClass('active');
            paymentCurrency = $(this).data('pay-currency');
            if (paymentCurrency === 'usd') {
                $('.usd-amt').show();
                $('.khr-amt').hide();
                $('#cashReceived').attr('placeholder', 'ទទួលប្រាក់ (USD)').val('');
            } else {
                $('.usd-amt').hide();
                $('.khr-amt').show();
                $('#cashReceived').attr('placeholder', 'ទទួលប្រាក់ (រៀល)').val('');
            }
            loadProducts();
            syncCustomerDisplay();
            updatePayState();
        });
        $(document).on('click', '.pay-method', function () {
            $('.pay-method').removeClass('active');
            $(this).addClass('active');
            currentPaymentMethod = $(this).data('method');
            if (currentPaymentMethod === 'cash') $('#cashPaymentSection').slideDown(160);
            else $('#cashPaymentSection').slideUp(160);
            $('#changeDisplay').removeClass('show');
            updatePayState();
        });
        $('#cashReceived').on('input', updatePayState);
        $(document).on('click', '.exact-btn, .quick-btn', function () {
            const amt = $(this).data('amount');
            if (amt === 'exact') {
                const sub = cart.reduce((s, i) => s + i.price * i.quantity, 0);
                const tot = sub - calcDiscount(sub);
                $('#cashReceived').val(paymentCurrency === 'usd' ? tot.toFixed(2) : toKhr(tot));
            } else {
                $('#cashReceived').val(amt);
            }
            updatePayState();
        });
        $('#discountAmount').on('input', function () {
            discountAmount = Math.max(parseFloat($(this).val()) || 0, 0);
            updateSummary();
            syncCustomerDisplay();
        });
        $('#discountTypeSelect').on('change', function () {
            discountType = $(this).val();
            $('#discountTypeBadge').text(discountType === 'fixed' ? 'ដុល្លារ' : 'ភាគរយ');
            updateSummary();
            syncCustomerDisplay();
        });

        $('#cancelOrderBtn').click(function () {
            if (!cart.length) return;
            if (confirm('បោះបង់ការកម្មង់?')) {
                resetCart();
                notify('បោះបង់ការកម្មង់', 'warning');
            }
        });
        $('#holdOrderBtn').click(function () {
            if (!cart.length) {
                notify('គ្មានទំនិញ', 'warning');
                return;
            }
            const sub = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const disc = calcDiscount(sub);
            const held = JSON.parse(localStorage.getItem('heldOrders') || '[]');
            held.push({
                id: 'HOLD' + Date.now(),
                items: cart,
                discount: {amount: discountAmount, type: discountType, value: disc},
                total: sub - disc
            });
            localStorage.setItem('heldOrders', JSON.stringify(held));
            resetCart();
            notify('ផ្អាកការកម្មង់', 'success');
        });

        /* ════ KHQR FLOW ════ */
        let _khqrActive = false;
        let qrModalTimer = null;

        async function openKhqrFlow(totalUsd) {
            const totalKhr = roundKhr100(toKhr(totalUsd));
            postToCustomer({type: 'CD_QR', total: totalUsd, totalKhr});
            showCashierQrModal(totalUsd, totalKhr);
            _khqrActive = true;
        }

        function showCashierQrModal(totalUsd, totalKhr) {
            $('#cqrAmount').text(fmtUsd(totalUsd));
            $('#cqrKhr').text(fmtKhr(totalKhr));
            $('#cashierQrModal').addClass('show');
            if (qrModalTimer) clearTimeout(qrModalTimer);
            qrModalTimer = setTimeout(function () {
                if ($('#cashierQrModal').hasClass('show')) {
                    closeKhqrFlow();
                    notify('KHQR ផុតកំណត់', 'warning');
                }
            }, 120000);
        }

        function closeKhqrFlow() {
            _khqrActive = false;
            $('#cashierQrModal').removeClass('show');
            postToCustomer({type: 'CD_QR_HIDE'});
            if (qrModalTimer) {
                clearTimeout(qrModalTimer);
                qrModalTimer = null;
            }
        }

        /* ════ PAY BUTTON ════ */
        $('#payBtn').on('click', async function () {
            const sub = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const totalUsd = sub - calcDiscount(sub);
            if (currentPaymentMethod === 'qr') {
                await openKhqrFlow(totalUsd);
            } else {
                openCashConfirm();
            }
        });

        /* ════ CASH CONFIRM MODAL ════ */
        function openCashConfirm() {
            const sub = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            const disc = calcDiscount(sub);
            const totalUsd = sub - disc;
            const totalKhr = roundKhr100(toKhr(totalUsd));
            const cash = parseFloat($('#cashReceived').val()) || totalUsd;
            let changeUsd = 0, changeKhr = 0;
            if (currentPaymentMethod === 'cash') {
                if (paymentCurrency === 'usd') {
                    changeUsd = Math.max(0, cash - totalUsd);
                    changeKhr = roundKhr100(toKhr(changeUsd));
                } else {
                    changeKhr = roundKhr100(Math.max(0, cash - totalKhr));
                    changeUsd = changeKhr / EXCHANGE_RATE;
                }
            }
            let itemsHtml = '';
            cart.forEach(item => {
                itemsHtml += `<div class="cc-order-item"><span class="cc-item-name">${item.name}</span><span class="cc-item-qty">×${item.quantity}</span><span class="cc-item-price">${fmtUsd(item.price * item.quantity)}</span></div>`;
            });
            $('#ccOrderItems').html(itemsHtml);
            let sumHtml = `<div class="cc-sum-row"><span>សរុប</span><span>${fmtUsd(sub)}<span class="cc-sum-khr">${fmtKhr(roundKhr100(toKhr(sub)))}</span></span></div>`;
            if (disc > 0) {
                const dLabel = discountType === 'percentage' ? `បញ្ចុះ ${discountAmount}%` : 'បញ្ចុះ';
                sumHtml += `<div class="cc-sum-row" style="color:#92400E;"><span>${dLabel}</span><span>-${fmtUsd(disc)}</span></div>`;
            }
            sumHtml += `<div class="cc-sum-row total"><span><i class="fas fa-calculator" style="margin-right:4px;"></i>សរុបទាំងអស់</span><span>${fmtUsd(totalUsd)}<span class="cc-sum-khr">${fmtKhr(totalKhr)}</span></span></div>`;
            $('#ccSummary').html(sumHtml);
            if (currentPaymentMethod === 'cash') {
                const cashDisp = paymentCurrency === 'usd' ? fmtUsd(cash) : fmtKhr(cash);
                const cashKhr = paymentCurrency === 'usd' ? fmtKhr(roundKhr100(toKhr(cash))) : '';
                const chDisp = paymentCurrency === 'usd' ? fmtUsd(changeUsd) : fmtKhr(changeKhr);
                const chKhrD = paymentCurrency === 'usd' ? fmtKhr(changeKhr) : '';
                $('#ccCashVal').text(cashDisp);
                $('#ccCashKhr').text(cashKhr);
                $('#ccChangeVal').text(chDisp);
                $('#ccChangeKhr').text(chKhrD);
                $('#ccPaymentBox').show();
            } else {
                $('#ccCashVal').text('Card');
                $('#ccCashKhr').text('');
                $('#ccChangeVal').text('—');
                $('#ccChangeKhr').text('');
                $('#ccPaymentBox').hide();
            }
            $('#cashConfirmModal').addClass('show');
        }

        $('#ccCancelBtn').on('click', function () {
            $('#cashConfirmModal').removeClass('show');
        });
        $('#ccConfirmBtn').on('click', function () {
            $('#cashConfirmModal').removeClass('show');
            runPayFlow();
        });

        /* ════ ACTUAL PAY ════ */
        async function runPayFlow() {
            const $btn = $('#payBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> កំពុងរក្សាទុក...');
            try {
                const sub = cart.reduce((s, i) => s + i.price * i.quantity, 0);
                const disc = calcDiscount(sub);
                const totalUsd = sub - disc;
                const totalKhr = roundKhr100(toKhr(totalUsd));
                const cash = parseFloat($('#cashReceived').val()) || totalUsd;
                let changeUsd = 0, changeKhr = 0;
                if (currentPaymentMethod === 'cash') {
                    if (paymentCurrency === 'usd') {
                        changeUsd = Math.max(0, cash - totalUsd);
                        changeKhr = roundKhr100(toKhr(changeUsd));
                    } else {
                        changeKhr = roundKhr100(Math.max(0, cash - totalKhr));
                        changeUsd = changeKhr / EXCHANGE_RATE;
                    }
                }
                const items = cart.map(i => ({
                    menuItemId: i.id,
                    brandId: i.brandId || 0,
                    quantity: i.quantity,
                    price: i.price,
                    subtotal: i.price * i.quantity
                }));
                const cashUsd = paymentCurrency === 'usd' ? cash : cash / EXCHANGE_RATE;
                const res = await fetch('/Order/CreateOrder', {
                    method: 'POST', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({items, cashReceived: cashUsd, discountAmount: disc})
                });
                if (!res.ok) {
                    const e = await res.json().catch(() => ({}));
                    throw new Error(e.error || `Server ${res.status}`);
                }
                const result = await res.json();
                orderCounter++;
                const orderNum = result.orderNumber || 'ORD' + orderCounter;
                const pmLabel = currentPaymentMethod === 'cash' ? 'សាច់ប្រាក់' : currentPaymentMethod === 'card' ? 'Card' : 'KHQR';
                const completedOrder = {
                    number: orderNum, date: new Date(), items: [...cart],
                    subtotal: sub, discount: disc, discountType, discountAmount,
                    total: totalUsd, totalKhr, paymentMethod: pmLabel,
                    paymentCurrency: paymentCurrency === 'usd' ? 'ដុល្លារ' : 'រៀល',
                    cashReceived: cash, changeUsd, changeKhr,
                    cashier: '@firstName @lastName'
                };
                window.lastOrder = completedOrder;
                lastOrderLocal = completedOrder;
                showCustomerThankYou(completedOrder);
                showInvoice(completedOrder);
                addRecentChip(orderNum, totalUsd);
                resetCart();
                notify('ការទូទាត់បានជោគជ័យ! ✓', 'success');
            } catch (err) {
                notify('មានបញ្ហា: ' + err.message, 'error');
            } finally {
                $btn.prop('disabled', false).html('<i class="fas fa-check-circle"></i> បញ្ចប់ការទូទាត់ <span class="shortcut-tag">F8</span>');
                updatePayState();
            }
        }

        function resetCart() {
            cart = [];
            discountAmount = 0;
            $('#discountAmount').val('0');
            $('#discountDisplay').hide();
            $('#cashReceived').val('0');
            $('#changeDisplay').removeClass('show');
            renderCart();
        }

        $('#cqrConfirmBtn').off('click').on('click', function () {
            closeKhqrFlow();
            runPayFlow();
        });
        $('#cqrCancelBtn').off('click').on('click', function () {
            closeKhqrFlow();
            notify('បោះបង់ KHQR — ជ្រើសរើសវិធីបង់ម្តងទៀត', 'warning');
        });

        /* ── Invoice ── */
        function showInvoice(order) {
            // Use Cambodia local time for invoice display
            const now = new Date();
            $('#invoiceDate').text(now.toLocaleDateString('en-GB', {day: '2-digit', month: 'short', year: 'numeric'}));
            $('#invoiceTime').text(now.toLocaleTimeString('en-US', {hour: '2-digit', minute: '2-digit'}));
            $('#invoiceNumber').text('#' + order.number);
            $('#invoicePaymentMethod').text(order.paymentMethod);
            let itemsHtml = '';
            order.items.forEach(item => {
                const tot = item.price * item.quantity;
                itemsHtml += `<div class="inv-item"><span class="inv-item-name">${item.name}</span><span class="inv-item-qty">${item.quantity} × ${fmtUsd(item.price)}</span><span class="inv-item-total">${fmtUsd(tot)}</span></div>`;
            });
            $('#invoiceItems').html(itemsHtml);
            let sumHtml = `<div class="inv-sum-row"><span>សរុបរង</span><span>${fmtUsd(order.subtotal)}</span></div>`;
            if (order.discount > 0) sumHtml += `<div class="inv-sum-row discount"><span>បញ្ចុះ ${order.discountType === 'percentage' ? '(' + order.discountAmount + '%)' : ''}</span><span>-${fmtUsd(order.discount)}</span></div>`;
            sumHtml += `<div class="inv-sum-row total"><span>សរុប</span><span>${fmtUsd(order.total)}</span></div><div style="text-align:right;font-size:10.5px;color:var(--text-muted);margin-top:3px;">${fmtKhr(order.totalKhr)}</div>`;
            $('#invoiceSummary').html(sumHtml);
            let payHtml = '';
            if (order.paymentMethod === 'សាច់ប្រាក់') {
                const cd = order.paymentCurrency === 'ដុល្លារ' ? fmtUsd(order.cashReceived) : fmtKhr(order.cashReceived);
                const ch = order.paymentCurrency === 'ដុល្លារ' ? fmtUsd(order.changeUsd) : fmtKhr(order.changeKhr);
                payHtml = `<div class="inv-sum-row"><span>ទទួល (${order.paymentCurrency})</span><span>${cd}</span></div><div class="inv-sum-row"><span>អាប់</span><span>${ch}</span></div>`;
            } else {
                payHtml = `<div class="inv-sum-row"><span>វិធីបង់</span><span>${order.paymentMethod}</span></div>`;
            }
            $('#invoicePaymentDetails').html(payHtml);
            $('#invoiceModal').addClass('show');
        }

        /* ── Print ── */
        $('#printInvoiceBtn').click(function () {
            if (!lastOrderLocal) return;
            $('#invoiceModal').removeClass('show');
            const order = lastOrderLocal;
            const now = new Date();
            const dateStr = now.toLocaleDateString('en-GB', {day: '2-digit', month: 'short', year: 'numeric'});
            const timeStr = now.toLocaleTimeString('en-US', {hour: '2-digit', minute: '2-digit'});
            const fu = n => '$' + parseFloat(n).toFixed(2);
            const fk = n => Math.round(n).toLocaleString() + ' ៛';
            let itH = '';
            order.items.forEach(i => {
                const t = i.price * i.quantity;
                itH += `<tr><td style="padding:5px 2px;border-bottom:1px dashed #ccc;">${i.name}</td><td style="text-align:center;padding:5px 2px;border-bottom:1px dashed #ccc;">${i.quantity}</td><td style="text-align:right;padding:5px 2px;border-bottom:1px dashed #ccc;">${fu(i.price)}</td><td style="text-align:right;padding:5px 2px;border-bottom:1px dashed #ccc;font-weight:900;">${fu(t)}</td></tr>`;
            });
            let sumH = `<div style="display:flex;justify-content:space-between;margin:5px 0;"><span>សរុបរង</span><span>${fu(order.subtotal)}</span></div>`;
            if (order.discount > 0) sumH += `<div style="display:flex;justify-content:space-between;margin:5px 0;color:#F59E0B;"><span>បញ្ចុះ</span><span>-${fu(order.discount)}</span></div>`;
            sumH += `<div style="display:flex;justify-content:space-between;margin:5px 0;font-weight:bold;font-size:16px;border-top:2px dashed #333;padding-top:8px;"><span>សរុបទាំងអស់</span><span>${fu(order.total)}</span></div><div style="text-align:right;font-size:11px;font-weight:bold;">${fk(order.totalKhr)}</div>`;
            let payH = '';
            if (order.paymentMethod === 'សាច់ប្រាក់') {
                const cd = order.paymentCurrency === 'ដុល្លារ' ? fu(order.cashReceived) : fk(order.cashReceived);
                const ch = order.paymentCurrency === 'ដុល្លារ' ? fu(order.changeUsd) : fk(order.changeKhr);
                payH = `<div style="display:flex;justify-content:space-between;margin:5px 0;"><span>ទទួល</span><span>${cd}</span></div><div style="display:flex;justify-content:space-between;margin:5px 0;"><span>អាប់</span><span>${ch}</span></div>`;
            } else {
                payH = `<div style="display:flex;justify-content:space-between;margin:5px 0;"><span>វិធីបង់</span><span>${order.paymentMethod}</span></div>`;
            }
            const pf = document.createElement('iframe');
            pf.style.cssText = 'position:absolute;width:0;height:0;border:none;visibility:hidden';
            document.body.appendChild(pf);
            const doc = pf.contentWindow.document;
            doc.open();
            doc.write(`<!DOCTYPE html><html><head><meta charset="utf-8"><title>Invoice</title>
<style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:'Khmer OS','Leelawadee UI',Arial,sans-serif;font-size:13px;font-weight:bold;width:72mm;margin:0 auto;padding:4mm 3mm;color:#000}.hdr{text-align:center;padding-bottom:8px;border-bottom:3px solid #000;margin-bottom:8px}.shop{font-size:22px;font-weight:900;letter-spacing:1px;margin-bottom:3px}.det{font-size:12px;margin:1px 0}.ord-num{font-size:15px;font-weight:900;text-align:center;margin:6px 0;border:2px solid #000;padding:4px 0}.info{margin-bottom:7px;border-bottom:2px dashed #000;padding-bottom:7px}.row{display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px}table{width:100%;border-collapse:collapse;margin-bottom:4px;table-layout:fixed}thead tr{border-bottom:2px solid #000;border-top:2px solid #000}th{font-size:12px;font-weight:900;padding:5px 2px;text-align:left}th:nth-child(1){width:40%}th:nth-child(2){width:12%;text-align:center}th:nth-child(3){width:22%;text-align:right}th:nth-child(4){width:26%;text-align:right}tbody tr{border-bottom:1px dashed #ccc}td{font-size:12px;font-weight:bold;padding:5px 2px}td:nth-child(2){text-align:center}td:nth-child(3){text-align:right}td:last-child{text-align:right;font-weight:900}.sum{padding:6px 0;border-bottom:2px dashed #000;margin-bottom:6px}.pay{padding:6px 0;border-bottom:2px dashed #000;margin-bottom:7px}.ftr{text-align:center;padding-top:7px;border-top:2px dashed #000}.ty{font-size:17px;font-weight:900;margin-bottom:4px}.fs{font-size:11px;margin:3px 0}@@media print{body{width:72mm;padding:2mm;margin:0}}</style></head>
<body><div class="hdr"><div class="shop">ផ្ទះបាយសេនឌូ</div><div class="det">ទូរស័ព្ទ: 086 262 828</div><div class="det">ភ្នំពេញ, កម្ពុជា</div></div><div class="ord-num">លេខ #${order.number}</div><div class="info"><div class="row"><span>កាលបរិច្ឆេទ:</span><span>${dateStr} ${timeStr}</span></div><div class="row"><span>អ្នកលក់:</span><span>${order.cashier}</span></div></div><table><thead><tr><th>មុខទំនិញ</th><th style="text-align:center">ចំនួន</th><th style="text-align:right">តម្លៃ</th><th style="text-align:right">សរុប</th></tr></thead><tbody>${itH}</tbody></table><div class="sum">${sumH}</div><div class="pay">${payH}</div><div class="ftr"><div class="ty">សូមអរគុណ! 🙏</div><div class="fs">ទំនិញទិញហើយ មិនអាចដូរបានទេ</div><div class="fs">សូមអញ្ជើញមកម្តងទៀត</div></div></body></html>`);
            doc.close();
            pf.onload = function () {
                setTimeout(function () {
                    pf.contentWindow.focus();
                    pf.contentWindow.print();
                    pf.contentWindow.onafterprint = () => document.body.removeChild(pf);
                }, 100);
            };
        });

        $('#closeInvoiceBtn').click(() => $('#invoiceModal').removeClass('show'));
        $(document).on('click', '.modal-overlay', function (e) {
            if ($(e.target).hasClass('modal-overlay')) $('#invoiceModal').removeClass('show');
        });

        /* Recent chips */
        function addRecentChip(num, amt) {
            const html = `<div class="recent-chip" data-order="${num}"><span class="rord-num">#${num}</span><span>${fmtUsd(amt)}</span><span class="rord-status">✓</span></div>`;
            $('#recentOrders').prepend(html);
            if ($('#recentOrders .recent-chip').length > 6) $('#recentOrders .recent-chip:last').remove();
        }

        $(document).on('click', '.recent-chip', () => {
            if (lastOrderLocal) showInvoice(lastOrderLocal);
        });
        addRecentChip('4582', 45.97);
        addRecentChip('4581', 23.50);
        addRecentChip('4580', 67.48);

        /* Mobile sheet */
        $('#cartFab').click(function () {
            $('#mobileCartContent').html($('#cartPanel').html());
            updateSummary();
            $('#cartSheet').addClass('open');
        });
        $('#sheetBackdrop').click(() => $('#cartSheet').removeClass('open'));

        /* Toast notifications */
        function notify(msg, type = 'info') {
            $('.toast').remove();
            const icons = {
                success: 'fa-check-circle',
                warning: 'fa-exclamation-triangle',
                error: 'fa-times-circle',
                info: 'fa-info-circle'
            };
            const $t = $(`<div class="toast t-${type}"><i class="fas ${icons[type] || icons.info}" style="color:${type === 'success' ? '#00B894' : type === 'warning' ? '#F59E0B' : type === 'error' ? '#EF4444' : '#FF6B35'};flex-shrink:0;"></i><span>${msg}</span></div>`);
            $('body').append($t);
            setTimeout(() => $t.addClass('show'), 10);
            setTimeout(() => {
                $t.removeClass('show');
                setTimeout(() => $t.remove(), 280);
            }, 2800);
        }

        /* Keyboard shortcuts */
        $(document).on('keydown', async function (e) {
            if (e.key === 'F2') {
                e.preventDefault();
                if (cart.length && confirm('ចាប់ផ្តើមថ្មី?')) {
                    resetCart();
                    notify('ចាប់ផ្ដើម​ការ​កម្មង់​ថ្មី', 'info');
                }
            }
            if (e.key === 'F3') {
                e.preventDefault();
                openCustomerDisplay();
            }
            if (e.key === 'F4') {
                e.preventDefault();
                $('#holdOrderBtn').click();
            }
            if (e.key === 'F8') {
                e.preventDefault();
                if (!$('#payBtn').prop('disabled')) {
                    const sub = cart.reduce((s, i) => s + i.price * i.quantity, 0);
                    const totalUsd = sub - calcDiscount(sub);
                    if (currentPaymentMethod === 'qr') {
                        await openKhqrFlow(totalUsd);
                    } else {
                        $('#payBtn').click();
                    }
                }
            }
            if (e.key === 'Escape') {
                e.preventDefault();
                if ($('#cashierQrModal').hasClass('show')) {
                    closeKhqrFlow();
                } else if ($('#cashConfirmModal').hasClass('show')) {
                    $('#cashConfirmModal').removeClass('show');
                } else if ($('#invoiceModal').hasClass('show')) {
                    $('#invoiceModal').removeClass('show');
                } else {
                    $('#cancelOrderBtn').click();
                }
            }
            if (e.key === '/' && !$(e.target).is('input,textarea,select')) {
                e.preventDefault();
                $('#productSearch').focus();
            }
        });

        console.log('%c✅ POS Ready', 'color:#00B894;font-weight:bold');
    });

    /* ════════════════════════════════════════════════
       SHIFT MANAGEMENT — Cambodia time (UTC+7)
    ════════════════════════════════════════════════ */
    const shift = {
        isOpen: false, shiftId: null, startTime: null,
        openingCash: 0, orderCount: 0, revenue: 0, elapsedTimer: null
    };

    (async function loadShiftState() {
        try {
            const res = await fetch('/Shift/GetCurrentShiftInfo');
            const data = await res.json();
            if (data.isOpen) {
                shift.isOpen = true;
                shift.shiftId = data.shiftId;
                shift.startTime = parseCambodiaTime(data.startTime);
                shift.openingCash = data.openingCash;
                shift.orderCount = data.orderCount;
                shift.revenue = parseFloat(data.revenue) || 0;
                document.getElementById('shiftBtn').classList.add('shift-open');
                document.getElementById('shiftOpenCashDisplay').textContent = '$' + parseFloat(data.openingCash).toFixed(2);
                document.getElementById('shiftStartedTime').textContent = 'ចាប់ផ្ដើម — ' + fmtCambodiaTime(shift.startTime);
                clearInterval(shift.elapsedTimer);
                shift.elapsedTimer = setInterval(updateShiftStats, 10000);
                updateShiftStats();
                setTimeout(() => {
                    customerDisplayAutoOpen = true;
                    openCustomerDisplay();
                }, 1000);
            }
        } catch (e) {
            console.warn('Could not load shift state:', e);
        }
    })();

    function showShiftModal() {
        const now = new Date();
        const h = now.getHours() % 12 || 12;
        const m = String(now.getMinutes()).padStart(2, '0');
        const ap = now.getHours() >= 12 ? 'PM' : 'AM';
        document.getElementById('shiftCurrentTime').textContent = `${h}:${m} ${ap}`;
        if (shift.isOpen) {
            document.getElementById('shiftClosedView').style.display = 'none';
            document.getElementById('shiftOpenView').style.display = 'block';
            updateShiftStats();
        } else {
            document.getElementById('shiftClosedView').style.display = 'block';
            document.getElementById('shiftOpenView').style.display = 'none';
        }
        document.getElementById('shiftModal').classList.add('show');
    }

    function hideShiftModal() {
        document.getElementById('shiftModal').classList.remove('show');
    }

    function updateShiftStats() {
        if (!shift.startTime) return;
        const elapsed = Math.floor((Date.now() - shift.startTime.getTime()) / 1000);
        const hrs = Math.floor(elapsed / 3600);
        const mins = Math.floor((elapsed % 3600) / 60);
        document.getElementById('shiftElapsed').textContent = `${hrs}:${String(mins).padStart(2, '0')}`;
        document.getElementById('shiftOrderCount').textContent = shift.orderCount;
        document.getElementById('shiftRevenue').textContent = '$' + shift.revenue.toFixed(2);
        document.getElementById('shiftTotalCash').textContent = '$' + (shift.openingCash + shift.revenue).toFixed(2);
    }

    document.getElementById('shiftStartBtn').addEventListener('click', async function () {
        const openCash = parseFloat(document.getElementById('shiftOpeningCash').value) || 0;
        this.disabled = true;
        this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> កំពុងបើក...';
        try {
            const res = await fetch('/Shift/OpenShift', {
                method: 'POST', headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({openingCash: openCash})
            });
            const data = await res.json();
            shift.isOpen = true;
            shift.shiftId = data.shiftId;
            shift.startTime = parseCambodiaTime(data.startTime);
            shift.openingCash = openCash;
            shift.orderCount = 0;
            shift.revenue = 0;
            document.getElementById('shiftBtn').classList.add('shift-open');
            document.getElementById('shiftStartedTime').textContent = 'ចាប់ផ្ដើម — ' + fmtCambodiaTime(shift.startTime);
            document.getElementById('shiftOpenCashDisplay').textContent = '$' + openCash.toFixed(2);
            clearInterval(shift.elapsedTimer);
            shift.elapsedTimer = setInterval(updateShiftStats, 10000);
            document.getElementById('shiftClosedView').style.display = 'none';
            document.getElementById('shiftOpenView').style.display = 'block';
            updateShiftStats();
            customerDisplayAutoOpen = true;
            setTimeout(() => openCustomerDisplay(), 500);
        } catch (e) {
            alert('បើកវេនមិនបានជោគជ័យ: ' + e.message);
        } finally {
            this.disabled = false;
            this.innerHTML = '<i class="fas fa-play-circle"></i> ចាប់ផ្ដើមវេន';
        }
    });

    document.getElementById('shiftEndBtn').addEventListener('click', async function () {
        if (!confirm('បញ្ចប់វេនការងារ?\n\nការកម្មង់: ' + shift.orderCount + '\nចំណូល: $' + shift.revenue.toFixed(2))) return;
        this.disabled = true;
        this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> កំពុងបិទ...';
        try {
            const res = await fetch('/Shift/CloseShift', {method: 'POST'});
            const data = await res.json();
            if (!data.success) {
                alert('មានបញ្ហា: ' + (data.message || 'Unknown error'));
                return;
            }

            const endTimeDt = parseCambodiaTime(data.endTime);
            const startTimeDt = parseCambodiaTime(data.startTime);
            console.log('✅ Shift closed — Start:', fmtCambodiaDateTime(startTimeDt), '| End:', fmtCambodiaDateTime(endTimeDt), '| Duration:', data.durationMinutes, 'min');

            clearInterval(shift.elapsedTimer);
            shift.isOpen = false;
            shift.shiftId = null;
            shift.startTime = null;
            shift.orderCount = 0;
            shift.revenue = 0;
            shift.openingCash = 0;
            customerDisplayAutoOpen = false;
            closeCustomerDisplay();
            document.getElementById('shiftBtn').classList.remove('shift-open');
            document.getElementById('shiftOpeningCash').value = '0';
            hideShiftModal();
            window.location.href = '/Shift/ShiftSummary/' + data.shiftId;
        } catch (e) {
            alert('បិទវេនមិនបានជោគជ័យ: ' + e.message);
        } finally {
            this.disabled = false;
            this.innerHTML = '<i class="fas fa-stop-circle"></i> បញ្ចប់វេន';
        }
    });

    document.getElementById('shiftModal').addEventListener('click', function (e) {
        if (e.target === this) hideShiftModal();
    });

    (function watchShiftRevenue() {
        const obs = new MutationObserver(function (mutations) {
            mutations.forEach(function (m) {
                m.addedNodes.forEach(function (node) {
                    if (node.classList &&
                        node.classList.contains('toast') &&
                        node.classList.contains('t-success') &&
                        shift.isOpen &&
                        window.lastOrder &&
                        window.lastOrder.total > 0) {
                        shift.orderCount++;
                        shift.revenue += window.lastOrder.total;
                        updateShiftStats();
                    }
                });
            });
        });
        obs.observe(document.body, {childList: true});
    })();

    setTimeout(maintainCustomerDisplay, 3000);
</script>
</body>
</html>